# Copy to .env for local builds. On Vercel, set these under
# Project → Settings → Environment Variables.

# Google Business Profile reviews (src/lib/google-reviews.mjs). Places API (New)
# key, restricted to the Places API. Used only at build time, never shipped.
GOOGLE_PLACES_API_KEY=
# Optional — overrides GBP_PLACE_ID in src/lib/site.mjs.
GOOGLE_PLACE_ID=

# Contact form (src/pages/api/contact.ts)
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=

# Chat assistant (src/pages/api/chat.ts)
GEMINI_API_KEY=
GEMINI_MODEL=
