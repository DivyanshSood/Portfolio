# Copy to .env for local builds. On Vercel, set these under
# Project → Settings → Environment Variables.

# Google Business Profile reviews (src/lib/google-reviews.mjs). Places API (New)
# key, restricted to the Places API. Used only at build time, never shipped.
GOOGLE_PLACES_API_KEY=
# Optional — overrides GBP_PLACE_ID in src/lib/site.mjs.
GOOGLE_PLACE_ID=

# Contact form (src/pages/api/contact.ts)
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=

# Chat assistant (src/pages/api/chat.ts)
GEMINI_API_KEY=
GEMINI_MODEL=

# Bing Webmaster Tools verification (src/layouts/Base.astro → <meta name="msvalidate.01">).
# Not needed if the site is added to Bing by "Import from Google Search Console".
# Bing's index feeds ChatGPT Search and Copilot, and IndexNow pings to Bing
# return 403 until the site is verified there.
BING_SITE_VERIFICATION=
