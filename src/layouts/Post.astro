---
// Blog post shell. Each post file keeps its own prose, FAQ array and JSON-LD;
// everything around them — hero, byline, cover, FAQ block, read-next links,
// hub links and the end CTA — lives here, in brandbook parts only.
import Base from "./Base.astro";
import PageHero from "../components/brand/PageHero.astro";
import Section from "../components/brand/Section.astro";
import SpecList from "../components/brand/SpecList.astro";
import Faq from "../components/brand/Faq.astro";
import PostList from "../components/brand/PostList.astro";
import EndCta from "../components/brand/EndCta.astro";
import { SITE, CALENDLY_URL, DEFAULT_OG, fmtDate, iso, related } from "../lib/blog.mjs";
import { coverBase, coverSrcset, COVER_SIZES_POST } from "../lib/images.mjs";

type Link = { href: string; label: string };
interface Props {
  post: any;
  jsonld: string;
  faqs?: { q: string; a: string }[];
  /** A post-specific end CTA; otherwise the audience default below. */
  cta?: { title: string; text: string; primary: Link; secondary?: Link };
}
const { post, jsonld, faqs = [], cta } = Astro.props;

const canonical = `${SITE}/blog/${post.slug}/`;
const ogImage = post.coverImage ? `${SITE}${post.coverImage}` : DEFAULT_OG;
const primaryTag = post.tags[0] || "Notes";
const showUpdated = post.updatedDate && +new Date(post.updatedDate) > +new Date(post.pubDate);

const spec = [
  { k: "Author", v: `<a href="/about/">Divyansh Sood</a>` },
  { k: "Published", v: fmtDate(post.pubDate) },
  ...(showUpdated ? [{ k: "Updated", v: fmtDate(post.updatedDate) }] : []),
  { k: "Read", v: `${post.readMins} min` },
];

// ---- Keep reading -----------------------------------------------------------
// Each post links its topic cluster plus a row of hubs (service pages, city
// pages, results), so posts aren't near-orphans reachable only from /blog/.
const more = related(post.slug, 5);

// City links rotate per post (deterministically, by slug) so all four city
// pages accumulate inbound links; each track keeps a stable set of hubs.
const LOCATIONS: Link[] = [
  { label: "Web developer in Kangra", href: "/web-developer-kangra/" },
  { label: "Web developer in Dharamshala", href: "/web-developer-dharamshala/" },
  { label: "Website designer in Shimla", href: "/web-developer-shimla/" },
  { label: "Web developer in Manali", href: "/web-developer-manali/" },
];
const offset = [...post.slug].reduce((n: number, c: string) => n + c.charCodeAt(0), 0) % LOCATIONS.length;
const twoCities = [LOCATIONS[offset], LOCATIONS[(offset + 1) % LOCATIONS.length]];
const TRACKS: Record<string, Link[]> = {
  "indian-smb": [
    { label: "Website development", href: "/services/website-development/" },
    ...twoCities,
    { label: "Results", href: "/results/" },
  ],
  "d2c-brand": [
    { label: "E-commerce development", href: "/services/ecommerce-website-development/" },
    { label: "Website development", href: "/services/website-development/" },
    { label: "AI development", href: "/services/ai-development/" },
    { label: "Selected work", href: "/portfolio/" },
  ],
  international: [
    { label: "Website development", href: "/services/website-development/" },
    { label: "AI development", href: "/services/ai-development/" },
    { label: "AI in web development", href: "/blog/topics/ai-web-development/" },
    { label: "Selected work", href: "/portfolio/" },
  ],
};
const HUBS = TRACKS[post.audience] || TRACKS.international;

// ---- End CTA, by audience ---------------------------------------------------
const AUDIENCE_CTA: Record<string, NonNullable<Props["cta"]>> = {
  "indian-smb": {
    title: "Working on something in India?",
    text: "If a post here matches what you're building, send me the brief. WhatsApp reply in under an hour, 9 AM–9 PM IST — I'll tell you within a day if it's a fit.",
    primary: { href: "https://wa.me/919816091875", label: "Message me on WhatsApp →" },
    secondary: { href: "/#work", label: "See the work →" },
  },
  "d2c-brand": {
    title: "Building a brand a theme can't carry?",
    text: "If your store has a model that off-the-shelf builders fight — hand-numbered drops, creator commerce, premium D2C — tell me about it. I read every brief personally.",
    primary: { href: "mailto:hello@divyanshsood.com", label: "Email me →" },
    secondary: { href: "/#work", label: "See the work →" },
  },
  international: {
    title: "Working on something similar?",
    text: "If a post here matches what you're building, send me the brief. I reply personally, usually within a couple of hours — and I'll tell you within a day if it's a fit.",
    primary: { href: "mailto:hello@divyanshsood.com", label: "Email me →" },
    secondary: { href: CALENDLY_URL, label: "Book a 15-min intro →" },
  },
};
const end = cta ?? AUDIENCE_CTA[post.audience] ?? AUDIENCE_CTA.international;
let n = 1;
---

<Base
  title={post.seoTitle ?? `${post.title} · Divyansh Sood`}
  description={post.description}
  canonical={canonical}
  keywords={post.tags.join(", ")}
  ogType="article"
  ogTitle={post.title}
  ogImage={ogImage}
  ogImageW={1200}
  ogImageH={750}
  articlePublished={iso(post.pubDate)}
  articleModified={iso(post.updatedDate || post.pubDate)}
  tags={post.tags}
  preloadImage={post.coverImage ? { href: coverBase(post.coverImage), srcset: coverSrcset(post.coverImage), sizes: COVER_SIZES_POST } : undefined}
  jsonld={jsonld}
>
  <main>
    <PageHero
      display="Journal"
      meta={`${primaryTag} · ${post.readMins} min read`}
      h1={post.title}
      h1Class="post-title"
      lead={post.description}
      leadClass="post-lead"
    />

    <section class="pb">
      <div class="wrap pb-in">
        <aside class="pb-side">
          <div class="lbl">({String(n).padStart(2, "0")}) Journal — {primaryTag}</div>
          <SpecList items={spec} />
          <div class="chips pb-tags">{post.tags.map((t: string) => <span class="chip chip--muted">{t}</span>)}</div>
        </aside>
        <div class="pb-main">
          {post.coverImage && (
            <figure class="pb-cover">
              <img src={coverBase(post.coverImage)} srcset={coverSrcset(post.coverImage)} sizes={COVER_SIZES_POST} alt={post.coverAlt ?? post.title} width="1200" height="750" fetchpriority="high" decoding="async" />
            </figure>
          )}
          <article class="post-body prose">
            <slot />
          </article>
        </div>
      </div>
    </section>

    {faqs.length > 0 && (
      <Section bare>
        <Faq faqs={faqs} label={`(${String(++n).padStart(2, "0")}) Before you ask`} />
      </Section>
    )}

    <Section n={++n} term="Journal" note="Read next" title="Keep reading">
      <PostList items={more.map((p: any) => ({ href: `/blog/${p.slug}/`, title: p.title, meta: `${p.tags[0] || "Notes"} · ${p.readMins} min` }))} />
      <div class="gap-top">
        <div class="chips-lbl">Related</div>
        <div class="chips">
          {HUBS.map((h) => <a class="chip" href={h.href}>{h.label}</a>)}
          <a class="chip chip--red" href="/blog/">All writing</a>
        </div>
      </div>
    </Section>

    <EndCta title={end.title} text={end.text} primary={end.primary} secondary={end.secondary} />
  </main>
</Base>

<style>
  .pb{padding:clamp(48px,6vw,96px) var(--gutter) 0}
  .pb-in{display:flex;flex-wrap:wrap;gap:40px clamp(28px,5vw,80px);align-items:flex-start}
  .pb-side{flex:0 1 320px;display:flex;flex-direction:column;gap:22px}
  .pb-side .lbl{margin:0}
  .pb-tags .chip{min-height:0;padding:8px 10px;font-size:11px}
  .pb-main{flex:1 1 560px;min-width:0;max-width:820px}
  .pb-cover{margin:0 0 clamp(32px,4vw,56px);aspect-ratio:16/10;background:var(--tint);overflow:hidden}
  .pb-cover img{width:100%;height:100%;object-fit:cover;display:block}
  @media (min-width:900px){.pb-side{position:sticky;top:88px}}
</style>
