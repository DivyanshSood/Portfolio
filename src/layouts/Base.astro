---
// ===========================================================================
// Base.astro — the site shell for every page.
//
// Chrome is the Home design's, used on every page: fixed header (DS®, six
// links, red IST clock, white "Book a call"; ink full-screen menu under
// 900px) and the big ink footer. Everything visual is specified by the
// locked brandbook (src/styles/brand.css); the <head> keeps every SEO / AEO /
// GEO tag, the JSON-LD graph and analytics exactly as they were.
// ===========================================================================
import "../styles/brand.css";
import BaseScripts from "../components/BaseScripts.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ChatWidget from "../components/ChatWidget.astro";
import { SOCIAL_PROFILES } from "../lib/site.mjs";
import { completeGraph, breadcrumbTrail } from "../lib/entity.mjs";

// Search-engine ownership verification (public tokens — fine to ship in source).
const BING_VERIFY = import.meta.env.BING_SITE_VERIFICATION;
const YANDEX_VERIFY = import.meta.env.YANDEX_VERIFICATION ?? "f949199876a945f6";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  keywords?: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageW?: number;
  ogImageH?: number;
  ogLocale?: string;
  imageAlt?: string;
  jsonld?: string;
  articlePublished?: string;
  articleModified?: string;
  tags?: string[];
  preloadImage?: { href: string; srcset?: string; sizes?: string };
  /**
   * Concepts this page is genuinely about, from TOPICS in src/lib/entity.mjs.
   * Used as `about` on the page-level WebPage node, which resolves an ambiguous
   * phrase to a public identifier. Keep it to what the page actually covers —
   * a long list is keyword stuffing wearing a schema costume.
   */
  topics?: object[];
  /** Keep the page out of the index (404). */
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  keywords,
  ogType = "website",
  ogTitle,
  ogDescription,
  ogImage = "https://www.divyanshsood.com/og-home.png",
  ogImageW = 1200,
  ogImageH = 630,
  ogLocale = "en_IN",
  imageAlt = "Divyansh Sood® Studio — custom-coded, conversion-focused websites",
  jsonld,
  articlePublished,
  articleModified,
  tags,
  preloadImage,
  topics,
  noindex = false,
} = Astro.props;

// The hero breadcrumb (PageHero) reads the trail from the page's own
// BreadcrumbList, so the visible trail and the markup are one array.
Astro.locals.crumbs = breadcrumbTrail(jsonld).map((c: { name: string; url: string }) => ({
  name: c.name,
  url: c.url ? c.url.replace(/^https?:\/\/[^/]+/, "") || "/" : "",
}));
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content="Divyansh Sood" />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1" />
      </>
    )}
    <meta name="theme-color" content="#0B0B0C" />
    <meta name="apple-mobile-web-app-title" content="Divyansh Sood" />
    {BING_VERIFY && <meta name="msvalidate.01" content={BING_VERIFY} />}
    {YANDEX_VERIFY && <meta name="yandex-verification" content={YANDEX_VERIFY} />}
    {canonical && <link rel="canonical" href={canonical} />}

    {canonical && (
      <>
        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content="Divyansh Sood® Studio" />
        <meta property="og:title" content={ogTitle ?? title} />
        <meta property="og:description" content={ogDescription ?? description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content={String(ogImageW)} />
        <meta property="og:image:height" content={String(ogImageH)} />
        <meta property="og:image:alt" content={imageAlt} />
        <meta property="og:locale" content={ogLocale} />
        {articlePublished && <meta property="article:published_time" content={articlePublished} />}
        {articleModified && <meta property="article:modified_time" content={articleModified} />}
        {(tags ?? []).map((t) => <meta property="article:tag" content={t} />)}

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={ogTitle ?? title} />
        <meta name="twitter:description" content={ogDescription ?? description} />
        <meta name="twitter:image" content={ogImage} />
        <meta name="twitter:image:alt" content={imageAlt} />
      </>
    )}

    {/* ?v= busts the 30-day icon cache in vercel.json — bump it whenever
        scripts/gen-brand-assets.mjs regenerates the icons (v2: red square). */}
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <link rel="icon" href="/icon.svg?v=2" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Divyansh Sood® Studio — Journal" href="/rss.xml" />

    {/* Identity links — the same set as JSON-LD `sameAs`, both derived from
        SOCIAL_PROFILES so the machine-readable and human-readable claims can
        never drift apart. */}
    {SOCIAL_PROFILES.map((p) => <link rel="me" href={p.url} />)}
    {canonical && <link rel="author" href={`${new URL(canonical).origin}/about/`} />}

    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage.href}
          imagesrcset={preloadImage.srcset}
          imagesizes={preloadImage.sizes}
          fetchpriority="high"
        />
      )
    }
    {/* The two brandbook families, self-hosted (scripts/self-host-fonts.py).
        Display lines are italic, so both Archivo files are needed up front. */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/archivo-italic.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/archivo.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/geist-mono.woff2" crossorigin />

    {/* completeGraph appends any identity node (#person / #studio / #website) the
        page references by @id but never defines, plus a WebPage node for pages
        that have no node representing themselves — see src/lib/entity.mjs. */}
    {jsonld && canonical && (
      <script
        type="application/ld+json"
        is:inline
        set:html={completeGraph(jsonld, { canonical, name: ogTitle ?? title, description, topics })}
      />
    )}

    {/* ---- Analytics: GA4 + Yandex Metrica ----
        Loaded unconditionally for every visitor — the consent banner that used
        to gate these was removed by an explicit owner decision, so do not add
        a consent gate back. IP anonymisation stays on and Metrica runs without
        session replay / clickmap. The YM ID is duplicated in BaseScripts.astro
        (dsTrack) — keep them in sync.

        Deferred, not removed: both tags start after `load` (or on the first
        idle slot) so they compete with nothing the visitor can see. `gtag` and
        `ym` are stubbed synchronously so early calls are buffered, not lost. */}
    <script is:inline>
      (function () {
        // Local builds and previews are not visitors: 127.0.0.1 and localhost
        // were showing up in GA4 as referral sources. Without the stubs below,
        // dsTrack's typeof guards turn every event into a no-op.
        if (/^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname)) return;

        // The owner's own devices. Visiting any page with ?notrack sets a flag
        // in this browser and analytics stays off here for good; ?track clears
        // it. GA4's IP filter can't do this job: home broadband and mobile data
        // both hand out a new IP every few days. Same no-op path as localhost.
        try {
          var q = new URLSearchParams(location.search);
          if (q.has("notrack") || q.has("track")) {
            if (q.has("notrack")) localStorage.setItem("ds-notrack", "1");
            else localStorage.removeItem("ds-notrack");
            alert(q.has("notrack")
              ? "Analytics is now OFF in this browser. Your visits won't be counted."
              : "Analytics is back ON in this browser.");
            q.delete("notrack");
            q.delete("track");
            history.replaceState(null, "", location.pathname + (q.toString() ? "?" + q : "") + location.hash);
          }
          if (localStorage.getItem("ds-notrack") === "1") return;
        } catch (e) {}
        var GA_ID = "G-51WG6025T0";
        var YM_ID = 110027161;

        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        window.gtag = gtag;
        window.ym = window.ym || function () { (window.ym.a = window.ym.a || []).push(arguments); };
        window.ym.l = 1 * new Date();

        gtag("js", new Date());
        gtag("config", GA_ID, { anonymize_ip: true });
        window.ym(YM_ID, "init", { ssr: true, ecommerce: "dataLayer", accurateTrackBounce: true, trackLinks: true });

        var started = false;
        function start() {
          if (started) return;
          started = true;

          var s = document.createElement("script");
          s.async = true;
          s.src = "https://www.googletagmanager.com/gtag/js?id=" + GA_ID;
          document.head.appendChild(s);

          var ymSrc = "https://mc.yandex.ru/metrika/tag.js?id=" + YM_ID;
          for (var j = 0; j < document.scripts.length; j++) {
            if (document.scripts[j].src === ymSrc) return;
          }
          var k = document.createElement("script");
          var a = document.getElementsByTagName("script")[0];
          k.async = 1;
          k.src = ymSrc;
          a.parentNode.insertBefore(k, a);
        }

        function schedule() {
          if (window.requestIdleCallback) requestIdleCallback(start, { timeout: 3000 });
          else setTimeout(start, 1200);
        }
        if (document.readyState === "complete") schedule();
        else window.addEventListener("load", schedule, { once: true });
      })();
    </script>
  </head>
  <body>
    <div class="site" id="top">
      <SiteHeader />
      <slot />
      <SiteFooter />
    </div>
    <ChatWidget />
    <BaseScripts />
    <script>
      import { initChrome } from "../scripts/chrome.js";
      initChrome();
    </script>
  </body>
</html>
