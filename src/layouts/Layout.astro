---
import "../styles/global.css";
import BaseScripts from "../components/BaseScripts.astro";
import StickyBook from "../components/StickyBook.astro";
import CookieConsent from "../components/CookieConsent.astro";

// Fonts are self-hosted (see src/styles/base.css @font-face block + /public/fonts).
// Preload the most-used weight of Archivo so the hero H1 doesn't FOUT.
const FAVICON =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%230b0b0c'/%3E%3Ctext x='50' y='70' font-family='Arial,sans-serif' font-weight='900' font-size='56' fill='%23ffffff' text-anchor='middle'%3EDS%3C/text%3E%3Crect x='28' y='80' width='44' height='6' fill='%23ff1f1f'/%3E%3C/svg%3E";

// Search-engine ownership verification (public tokens — fine to ship in source).
// Yandex is verified with the baked-in default below; Bing renders only when its
// env var is set in Vercel (or import the site from Google Search Console, which
// needs no meta tag). Bing Webmaster also powers DuckDuckGo/Yahoo/Ecosia.
const BING_VERIFY = import.meta.env.BING_SITE_VERIFICATION;
const YANDEX_VERIFY = import.meta.env.YANDEX_VERIFICATION ?? "f949199876a945f6";

// Analytics (GA4 + Yandex Metrica) are NO LONGER loaded here.
// The CookieConsent component injects them at runtime, only after the visitor
// clicks "Accept analytics". Until then, the only request this site makes is
// the one to load it. See src/components/CookieConsent.astro.

export interface Props {
  title: string;
  description: string;
  canonical: string;
  keywords?: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageW?: number;
  ogImageH?: number;
  ogLocale?: string;
  imageAlt?: string;
  jsonld?: string;
  articlePublished?: string;
  articleModified?: string;
  tags?: string[];
  preloadImage?: { href: string; srcset?: string; sizes?: string };
}

const {
  title,
  description,
  canonical,
  keywords,
  ogType = "website",
  ogTitle,
  ogDescription,
  // Branded studio card (1200×630, generated from the site's own fonts/colors).
  // Pages with their own visual (projects, blog posts) pass ogImage explicitly.
  ogImage = "https://www.divyanshsood.com/og-home.png",
  ogImageW = 1200,
  ogImageH = 630,
  ogLocale = "en_US",
  imageAlt = "Divyansh Sood® Studio — custom-coded, conversion-focused websites",
  jsonld,
  articlePublished,
  articleModified,
  tags,
  preloadImage,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    {/*
      Analytics scripts (GA4 + Yandex Metrica) are intentionally absent here.
      They are injected at runtime by <CookieConsent /> only after the visitor
      clicks "Accept analytics" — see src/components/CookieConsent.astro.
      Until that choice is made, the only request this site makes is the one
      to load it. GDPR/CCPA-compliant by construction, not by banner.
    */}

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content="Divyansh Sood" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#0b0b0c" />
    <meta name="apple-mobile-web-app-title" content="Divyansh Sood" />
    {BING_VERIFY && <meta name="msvalidate.01" content={BING_VERIFY} />}
    {YANDEX_VERIFY && <meta name="yandex-verification" content={YANDEX_VERIFY} />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Divyansh Sood® Studio" />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageW)} />
    <meta property="og:image:height" content={String(ogImageH)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={ogLocale} />
    {articlePublished && <meta property="article:published_time" content={articlePublished} />}
    {articleModified && <meta property="article:modified_time" content={articleModified} />}
    {(tags ?? []).map((t) => <meta property="article:tag" content={t} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={ogDescription ?? description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" href={FAVICON} />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Divyansh Sood® Studio — Journal" href="/rss.xml" />

    {/* Identity / authorship — rel=me ties this domain to the founder's profiles
        so search and AI answer engines resolve them to one entity (GEO signal). */}
    <link rel="me" href="https://github.com/DivyanshSood" />
    <link rel="me" href="https://www.linkedin.com/in/divyansh-sood-023556151/" />
    <link rel="author" href={`${new URL(canonical).origin}/about/`} />

    <link rel="preconnect" href="https://ik.imagekit.io" crossorigin />
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage.href}
          imagesrcset={preloadImage.srcset}
          imagesizes={preloadImage.sizes}
          fetchpriority="high"
        />
      )
    }
    {/*
      Self-hosted font preload — Archivo 900 is the hero headline weight and
      the most FOIT-prone. Preload cuts the swap from ~80ms to ~10ms on first
      paint. Other weights fall through the cascade from /fonts/*.woff2.
    */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/archivo-900.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/space-mono-400.woff2" crossorigin />

    {jsonld && <script type="application/ld+json" is:inline set:html={jsonld} />}

    {/* Page-level head injection (e.g. the homepage's synchronous motion-class
        script, which pre-arms scroll-reveal before first paint). */}
    <slot name="head" />

    {/* Synchronous, after the slot on purpose: pages that armed the GSAP
        engine (html.motion — the homepage) are left alone; every other page
        gets the lightweight IntersectionObserver reveal (html.motion-io,
        driven by BaseScripts). Same 3s failsafe as the homepage: if the
        engine never marks itself ready, reveal everything. Skipped entirely
        under prefers-reduced-motion. */}
    <script is:inline>
      (function () {
        try {
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          var d = document.documentElement;
          if (d.classList.contains("motion")) return;
          d.classList.add("motion-io");
          setTimeout(function () {
            if (!d.classList.contains("motion-io-ready")) d.classList.add("motion-fallback");
          }, 3000);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div id="ds-root">
      <slot />
    </div>

    <StickyBook />
    <CookieConsent />
    <BaseScripts />
  </body>
</html>
