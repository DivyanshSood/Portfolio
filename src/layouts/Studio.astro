          const t = (e.target as HTMLElement).dataset.rev !== undefined
            ? (e.target as HTMLElement)
            : (e.target as HTMLElement).querySelector<HTMLElement>("[data-rev]");
          if (t) revealEl(t);
          io.unobserve(e.target);
        }),
      { threshold: 0.05, rootMargin: "0px 0px -6% 0px" }
    );
    q("[data-rev]").forEach((el) => io.observe(el.parentElement || el));

    // Content fade-ups ([data-reveal]) — the site-wide inner-page hook. Staggers
    // elements that enter together.
    let revQueue: HTMLElement[] = [];
    let revScheduled = false;
    const flushRev = () => {
      revQueue.forEach((el, i) => {
        el.style.transitionDelay = Math.min(i * 70, 420) + "ms";
        el.classList.add("is-in");
        el.addEventListener("transitionend", () => (el.style.transitionDelay = ""), { once: true });
      });
      revQueue = [];
      revScheduled = false;
    };
    const ioRev = new IntersectionObserver(
      (es) => {
        for (const e of es) {
          if (!e.isIntersecting) continue;
          revQueue.push(e.target as HTMLElement);
          ioRev.unobserve(e.target);
        }
        if (revQueue.length && !revScheduled) {
          revScheduled = true;
          requestAnimationFrame(flushRev);
        }
      },
      { rootMargin: "0px 0px -8% 0px" }
    );
    q("[data-reveal]").forEach((el) => ioRev.observe(el));

    // ---- Preloader -----------------------------------------------------------
    const finishLoader = (() => {
      let fin = false;
      return () => {
        if (fin) return;
        fin = true;
        const L = one("[data-loader]");
        if (L) {
          L.style.transition = "transform 0.75s cubic-bezier(0.76, 0, 0.24, 1)";
          L.style.transform = "translateY(-101%)";
        }
        setTimeout(runIntro, 330);
        setTimeout(() => {
          loaderDone = true;
          doc.classList.remove("dsx-load");
        }, 800);
      };
    })();
    if (doc.classList.contains("dsx-load") && !reduced) {
      const t0 = performance.now();
      // 700ms, down from 1050. The counter is a full-screen cover over the
      // homepage's first paint, so every ms here is added directly to how long
      // a first-time visitor waits before seeing the headline.
      const dur = 700;
      const numEl = one("[data-load-num]");
      const barEl = one("[data-load-bar]");
      const tick = () => {
        const p = Math.min((performance.now() - t0) / dur, 1);
        const e = 1 - Math.pow(1 - p, 3);
        if (numEl) numEl.textContent = String(Math.round(e * 100));
        if (barEl) barEl.style.transform = "scaleX(" + e.toFixed(3) + ")";
        if (p < 1) requestAnimationFrame(tick);
        else finishLoader();
      };
      tick();
      setTimeout(finishLoader, 3500); // failsafe
    } else {
      loaderDone = true;
      doc.classList.remove("dsx-load");
      setTimeout(runIntro, 60);
    }

    // ---- IST clock -----------------------------------------------------------
    const istEls = q("[data-ist]");
    const updT = () => {
      try {
        const t = new Intl.DateTimeFormat("en-GB", {
          hour: "2-digit",
          minute: "2-digit",
          timeZone: "Asia/Kolkata",
        }).format(new Date());
        istEls.forEach((el) => (el.textContent = t));
      } catch (err) {
        /* noop */
      }
    };
    updT();
    setInterval(updT, 30000);

    // ---- Case overlay (homepage) ---------------------------------------------
    const openOverlay = (i: number) => {
      const p = PROJECTS[i];
      if (!p || !overlay) return;
      overlayIdx = i;
      if (oF.num) oF.num.textContent = p.num;
      if (oF.name) oF.name.textContent = p.name;
      if (oF.client) oF.client.textContent = p.client;
      if (oF.tags) oF.tags.textContent = p.tags;
      if (oF.year) oF.year.textContent = p.year;
      if (oF.scope) oF.scope.textContent = p.scope;
      if (oF.img) {
        oF.img.src = p.img;
        oF.img.alt = p.name;
      }
      if (oF.blurb) oF.blurb.textContent = p.blurb;
      if (oF.quote) oF.quote.style.display = p.quote ? "" : "none";
      if (oF.quoteText) oF.quoteText.textContent = p.quote || "";
      if (oF.quoteBy) oF.quoteBy.textContent = p.quoteBy || "";
      if (oF.link) oF.link.href = p.url;
      overlay.style.display = "block";
      overlay.setAttribute("aria-label", p.name + " — case study");
      overlay.style.animation = "none";
      void overlay.offsetWidth;
      overlay.style.animation = "";
      overlay.scrollTop = 0;
      document.body.style.overflow = "hidden";
    };
    const closeOverlay = () => {
      if (!overlay) return;
      overlay.style.display = "none";
      overlayIdx = null;
      document.body.style.overflow = "";
    };
    one("[data-o-close]")?.addEventListener("click", closeOverlay);
    one("[data-o-next]")?.addEventListener("click", () => {
      if (overlayIdx != null) openOverlay((overlayIdx + 1) % PROJECTS.length);
    });

    // ---- Fullscreen menu (burger) ---------------------------------------------
    const headEl = one("[data-header]");
    const menuEl = one("[data-menu]");
    const menuBtn = one("[data-menu-btn]");
    let menuOpen = false;
    const setMenu = (open: boolean) => {
      if (!menuEl || open === menuOpen) return;
      menuOpen = open;
      menuEl.classList.toggle("is-open", open);
      menuBtn?.setAttribute("aria-expanded", String(open));
      document.body.style.overflow = open || overlayIdx != null ? "hidden" : "";
      if (open) one("[data-menu-close]")?.focus();
      else menuBtn?.focus();
    };
    menuBtn?.addEventListener("click", () => setMenu(!menuOpen));
    one("[data-menu-close]")?.addEventListener("click", () => setMenu(false));
    // Any link in the menu closes it (data-goto smooth-scroll still runs via
    // the delegated root click handler; page links just navigate).
    menuEl?.addEventListener("click", (e) => {
      const el = e.target as Element | null;
      if (el && el.closest && el.closest("a")) setMenu(false);
    });
    // The burger only exists ≤720px — close the menu if the viewport leaves it.
    window.addEventListener("resize", () => {
      if (menuOpen && window.innerWidth > 720) setMenu(false);
    });

    // ---- Cursor ----------------------------------------------------------------
    let curLabel: string | null = null;
    const setCursorLabel = (label: string | null) => {
      if (label === curLabel) return;
      curLabel = label;
      if (!curEls.orbIn || !curEls.label) return;
      if (label) {
        curEls.label.textContent = label;
        curEls.label.style.opacity = "1";
        curEls.orbIn.style.transform = "scale(1)";
        curEls.orbIn.style.backgroundColor = "#D9FF3C";
        curEls.orbIn.style.borderColor = "transparent";
        if (curEls.dot) curEls.dot.style.opacity = "0";
      } else {
        curEls.label.style.opacity = "0";
        curEls.orbIn.style.transform = "scale(0.4)";
        curEls.orbIn.style.backgroundColor = "transparent";
        curEls.orbIn.style.borderColor = "rgba(244,242,236,0.4)";
        if (curEls.dot) curEls.dot.style.opacity = "1";
      }
    };

    // ---- Events ----------------------------------------------------------------
    let cur = window.scrollY || 0;
    let target = cur;
    let wheelT = 0;
    window.addEventListener(
      "wheel",
      (e) => {
        if (!fine || reduced || overlayIdx != null || menuOpen || !loaderDone) return;
        if (e.ctrlKey) return; // pinch-zoom
        e.preventDefault();
        const dy = e.deltaY * (e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? window.innerHeight : 1);
        target = Math.max(0, Math.min(maxSc, target + dy));
        wheelT = performance.now();
      },
      { passive: false }
    );
    window.addEventListener(
      "scroll",
      () => {
        if (performance.now() - wheelT < 400) return;
        const y = window.scrollY;
        if (Math.abs(y - cur) < 2) return;
        cur = target = y;
      },
      { passive: true }
    );
    window.addEventListener("resize", measureSoon);
    window.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      if (menuOpen) setMenu(false);
      else if (overlayIdx != null) closeOverlay();
    });

    let mx = -200, my = -200, cx = -200, cy = -200;
    document.addEventListener("mousemove", (e) => {
      mx = e.clientX;
      my = e.clientY;
    });
    document.addEventListener("mouseover", (e) => {
      const el = e.target as Element | null;
      const t = el && el.closest ? (el.closest("[data-cursor]") as HTMLElement | null) : null;
      setCursorLabel(t ? t.getAttribute("data-cursor") : null);
    });

    const goTo = (id: string) => {
      if (id === "top") {
        if (fine && !reduced) {
          target = 0;
          wheelT = performance.now();
        } else {
          window.scrollTo({ top: 0, behavior: "smooth" });
        }
        return;
      }
      const el = document.getElementById(id);
      if (!el) return;
      const top = Math.max(0, el.getBoundingClientRect().top + window.scrollY);
      if (fine && !reduced) {
        target = Math.min(top, maxSc);
        wheelT = performance.now();
      } else {
        window.scrollTo({ top, behavior: "smooth" });
      }
    };
    root.addEventListener("click", (e) => {
      const el = e.target as Element | null;
      if (!el || !el.closest) return;
      const go = el.closest("[data-goto]") as HTMLElement | null;
      if (go) {
        const id = go.dataset.goto || "top";
        // Only intercept when the target exists on this page (or it's "top");
        // otherwise let the browser follow the href (e.g. /#work from an inner page).
        if (id === "top" || document.getElementById(id)) {
          e.preventDefault();
          goTo(id);
          return;
        }
      }
      // Deck cards open the case overlay — except the real VIEW CASE link.
      const card = el.closest("[data-card]") as HTMLElement | null;
      if (card && !el.closest("a")) openOverlay(+(card.dataset.idx || 0));
    });

    // ---- Frame loop -------------------------------------------------------------
    let lastY: number | null = null;
    let sv = 0;
    let dir = -1;
    let dirT = -1;
    let deckIdx = 0;
    let wc = -1;
    const frame = () => {
      requestAnimationFrame(frame);
      const vh = window.innerHeight;

      if (fine && !reduced && overlayIdx == null && loaderDone) {
        if (Math.abs(target - cur) > 0.4) {
          cur += (target - cur) * 0.1;
          window.scrollTo(0, cur);
        }
      }
      const y = window.scrollY;
      const vel = lastY == null ? 0 : y - lastY;
      lastY = y;
      sv += (vel - sv) * 0.09;
      const av = Math.min(Math.abs(sv) * 0.16, 4.2);
      if (vel > 0.6) dirT = -1;
      else if (vel < -0.6) dirT = 1;
      dir += (dirT - dir) * 0.05;

      // Header: tuck away on scroll-down, return on scroll-up / near the top.
      // The gap between the two thresholds keeps it from flickering.
      if (headEl) {
        if (!menuOpen && y > 240 && sv > 1.4) headEl.classList.add("dsx-hh");
        else if (menuOpen || y < 240 || sv < -1) headEl.classList.remove("dsx-hh");
      }

      if (!reduced) {
        for (const m of marquees) {
          if (!m.w) {
            if (m.copy) m.w = m.copy.offsetWidth;
            if (!m.w) continue;
          }
          m.x += (1.0 + av) * dir;
          if (m.x <= -m.w) m.x += m.w;
          if (m.x > 0) m.x -= m.w;
          m.el.style.transform = "translate3d(" + m.x.toFixed(2) + "px,0,0)";
        }
        for (const m of drifts) {
          if (!m.w) {
            if (m.copy) m.w = m.copy.offsetWidth;
            if (!m.w) continue;
          }
          m.x += m.dir * (m.base + av * 0.9);
          if (m.x <= -m.w) m.x += m.w;
          if (m.x > 0) m.x -= m.w;
          m.el.style.transform = "translate3d(" + m.x.toFixed(2) + "px,0,0)";
        }
      }

      if (deckSec && deckScreens.length) {
        const N = deckScreens.length;
        const p = Math.min(N - 1, Math.max(0, (y - deckTop) / vh));
        const i = Math.floor(p);
        const tt = p - i;
        const te = tt * tt * (3 - 2 * tt);
        // Cross-fade the active project's screen + copy into the next one. Copy
        // also slides a touch vertically to feel deliberate rather than a dissolve.
        for (let k = 0; k < N; k++) {
          let so = 0, co = 0, ty = 0;
          if (k === i) { so = 1 - te; co = 1 - te; ty = -te * 28; }
          else if (k === i + 1) { so = te; co = te; ty = (1 - te) * 28; }
          const sc = deckScreens[k], cp = deckCopies[k];
          if (sc) sc.style.opacity = so.toFixed(3);
          if (cp) {
            cp.style.opacity = co.toFixed(3);
            cp.style.transform = "translate3d(0," + ty.toFixed(1) + "px,0)";
          }
        }
        const active = Math.min(N - 1, Math.round(p));
        const idx = active + 1;
        if (idx !== deckIdx) {
          deckIdx = idx;
          if (deckNum) deckNum.textContent = "0" + idx;
          if (deckCard) deckCard.dataset.idx = String(active);
          if (deckUrl) deckUrl.textContent = (PROJECTS[active] && PROJECTS[active].domain) || "";
        }
        if (deckBar) deckBar.style.transform = "scaleX(" + (p / (N - 1)).toFixed(4) + ")";
      }

      if (stmtSec && words.length) {
        const p = Math.min(1, Math.max(0, (y - stmtTop) / stmtLen));
        const cnt = Math.floor(p * words.length * 1.3);
        if (cnt !== wc) {
          wc = cnt;
          words.forEach((w, i) => (w.style.opacity = i < cnt ? "1" : "0.13"));
        }
      }

      if (fine && curEls.orb) {
        cx += (mx - cx) * 0.16;
        cy += (my - cy) * 0.16;
        curEls.orb.style.transform = "translate3d(" + cx.toFixed(1) + "px," + cy.toFixed(1) + "px,0)";
        if (curEls.dot) curEls.dot.style.transform = "translate3d(" + mx + "px," + my + "px,0)";
      }
    };

    measure();
    requestAnimationFrame(frame);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => measure());
    [600, 1500, 3000].forEach((t) => setTimeout(measure, t));
    window.addEventListener("load", measure);
  }
</script>
