---
// ===========================================================================
// Studio.astro — the site-wide "Portfolio 2026" shell.
//
// Single source of truth for the whole site's chrome and motion. Every page
// (homepage + inner pages) renders inside #dsx: near-black + neon-green,
// Anton / JetBrains Mono, grain, custom cursor, lerped smooth scroll,
// velocity-reactive marquees, masked scroll reveals, a shared minimal header
// and the giant-wordmark footer. Homepage-only features (counting preloader,
// deck-of-cards, word-by-word statement, case overlay) are all guarded in the
// engine, so they no-op on pages that don't include their markup.
//
// A page opts into the homepage preloader with `preloader`, and tells the
// header/footer to use in-page smooth-scroll anchors with `home`.
// ===========================================================================
import "../styles/global.css";
import BaseScripts from "../components/BaseScripts.astro";
import { CALENDLY_URL } from "../lib/site.mjs";

const FAVICON =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%230b0b0c'/%3E%3Ctext x='50' y='70' font-family='Arial,sans-serif' font-weight='900' font-size='56' fill='%23f4f2ec' text-anchor='middle'%3EDS%3C/text%3E%3Crect x='28' y='80' width='44' height='6' fill='%23d9ff3c'/%3E%3C/svg%3E";

// Search-engine ownership verification (public tokens — fine to ship in source).
const BING_VERIFY = import.meta.env.BING_SITE_VERIFICATION;
const YANDEX_VERIFY = import.meta.env.YANDEX_VERIFICATION ?? "f949199876a945f6";

export interface Props {
  title: string;
  description: string;
  canonical: string;
  keywords?: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageW?: number;
  ogImageH?: number;
  ogLocale?: string;
  imageAlt?: string;
  jsonld?: string;
  articlePublished?: string;
  articleModified?: string;
  tags?: string[];
  preloadImage?: { href: string; srcset?: string; sizes?: string };
  /** Homepage: show the counting preloader (first view per session) + arm the intro. */
  preloader?: boolean;
  /** Homepage: header/footer use in-page smooth-scroll anchors instead of /#… links. */
  home?: boolean;
}

const {
  title,
  description,
  canonical,
  keywords,
  ogType = "website",
  ogTitle,
  ogDescription,
  ogImage = "https://www.divyanshsood.com/og-home.png",
  ogImageW = 1200,
  ogImageH = 630,
  ogLocale = "en_US",
  imageAlt = "Divyansh Sood® Studio — custom-coded, conversion-focused websites",
  jsonld,
  articlePublished,
  articleModified,
  tags,
  preloadImage,
  preloader = false,
  home = false,
} = Astro.props;

const STAR =
  "M12 0C13.05 6.9 17.1 10.95 24 12C17.1 13.05 13.05 17.1 12 24C10.95 17.1 6.9 13.05 0 12C6.9 10.95 10.95 6.9 12 0Z";
const ARROW = "M7 17 17 7M8 7h9v9";

// Header/footer anchor targets — smooth-scroll on the homepage, real links elsewhere.
const workHref = home ? "#work" : "/#work";
const contactHref = home ? "#contact" : "/#contact";
const topHref = home ? "#top" : "/";

// Active-page marker for nav links (green dot on the section you're in).
const path = Astro.url.pathname;
const isActive = (p: string) => path === p || path.startsWith(p);

// Fullscreen menu (burger on ≤720px). Same targets as the desktop nav plus
// the two sections the minimal header leaves to the footer.
const MENU = [
  { label: "Work", href: workHref, goto: home ? "work" : undefined, num: "01", active: false },
  { label: "Portfolio", href: "/portfolio/", goto: undefined, num: "02", active: isActive("/portfolio") },
  { label: "Results", href: "/results/", goto: undefined, num: "03", active: isActive("/results") },
  { label: "About", href: "/about/", goto: undefined, num: "04", active: isActive("/about") },
  { label: "Blog", href: "/blog/", goto: undefined, num: "05", active: isActive("/blog") },
  { label: "Contact", href: contactHref, goto: home ? "contact" : undefined, num: "06", active: false },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content="Divyansh Sood" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#0b0b0c" />
    <meta name="apple-mobile-web-app-title" content="Divyansh Sood" />
    {BING_VERIFY && <meta name="msvalidate.01" content={BING_VERIFY} />}
    {YANDEX_VERIFY && <meta name="yandex-verification" content={YANDEX_VERIFY} />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Divyansh Sood® Studio" />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageW)} />
    <meta property="og:image:height" content={String(ogImageH)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={ogLocale} />
    {articlePublished && <meta property="article:published_time" content={articlePublished} />}
    {articleModified && <meta property="article:modified_time" content={articleModified} />}
    {(tags ?? []).map((t) => <meta property="article:tag" content={t} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={ogDescription ?? description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href={FAVICON} type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Divyansh Sood® Studio — Journal" href="/rss.xml" />

    <link rel="me" href="https://github.com/DivyanshSood" />
    <link rel="me" href="https://www.linkedin.com/in/divyanshsood/" />
    <link rel="author" href={`${new URL(canonical).origin}/about/`} />

    {/* No third-party image origin to preconnect to any more — every project
        image is self-hosted with a generated width ladder (see
        scripts/gen-work-variants.mjs). Re-add a preconnect only if a remote
        image host comes back. */}
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage.href}
          imagesrcset={preloadImage.srcset}
          imagesizes={preloadImage.sizes}
          fetchpriority="high"
        />
      )
    }
    {/* Self-hosted display + label fonts — Anton (headlines) and JetBrains Mono
        (labels) are the most FOIT-prone; Archivo carries body copy. */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/anton-400.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/jetbrains-mono.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/archivo.woff2" crossorigin />

    {jsonld && <script type="application/ld+json" is:inline set:html={jsonld} />}

    {/* ---- Analytics: GA4 + Yandex Metrica ----
        Loaded unconditionally for every visitor — the consent banner that used
        to gate these was removed by an explicit owner decision, so do not add
        a consent gate back. IP anonymisation stays on and Metrica runs without
        session replay / clickmap.
        IDs are duplicated in BaseScripts.astro (dsTrack) — keep them in sync. */}
    <script is:inline>
      (function () {
        var GA_ID = "G-51WG6025T0";
        var YM_ID = 110027161;

        var s = document.createElement("script");
        s.async = true;
        s.src = "https://www.googletagmanager.com/gtag/js?id=" + GA_ID;
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag("js", new Date());
        gtag("config", GA_ID, { anonymize_ip: true });

        (function (m, e, t, r, i, k, a) {
          m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
          m[i].l = 1 * new Date();
          for (var j = 0; j < document.scripts.length; j++) { if (document.scripts[j].src === r) { return; } }
          k = e.createElement(t); a = e.getElementsByTagName(t)[0];
          k.async = 1; k.src = r; a.parentNode.insertBefore(k, a);
        })(window, document, "script", "https://mc.yandex.ru/metrika/tag.js?id=" + YM_ID, "ym");
        window.ym && window.ym(YM_ID, "init", { ssr: true, ecommerce: "dataLayer", accurateTrackBounce: true, trackLinks: true });
      })();
    </script>

    {/* Page-level head injection. */}
    <slot name="head" />

    {/* Synchronous, render-blocking: arm motion states before first paint so
        nothing flashes. `motion` gates every hidden-until-revealed state; the
        preloader (`dsx-load`) shows only on a page that opts in, first view per
        session. 3s failsafe reveals everything if the engine never boots.
        Skipped entirely under prefers-reduced-motion. */}
    <script is:inline define:vars={{ preloader }}>
      (function () {
        try {
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          var d = document.documentElement;
          d.classList.add("motion");
          if (preloader) {
            try {
              if (!sessionStorage.getItem("dsxLoad")) {
                sessionStorage.setItem("dsxLoad", "1");
                d.classList.add("dsx-load");
              }
            } catch (err) {}
          }
          setTimeout(function () {
            if (!d.classList.contains("motion-ready")) d.classList.add("motion-fallback");
          }, 3000);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div id="ds-root">
      <div id="dsx" style="--accent:#D9FF3C; background:#0B0B0C; color:#F4F2EC; font-family:'Archivo',sans-serif; min-height:100vh; position:relative;">
        {/* SVG displacement filter — shared by the image-distortion hover effect. */}
        <svg aria-hidden="true" style="position:absolute; width:0; height:0; overflow:hidden;">
          <defs>
            <filter id="dsx-distort" x="-20%" y="-20%" width="140%" height="140%">
              <feTurbulence id="dsx-turb" type="fractalNoise" baseFrequency="0.011 0.006" numOctaves="2" seed="4" result="noise"></feTurbulence>
              <feDisplacementMap id="dsx-disp" in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
            </filter>
          </defs>
        </svg>

        <div data-grain style="position:fixed; inset:-20%; z-index:200; pointer-events:none; opacity:0.05;"></div>

        {
          preloader && (
            <div data-loader style="position:fixed; inset:0; z-index:150; background:#0E0E10; flex-direction:column; justify-content:space-between; padding:24px 4vw 20px; will-change:transform;">
              <div style="display:flex; justify-content:space-between; font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.14em; color:#8A8A93;">
                <span>DIVYANSH SOOD®</span>
                <span>PORTFOLIO — 2026</span>
              </div>
              <div style="text-align:center; display:flex; flex-direction:column; align-items:center; gap:22px;">
                <svg width="34" height="34" viewBox="0 0 24 24" fill="var(--accent, #D9FF3C)" style="animation:dsxSpin 3.2s linear infinite;" aria-hidden="true"><path d={STAR} /></svg>
                <div style="font-family:'Anton',sans-serif; font-weight:400; font-size:clamp(42px, 8.5vw, 120px); line-height:0.95; text-transform:uppercase;">Divyansh Sood<span style="color:var(--accent, #D9FF3C);">®</span></div>
                <div style="margin-top:16px; font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.16em; color:#8A8A93;">CUSTOM-CODED · CONVERSION-FOCUSED · WORLDWIDE</div>
              </div>
              <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:28px;">
                <div style="flex:1; height:1px; background:rgba(244,242,236,0.16); position:relative; margin-bottom:14px;">
                  <div data-load-bar style="position:absolute; inset:0; background:var(--accent, #D9FF3C); transform:scaleX(0); transform-origin:left center;" />
                </div>
                <div style="font-family:'Anton',sans-serif; font-weight:400; font-size:clamp(56px, 9vw, 130px); line-height:0.8;"><span data-load-num>0</span><span style="font-size:0.38em; color:#8A8A93;">%</span></div>
              </div>
            </div>
          )
        }

        {/* Custom cursor (fine pointers only) */}
        <div data-cursor-orb style="position:fixed; left:0; top:0; z-index:300; pointer-events:none; transform:translate3d(-200px,-200px,0); will-change:transform;">
          <div data-cursor-orb-in style="width:76px; height:76px; margin:-38px 0 0 -38px; border:1px solid rgba(244,242,236,0.4); border-radius:50%; background:transparent; transform:scale(0.4); transition:transform 0.35s cubic-bezier(0.22,1,0.22,1), background-color 0.25s, border-color 0.25s; display:flex; align-items:center; justify-content:center;">
            <span data-cursor-label style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.12em; color:#0B0B0C; opacity:0; transition:opacity 0.2s;">VIEW</span>
          </div>
        </div>
        <div data-cursor-dot style="position:fixed; left:0; top:0; z-index:300; pointer-events:none; width:6px; height:6px; margin:-3px 0 0 -3px; background:#F4F2EC; border-radius:50%; transform:translate3d(-200px,-200px,0); mix-blend-mode:difference; will-change:transform;"></div>

        {/* Header — shared minimal nav. Hides on scroll-down, returns on
            scroll-up (engine toggles .dsx-hh). Desktop links get a rolling
            double-label hover; ≤720px the links collapse into the burger. */}
        <header data-header style="position:fixed; top:0; left:0; right:0; z-index:60; display:flex; align-items:center; justify-content:space-between; gap:16px; padding:16px 4vw; mix-blend-mode:difference;">
          <a href={topHref} data-goto={home ? "top" : undefined} aria-label="Divyansh Sood — home" style="display:inline-flex; align-items:center; gap:10px; font-weight:600; font-size:13px; letter-spacing:0.06em;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--accent, #D9FF3C)" aria-hidden="true"><path d={STAR}></path></svg>
            <span>DIVYANSH SOOD<span style="color:var(--accent, #D9FF3C);">®</span></span>
          </a>
          <nav data-hide-m style="display:flex; gap:28px; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.12em;">
            <a href={workHref} data-goto={home ? "work" : undefined} class="dsx-nav-link"><span class="dsx-roll"><span>WORK</span><span aria-hidden="true">WORK</span></span></a>
            <a href="/portfolio/" class="dsx-nav-link" aria-current={isActive("/portfolio") ? "page" : undefined}><span class="dsx-roll"><span>PORTFOLIO</span><span aria-hidden="true">PORTFOLIO</span></span></a>
            <a href="/results/" class="dsx-nav-link" aria-current={isActive("/results") ? "page" : undefined}><span class="dsx-roll"><span>RESULTS</span><span aria-hidden="true">RESULTS</span></span></a>
            <a href="/about/" class="dsx-nav-link" aria-current={isActive("/about") ? "page" : undefined}><span class="dsx-roll"><span>ABOUT</span><span aria-hidden="true">ABOUT</span></span></a>
            <a href={contactHref} data-goto={home ? "contact" : undefined} class="dsx-nav-link"><span class="dsx-roll"><span>CONTACT</span><span aria-hidden="true">CONTACT</span></span></a>
          </nav>
          <div style="display:inline-flex; align-items:center; gap:10px;">
            <a href={CALENDLY_URL} target="_blank" rel="noopener" style="font-family:'JetBrains Mono',monospace; font-size:10.5px; letter-spacing:0.12em; border:1px solid rgba(244,242,236,0.45); border-radius:999px; padding:9px 16px; white-space:nowrap; display:inline-flex; align-items:center; gap:8px;">START A PROJECT <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d={ARROW}></path></svg></a>
            <button data-menu-btn class="dsx-burger" aria-label="Open menu" aria-expanded="false" aria-controls="dsx-menu">
              <span></span>
              <span></span>
            </button>
          </div>
        </header>

        {/* Fullscreen nav — curtain overlay opened by the burger. Sits above
            the header (z-95) with its own close button; the engine staggers
            the oversized links in via .is-open. */}
        <div data-menu id="dsx-menu" class="dsx-menu" role="dialog" aria-modal="true" aria-label="Site navigation">
          <div style="display:flex; align-items:center; justify-content:space-between; gap:16px;">
            <span style="display:inline-flex; align-items:center; gap:10px; font-weight:600; font-size:13px; letter-spacing:0.06em;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--accent, #D9FF3C)" aria-hidden="true"><path d={STAR}></path></svg>
              <span>DIVYANSH SOOD<span style="color:var(--accent, #D9FF3C);">®</span></span>
            </span>
            <button data-menu-close class="dsx-pill" style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.12em; border:1px solid rgba(244,242,236,0.35); border-radius:999px; padding:10px 18px; cursor:pointer; display:inline-flex; align-items:center; gap:8px;">CLOSE <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"></path></svg></button>
          </div>
          <nav style="display:flex; flex-direction:column; gap:4px; margin:auto 0; padding:7vh 0;" aria-label="Menu">
            {MENU.map((m) => (
              <div class="dsx-menu-row">
                <a href={m.href} data-goto={m.goto} aria-current={m.active ? "page" : undefined}>
                  <span class="n">{m.num}</span>
                  <span class="t">{m.label}</span>
                  {m.active && <span class="dot" aria-hidden="true" />}
                </a>
              </div>
            ))}
          </nav>
          <div class="dsx-menu-foot">
            <div style="display:flex; flex-wrap:wrap; gap:10px 22px; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.12em;">
              <a href="https://github.com/DivyanshSood" target="_blank" rel="noopener">GITHUB ↗</a>
              <a href="https://www.linkedin.com/in/divyanshsood/" target="_blank" rel="noopener">LINKEDIN ↗</a>
              <a href="https://wa.me/919816091875" target="_blank" rel="noopener">WHATSAPP ↗</a>
              <a href="mailto:hello@divyanshsood.com">EMAIL ↗</a>
            </div>
            <div style="margin-top:20px; display:flex; align-items:center; justify-content:space-between; gap:16px 24px; flex-wrap:wrap;">
              <a class="dsx-cta" href={CALENDLY_URL} target="_blank" rel="noopener" style="background:var(--accent, #D9FF3C); color:#0B0B0C; font-weight:600; font-size:14px; letter-spacing:0.02em; padding:16px 26px; border-radius:999px; display:inline-flex; align-items:center; gap:10px;">START A PROJECT <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d={ARROW}></path></svg></a>
              <span style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.12em; color:#8A8A93;">HIMACHAL PRADESH, IN · IST <span data-ist>––:––</span></span>
            </div>
          </div>
        </div>

        <slot />

        {/* Footer — shared */}
        <footer style="border-top:1px solid rgba(244,242,236,0.14); position:relative; overflow:hidden; background:#0E0E10;">
          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(210px, 1fr)); gap:44px 24px; padding:9vh 4vw 6vh;">
            <div style="display:flex; flex-direction:column; gap:18px; align-items:flex-start;">
              <a href={topHref} data-goto={home ? "top" : undefined} aria-label="Back to top" style="display:inline-flex; align-items:center; gap:10px; font-weight:600; font-size:14px; letter-spacing:0.06em;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="var(--accent, #D9FF3C)" aria-hidden="true"><path d={STAR}></path></svg>
                <span>DIVYANSH SOOD<span style="color:var(--accent, #D9FF3C);">®</span></span>
              </a>
              <p style="margin:0; font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.1em; line-height:1.9; color:#8A8A93; max-width:280px;">INDEPENDENT WEB DESIGNER &amp; DEVELOPER. CUSTOM-CODED, CONVERSION-FOCUSED, WORLDWIDE.</p>
            </div>
            <nav style="display:flex; flex-direction:column; gap:12px; align-items:flex-start;">
              <span style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.14em; color:#55555C; margin-bottom:4px;">SITEMAP</span>
              <a href={workHref} data-goto={home ? "work" : undefined} style="font-weight:500; font-size:14px;">Work</a>
              <a href="/services/" style="font-weight:500; font-size:14px;">Services</a>
              <a href="/portfolio/" style="font-weight:500; font-size:14px;">Portfolio</a>
              <a href="/about/" style="font-weight:500; font-size:14px;">About</a>
              <a href="/blog/" style="font-weight:500; font-size:14px;">Blog</a>
              <a href="/tools/" style="font-weight:500; font-size:14px;">Free tools</a>
              <a href="/testimonials/" style="font-weight:500; font-size:14px;">Testimonials</a>
              <a href="/results/" style="font-weight:500; font-size:14px;">Results</a>
              <a href="/website-audit/" style="font-weight:500; font-size:14px;">Free website audit</a>
              <a href="/press/" style="font-weight:500; font-size:14px;">Press kit</a>
              <a href={contactHref} data-goto={home ? "contact" : undefined} style="font-weight:500; font-size:14px;">Contact</a>
            </nav>
            {/* Services + locations. These are the commercial pages, and until
                now each had 2–4 inbound internal links site-wide while the
                boilerplate pages above had 60+ — so the pages meant to rank for
                "web developer <city>" were the least linked on the site. */}
            <nav style="display:flex; flex-direction:column; gap:12px; align-items:flex-start;">
              <span style="font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:0.14em; color:#55555C; margin-bottom:4px;">SERVICES</span>
              <a href="/services/web-app-development/" style="font-weight:500; font-size:14px;">Web app development</a>
              <a href="/services/ecommerce-website-development/" style="font-weight:500; font-size:14px;">E-commerce websites</a>
