---
// Shared shell for a free tool page: hero, the tool (default slot), an
// optional "Go further" card row, related tools, FAQ and the end CTA, plus
// the WebApplication + BreadcrumbList + FAQPage JSON-LD. A tool page passes
// its copy as props and puts only its form, output and <script> in the slot.
import Base from "./Base.astro";
import PageHero from "../components/brand/PageHero.astro";
import Section from "../components/brand/Section.astro";
import Cards from "../components/brand/Cards.astro";
import Faq from "../components/brand/Faq.astro";
import EndCta from "../components/brand/EndCta.astro";
import RelatedTools from "../components/brand/RelatedTools.astro";
import { SITE } from "../lib/site.mjs";
import { TOOL_BY_SLUG } from "../lib/tools.mjs";
import "../styles/tools.css";

interface Props {
  slug: string;
  title: string;
  description: string;
  keywords: string;
  ogTitle: string;
  ogDescription: string;
  display: string;
  kicker: string;
  lead: string;
  appName: string;
  appDescription: string;
  category?: "BusinessApplication" | "DeveloperApplication" | "UtilitiesApplication" | "DesignApplication";
  toolTitle: string;
  toolNote?: string;
  note?: string;
  cardsTitle?: string;
  cards?: { tag?: string; t?: string; d?: string; wide?: boolean }[];
  faqs: { q: string; a: string }[];
  topics?: object[];
  end: { title: string; text: string; primary: { href: string; label: string }; secondary?: { href: string; label: string } };
}
const p = Astro.props;
const canonical = `${SITE}/tools/${p.slug}/`;
const crumb = TOOL_BY_SLUG[p.slug]?.name ?? p.appName;
let n = 1;
const toolN = n++;
const cardsN = p.cards ? n++ : 0;
const relN = n++;
const faqN = n++;

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `${canonical}#app`,
      name: p.appName,
      applicationCategory: p.category ?? "BusinessApplication",
      operatingSystem: "Web browser",
      url: canonical,
      description: p.appDescription,
      offers: { "@type": "Offer", price: "0", priceCurrency: "INR" },
      author: { "@id": `${SITE}/#person` },
      provider: { "@id": `${SITE}/#studio` },
      isAccessibleForFree: true,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Tools", item: `${SITE}/tools/` },
        { "@type": "ListItem", position: 3, name: crumb, item: canonical },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: p.faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
});
const pad = (x: number) => String(x).padStart(2, "0");
---

<Base
  title={p.title}
  description={p.description}
  canonical={canonical}
  keywords={p.keywords}
  ogTitle={p.ogTitle}
  ogDescription={p.ogDescription}
  topics={p.topics}
  jsonld={jsonld}
>
  <main>
    <PageHero display={p.display} size="case" kicker={p.kicker} lead={p.lead} />

    <Section n={toolN} term="Setup" note={p.toolNote ?? "Live preview"} title={p.toolTitle}>
      <slot />
      {p.note && <p class="meta tk-note" set:html={p.note} />}
    </Section>

    {p.cards && (
      <Section n={cardsN} term="Setup" note="Go further" title={p.cardsTitle ?? "Go further"}>
        <Cards items={p.cards} />
      </Section>
    )}

    <Section n={relN} term="Pit lane" note="Free, no sign-up" title="Related free tools">
      <RelatedTools slug={p.slug} />
    </Section>

    <Section bare>
      <Faq faqs={p.faqs} label={`(${pad(faqN)}) Before you ask`} />
    </Section>

    <EndCta title={p.end.title} text={p.end.text} primary={p.end.primary} secondary={p.end.secondary ?? { href: "/tools/", label: "More free tools →" }} />
  </main>
</Base>
