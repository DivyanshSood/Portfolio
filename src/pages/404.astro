---
// 404 — the brandbook hero on its own: "Off track" in the red chevron, the
// way back below it. noindex; no canonical (verify-seo.mjs skips /404.html).
import Base from "../layouts/Base.astro";
import PageHero from "../components/brand/PageHero.astro";
---

<Base title="404 — Page not found · Divyansh Sood® Studio" description="This page doesn't exist. Head back to the homepage or browse the portfolio of custom-coded, conversion-focused websites." noindex>
  <main>
    <PageHero
      display="404"
      kicker="Error — Lost in the build"
      crumbs={[{ name: "Home", url: "/" }, { name: "Not found", url: "" }]}
      h1="This page took a wrong turn."
      lead="The link's broken or the page moved. Get back to something that works — or message me and I'll point you the right way."
    >
      <a class="btn btn--red" href="/">Back home <span aria-hidden="true">→</span></a>
      <a class="btn btn--ink" href="https://wa.me/919816091875">WhatsApp me ↗</a>
    </PageHero>
    <section class="nf">
      <div class="wrap">
        <div class="chips-lbl">Or try</div>
        <div class="chips">
          <a class="chip" href="/portfolio/">Portfolio</a>
          <a class="chip" href="/#contact">Contact</a>
          <a class="chip" href="/blog/">Blog</a>
          <a class="chip chip--muted" href="mailto:hello@divyanshsood.com">Email</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .nf{padding:clamp(40px,5vw,72px) var(--gutter) var(--sec-y)}
</style>
