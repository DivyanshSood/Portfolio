      * { box-sizing: border-box; margin: 0; padding: 0; }
      :root { --accent: #ff1f1f; }
      html, body { height: 100%; }
      body {
        background: radial-gradient(90% 70% at 70% 10%, rgba(255, 31, 31,.18), transparent 55%), linear-gradient(180deg,#161618 0%,#0b0b0c 70%);
        color: #fff; font-family: 'Archivo', sans-serif; -webkit-font-smoothing: antialiased;
        min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center;
        text-align: center; padding: 40px 24px; overflow: hidden;
      }
      ::selection { background: var(--accent); color: #fff; }
      .eyebrow { font-family: 'Space Mono', monospace; font-size: 11px; letter-spacing: .2em; text-transform: uppercase; opacity: .6; margin-bottom: 24px; }
      .big { position: relative; font-weight: 900; font-size: clamp(110px,26vw,300px); line-height: .82; letter-spacing: -.04em; }
      .sig { position: absolute; left: 50%; bottom: -6px; transform: translateX(-50%) rotate(-7deg); font-family: 'Caveat', cursive; font-weight: 700; font-size: clamp(34px,7vw,72px); color: var(--accent); pointer-events: none; }
      h1 { font-weight: 800; font-size: clamp(20px,3vw,30px); letter-spacing: -.02em; margin: 40px 0 12px; text-transform: uppercase; }
      p { max-width: 440px; font-size: 15px; line-height: 1.6; opacity: .7; margin: 0 auto 36px; }
      .row { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }
      a.btn { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; font-family: 'Space Mono', monospace; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; font-weight: 700; padding: 14px 22px; border-radius: 2px; transition: transform .25s ease, background .25s ease, border-color .25s ease; }
      a.solid { background: var(--accent); color: #fff; }
      a.solid:hover { transform: translateY(-2px); }
      a.ghost { border: 1px solid rgba(255,255,255,.3); color: #fff; }
      a.ghost:hover { border-color: #fff; transform: translateY(-2px); }
      .brand { position: fixed; top: 22px; left: 24px; font-weight: 900; font-size: 16px; letter-spacing: -.04em; color: #fff; text-decoration: none; }
      .brand sup { font-size: 8px; }
      .links { margin-top: 34px; font-family: 'Space Mono', monospace; font-size: 10px; letter-spacing: .12em; text-transform: uppercase; opacity: .45; display: flex; gap: 18px; flex-wrap: wrap; justify-content: center; }
      .links a { color: #fff; text-decoration: none; }
      /* Same cross-document crossfade as the rest of the site (both documents
         must opt in — this page skips global.css, so declare it here too). */
      @view-transition{navigation:auto;}
      a.btn:active { transform: scale(.97); }
      @media (prefers-reduced-motion: reduce){
        ::view-transition-group(*),::view-transition-image-pair(*),
        ::view-transition-old(*),::view-transition-new(*){animation:none !important;}
        a.btn{transition:none;}
      }
