---
import Studio from "../layouts/Studio.astro";
import { SITE, CALENDLY_URL } from "../lib/site.mjs";
import { TOPICS } from "../lib/entity.mjs";

const canonical = `${SITE}/website-audit/`;

const checks = [
  { t: "Conversion path", d: "Where the friction is. I click through your buyers' path and flag the page where it shows up." },
  { t: "Page speed", d: "Lighthouse on a throttled 4G phone, not on your office wifi. Most of your traffic is on phones." },
  { t: "Mobile UX", d: "How the site feels at 11pm with one thumb. That's when most of your buyers actually decide." },
  { t: "SEO & AI visibility", d: "Whether Google and ChatGPT can find you and quote you. Cheap to set up right now." },
  { t: "Trust & credibility", d: "Whether a stranger would buy from you in 30 seconds. Logos, proof, polish — the parts that earn a yes." },
  { t: "Message clarity", d: "5-second test. I show the homepage to someone who hasn't heard of you. If they can't say what you do out loud, we have a clarity gap." },
];

const faqs = [
  { q: "Is the free audit really free?", a: "Yes. No upsell, no calendar chasing. Send a URL, get a Loom. I'll mention the deep dive once if it makes sense." },
  { q: "How fast do I get it?", a: "Free: 3–4 days. Deep dive: within a week plus a 30-min call. I keep a small buffer so I can deliver on time." },
  { q: "Do I have to hire you afterwards?", a: "Up to you. Take the findings to whoever. I'll be glad to implement, glad if you don't — both work." },
];

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `${canonical}#service`,
      name: "Website audit",
      serviceType: "Website conversion, SEO & performance audit",
      provider: { "@id": `${SITE}/#person` },
      areaServed: [{ "@type": "Country", name: "India" }, { "@type": "Place", name: "Worldwide" }],
      description:
        "A free quick website audit (walkthrough of the biggest wins) plus an optional paid deep-dive teardown covering conversion, SEO, performance and UX, for founders worldwide.",
      url: canonical,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Website audit", item: canonical },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
});
---

<Studio
  title="Free Website Audit — Conversion, Speed & SEO · Divyansh Sood"
  description="Free website audit by Divyansh Sood — find the conversion, page-speed and SEO leaks costing you customers. Send your URL, get the top fixes walked through."
  canonical={canonical}
  keywords="free website audit, website conversion audit, website teardown, SEO audit, page speed audit, UX audit, website review, Divyansh Sood"
  ogTitle="Free website audit — find what's costing you customers"
  ogDescription="A free walkthrough of the biggest conversion, speed and SEO wins on your site — plus an optional deep-dive teardown."
  topics={[TOPICS.seo, TOPICS.cwv, TOPICS.cro, TOPICS.webDevelopment]}
  jsonld={jsonld}
>
  <main>
    <header class="cs-hero">
      <div class="wrap">
        <div class="cs-eyebrow">
          <span>Website audit</span><span>Free + deep-dive</span><span>2026</span>
        </div>
        <h1 style="margin:14px 0 0;font-family:'Anton',sans-serif;font-weight:400;font-size:clamp(44px,8vw,108px);line-height:.9;letter-spacing:-.01em;text-transform:uppercase;">Is your site<br />costing you <span style="color:var(--accent);">customers?</span></h1>
        <p class="cs-lead">Most websites leak revenue in the same few places — a slow first load, a fuzzy message, a buy button that hides. Send me your URL and I'll show you exactly where yours leaks, and what I'd fix first.</p>
        <div class="cs-cta-row">
          <a class="btn btn-primary" href="#audit-form">Get my free audit ↓</a>
          <a class="btn btn-ghost" href={CALENDLY_URL} target="_blank" rel="noopener">Book a call instead</a>
        </div>
      </div>
    </header>

    <section class="cs-sec" aria-labelledby="tiers-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="tiers-h">Two ways to get audited</h2>
          <span class="mono">Free or deep</span>
        </div>
        <div class="cs-body" data-reveal>
          <div class="cs-card">
            <span class="cs-tag">Quick audit · 3–4 days · Free</span>
            <p class="cs-card-h2">Send a URL. 3–4 day turnaround. A 5-min Loom of the 3–5 highest-impact fixes — what's broken, what I'd change, what I'd leave alone. Yours to keep.</p>
            <div style="margin-top:18px;font-family:'Anton',sans-serif;font-weight:400;font-size:clamp(30px,4.4vw,48px);letter-spacing:0;color:var(--accent);">No charge</div>
          </div>
          <div class="cs-card">
            <span class="cs-tag">Deep dive · within a week · Full teardown + strategy call</span>
            <p class="cs-card-h2">Written teardown across conversion, SEO, speed, UX. 30-min call. Hand the fix list to any developer — me, your in-house team, whoever. Up to you.</p>
            <div style="margin-top:18px;font-family:'Anton',sans-serif;font-weight:400;font-size:clamp(30px,4.4vw,48px);letter-spacing:0;color:var(--accent);">Quoted on the call</div>
            <a class="btn btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener" style="margin-top:20px;">Book the deep dive <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="cs-sec" aria-labelledby="look-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="look-h">What I look at</h2>
          <span class="mono">Six lenses</span>
        </div>
        <div class="cs-body" data-reveal>
          {checks.map((c) => (
            <div class="cs-card">
              <span class="cs-tag">{c.t}</span>
              <p class="cs-card-h2">{c.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="cs-sec" aria-labelledby="proof-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="proof-h">It works in practice</h2>
          <span class="mono">From a real rebuild</span>
        </div>
        <figure class="cs-card cs-quote span2" data-reveal>
          <span class="cs-tag">In their words</span>
          <blockquote>"The website is so beautiful — looks 10 times more premium than our competitors. We started getting direct bookings instead of losing them to Google Maps."</blockquote>
          <figcaption>— Founder, Nandini Travels</figcaption>
        </figure>
      </div>
    </section>

    <section class="cs-sec" id="audit-form" aria-labelledby="form-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="form-h">Get your free audit</h2>
          <span class="mono">Takes 30 seconds</span>
        </div>
        <form id="ds-audit-form" data-reveal style="max-width:620px;border:1px solid rgba(255,255,255,.14);border-radius:10px;padding:30px;background:linear-gradient(180deg,rgba(255,255,255,.03),transparent);">
          <label for="au-url" style="display:block;font-family:'JetBrains Mono',monospace;font-size:var(--fs-label);letter-spacing:var(--ls-label);text-transform:uppercase;opacity:.6;margin-bottom:8px;">Your website URL *</label>
          <input id="au-url" type="url" required placeholder="https://yourwebsite.com" autocomplete="url" style="width:100%;background:transparent;border:none;border-bottom:1px solid rgba(255,255,255,.25);color:#F4F2EC;font-family:'JetBrains Mono',monospace;font-size:14px;padding:12px 2px;outline:none;margin-bottom:24px;" />
          <label for="au-email" style="display:block;font-family:'JetBrains Mono',monospace;font-size:var(--fs-label);letter-spacing:var(--ls-label);text-transform:uppercase;opacity:.6;margin-bottom:8px;">Email</label>
          <input id="au-email" type="email" placeholder="So I can send the teardown" autocomplete="email" style="width:100%;background:transparent;border:none;border-bottom:1px solid rgba(255,255,255,.25);color:#F4F2EC;font-family:'JetBrains Mono',monospace;font-size:14px;padding:12px 2px;outline:none;margin-bottom:24px;" />
          <label for="au-goal" style="display:block;font-family:'JetBrains Mono',monospace;font-size:var(--fs-label);letter-spacing:var(--ls-label);text-transform:uppercase;opacity:.6;margin-bottom:8px;">What should this site do better? (optional)</label>
          <input id="au-goal" type="text" placeholder="More leads, faster load, more sales…" style="width:100%;background:transparent;border:none;border-bottom:1px solid rgba(255,255,255,.25);color:#F4F2EC;font-family:'JetBrains Mono',monospace;font-size:14px;padding:12px 2px;outline:none;margin-bottom:30px;" />
          {/* Honeypot — invisible to humans; bots that fill it are dropped. */}
          <input id="au-hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none;" />
          <button type="submit" class="btn btn-primary">Get my free audit <span aria-hidden="true">↗</span></button>
          <p style="margin:18px 0 0;font-family:'JetBrains Mono',monospace;font-size:var(--fs-label-lg);line-height:1.6;opacity:.5;">Goes straight to my inbox — no spam, no list.</p>
        </form>
      </div>
    </section>

    <section class="cs-sec" id="start-form" aria-labelledby="start-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="start-h">Skip the audit — start a project</h2>
          <span class="mono">Already sold? Two minutes</span>
        </div>
        <p class="au-start-lead">Know you want a new build, not a teardown? Tell me the shape of it and you'll get a personal reply — usually within a couple of hours, from me, not an autoresponder.</p>
        <form id="ds-start-form" data-reveal class="au-project-form">
          <div class="au-grid2">
            <div>
              <label for="st-name" class="au-label">Your name *</label>
              <input id="st-name" type="text" required placeholder="Jane Founder" autocomplete="name" class="au-input" />
            </div>
            <div>
              <label for="st-email" class="au-label">Email *</label>
              <input id="st-email" type="email" required placeholder="you@company.com" autocomplete="email" class="au-input" />
            </div>
          </div>

          <label for="st-company" class="au-label">Company or current website</label>
          <input id="st-company" type="text" placeholder="company.com (optional)" class="au-input au-mb" />

          <div class="au-grid2">
            <div>
              <label for="st-type" class="au-label">What do you need? *</label>
              <select id="st-type" required class="au-input au-select">
                <option value="">Select one…</option>
                <option>New website</option>
                <option>Web app / SaaS / MVP</option>
                <option>E-commerce store</option>
                <option>Redesign or rebuild</option>
                <option>Something else</option>
              </select>
            </div>
            {/* Replaced the old budget-range select when pricing came off the
                site. Stage qualifies a brief better than a number anyway — it
                tells me how much is already decided, which is what actually
                drives scope. */}
            <div>
              <label for="st-stage" class="au-label">Where are you now? *</label>
              <select id="st-stage" required class="au-input au-select">
                <option value="">Select one…</option>
                <option>Just an idea so far</option>
                <option>Designs or specs are ready</option>
                <option>Existing site needs rebuilding</option>
                <option>Live product, adding to it</option>
              </select>
            </div>
          </div>

          <label for="st-timeline" class="au-label">Timeline</label>
          <select id="st-timeline" class="au-input au-select au-mb">
            <option value="">When do you want it live?</option>
            <option>As soon as possible</option>
            <option>Within 1 month</option>
            <option>1–3 months</option>
            <option>Just exploring</option>
          </select>

          <label for="st-msg" class="au-label">Anything else?</label>
          <textarea id="st-msg" rows="3" placeholder="One line on what you're building and what success looks like." class="au-textarea"></textarea>

          {/* Honeypot — invisible to humans; bots that fill it are dropped. */}
          <input id="st-hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none;" />
          <button type="submit" class="btn btn-primary">Send it to Divyansh <span aria-hidden="true">↗</span></button>
          <p class="au-formnote">Goes to my inbox. No list. If it's not a fit, I'll tell you straight away and point you somewhere better. (WhatsApp: <a href="https://wa.me/919816091875" target="_blank" rel="noopener">+91 98160 91875 ↗</a>)</p>
        </form>
      </div>
    </section>

    <section class="cs-sec" aria-labelledby="faq-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="faq-h">Frequently asked</h2>
          <span class="mono">About the audit</span>
        </div>
        <div class="cs-faq">
          {faqs.map((f, i) => (
            <div class="cs-faq-row">
              <button class="cs-faq-q" data-faqtog={i} aria-expanded="false" aria-controls={`faq-audit-${i}`}>
                <span>{f.q}</span><span class="cs-faq-icon" data-faqicon={i} aria-hidden="true">+</span>
              </button>
              <div class="cs-faq-a" id={`faq-audit-${i}`} data-faqbody={i}><p>{f.a}</p></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="cs-endcta">
      <div class="wrap">
        <h2>Prefer to just talk it through?</h2>
        <p>Book a 15-minute slot. We'll pull up your site live. I'll tell you what I'd fix first, free, and you decide on the rest.</p>
        <div class="cs-cta-row" style="justify-content:center;">
          <a class="btn btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Book an intro call <span aria-hidden="true">↗</span></a>
          <a class="btn btn-ghost" href="/portfolio/">See the work</a>
        </div>
      </div>
    </section>
  </main>

  <style>
    /* ============================================================
       Website audit — UI polish (scoped). Matches About / Results /
       Portfolio, plus the merged 'start a project' qualifying form
       (moved here from /start).
       ============================================================ */
    /* Rhythm, section-head alignment and hero clearance are shared — they live
       in case-study.css and Breadcrumbs.astro now. */
    main .cs-lead { max-width: 64ch; font-size: clamp(17px, 1.7vw, 21px); }
    main .cs-sec-head h2 {
      font-family: 'Anton', sans-serif;
      font-weight: 400;
      font-size: clamp(30px, 4.8vw, 68px);
      line-height: 0.96;
      letter-spacing: 0;
      text-transform: uppercase;
    }
    main .cs-sec-head .mono { color: #8A8A93; }

    /* Cards: interactive lift + accent edge on hover. */
    main .cs-card {
      border-radius: 10px;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, background 0.3s ease;
    }
    main .cs-card:hover {
      transform: translateY(-4px);
      border-color: rgba(217,255,60, 0.5);
      background: linear-gradient(180deg, rgba(217,255,60, 0.06), transparent);
    }
    main .cs-quote:hover { transform: none; }

    /* ---- Merged 'start a project' qualifying form ---- */
    main .au-start-lead {
      max-width: 60ch;
      margin: 0 0 26px;
      font-size: clamp(15px, 1.5vw, 17px);
      line-height: 1.6;
      opacity: 0.82;
    }
    main .au-project-form {
      max-width: 680px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 12px;
      padding: clamp(24px, 3vw, 32px);
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.03), transparent);
    }
    main .au-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; margin-bottom: 22px; }
    main .au-label {
      display: block;
      font-family: "JetBrains Mono", monospace;
      font-size: var(--fs-label);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      opacity: 0.6;
      margin-bottom: 8px;
    }
    main .au-input {
      width: 100%;
      background: transparent;
      border: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.25);
      color: #F4F2EC;
      font-family: "JetBrains Mono", monospace;
      font-size: 14px;
      padding: 12px 2px;
      outline: none;
    }
    main .au-input:focus { border-bottom-color: var(--accent, #d9ff3c); }
    main .au-select { background: #0b0b0c; }
    main .au-mb { margin-bottom: 22px; }
    main .au-textarea {
      width: 100%;
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 6px;
      color: #F4F2EC;
      font-family: "JetBrains Mono", monospace;
      font-size: 14px;
      padding: 12px;
      outline: none;
      margin: 0 0 24px;
      resize: vertical;
    }
    main .au-textarea:focus { border-color: var(--accent, #d9ff3c); }
    main .au-formnote {
      margin: 18px 0 0;
      font-family: "JetBrains Mono", monospace;
      font-size: var(--fs-label-lg);
      line-height: 1.6;
      opacity: 0.5;
    }
    main .au-formnote a { color: var(--accent, #d9ff3c); text-decoration: underline; }

    /* 720, not 620 — the section heads and every other grid on this page
       switch at 720, and the form has to switch with them. */
    @media (max-width: 720px) {
      main .au-grid2 { grid-template-columns: 1fr; gap: 0; }
      main .au-grid2 > div { margin-bottom: 22px; }
    }
  </style>
</Studio>

<script is:inline>
  (function () {
    var root = document.getElementById("ds-root");
    if (!root) return;

    /* faq accordion */
    var faq = -1;
    function sync() {
      root.querySelectorAll("[data-faqbody]").forEach(function (el) {
        var open = Number(el.getAttribute("data-faqbody")) === faq;
        el.style.maxHeight = open ? el.scrollHeight + "px" : "0px";
        el.style.opacity = open ? "1" : "0";
      });
      root.querySelectorAll("[data-faqicon]").forEach(function (el) {
        el.style.transform = Number(el.getAttribute("data-faqicon")) === faq ? "rotate(45deg)" : "rotate(0deg)";
      });
      root.querySelectorAll("[data-faqtog]").forEach(function (el) {
        el.setAttribute("aria-expanded", Number(el.getAttribute("data-faqtog")) === faq ? "true" : "false");
      });
    }
    root.querySelectorAll("[data-faqtog]").forEach(function (el) {
      el.addEventListener("click", function () {
        var i = Number(el.getAttribute("data-faqtog"));
        faq = faq === i ? -1 : i;
        sync();
      });
    });
    var rt;
    window.addEventListener("resize", function () {
      if (faq < 0) return;
      clearTimeout(rt);
      rt = setTimeout(sync, 120);
    });
    sync();
  })();
</script>

<script>
  import initContactForms from "../scripts/contact-form.js";
  initContactForms();
</script>
