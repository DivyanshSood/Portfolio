---
import Base from "../layouts/Base.astro";
import PageHero from "../components/brand/PageHero.astro";
import Section from "../components/brand/Section.astro";
import Cards from "../components/brand/Cards.astro";
import Faq from "../components/brand/Faq.astro";
import EndCta from "../components/brand/EndCta.astro";
import Quote from "../components/brand/Quote.astro";
import { SITE, CALENDLY_URL } from "../lib/site.mjs";
import { TOPICS } from "../lib/entity.mjs";

const canonical = `${SITE}/website-audit/`;

const checks = [
  { t: "Conversion path", d: "Where the friction is. I click through your buyers' path and flag the page where it shows up." },
  { t: "Page speed", d: "Lighthouse on a throttled 4G phone, not on your office wifi. Most of your traffic is on phones." },
  { t: "Mobile UX", d: "How the site feels at 11pm with one thumb. That's when most of your buyers actually decide." },
  { t: "SEO & AI visibility", d: "Whether Google and ChatGPT can find you and quote you. Cheap to set up right now." },
  { t: "Trust & credibility", d: "Whether a stranger would buy from you in 30 seconds. Logos, proof, polish — the parts that earn a yes." },
  { t: "Message clarity", d: "5-second test. I show the homepage to someone who hasn't heard of you. If they can't say what you do out loud, we have a clarity gap." },
];

const faqs = [
  { q: "Is the free audit really free?", a: "Yes. No upsell, no calendar chasing. Send a URL, get a Loom. I'll mention the deep dive once if it makes sense." },
  { q: "How fast do I get it?", a: "Free: 3–4 days. Deep dive: within a week plus a 30-min call. I keep a small buffer so I can deliver on time." },
  { q: "Do I have to hire you afterwards?", a: "Up to you. Take the findings to whoever. I'll be glad to implement, glad if you don't — both work." },
];

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `${canonical}#service`,
      name: "Website audit",
      serviceType: "Website conversion, SEO & performance audit",
      provider: { "@id": `${SITE}/#person` },
      areaServed: [{ "@type": "Country", name: "India" }, { "@type": "Place", name: "Worldwide" }],
      description:
        "A free quick website audit (walkthrough of the biggest wins) plus an optional paid deep-dive teardown covering conversion, SEO, performance and UX, for founders worldwide.",
      url: canonical,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Website audit", item: canonical },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
});
---

<Base
  title="Free Website Audit — Conversion, Speed & SEO · Divyansh Sood"
  description="Free website audit by Divyansh Sood — find the conversion, page-speed and SEO leaks costing you customers. Send your URL, get the top fixes walked through."
  canonical={canonical}
  keywords="free website audit, website conversion audit, website teardown, SEO audit, page speed audit, UX audit, website review, Divyansh Sood"
  ogTitle="Free website audit — find what's costing you customers"
  ogDescription="A free walkthrough of the biggest conversion, speed and SEO wins on your site — plus an optional deep-dive teardown."
  topics={[TOPICS.seo, TOPICS.cwv, TOPICS.cro, TOPICS.webDevelopment]}
  jsonld={jsonld}
>
  <main>
    <PageHero
      display="Is your site costing you customers?"
      size="case"
      kicker="Website audit · Free + deep-dive · 2026"
      lead="Most websites leak revenue in the same few places — a slow first load, a fuzzy message, a buy button that hides. Send me your URL and I'll show you exactly where yours leaks, and what I'd fix first."
    >
      <a class="btn btn--red" href="#audit-form">Get my free audit <span aria-hidden="true">↓</span></a>
      <a class="btn btn--ink" href={CALENDLY_URL}>Book a call instead</a>
    </PageHero>

    <Section n={1} term="Setup" note="Free or deep" title="Two ways to get audited">
      <Cards min={380} items={[
        { tag: "Quick audit · 3–4 days · Free", t: "No charge", d: "Send a URL. 3–4 day turnaround. A 5-min Loom of the 3–5 highest-impact fixes — what's broken, what I'd change, what I'd leave alone. Yours to keep." },
        { tag: "Deep dive · within a week · Full teardown + strategy call", t: "Quoted on the call", d: "Written teardown across conversion, SEO, speed, UX. 30-min call. Hand the fix list to any developer — me, your in-house team, whoever. Up to you." },
      ]} />
      <div class="btn-row gap-top"><a class="btn btn--ink" href={CALENDLY_URL}>Book the deep dive <span aria-hidden="true">→</span></a></div>
    </Section>

    <Section n={2} term="Telemetry" note="Six lenses" title="What I look at">
      <Cards items={checks} />
    </Section>

    <Section n={3} term="Team radio" note="From a real rebuild" title="It works in practice">
      <div class="au-q"><Quote text="The website is so beautiful — looks 10 times more premium than our competitors. We started getting direct bookings instead of losing them to Google Maps." by="Founder, Nandini Travels" red /></div>
    </Section>

    <Section n={4} term="Chequered flag" note="Takes 30 seconds" title="Get your free audit" id="audit-form">
      <div class="au-card">
        <div class="au-card-top"><span>Send a URL — get a Loom</span><span style="color:var(--red)">●</span></div>
        <form id="ds-audit-form" class="form">
          <label class="field" for="au-url">Your website URL *<input id="au-url" type="url" required placeholder="https://yourwebsite.com" autocomplete="url" /></label>
          <label class="field" for="au-email">Email<input id="au-email" type="email" placeholder="So I can send the teardown" autocomplete="email" /></label>
          <label class="field" for="au-goal">What should this site do better? (optional)<input id="au-goal" type="text" placeholder="More leads, faster load, more sales…" /></label>
          {/* Honeypot — invisible to humans; bots that fill it are dropped. */}
          <div class="hp" aria-hidden="true"><label for="au-hp">Leave this empty</label><input id="au-hp" type="text" name="website" tabindex="-1" autocomplete="off" /></div>
          <button type="submit" class="form-submit">Get my free audit →</button>
          <p class="meta au-fine">Goes straight to my inbox — no spam, no list.</p>
        </form>
      </div>
    </Section>

    <Section n={5} term="Chequered flag" note="Already sold? Two minutes" title="Skip the audit — start a project" id="start-form">
      <p class="body au-lead">Know you want a new build, not a teardown? Tell me the shape of it and you'll get a personal reply — usually within a couple of hours, from me, not an autoresponder.</p>
      <div class="au-card">
        <div class="au-card-top"><span>Start a project</span><span style="color:var(--red)">●</span></div>
        <form id="ds-start-form" class="form">
          <div class="au-two">
            <label class="field" for="st-name">Your name *<input id="st-name" type="text" required placeholder="Jane Founder" autocomplete="name" /></label>
            <label class="field" for="st-email">Email *<input id="st-email" type="email" required placeholder="you@company.com" autocomplete="email" /></label>
          </div>
          <label class="field" for="st-company">Company or current website<input id="st-company" type="text" placeholder="company.com (optional)" /></label>
          <div class="au-two">
            <label class="field" for="st-type">What do you need? *
              <select id="st-type" required>
                <option value="">Select one…</option>
                <option>New website</option>
                <option>Web app / SaaS / MVP</option>
                <option>E-commerce store</option>
                <option>Redesign or rebuild</option>
                <option>Something else</option>
              </select>
            </label>
            {/* Stage replaced the old budget select when pricing came off the
                site: it tells me how much is already decided, which is what
                actually drives scope. */}
            <label class="field" for="st-stage">Where are you now? *
              <select id="st-stage" required>
                <option value="">Select one…</option>
                <option>Just an idea so far</option>
                <option>Designs or specs are ready</option>
                <option>Existing site needs rebuilding</option>
                <option>Live product, adding to it</option>
              </select>
            </label>
          </div>
          <label class="field" for="st-timeline">Timeline
            <select id="st-timeline">
              <option value="">When do you want it live?</option>
              <option>As soon as possible</option>
              <option>Within 1 month</option>
              <option>1–3 months</option>
              <option>Just exploring</option>
            </select>
          </label>
          <label class="field" for="st-msg">Anything else?<textarea id="st-msg" rows="3" placeholder="One line on what you're building and what success looks like."></textarea></label>
          {/* Honeypot — invisible to humans; bots that fill it are dropped. */}
          <div class="hp" aria-hidden="true"><label for="st-hp">Leave this empty</label><input id="st-hp" type="text" name="website" tabindex="-1" autocomplete="off" /></div>
          <button type="submit" class="form-submit">Send it to Divyansh →</button>
          <p class="meta au-fine">Goes to my inbox. No list. If it's not a fit, I'll tell you straight away and point you somewhere better. (WhatsApp: <a href="https://wa.me/919816091875">+91 98160 91875 ↗</a>)</p>
        </form>
      </div>
    </Section>

    <Section bare>
      <Faq faqs={faqs} label="(06) Before you ask" />
    </Section>

    <EndCta
      title="Prefer to just talk it through?"
      text="Book a 15-minute slot. We'll pull up your site live. I'll tell you what I'd fix first, free, and you decide on the rest."
      primary={{ href: CALENDLY_URL, label: "Book an intro call →" }}
      secondary={{ href: "/portfolio/", label: "See the work →" }}
    />
  </main>
</Base>

<script>
  import initContactForms from "../scripts/contact-form.js";
  initContactForms();
</script>

<style>
  .au-q{max-width:760px}
  .au-lead{margin:0 0 28px;max-width:60ch}
  .au-card{max-width:680px;border:1px solid var(--gda);border-top:3px solid var(--ink);padding:clamp(22px,2.6vw,36px)}
  .au-card-top{display:flex;justify-content:space-between;font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;margin-bottom:22px}
  .au-two{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:16px}
  .au-fine{margin:6px 0 0;line-height:1.6;text-transform:none;letter-spacing:.02em}
</style>
