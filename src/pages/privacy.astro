---
import Studio from "../layouts/Studio.astro";
import { SITE, CALENDLY_URL, GOOGLE_REVIEWS_URL } from "../lib/site.mjs";

const canonical = `${SITE}/privacy/`;

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonical}#page`,
      url: canonical,
      name: "Privacy — Divyansh Sood® Studio",
      description: "What divyanshsood.com collects, what it doesn't, who it shares with, and how to opt out.",
      isPartOf: { "@id": `${SITE}/#website` },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Privacy", item: canonical },
      ],
    },
  ],
});

// Plain-English summary at the top, detail in the body. Matches the actual
// runtime behaviour: GA + YM load on every page view, no third-party ad
// scripts, no IP capture beyond what the CDN does on its own.
const sections = [
  {
    h: "What runs when you arrive",
    p: "Two analytics scripts load with the page: Google Analytics 4 and Yandex Metrica, both described below. No advertising scripts, no tracking pixels, no session replay, no data broker of any kind. Browser-level controls are the way to opt out — see \"Analytics\".",
  },
  {
    h: "Cookies",
    p: "The analytics tools set their own cookies to tell one visit from the next — Google's _ga family and Yandex's _ym family. They hold a random ID, not a name or an email. The LinkedIn badge on the About page may set LinkedIn's cookies as well. No advertising cookies, and nothing is sold or shared with anyone.",
  },
  {
    h: "Analytics",
    p: "Google Analytics 4 runs with IP anonymisation enabled, and Yandex Metrica runs without session replay or clickmap. They record page views, country-level geolocation, and referrer. Yandex-verified domain only — not loaded for any other site that hotlinks these scripts. To opt out, use your browser's tracker blocking or Do Not Track signal, a content blocker such as uBlock Origin, or Google's official opt-out add-on.",
  },
  {
    h: "LinkedIn badge",
    p: "The About page embeds my LinkedIn profile badge, which loads in an iframe from platform.linkedin.com and can set LinkedIn's cookies. That embed is governed by LinkedIn's privacy policy, not mine. Blocking third-party frames in your browser removes it; the rest of the page is unaffected.",
  },
  {
    h: "What I don't collect",
    p: "No name. No email. No phone. No payment info. This site is a portfolio — the only way to contact me is to send a message yourself, via the Calendly link, email, or WhatsApp (the channels are visible at the bottom of every page).",
  },
  {
    h: "Hosting & CDN",
    p: "Pages are served by Vercel (static files at the edge). Project images are served by ImageKit, an image CDN. Both will log your IP for the duration of the request as part of normal operation; I don't see those logs unless I debug a specific incident.",
  },
  {
    h: "Reviews",
    p: "The \"Read our Google reviews\" link goes to our public Google Business Profile. Loading that page is governed by Google's privacy policy, not mine.",
  },
  {
    h: "Your rights (GDPR / CCPA)",
    p: "If you're in the EU, UK, or California, you can ask what data we hold about you and have it deleted. We hold nothing tied to your identity — the analytics data is pseudonymous (a random client ID + IP-prefix only). For a verifiable request, email hello@divyanshsood.com.",
  },
  {
    h: "Changes",
    p: "If anything here changes materially, I'll update the date at the top of this page. The site does not have a comment system or a mailing list, so there is no in-product way to notify you.",
  },
];
---
<Studio
  title="Privacy — what divyanshsood.com collects · Divyansh Sood® Studio"
  description="What divyanshsood.com collects (and doesn't). Cookies, anonymous analytics, no third-party ads, nothing sold. Plain English, GDPR/CCPA."
  canonical={canonical}
  keywords="Divyansh Sood privacy, cookie policy, GDPR portfolio, CCPA web developer"
  ogTitle="Privacy — plain English, no dark patterns"
  ogDescription="What this site collects, what it doesn't, and how to opt out."
  jsonld={jsonld}
>
  <main>
    <header class="cs-hero">
      <div class="cs-hero-bg" aria-hidden="true"></div>
      <div class="wrap">
        <div class="cs-eyebrow">
          <span>Privacy</span><span>Plain English, no dark patterns</span><span>Updated 2026-06</span>
        </div>
        <h1 class="cs-domain">Privacy.<span class="arrow">↗</span></h1>
        <p class="cs-h1">The short version: <span class="tail">two analytics tools count page views, I never sell anything to anyone, and there's no third-party ad script on the page.</span></p>
        <p class="cs-lead">If you want the full policy, the section-by-section breakdown is below — what loads, what it stores, and how to switch it off from your browser.</p>
        <div class="cs-cta-row">
          <a class="btn btn-primary" href="#privacy-detail">Read the detail</a>
          <a class="btn btn-ghost" href={CALENDLY_URL} target="_blank" rel="noopener">Get in touch instead</a>
        </div>
      </div>
    </header>

    <section class="cs-sec" aria-labelledby="summary-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="summary-h">In 30 seconds</h2>
          <span class="mono">TL;DR</span>
        </div>
        <div class="cs-body" data-reveal>
          <div class="cs-card span2">
            <span class="cs-tag">The one-line answer</span>
            <p>This site is a portfolio. It does not collect personal data from visitors. The only thing it records is anonymous page-view counts, through two standard analytics tools that can't tie a visit to a name. That's it.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="cs-sec" id="privacy-detail" aria-labelledby="detail-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="detail-h">Section by section</h2>
          <span class="mono">Full policy</span>
        </div>
        <div class="cs-body" data-reveal>
          {sections.map((s, i) => (
            <div class={"cs-card" + (i % 4 === 0 ? " span2" : "")}>
              <span class="cs-tag">({String(i + 1).padStart(2, "0")})</span>
              <p class="cs-card-h2">{s.h}</p>
              <p>{s.p}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="cs-endcta">
      <div class="wrap">
        <h2>Still have questions?</h2>
        <p>If something on this page is unclear, or you want a verifiable data request under GDPR / CCPA, email <a href="mailto:hello@divyanshsood.com" style="color:var(--accent,#d9ff3c);text-decoration:underline;">hello@divyanshsood.com</a> — I reply personally within a couple of hours during IST working hours.</p>
        <div class="cs-cta-row" style="justify-content:center;">
          <a class="btn btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Book a 15-min intro <span aria-hidden="true">↗</span></a>
          <a class="btn btn-ghost" href={GOOGLE_REVIEWS_URL} target="_blank" rel="noopener">Read our Google reviews ↗</a>
        </div>
      </div>
    </section>
  </main>
</Studio>
