---
import Base from "../layouts/Base.astro";
import PageHero from "../components/brand/PageHero.astro";
import Section from "../components/brand/Section.astro";
import Rows from "../components/brand/Rows.astro";
import Cards from "../components/brand/Cards.astro";
import ResultGrid from "../components/brand/ResultGrid.astro";
import Faq from "../components/brand/Faq.astro";
import EndCta from "../components/brand/EndCta.astro";
import { SITE, CALENDLY_URL, GOOGLE_MAPS_URL } from "../lib/site.mjs";
import { TOPICS } from "../lib/entity.mjs";

const canonical = `${SITE}/web-developer-shimla/`;
const WA = "https://wa.me/919816091875?text=Hi%20Divyansh,%20I%20run%20a%20business%20in%20Shimla%20and%20need%20a%20website.";

const offers = [
  { t: "Hotel & resort websites", d: "Direct-booking sites for Shimla's hotels, resorts and heritage stays — with rate enquiries, WhatsApp booking and the photography-first layouts a hill station deserves." },
  { t: "Institutions & professional firms", d: "Schools, colleges, hospitals, law and CA firms — the establishments Shimla is built on. Credible, fast, findable websites with the right structure for each." },
  { t: "Tourism & experience operators", d: "Tour packages, adventure operators, travel desks — booking-first builds that capture the searches tourists make before they ever reach the Mall Road." },
  { t: "Redesigns that rank", d: "Many Shimla businesses have a website — from 2015. I rebuild them custom-coded: faster, mobile-first, structured for Google and AI search, without losing your existing rankings." },
];

const faqs = [
  { q: "Do you work with businesses in Shimla?", a: "Yes. I'm based in Kangra district and work with businesses across Himachal Pradesh — Shimla included. Everything runs over WhatsApp, calls and screen-shares, the same way I work with clients in the US and Europe; and being in-state means same-timezone responses and the option to meet when it matters." },
  { q: "What does a website cost in Shimla?", a: "A hotel direct-booking site, an institution's website and a firm's profile site are three different scopes — so I quote after one conversation, fixed and in writing. You'll know the whole number before anything starts." },
  { q: "Can you redesign our existing website without losing our Google rankings?", a: "Yes — that's a technical SEO job as much as a design job: preserving URLs or redirecting them properly, keeping the content Google already trusts, and shipping a faster site that improves rankings rather than gambling with them." },
  { q: "How is this different from hiring a big agency in Chandigarh or Delhi?", a: "You work directly with the person who designs and codes — no account managers, no junior handoffs, no six-month timelines. Builds go live in 1–3 weeks, you own the code outright, and support doesn't die after launch." },
];

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `${canonical}#service`,
      name: "Web design and development in Shimla",
      serviceType: "Website design and development",
      provider: { "@id": `${SITE}/#studio` },
      areaServed: { "@type": "City", name: "Shimla", containedInPlace: { "@type": "State", name: "Himachal Pradesh" } },
      description:
        "Website designer and developer for Shimla businesses — hotels, institutions, tourism operators and professional firms. Custom-coded, SEO-safe redesigns, direct-booking builds, live in 1–3 weeks.",
      url: canonical,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Services", item: `${SITE}/services/` },
        { "@type": "ListItem", position: 3, name: "Web developer in Shimla", item: canonical },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
});
---

<Base
  title="Web Developer in Shimla — Websites for Hotels, Schools & Firms"
  description="Web developer for Shimla businesses — hotel direct-booking sites, school and institution websites, SEO-safe redesigns. Built from Kangra, Himachal."
  canonical={canonical}
  keywords="website designer in Shimla, web developer Shimla, website design Shimla Himachal, hotel website design Shimla, website redesign Shimla, web development company Shimla"
  ogTitle="Web developer in Shimla"
  ogDescription="Hotels, institutions and firms — custom-coded websites for Shimla, built in Himachal, not outsourced to a metro."
  topics={[TOPICS.webDevelopment, TOPICS.himachal, TOPICS.hotel]}
  jsonld={jsonld}
>
  <main>
    <PageHero
      display="Web developer in Shimla."
      size="case"
      kicker="Himachal Pradesh · Shimla · 2026"
      lead={`Shimla's hotels, institutions and firms compete for guests and clients who research online first — and most of the city's websites were built a decade ago. I build from Kangra and work with Shimla clients over WhatsApp, calls and screen-shares, rebuilding their sites custom-coded: faster than the metro agencies, without their timelines, and with SEO handled so the rankings you have only get stronger.`}
    >
      <a class="btn btn--red" href={CALENDLY_URL}>Book a call <span aria-hidden="true">→</span></a>
      <a class="btn btn--ink" href={WA}>Message on WhatsApp</a>
      <Fragment slot="notes"><span>Based in Kangra, Himachal · <a href={GOOGLE_MAPS_URL} target="_blank" rel="noopener">on Google Maps ↗</a></span><span>Live in 1–3 weeks</span></Fragment>
    </PageHero>

    <Section n={1} term="Setup" note="The offering" title="Built for how Shimla works">
      <Rows items={offers} />
    </Section>

    <Section n={2} term="Telemetry" note="Proof, not promises" title="Himachal work, on the record">
      <ResultGrid stats={[
        { v: `20+`, l: `Builds shipped since 2022` },
        { v: `~1,000`, l: `Monthly bookings via one travel site` },
        { v: `7 days`, l: `Fastest full build (site + portal)` },
        { v: `1–3 wks`, l: `Typical time to live` },
      ]} />
      <div class="gap-top">
        <Cards items={[
          { tag: `Travel & stays`, d: `Booking-first builds for Himalayan tourism: Dharamshala Tours handles part of ~1,000 monthly bookings; Nandini Travels moved its enquiries off a Maps listing. <a href="/projects/dharamshala-tours/">See a travel build →</a>` },
          { tag: `Institutions`, d: `Modern K.B.S. school got a public site plus an admissions portal for classes I–XII in seven days — the timeline agencies quoted was six months. <a href="/projects/modernkbs/">See the school build →</a>` },
          { tag: `Pinnacle World School · Baroh, Kangra`, d: `A CBSE school site where every published fact traces back to the school's affiliation record: Mandatory Public Disclosure, an admissions form that lands in the office's WhatsApp, and old URLs redirected. <a href="/projects/pinnacle-world-school/">Read the case study →</a>` },
          { tag: `Yash Rock Hotel · Dehrian, Kangra`, d: `Seven rooms, a pool, and no booking engine: every enquiry goes to WhatsApp or a call, and 14 “near” pages reach guests heading for NIFT, Tanda Medical College and the airport. <a href="/projects/yash-rock-hotel/">Read the case study →</a>` },
          { tag: `By industry`, wide: true, d: `What I build most in Himachal: <a href="/services/school-website-development/">school websites</a>, <a href="/services/hotel-website-development/">hotel and homestay websites</a>, and <a href="/services/travel-website-development/">travel and taxi websites</a>.` },
          { tag: `Direct bookings, not commissions`, wide: true, d: `For Shimla's hotels the math is simple: every OTA booking pays a commission a direct-booking site would keep. I wrote up how Himalayan stays fix that. <a href="/blog/hotel-homestay-website-himachal-direct-bookings/">Read the breakdown →</a>` },
        ]} />
      </div>
    </Section>

    <Section bare>
      <Faq faqs={faqs} label="(03) Before you ask" />
    </Section>

    <EndCta
      title="Run a business in Shimla?"
      text={`Send your current website — or just what you do. You'll get an honest read on what's costing you customers, and a fixed quote in writing.`}
      primary={{ href: WA, label: "Message on WhatsApp →" }}
      secondary={{ href: "/website-audit/", label: "Get a free website audit →" }}
    />
  </main>
</Base>
