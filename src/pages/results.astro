---
import Base from "../layouts/Base.astro";
import PageHero from "../components/brand/PageHero.astro";
import Section from "../components/brand/Section.astro";
import ResultGrid from "../components/brand/ResultGrid.astro";
import EndCta from "../components/brand/EndCta.astro";
import Quote from "../components/brand/Quote.astro";
import { SITE, CALENDLY_URL, GOOGLE_REVIEWS_URL } from "../lib/site.mjs";
import { countWord, projects } from "../lib/projects/data.mjs";

const canonical = `${SITE}/results/`;

// Top-line studio numbers — every figure is real and matches the case studies.
const topStats = [
  { v: "20+", l: "Projects shipped since 2022" },
  { v: "3–4 wks", l: "Typical kickoff to live" },
  { v: String(projects.length), l: "Case studies published" },
  { v: "1–3 wks", l: "Local Himachal sites, kickoff to live" },
];

// One headline result per project. Every number is pulled from a real case study
// you can open and read — no rounded-up vanity metrics.
const results = [
  { slug: "pinnacle-world-school", name: "Pinnacle World School", cat: "CBSE school site", v: "0", l: "facts published without a source", o: "A CBSE school in Kangra on a new domain. Every fact is checked against its affiliation record, anything unconfirmed says “To be updated”, and admission enquiries land in the office's WhatsApp." },
  { slug: "sunny-himachal-travels", name: "Sunny Himachal Travels", cat: "Tours + taxi", v: "1.1 KB", l: "of its own JavaScript · Lighthouse 100 ×4 on desktop", o: "A one-page design canvas rebuilt as a real site with a page for every trip, transfer and town in the Kangra valley — 8,695 search impressions in its first month, read honestly through a Google spam update." },
  { slug: "yash-rock-hotel", name: "Yash Rock Hotel", cat: "Hillside hotel", v: "14", l: "“near” pages for where guests are going", o: "A seven-room hotel with a pool, and no booking engine by design. Every call to action goes to WhatsApp or a call, and the site ranks for the places guests are actually heading." },
  { slug: "hotel-himalayan-brothers", name: "Himalayan Brothers Hotels", cat: "Hotel group", v: "5", l: "hotels on one site · Lighthouse mobile 98–100", o: "Five family-run hotels from Dharamshala to Spiti, rebuilt from an audit of the old site. Every old URL kept, one booking form for two kinds of booking, and only reviews that can be found." },
  { slug: "himalayan-brothers", name: "Himalayan Brothers Travel", cat: "Tours + taxi", v: "51", l: "pages from a parked domain", o: "The hotel family's travel desk, built on the hotel site's design system so the two read as one business — with every drafted itinerary flagged until the family signs it off." },
  { slug: "leisure-himachal", name: "Leisure Himachal", cat: "Manali travel agency", v: "71", l: "old URLs redirected", o: "A Manali agency's site from 2011, read in full — live and through 74 Wayback captures — then rebuilt as 77 pages with every unconfirmed fact outlined on the page." },
  { slug: "kangra-valley-travels", name: "Kangra Valley Travels", cat: "Owner-driver taxi", v: "558", l: "road distances, map-measured", o: "An owner-driver who started with one Ertiga, on 56 pages, with a build that fails on any fare, rating or “AC” claim the driver hasn't confirmed." },
  { slug: "shiva-tour-and-travel", name: "Shiva Tour and Travel", cat: "Airport taxi + yatras", v: "0", l: "invented stats or reviews left", o: "A Kangra Airport taxi and temple-yatra site rebuilt from a mockup that made up its own reviews — and a build that fails if they come back." },
  { slug: "sach-pass", name: "Sach Pass", cat: "Stays + road status", v: "14", l: "stays on the road, each with its source", o: "Every place to stay between Chamba and Killar, the pass's road status with a source for every date, and eight tour packages — for the hotel family that runs Diwan Sachpass at Bairagarh." },
  { slug: "modernkbs", name: "Modern K.B.S.", cat: "Web app + admin", v: "I–XII", l: "classes apply online", o: "A school website with online admissions, an application-status page and an admin panel the office staff run themselves — live for the intake it was built for, with no SaaS fee." },
  { slug: "webseek", name: "Websitekind.ai", cat: "AI product", v: "1", l: "prompt to an editable, exportable site", o: "My own AI website builder, launched as WebSeek.ai on three model providers and now powered by Claude. Click anything to edit it, then export clean HTML — a product in real use, not a demo." },
  { slug: "chinkiz", name: "ChinkiZ Knitting Knife", cat: "Creator site", v: "585K", l: "subscriber creator's own site", o: "A knitting teacher with 585K YouTube subscribers. 96 handmade pieces in a gallery, no cart by design, and an order builder that writes the WhatsApp message for the customer." },
  { slug: "dharamshala-tours", name: "Dharamshala Tours", cat: "Treks + adventure", v: "13", l: "trek pages the crew edits", o: "Treks, paragliding, rentals and workations above Dharamshala on a static site the crew updates and deploys themselves. Every page ends in a WhatsApp chat, not a dead form." },
  { slug: "nandini", name: "Nandini Travels", cat: "Local travel", v: "10×", l: "“more premium” — the founder", o: "Was losing every booking to a Google Maps listing. Now enquiries land on a site the owner controls — and looks, in his words, ten times more premium than the competition." },
  { slug: "baglamukhi-travels", name: "Baglamukhi Travels", cat: "Kangra taxi + yatra", v: "41.8K", l: "Google impressions in 28 days", o: "Owner-drivers competing against commission agents and aggregators. With ten pages the site averaged position 5.7; at 139 pages it drew 41,829 impressions and 246 clicks in the 28 days to 3 November 2026." },
  { slug: "northpeak", name: "North Peak Power", cat: "Concept · solar", v: "19", l: "pages, self-serve admin", o: "My own concept build for a Himachal solar contractor pitching private buyers: nineteen pages and an admin a non-technical team could run." },
  { slug: "redline", name: "Redline Studios", cat: "My own label", v: "1", l: "sprint, brand to checkout", o: "My own motorcycle-apparel label: identity, storefront and checkout built as one piece of work in a single sprint." },
  { slug: "cultxberserk", name: "CultXberserk", cat: "My own label", v: "0001–0666", l: "hand-numbered units", o: "My own lore-driven label, where the story, the numbering mechanic and the buy button live on one screen and the storefront enforces the scarcity." },
];
// Client outcomes first; the studio's own brands and product are listed
// separately so nothing here reads as a result delivered for a client.
const isPersonal = (slug) => projects.find((p) => p.slug === slug)?.personal;
const clientResults = results.filter((r) => !isPersonal(r.slug));
const personalResults = results.filter((r) => isPersonal(r.slug));

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#page`,
      url: canonical,
      name: "Results — Divyansh Sood® Studio",
      description: "Real, measurable outcomes from custom-coded websites, stores and web apps built by Divyansh Sood for clients worldwide.",
      isPartOf: { "@id": `${SITE}/#website` },
      about: { "@id": `${SITE}/#studio` },
    },
    {
      "@type": "ItemList",
      itemListElement: clientResults.map((r, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${SITE}/projects/${r.slug}/`,
        name: `${r.name} — ${r.l}`,
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Results", item: canonical },
      ],
    },
  ],
});
---

<Base
  title="Website Results — Bookings, Sales & Speed · Divyansh Sood® Studio"
  description="Results from Divyansh Sood's custom-coded websites: first-page Google rankings for a Kangra taxi operator, five hotels on one fast site, Lighthouse 100."
  canonical={canonical}
  keywords="web design results, website case study results, conversion results, web developer portfolio outcomes, Divyansh Sood results"
  ogTitle="Results — what the work actually did"
  ogDescription="From 41.8K Google impressions a month to Lighthouse 100 — measurable outcomes from real projects, each linked to its case study."
  jsonld={jsonld}
>
  <main>
    <PageHero
      display="The work, by the numbers."
      size="case"
      kicker="Results · Real numbers, real projects · 2022—2026"
      lead="Anyone can promise a pretty website. Here's what mine actually did — bookings won back from aggregators, old sites rebuilt without losing a URL, storefronts that outgrew the builders they replaced. Every figure links to its case study."
    >
      <a class="btn btn--red" href={CALENDLY_URL}>Book an intro call <span aria-hidden="true">→</span></a>
      <a class="btn btn--ink" href="/portfolio/">See all work</a>
    </PageHero>

    <Section n={1} term="Telemetry" note="Since 2022" title="The studio at a glance">
      <ResultGrid stats={topStats} />
    </Section>

    <Section n={2} term="Telemetry" note={`${countWord(clientResults.length)[0].toUpperCase()}${countWord(clientResults.length).slice(1)} client projects · ${countWord(clientResults.length)} outcomes`} title="One headline result per client project">
      <ol class="rs">
        {clientResults.map((r, i) => (
          <li>
            <a href={`/projects/${r.slug}/`} class="rs-row">
              <div class="rs-top"><span class="rs-pos">P{String(i + 1).padStart(2, "0")}</span><span>{r.cat}</span></div>
              <div class="rs-v"><span class="rs-num">{r.v}</span><span class="rs-l">{r.l}</span></div>
              <div class="rs-copy">
                <h3 class="h-step">{r.name}</h3>
                <p>{r.o}</p>
                <span class="rs-more">Read the case study →</span>
              </div>
            </a>
          </li>
        ))}
      </ol>
      <h3 class="rs-ph">Personal projects — my own brands and product, not client work</h3>
      <ol class="rs">
        {personalResults.map((r, i) => (
          <li>
            <a href={`/projects/${r.slug}/`} class="rs-row">
              <div class="rs-top"><span class="rs-pos">P{String(clientResults.length + i + 1).padStart(2, "0")}</span><span>{r.cat}</span></div>
              <div class="rs-v"><span class="rs-num">{r.v}</span><span class="rs-l">{r.l}</span></div>
              <div class="rs-copy">
                <h3 class="h-step">{r.name}</h3>
                <p>{r.o}</p>
                <span class="rs-more">Read the case study →</span>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </Section>

    <Section n={3} term="Team radio" note="Clients" title="In their words">
      <div class="rq">
        <Quote text="The website is so beautiful — it looks 10 times more premium than our competitors. We started getting direct bookings instead of losing them to Google Maps." by="Founder, Nandini Travels" red />
      </div>
      <div class="links-row gap-top">
        <a href="/testimonials/">More testimonials →</a>
        <a href={GOOGLE_REVIEWS_URL} rel="noopener">Google reviews <span aria-hidden="true">↗</span></a>
      </div>
    </Section>

    <EndCta
      title="Want results like these?"
      text="Send me what you're building. If I'd win on it, I'll tell you which page I'd build first and what I'd cut. If I wouldn't, I'll tell you that too."
      primary={{ href: CALENDLY_URL, label: "Book an intro call →" }}
      secondary={{ href: "/website-audit/", label: "Get a free audit →" }}
    />
  </main>
</Base>

<style>
  .rs-ph{margin:clamp(48px,6vw,80px) 0 16px;font-family:var(--mono);font-size:13px;letter-spacing:.08em;text-transform:uppercase}
  .rs{list-style:none;margin:0;padding:0;border-top:3px solid var(--ink)}
  .rs li{border-bottom:1px solid var(--gda)}
  .rs-row{display:flex;flex-wrap:wrap;gap:14px clamp(24px,4vw,64px);padding:clamp(22px,2.6vw,36px) 0;color:var(--ink);text-decoration:none}
  .rs-row:hover{color:var(--ink)}
  .rs-row:hover .rs-more{color:var(--ink)}
  .rs-top{flex:0 0 180px;display:flex;flex-direction:column;gap:6px;font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--g5c)}
  .rs-pos{color:var(--red);font-weight:700}
  .rs-v{flex:1 1 280px;display:flex;flex-direction:column;gap:10px}
  .rs-num{font-weight:900;font-style:italic;font-stretch:125%;line-height:.9;letter-spacing:-0.03em;font-size:clamp(44px,5vw,84px);color:var(--red);overflow-wrap:anywhere}
  .rs-l{font-size:16px;line-height:1.4}
  .rs-copy{flex:1 1 380px;display:flex;flex-direction:column;gap:10px}
  .rs-copy p{margin:0;font-size:16px;line-height:1.55;color:var(--g3e);max-width:56ch}
  .rs-more{font-family:var(--mono);font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--red)}
  .rq{max-width:760px}
</style>
