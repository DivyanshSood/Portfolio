---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { CALENDLY_URL, GOOGLE_REVIEWS_URL } from "../lib/site.mjs";

const SITE = "https://www.divyanshsood.com";
const canonical = `${SITE}/results`;

// Top-line studio numbers (same real figures shown on the homepage).
const topStats = [
  { v: "20+", l: "Projects shipped since 2022" },
  { v: "3–4 wks", l: "Typical time to live" },
  { v: "98%", l: "Client retention" },
  { v: "Async", l: "Across 4 time zones" },
];

// One headline result per project — every number is pulled from a real case study.
const results = [
  { slug: "webseek", name: "WebSeek.ai", cat: "AI product", v: "3", l: "AI models in one app", o: "I built it for myself first, then opened it up. Three models, one prompt bar, one deployed site." },
  { slug: "inhimalayas", name: "InHimalayas", cat: "Booking platform", v: "↑", l: "AI-referred traffic", o: "llms.txt + GEO for a Himachal travel platform. AI engines started quoting them within weeks." },
  { slug: "modernkbs", name: "Modern K.B.S.", cat: "Web app + admin", v: "7 days", l: "vs. 6 months quoted", o: "Admissions portal for a school cycle. Public site + admin panel the office staff actually run." },
  { slug: "northpeak", name: "North Peak Power", cat: "Infra portal", v: "15", l: "pages + self-serve admin", o: "15 pages, self-serve admin. The marketing team uses it without needing me." },
  { slug: "chinkiz", name: "ChinkiZ Knitting Knife", cat: "Creator D2C", v: "600K+", l: "subscriber creator", o: "600K-subscriber creator who'd already tried Shopify and Webflow. Custom storefront, video next to buy." },
  { slug: "nandini", name: "Nandini Travels", cat: "Local travel", v: "10×", l: "“more premium” — founder", o: "Was losing every booking to Google Maps. Now they run through a site the owner controls." },
  { slug: "dharamshala-tours", name: "Dharamshala Tours", cat: "Travel CMS", v: "~1,000", l: "bookings a month", o: "WhatsApp-first travel site. The booking flow ends in a chat. ~1,000 packages a month." },
  { slug: "redline", name: "Redline Studios", cat: "Brand + store", v: "1", l: "sprint, end-to-end", o: "Brand + store + payments in one sprint. No phases, no deck, no \"discovery week.\"" },
  { slug: "cultxberserk", name: "CultXberserk", cat: "Lore-driven D2C", v: "0001–0666", l: "hand-numbered units", o: "Lore-driven D2C. The drop mechanics, the story, the buy button are one screen." },
];

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#page`,
      url: canonical,
      name: "Results — Divyansh Sood® Studio",
      description: "Real, measurable outcomes from custom-coded websites, stores and web apps built by Divyansh Sood for clients worldwide.",
      isPartOf: { "@id": `${SITE}/#website` },
      about: { "@id": `${SITE}/#studio` },
    },
    {
      "@type": "ItemList",
      itemListElement: results.map((r, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${SITE}/projects/${r.slug}`,
        name: `${r.name} — ${r.l}`,
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Results", item: canonical },
      ],
    },
  ],
});
---

<Layout
  title="Results — measurable outcomes · Divyansh Sood® Studio"
  description="Real results from custom-coded websites, stores and web apps — from a school site live in 7 days to ~1,000 bookings a month and a 600K-subscriber storefront. Built by Divyansh Sood for clients worldwide."
  canonical={canonical}
  keywords="web design results, website case study results, conversion results, web developer portfolio outcomes, Divyansh Sood results"
  ogTitle="Results — what the work actually did"
  ogDescription="From a school site live in 7 days to ~1,000 bookings a month — measurable outcomes from real projects."
  jsonld={jsonld}
>
  <Nav kicker="Results" />

  <main>
    <header class="cs-hero">
      <div class="cs-hero-bg" aria-hidden="true"></div>
      <div class="wrap">
        <div class="cs-eyebrow">
          <span>Results</span><span>Real numbers, real projects</span><span>2022—2026</span>
        </div>
        <h1 style="margin:14px 0 0;font-weight:900;font-size:clamp(38px,7vw,96px);line-height:.9;letter-spacing:-.035em;text-transform:uppercase;">The work, <span style="color:var(--accent);">by the numbers.</span></h1>
        <p class="cs-lead">Pretty sites are easy to promise. Here's what mine actually did — every figure below is pulled straight from a real case study you can open and read.</p>
        <div class="cs-cta-row">
          <a class="btn btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener" data-cursor>Book an intro call <span aria-hidden="true">↗</span></a>
          <a class="btn btn-ghost" href="/#work" data-cursor>See all work</a>
        </div>
      </div>
    </header>

    <section class="cs-sec" aria-labelledby="top-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="top-h">The studio at a glance</h2>
          <span class="mono">Since 2022</span>
        </div>
        <div class="cs-metrics" data-reveal>
          {topStats.map((s) => (
            <div class="cs-metric"><span class="cs-metric-v">{s.v}</span><span class="cs-metric-l">{s.l}</span></div>
          ))}
        </div>
      </div>
    </section>

    <section class="cs-sec" aria-labelledby="proj-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="proj-h">One headline result per project</h2>
          <span class="mono">Nine projects</span>
        </div>
        <div class="cs-body" data-reveal>
          {results.map((r) => (
            <a class="cs-card" href={`/projects/${r.slug}`} data-cursor style="text-decoration:none;color:inherit;display:flex;flex-direction:column;">
              <span class="cs-tag">{r.cat}</span>
              <div style="font-weight:900;font-size:clamp(34px,4.6vw,56px);letter-spacing:-.03em;line-height:1;color:var(--accent);margin:6px 0 4px;">{r.v}</div>
              <div style="font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.08em;text-transform:uppercase;opacity:.6;margin-bottom:14px;">{r.l}</div>
              <h2 style="margin:0 0 10px;font-weight:800;font-size:clamp(19px,2.2vw,24px);letter-spacing:-.02em;">{r.name}</h2>
              <p style="margin:0;font-size:14px;line-height:1.55;opacity:.72;flex:1;">{r.o}</p>
              <span style="margin-top:16px;font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);">Read the case study →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="cs-sec" aria-labelledby="say-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="say-h">In their words</h2>
          <span class="mono">Clients</span>
        </div>
        <figure class="cs-card cs-quote span2" data-reveal>
          <span class="cs-tag">Nandini Travels</span>
          <blockquote>"The website is so beautiful — looks 10 times more premium than our competitors. We started getting direct bookings instead of losing them to Google Maps."</blockquote>
          <figcaption>— Founder, Nandini Travels · <a href="/testimonials" data-cursor>read more →</a> · <a href={GOOGLE_REVIEWS_URL} target="_blank" rel="noopener" data-cursor>Google reviews ↗</a></figcaption>
        </figure>
      </div>
    </section>

    <section class="cs-endcta">
      <div class="wrap">
        <h2>Want results like these?</h2>
        <p>Send me what you're building. If I'd win on it, I'll tell you which page I'd build first and what I'd cut.</p>
        <div class="cs-cta-row" style="justify-content:center;">
          <a class="btn btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener" data-cursor>Book an intro call <span aria-hidden="true">↗</span></a>
          <a class="btn btn-ghost" href="/website-audit" data-cursor>Get a free audit</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
