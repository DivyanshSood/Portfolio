---
import Base from "../layouts/Base.astro";
import PageHero from "../components/brand/PageHero.astro";
import Section from "../components/brand/Section.astro";
import Rows from "../components/brand/Rows.astro";
import Cards from "../components/brand/Cards.astro";
import ResultGrid from "../components/brand/ResultGrid.astro";
import Faq from "../components/brand/Faq.astro";
import EndCta from "../components/brand/EndCta.astro";
import { SITE, CALENDLY_URL, GOOGLE_MAPS_URL, STARTING_PRICES as P, inr } from "../lib/site.mjs";
import { TOPICS } from "../lib/entity.mjs";

const canonical = `${SITE}/web-developer-manali/`;
const WA = "https://wa.me/919816091875?text=Hi%20Divyansh,%20I%20run%20a%20business%20in%20Manali%20and%20need%20a%20website.";

const offers = [
  { t: "Direct-booking hotel sites", d: "Manali's stays pay aggregators a commission on almost every room night. A direct-booking website — rates, photos, WhatsApp enquiry, instant confirmation — keeps that margin yours." },
  { t: "Adventure & activity operators", d: "Paragliding, rafting, trekking, skiing — booking-first sites for operators whose customers plan on their phones, days before they arrive in the valley." },
  { t: "Cafés, camps & experiences", d: "Old Manali's cafés and riverside camps live on search and word of mouth. A fast site that ranks — and looks like the place feels — converts both." },
  { t: "Seasonal SEO that compounds", d: "Manali's demand is a calendar: snow queries in December, honeymoon queries in spring, adventure queries all summer. I structure sites to catch each wave, year after year." },
];

const faqs = [
  { q: "Why do Manali hotels need their own website when MakeMyTrip exists?", a: "Because aggregators charge commission on every booking and own the guest relationship. A direct-booking site pays for itself the moment a fraction of your bookings shift direct — and the guest data, reviews and repeat bookings stay yours. I've written up the exact math for Himalayan stays." },
  { q: "What does a website cost for a Manali business?", a: `A hotel, camp or operator's site starts at ${inr(P.hotel)}, and a simple business site at ${inr(P.basic)}. A camp's one-pager, an operator's booking site and a hotel's full direct-booking build are different scopes, so I quote fixed, in writing, after one WhatsApp conversation — and I'll say up front if the smallest version is the right one to start with.` },
  { q: "Our guests find us on Instagram. Isn't that enough?", a: "Instagram is where guests discover you; Google is where they verify and book you. 'Best paragliding in Manali' and 'riverside camp Manali price' are searches Instagram can't rank for. The businesses that capture those queries own the season." },
  { q: "Do you understand the tourism business here?", a: "It's my home market. I'm based in Himachal, I built the site that handles part of ~1,000 monthly bookings for a Dharamshala operator, and I rebuilt Kangra's most-reviewed taxi operator so enquiries land on a site they own instead of a Google Maps listing. The seasonality, the WhatsApp-first customer, the mountain-network phones — all of it is designed in." },
];

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `${canonical}#service`,
      name: "Web design and development in Manali",
      serviceType: "Website design and development",
      provider: { "@id": `${SITE}/#studio` },
      areaServed: { "@type": "City", name: "Manali", containedInPlace: { "@type": "State", name: "Himachal Pradesh" } },
      description:
        "Web developer for Manali businesses — direct-booking hotel websites, adventure operator booking sites, café and camp websites. Himachal-based, seasonal SEO built in, live in 1–3 weeks.",
      url: canonical,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Services", item: `${SITE}/services/` },
        { "@type": "ListItem", position: 3, name: "Web developer in Manali", item: canonical },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
});
---

<Base
  title="Web Developer in Manali — Direct-Booking Websites for Stays"
  description="Web developer in Manali, Himachal — direct-booking websites for hotels, camps and adventure operators. Stop paying aggregator commission; live in 1–3 weeks."
  canonical={canonical}
  keywords="web developer Manali, website design Manali, hotel website design Manali, direct booking website Manali, adventure tour website developer, camp website Himachal"
  ogTitle="Web developer in Manali"
  ogDescription="Direct-booking websites for Manali's hotels, camps and adventure operators — keep the commission aggregators take."
  topics={[TOPICS.webDevelopment, TOPICS.himachal, TOPICS.tourism, TOPICS.hotel]}
  jsonld={jsonld}
>
  <main>
    <PageHero
      display="Web developer in Manali."
      size="case"
      kicker="Himachal Pradesh · Manali · Kullu valley · 2026"
      lead={`Every season, Manali's hotels, camps and adventure operators hand aggregators a commission on bookings that started as a Google search. I build direct-booking websites that capture those searches yourself — custom-coded, WhatsApp-first, built by a Himachal developer who works this market from the inside.`}
    >
      <a class="btn btn--red" href={CALENDLY_URL}>Book a call <span aria-hidden="true">→</span></a>
      <a class="btn btn--ink" href={WA}>Message on WhatsApp</a>
      <Fragment slot="notes"><span>Himachal-based · <a href={GOOGLE_MAPS_URL} target="_blank" rel="noopener">on Google Maps ↗</a></span><span>Live in 1–3 weeks</span></Fragment>
    </PageHero>

    <Section n={1} term="Setup" note="The offering" title="Built for the valley's business">
      <Rows items={offers} />
    </Section>

    <Section n={2} term="Telemetry" note="Proof, not promises" title="Mountain tourism, on the record">
      <ResultGrid stats={[
        { v: `~1,000`, l: `Monthly bookings via one Himachal travel site` },
        { v: `0%`, l: `Commission on direct bookings` },
        { v: `1-tap`, l: `WhatsApp booking on every package` },
        { v: `llms.txt`, l: `AI-search files on every build` },
      ]} />
      <div class="gap-top">
        <Cards items={[
          { tag: `Dharamshala Tours · operator`, d: `A WhatsApp-first booking site with a self-serve package editor — part of ~1,000 travel packages booked through it every month. The same build works for Kullu–Manali operators. <a href="/projects/dharamshala-tours/">Read the case study →</a>` },
          { tag: `Nandini Travels · Kangra`, d: `Kangra's most-reviewed taxi operator was losing every enquiry to a Google Maps listing. Now the bookings land on a site he owns. <a href="/projects/nandini/">Read the case study →</a>` },
          { tag: `Sunny Himachal Travels · Dharamshala`, d: `A tour and taxi operator with a page for every trip, transfer and town it serves, plus 1.1 KB of JavaScript and Lighthouse 100 across all four desktop scores. <a href="/projects/sunny-himachal-travels/">Read the case study →</a>` },
          { tag: `Yash Rock Hotel · Dehrian, Kangra`, d: `Seven rooms, a pool, and no booking engine: every enquiry goes to WhatsApp or a call, and 14 “near” pages reach guests heading for NIFT, Tanda Medical College and the airport. <a href="/projects/yash-rock-hotel/">Read the case study →</a>` },
          { tag: `By industry`, wide: true, d: `What I build most in Himachal: <a href="/services/school-website-development/">school websites</a>, <a href="/services/hotel-website-development/">hotel and homestay websites</a>, and <a href="/services/travel-website-development/">travel and taxi websites</a>. In Manali, guests pick from the map before any website: <a href="/blog/rank-on-google-maps-himachal/">how to rank on Google Maps</a>.` },
          { tag: `The commission math`, wide: true, d: `What aggregator commission actually costs a Himalayan stay across a season — and what shifting even a fraction of bookings direct is worth. <a href="/blog/hotel-homestay-website-himachal-direct-bookings/">Read the breakdown →</a>` },
        ]} />
      </div>
    </Section>

    <Section bare>
      <Faq faqs={faqs} label="(03) Before you ask" />
    </Section>

    <EndCta
      title="Run a stay or operation in Manali?"
      text={`Message me your property or activity and how bookings come in today. I'll show you what a direct-booking site would change — with a fixed quote in writing.`}
      primary={{ href: WA, label: "Message on WhatsApp →" }}
      secondary={{ href: "/services/", label: "See all services →" }}
    />
  </main>
</Base>
