---
import Base from "../layouts/Base.astro";
import PageHero from "../components/brand/PageHero.astro";
import Section from "../components/brand/Section.astro";
import EndCta from "../components/brand/EndCta.astro";
import SpecList from "../components/brand/SpecList.astro";
import { SITE, FOUNDER_PHOTO, FOUNDER_PHOTO_ALT, SOCIAL_PROFILES } from "../lib/site.mjs";

const canonical = `${SITE}/press/`;

const bioShort =
  "Divyansh Sood is a freelance web designer & developer based in Himachal Pradesh, India, working with founders worldwide. Since 2022 he has shipped 20+ custom-coded websites, stores and web apps under Divyansh Sood® Studio — a one-person studio.";

const bioLong =
  "Divyansh Sood is a freelance web designer and developer based in Himachal Pradesh, India, working with clients worldwide as Divyansh Sood® Studio — a one-person practice. He designs and builds custom-coded, conversion-focused websites, e-commerce storefronts and web apps end to end: strategy, interface design and full-stack engineering under one roof, with no page-builder templates. Since 2022 he has shipped 20+ projects, including a school website and admissions portal delivered in 7 days, a storefront for a 600K-subscriber creator built without Shopify, and a travel booking site that handles roughly 1,000 bookings a month. He works in React, Next.js, Astro and Angular, and specialises in technical SEO and Generative Engine Optimization (GEO).";

const facts = [
  { k: "Name", v: "Divyansh Sood" },
  { k: "Title", v: "Freelance web designer & developer" },
  { k: "Studio", v: "Divyansh Sood® Studio (1 person)" },
  { k: "Based", v: "Himachal Pradesh, India — worldwide" },
  { k: "Since", v: "2022" },
  { k: "Stacks", v: "React · Next.js · Astro · Angular" },
  { k: "Focus", v: "Custom-coded, conversion-focused, SEO/GEO" },
  { k: "Email", v: "hello@divyanshsood.com" },
];

const creditPlain = `<a href="https://www.divyanshsood.com/" rel="nofollow" title="Website by Divyansh Sood">Site by Divyansh Sood</a>`;

const creditBadge = `<a href="https://www.divyanshsood.com/" rel="nofollow" title="Website by Divyansh Sood"
   style="display:inline-flex;align-items:center;gap:6px;font:500 12px/1 system-ui,sans-serif;color:#111;text-decoration:none;">
  <svg width="13" height="13" viewBox="0 0 24 24" fill="#111" aria-hidden="true"><path d="M12 0c1.05 6.9 5.1 10.95 12 12-6.9 1.05-10.95 5.1-12 12-1.05-6.9-5.1-10.95-12-12C6.9 10.95 10.95 6.9 12 0Z"/></svg>
  Site by Divyansh Sood
</a>`;

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "@id": `${canonical}#page`,
      name: "Press & brand kit — Divyansh Sood",
      url: canonical,
      description: "Press kit and brand facts for Divyansh Sood — bio, headshot, logo and citation details for journalists, directories and clients.",
      about: { "@id": `${SITE}/#person` },
      isPartOf: { "@id": `${SITE}/#website` },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Press", item: canonical },
      ],
    },
  ],
});
---

<Base
  title="Press & Brand Kit — Divyansh Sood"
  description="Press kit for Divyansh Sood, freelance web designer & developer: bio, headshot, logo, fast facts and a site-credit snippet for clients. Cite accurately."
  canonical={canonical}
  keywords="Divyansh Sood press kit, Divyansh Sood bio, brand kit, media kit, site credit, freelance web developer"
  ogTitle="Press & brand kit — Divyansh Sood"
  ogDescription="Bio, headshot, logo, fast facts and a site-credit snippet — everything to cite or credit Divyansh Sood correctly."
  jsonld={jsonld}
>
  <main>
    <PageHero
      display="Cite me correctly."
      size="case"
      kicker="Press & brand kit · For writers, directories & clients · 2026"
      lead="Everything you need to write about, list, or credit my work — a ready-to-paste bio, headshot, logo and the facts, plus a tidy site-credit snippet for clients. Grab what you need; no permission required for accurate use."
    />

    <Section n={1} term="Telemetry" note="At a glance" title="Fast facts">
      <div class="pk-facts"><SpecList items={facts} /></div>
    </Section>

    <Section n={2} term="Team radio" note="Copy & paste" title="Bio">
      <div class="pk-stack">
        <div class="pk-block">
          <div class="pk-bar"><span>Short — one line</span><button class="pk-copy" type="button" data-copy="pk-short">Copy</button></div>
          <p class="pk-body" id="pk-short">{bioShort}</p>
        </div>
        <div class="pk-block">
          <div class="pk-bar"><span>Long — profile</span><button class="pk-copy" type="button" data-copy="pk-long">Copy</button></div>
          <p class="pk-body" id="pk-long">{bioLong}</p>
        </div>
      </div>
    </Section>

    {/* Official profiles — rendered from SOCIAL_PROFILES so they can never
        disagree with the schema `sameAs`. */}
    <Section n={3} term="Setup" note="Verified accounts" title="Official profiles">
      <p class="body pk-note">These are the only accounts run by Divyansh Sood. Anything else using the name isn't him.</p>
      <ul class="pk-prof">
        {SOCIAL_PROFILES.map((p) => (
          <li>
            <a href={p.url} rel="me noopener">
              <span class="pk-prof-n">{p.name}</span>
              <span class="pk-prof-u">{p.url.replace(/^https:\/\/(www\.)?/, "")}</span>
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </Section>

    <Section n={4} term="Setup" note="Headshot & logo" title="Assets">
      <div class="pk-assets">
        <figure class="pk-asset">
          <span class="pk-tag">01 · Headshot</span>
          <div class="pk-img"><img src={FOUNDER_PHOTO} alt={FOUNDER_PHOTO_ALT} width="480" height="480" loading="lazy" /></div>
          <a class="btn btn--ink" href={FOUNDER_PHOTO} download>Download portrait</a>
        </figure>
        <figure class="pk-asset">
          <span class="pk-tag">02 · Logo mark</span>
          <div class="pk-img pk-img--logo"><img src="/icon.svg" alt="Divyansh Sood® Studio logo mark" width="160" height="160" loading="lazy" /></div>
          <a class="btn btn--ink" href="/icon.svg" download>Download logo (SVG)</a>
        </figure>
      </div>
    </Section>

    <Section n={5} term="Chequered flag" note="Paste in your footer" title="Site credit — for clients">
      <p class="body pk-note">Built you a site? Thank you — a small credit in your footer is genuinely appreciated and helps people find me. Use the branded snippet below (kept intentionally simple and un-spammy). Paste it wherever your footer lives.</p>
      <div class="pk-stack">
        <div class="pk-block">
          <div class="pk-bar"><span>Text link</span><button class="pk-copy" type="button" data-copy="pk-credit1">Copy</button></div>
          <pre class="pk-pre" id="pk-credit1">{creditPlain}</pre>
        </div>
        <div class="pk-block">
          <div class="pk-bar"><span>With star mark</span><button class="pk-copy" type="button" data-copy="pk-credit2">Copy</button></div>
          <pre class="pk-pre" id="pk-credit2">{creditBadge}</pre>
        </div>
      </div>
      <p class="meta pk-fine">The link uses a plain branded label and rel="nofollow" — the honest, search-safe form for a site credit. If you'd rather link to your own project write-up instead of my homepage, swap the URL for its case-study page; either is welcome.</p>
    </Section>

    <EndCta
      title="Writing about the work?"
      text="Happy to help with quotes, extra detail or higher-res assets. Reach out any time."
      primary={{ href: "mailto:hello@divyanshsood.com", label: "Email me →" }}
      secondary={{ href: "/about/", label: "More about me →" }}
    />
  </main>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const el = document.getElementById(btn.dataset.copy || "");
      if (!el) return;
      const text = el.textContent || "";
      const done = () => {
        btn.textContent = "Copied ✓";
        setTimeout(() => { btn.textContent = "Copy"; }, 1600);
      };
      if (navigator.clipboard?.writeText) navigator.clipboard.writeText(text).then(done, done);
      else {
        const ta = document.createElement("textarea");
        ta.value = text; ta.style.position = "fixed"; ta.style.left = "-9999px";
        document.body.appendChild(ta); ta.select();
        try { document.execCommand("copy"); } catch (_e) {}
        ta.remove(); done();
      }
    });
  });
</script>

<style>
  .pk-facts{max-width:900px}
  .pk-stack{display:flex;flex-direction:column;gap:clamp(16px,2vw,28px);max-width:980px}
  .pk-block{border:1px solid var(--gda)}
  .pk-bar{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 16px;border-bottom:1px solid var(--gda);font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--g5c)}
  .pk-copy{background:var(--ink);color:#fff;border:0;min-height:36px;padding:0 18px;font-family:var(--display);font-weight:800;font-stretch:112%;font-size:12px;letter-spacing:.04em;text-transform:uppercase;cursor:pointer;clip-path:polygon(6px 0,100% 0,calc(100% - 6px) 100%,0 100%)}
  .pk-copy:hover{background:var(--red)}
  .pk-body{margin:0;padding:18px 16px;font-size:17px;line-height:1.6;color:var(--g3e)}
  .pk-pre{margin:0;padding:18px 16px;overflow-x:auto;font-family:var(--mono);font-size:13px;line-height:1.6;color:var(--ink);white-space:pre-wrap;word-break:break-all}
  .pk-note{margin:0 0 28px;max-width:60ch}
  .pk-fine{margin:22px 0 0;max-width:90ch;line-height:1.6;text-transform:none;letter-spacing:.02em}
  .pk-prof{list-style:none;margin:0;padding:0;border-top:3px solid var(--ink);max-width:980px}
  .pk-prof a{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 24px;padding:18px 0;border-bottom:1px solid var(--gda);color:var(--ink);text-decoration:none}
  .pk-prof a:hover{color:var(--red)}
  .pk-prof-n{flex:0 0 160px;font-weight:750;font-stretch:106%;font-size:clamp(19px,1.9vw,24px)}
  .pk-prof-u{flex:1 1 240px;font-family:var(--mono);font-size:12px;letter-spacing:.06em;color:var(--g5c);overflow-wrap:anywhere}
  .pk-assets{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));gap:clamp(16px,2vw,28px);max-width:980px}
  .pk-asset{margin:0;border:1px solid var(--gda);padding:clamp(20px,2.4vw,28px);display:flex;flex-direction:column;gap:16px;align-items:flex-start}
  .pk-tag{font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--g5c)}
  .pk-img{width:100%;aspect-ratio:1;background:var(--tint);overflow:hidden;display:flex;align-items:center;justify-content:center}
  .pk-img img{width:100%;height:100%;object-fit:cover;display:block}
  .pk-img--logo img{width:40%;height:auto}
</style>
