---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import DepthGallery from "../components/DepthGallery.astro";
import { CALENDLY_URL, PROJECT_MIN_USD } from "../lib/site.mjs";
import { projects } from "../lib/projects/data.mjs";

const SITE = "https://www.divyanshsood.com";
const canonical = `${SITE}/portfolio/`;

// Every shipped project, ordered by its case-study number.
const work = [...projects].sort((a, b) => Number(a.num) - Number(b.num));

// Real studio numbers — same figures used on /results and the homepage.
const stats = [
  { v: "20+", l: "Projects shipped since 2022" },
  { v: "9/9", l: "Recent clients still on board" },
  { v: "<1.5s", l: "Typical LCP on shipped sites" },
  { v: "3–4 wks", l: "Kickoff to live" },
];

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#page`,
      url: canonical,
      name: "Portfolio — Divyansh Sood® Studio",
      description:
        "Selected work from Divyansh Sood — custom-coded websites, stores, web apps and AI products shipped for founders worldwide.",
      isPartOf: { "@id": `${SITE}/#website` },
      about: { "@id": `${SITE}/#studio` },
    },
    {
      "@type": "ItemList",
      itemListElement: work.map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${SITE}/projects/${p.slug}`,
        name: `${p.name} — ${p.category}`,
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Portfolio", item: canonical },
      ],
    },
  ],
});
---

<Layout
  title="Web Design & Development Portfolio — Divyansh Sood® Studio"
  description="The portfolio of web developer Divyansh Sood — nine custom-coded websites, e-commerce stores, web apps and AI products, each with a case study and live link."
  canonical={canonical}
  keywords="Divyansh Sood portfolio, web developer portfolio, custom website portfolio, Next.js Astro projects, web app case studies, freelance web developer work"
  ogTitle="Portfolio — the work, up close"
  ogDescription="Custom-coded websites, stores, web apps and AI products, shipped for real clients worldwide."
  jsonld={jsonld}
>
  <Nav />

  <main>
    <header class="cs-hero">
      <div class="cs-hero-bg" aria-hidden="true"></div>
      <div class="wrap">
        <div class="cs-eyebrow">
          <span>Portfolio</span><span>Custom-coded · shipped</span><span>2022—2026</span>
        </div>
        <h1 style="margin:14px 0 0;font-weight:900;font-size:clamp(38px,7vw,96px);line-height:.9;letter-spacing:-.035em;text-transform:uppercase;">Selected <span style="color:var(--accent);">work.</span></h1>
        <p class="cs-lead">Nine projects, every one custom-coded — no page-builders, no theme marketplaces. Marketing websites, e-commerce storefronts, web apps and my own AI product. Open a case study, or visit it live.</p>
        <div class="cs-cta-row">
          <a class="btn btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Book an intro call <span aria-hidden="true">↗</span></a>
          <a class="btn btn-ghost" href="/portfolio.pdf" target="_blank" rel="noopener">Download one-pager PDF ↗</a>
        </div>
      </div>
    </header>

    <DepthGallery />

    <section class="cs-sec" aria-labelledby="stats-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="stats-h">The studio at a glance</h2>
          <span class="mono">Since 2022</span>
        </div>
        <div class="cs-metrics" data-reveal>
          {stats.map((s) => (
            <div class="cs-metric"><span class="cs-metric-v">{s.v}</span><span class="cs-metric-l">{s.l}</span></div>
          ))}
        </div>
      </div>
    </section>

    <section class="cs-endcta">
      <div class="wrap">
        <h2>Yours could be number ten.</h2>
        <p>Custom-coded, most projects live in 3–4 weeks, from {PROJECT_MIN_USD}. Tell me what you're building and I'll tell you within a day if it's a fit.</p>
        <div class="cs-cta-row" style="justify-content:center;">
          <a class="btn btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Book an intro call <span aria-hidden="true">↗</span></a>
          <a class="btn btn-ghost" href="/results/">See the results</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    /* ============================================================
       Portfolio — browsable project listing. Editorial black + red,
       image-forward cards. Matches the About / Results treatment.
       ============================================================ */
    main .cs-sec { padding: clamp(58px, 7vw, 108px) 0; }
    main .cs-hero { padding-top: clamp(120px, 16vw, 160px); }
    main .cs-lead { max-width: 66ch; font-size: clamp(17px, 1.7vw, 21px); }
    main .cs-sec-head { align-items: flex-end; margin-bottom: clamp(30px, 4vw, 52px); }
    main .cs-sec-head h2 {
      font-weight: 900;
      font-size: clamp(30px, 4.8vw, 68px);
      line-height: 0.96;
      letter-spacing: -0.035em;
      text-transform: uppercase;
    }
    main .cs-sec-head .mono { opacity: 0.5; }

    /* Studio stats → borderless giant figures + hairlines. */
    main .cs-metrics { gap: 0; border-top: 1px solid rgba(255, 255, 255, 0.16); }
    main .cs-metric {
      border: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 0;
      background: none;
      padding: clamp(22px, 3vw, 34px) 22px clamp(22px, 3vw, 34px) 0;
    }
    main .cs-metric-v { font-size: clamp(38px, 5.5vw, 78px); line-height: 0.88; }
    main .cs-metric-l { margin-top: 12px; }
    @media (min-width: 721px) {
      main .cs-metric { border-right: 1px solid rgba(255, 255, 255, 0.1); padding-left: clamp(20px, 2.4vw, 34px); }
      main .cs-metric:first-child { padding-left: 0; }
      main .cs-metric:last-child { border-right: 0; }
    }

    /* Curves everywhere on this page — sharp edges are banned. Buttons match
       the nav/Book-a-call pills. */
    main .btn { border-radius: 999px; }

    /* ~90% of visitors are on phones — the mobile layout is the primary one.
       Full-width tappable CTAs, two-up stats that don't cramp, single-column
       image cards with comfortable padding. */
    @media (max-width: 720px) {
      main .cs-metrics { grid-template-columns: 1fr 1fr; }
      main .cs-metric { padding: 20px 14px 20px 0; }
      main .cs-metric:nth-child(odd) { border-right: 1px solid rgba(255, 255, 255, 0.1); }
      main .cs-metric:nth-child(even) { padding-left: 16px; }
      main .cs-metric-v { font-size: clamp(30px, 9vw, 40px); }
      main .cs-metric-l { font-size: 10.5px; }
      main .cs-cta-row { flex-direction: column; align-items: stretch; }
      main .cs-cta-row .btn { justify-content: center; padding: 16px 22px; }
      main .cs-sec { padding: 52px 0; }
      main .cs-endcta .cs-cta-row { align-items: stretch; }
    }
  </style>
</Layout>
