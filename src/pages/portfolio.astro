---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { CALENDLY_URL, PROJECT_MIN_USD } from "../lib/site.mjs";
import { projects } from "../lib/projects/data.mjs";

const SITE = "https://www.divyanshsood.com";
const canonical = `${SITE}/portfolio/`;

// Every shipped project, ordered by its case-study number.
const work = [...projects].sort((a, b) => Number(a.num) - Number(b.num));

// Real studio numbers — same figures used on /results and the homepage.
const stats = [
  { v: "20+", l: "Projects shipped since 2022" },
  { v: "9/9", l: "Recent clients still on board" },
  { v: "<1.5s", l: "Typical LCP on shipped sites" },
  { v: "3–4 wks", l: "Kickoff to live" },
];

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#page`,
      url: canonical,
      name: "Portfolio — Divyansh Sood® Studio",
      description:
        "Selected work from Divyansh Sood — custom-coded websites, stores, web apps and AI products shipped for founders worldwide.",
      isPartOf: { "@id": `${SITE}/#website` },
      about: { "@id": `${SITE}/#studio` },
    },
    {
      "@type": "ItemList",
      itemListElement: work.map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${SITE}/projects/${p.slug}`,
        name: `${p.name} — ${p.category}`,
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Portfolio", item: canonical },
      ],
    },
  ],
});
---

<Layout
  title="Portfolio — selected work · Divyansh Sood® Studio"
  description="Selected work from Divyansh Sood — custom-coded websites, stores, web apps and AI products. From a school portal live in 7 days to a 600K-subscriber storefront. Built for founders worldwide."
  canonical={canonical}
  keywords="Divyansh Sood portfolio, web developer portfolio, custom website portfolio, Next.js Astro projects, web app case studies, freelance web developer work"
  ogTitle="Portfolio — the work, up close"
  ogDescription="Custom-coded websites, stores, web apps and AI products, shipped for real clients worldwide."
  jsonld={jsonld}
>
  <Nav kicker="Portfolio" />

  <main>
    <header class="cs-hero">
      <div class="cs-hero-bg" aria-hidden="true"></div>
      <div class="wrap">
        <div class="cs-eyebrow">
          <span>Portfolio</span><span>Custom-coded · shipped</span><span>2022—2026</span>
        </div>
        <h1 style="margin:14px 0 0;font-weight:900;font-size:clamp(38px,7vw,96px);line-height:.9;letter-spacing:-.035em;text-transform:uppercase;">Selected <span style="color:var(--accent);">work.</span></h1>
        <p class="cs-lead">Nine projects, every one custom-coded — no page-builders, no theme marketplaces. Marketing sites, storefronts, web apps and my own AI product. Open any one to read the full case study, or visit it live.</p>
        <div class="cs-cta-row">
          <a class="btn btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Book an intro call <span aria-hidden="true">↗</span></a>
          <a class="btn btn-ghost" href="/portfolio.pdf" target="_blank" rel="noopener">Download one-pager PDF ↗</a>
        </div>
      </div>
    </header>

    <section class="cs-sec" aria-labelledby="stats-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="stats-h">The studio at a glance</h2>
          <span class="mono">Since 2022</span>
        </div>
        <div class="cs-metrics" data-reveal>
          {stats.map((s) => (
            <div class="cs-metric"><span class="cs-metric-v">{s.v}</span><span class="cs-metric-l">{s.l}</span></div>
          ))}
        </div>
      </div>
    </section>

    <section class="cs-sec" aria-labelledby="work-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="work-h">All nine projects</h2>
          <span class="mono">Newest number last</span>
        </div>

        <div class="pf-grid" data-reveal>
          {work.map((p) => (
            <article class="pf-card">
              <div class="pf-body">
                <div class="pf-meta">
                  <span class="cs-tag">{p.category}</span>
                  <span class="pf-year mono">{p.num} · {p.year}</span>
                </div>
                <h3 class="pf-name">{p.name}</h3>
                <p class="pf-outcome">{p.outcome}</p>
                <div class="pf-metric">
                  <span class="pf-metric-v">{p.metrics[0].v}</span>
                  <span class="pf-metric-l">{p.metrics[0].l}</span>
                </div>
                <p class="pf-stack mono">{p.stackLine}</p>
                <div class="pf-links">
                  <a href={`/projects/${p.slug}`} class="pf-link pf-link--accent pf-stretch">Read the case study →</a>
                  {p.liveUrl && (
                    <a href={p.liveUrl} target="_blank" rel="noopener" class="pf-link pf-link--live">Visit live ↗</a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="cs-endcta">
      <div class="wrap">
        <h2>Yours could be number ten.</h2>
        <p>Custom-coded, most projects live in 3–4 weeks, from {PROJECT_MIN_USD}. Tell me what you're building and I'll tell you within a day if it's a fit.</p>
        <div class="cs-cta-row" style="justify-content:center;">
          <a class="btn btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Book an intro call <span aria-hidden="true">↗</span></a>
          <a class="btn btn-ghost" href="/results">See the results</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    /* ============================================================
       Portfolio — browsable project listing. Editorial black + red,
       image-forward cards. Matches the About / Results treatment.
       ============================================================ */
    main .cs-sec { padding: clamp(58px, 7vw, 108px) 0; }
    main .cs-hero { padding-top: clamp(120px, 16vw, 160px); }
    main .cs-lead { max-width: 66ch; font-size: clamp(17px, 1.7vw, 21px); }
    main .cs-sec-head { align-items: flex-end; margin-bottom: clamp(30px, 4vw, 52px); }
    main .cs-sec-head h2 {
      font-weight: 900;
      font-size: clamp(30px, 4.8vw, 68px);
      line-height: 0.96;
      letter-spacing: -0.035em;
      text-transform: uppercase;
    }
    main .cs-sec-head .mono { opacity: 0.5; }

    /* Studio stats → borderless giant figures + hairlines. */
    main .cs-metrics { gap: 0; border-top: 1px solid rgba(255, 255, 255, 0.16); }
    main .cs-metric {
      border: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 0;
      background: none;
      padding: clamp(22px, 3vw, 34px) 22px clamp(22px, 3vw, 34px) 0;
    }
    main .cs-metric-v { font-size: clamp(38px, 5.5vw, 78px); line-height: 0.88; }
    main .cs-metric-l { margin-top: 12px; }
    @media (min-width: 721px) {
      main .cs-metric { border-right: 1px solid rgba(255, 255, 255, 0.1); padding-left: clamp(20px, 2.4vw, 34px); }
      main .cs-metric:first-child { padding-left: 0; }
      main .cs-metric:last-child { border-right: 0; }
    }

    /* Project grid */
    main .pf-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: clamp(18px, 2.4vw, 30px);
    }
    main .pf-card {
      position: relative;
      display: flex;
      flex-direction: column;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 14px;
      overflow: hidden;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.03), transparent);
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
    }
    main .pf-card:hover { transform: translateY(-5px); border-color: rgba(255, 31, 31, 0.5); }
    /* Whole card links to the case study; the "Visit live" link stays clickable
       above the stretched overlay. */
    main .pf-stretch::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
    }
    main .pf-card:hover .pf-stretch { text-decoration: underline; }
    main .pf-link--live { position: relative; z-index: 2; }
    main .pf-body { display: flex; flex-direction: column; flex: 1; padding: clamp(24px, 2.6vw, 34px); }
    main .pf-meta { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 14px; }
    main .pf-meta .cs-tag { margin: 0; }
    main .pf-year { font-size: 11px; letter-spacing: 0.14em; opacity: 0.55; }
    main .pf-name {
      margin: 0 0 10px;
      font-weight: 900;
      font-size: clamp(22px, 2.4vw, 30px);
      letter-spacing: -0.03em;
      line-height: 1;
    }
    main .pf-outcome { margin: 0 0 20px; font-size: 14.5px; line-height: 1.55; opacity: 0.76; }
    main .pf-metric {
      display: flex;
      align-items: baseline;
      gap: 12px;
      padding: 14px 0;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      margin-top: auto;
    }
    main .pf-metric-v {
      font-weight: 900;
      font-size: clamp(26px, 3vw, 38px);
      letter-spacing: -0.03em;
      line-height: 1;
      color: var(--accent, #ff1f1f);
    }
    main .pf-metric-l {
      font-family: "Space Mono", monospace;
      font-size: 11px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      opacity: 0.6;
      line-height: 1.3;
    }
    main .pf-stack { font-size: 11px; letter-spacing: 0.04em; opacity: 0.5; margin: 0 0 18px; }
    main .pf-links { display: flex; gap: 20px; flex-wrap: wrap; }
    main .pf-link {
      font-family: "Space Mono", monospace;
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-decoration: none;
      color: rgba(255, 255, 255, 0.72);
    }
    main .pf-link:hover { color: #fff; }
    main .pf-link--accent { color: var(--accent, #ff1f1f); }
    main .pf-link--accent:hover { color: var(--accent, #ff1f1f); text-decoration: underline; }

    @media (max-width: 720px) {
      main .pf-grid { grid-template-columns: 1fr; }
      main .cs-metrics { grid-template-columns: 1fr 1fr; }
    }
  </style>
</Layout>
