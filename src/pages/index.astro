---
// Home — a port of Home.dc.html (Divyansh Sood® Studio brandbook). Section
// order and colours are locked by the brandbook: Hero (red) · Proof · About ·
// Work · Services (white) · Process (tint) · Team radio · Blogs · FAQ
// (white) · Contact (red) · Footer (ink). Motion lives in src/scripts/home.js.
import Base from "../layouts/Base.astro";
import Faq from "../components/brand/Faq.astro";
import { homeJsonLd, HOME_FAQ } from "../lib/home-schema.mjs";
import { SITE, CALENDLY_URL, GOOGLE_MAPS_URL } from "../lib/site.mjs";
import { projects } from "../lib/projects/data.mjs";
import { POSTS } from "../lib/blog.mjs";
import { localVariant, localSrcset } from "../lib/images.mjs";
import { TOPICS } from "../lib/entity.mjs";

// Title and description are the live, Search-Console-tuned strings (the
// September 2026 move to state-level geography) — the brandbook keeps SEO
// titles intact.
const META_TITLE = "Web Designer & Developer in Himachal Pradesh · Divyansh Sood"; // 60 chars
const META_DESCRIPTION =
  "Web designer & developer in Kangra, Himachal Pradesh. Custom-coded websites for schools, hotels, travel operators and brands across India. You own the code."; // 155

const jsonld = homeJsonLd(SITE);

// Proof — exactly six real, sourced tiles (brandbook C01 + "Proof = 6").
const PROOF = [
  { ch: "CH.01", tag: "SINCE 2022", v: "20", dec: 0, pre: "", suf: "+", sufSm: false, w: 82, l: "Projects shipped since 2022" },
  { ch: "CH.02", tag: "RETENTION", v: "9", dec: 0, pre: "", suf: "/9", sufSm: false, w: 100, l: "Recent clients still on board" },
  { ch: "CH.03", tag: "FASTEST LAP", v: "7", dec: 0, pre: "", suf: " DAYS", sufSm: true, w: 96, l: "Fastest full build — against a 6-month quote" },
  { ch: "CH.04", tag: "GRID POSITION", v: "5.7", dec: 1, pre: "P", suf: "", sufSm: true, w: 90, l: "Avg. Google position — Baglamukhi Travels" },
  { ch: "CH.05", tag: "LIGHTHOUSE", v: "100", dec: 0, pre: "", suf: " /100", sufSm: true, w: 100, l: "Every category — Sunny Himachal Travels" },
  { ch: "CH.06", tag: "PIT STOP", v: "2", dec: 0, pre: "", suf: " HRS", sufSm: true, w: 92, l: "Reply time to a new brief, 9 AM–9 PM IST" },
];

// Pit lane — the seven cards in the design, with the design's own copy.
const WORK = [
  { slug: "redline", tags: "Brand · E-commerce · 2025", alt: "Redline Studios motorcycle apparel storefront homepage", d: "A motorcycle-apparel brand born out of speed. Race-car geometry, racing-livery colours, custom Next.js + Razorpay." },
  { slug: "cultxberserk", tags: "Brand · D2C · 2026", alt: "CultXberserk apparel storefront", d: "Lore and buy flow as one experience — a hand-numbered drop system enforced in code. No Shopify theme." },
  { slug: "modernkbs", tags: "Web App · Admin · 2024", alt: "Modern K.B.S. school website and admissions portal", d: "School website, admissions portal and self-serve admin. Delivered in 7 days against a six-month quote." },
  { slug: "chinkiz", tags: "D2C · Creator · 2024", alt: "ChinkiZ Knitting Knife creator storefront", d: "A 600K-subscriber creator's store with the video right next to the buy button. Live in two weeks." },
  { slug: "baglamukhi-travels", tags: "Travel · Local SEO · 2026", alt: "Baglamukhi Travels Kangra taxi website", d: "Owner-drivers vs commission agents. Astro + a full schema graph — now averaging position 5.7 on Google." },
  { slug: "sunny-himachal-travels", tags: "Travel · Tours & Taxi · 2026", alt: "Sunny Himachal Travels Dharamshala tours website", d: "A page for every trip, transfer and town. 1.1 KB of JavaScript, Lighthouse 100 across the board." },
  { slug: "yash-rock-hotel", tags: "Hospitality · Hotel · 2026", alt: "Yash Rock Hotel Kangra website", d: "Seven rooms, no booking engine by design. Every enquiry to WhatsApp, and 14 “near” pages." },
].map((w, i) => {
  const p = projects.find((x) => x.slug === w.slug);
  if (!p) throw new Error(`Home work card: unknown project "${w.slug}"`);
  return { ...w, name: p.name, img: p.feature.src, pos: `P${String(i + 1).padStart(2, "0")}` };
});

const SERVICES = [
  { t: "Web design", d: "The design that ships, not the one that wins a Figma award. I design in code, on a real URL." },
  { t: "Web development", d: "Next.js, Astro, React — storefronts, web apps and marketing sites the next developer picks up clean." },
  { t: "AI features", d: "Claude, GPT, Gemini — whichever fits. I run my own AI product on all three, so I integrate shipped code, not experiments." },
  { t: "Strategy & copy", d: "What the homepage should say, in what order, to whom — decided before a single pixel moves." },
];
const CHIPS = [
  { href: "/services/website-development/", label: "Website development" },
  { href: "/services/school-website-development/", label: "School websites" },
  { href: "/services/hotel-website-development/", label: "Hotel & homestay" },
  { href: "/services/travel-website-development/", label: "Travel & taxi" },
  { href: "/services/ai-development/", label: "AI development" },
  { href: "/services/web-app-development/", label: "Web apps" },
  { href: "/services/ecommerce-website-development/", label: "E-commerce" },
  { href: "/services/landing-page-design/", label: "Landing pages" },
  { href: "/services/seo-geo-services/", label: "SEO & GEO", kind: "red" },
  { href: "/web-developer-kangra/", label: "Kangra", kind: "muted" },
  { href: "/web-developer-dharamshala/", label: "Dharamshala", kind: "muted" },
  { href: "/web-developer-shimla/", label: "Shimla", kind: "muted" },
  { href: "/web-developer-manali/", label: "Manali", kind: "muted" },
];

const PROCESS = [
  { code: "FP1", t: "Brief & fit", d: "Send what you're building. A personal reply within hours, a yes or no on fit within a day." },
  { code: "FP2", t: "Strategy", d: "The customer journey, the commercial goal, and exactly what stops people acting today." },
  { code: "QUALI", t: "Design & prototype", d: "High-fidelity screens and a clickable prototype, approved before any production code." },
  { code: "RACE", t: "Build", d: "Custom-coded in clear milestones, with a revision round at each one. No surprises at the end.", hot: true },
  { code: "FLAG", t: "Launch", d: "Clean repo, README, architecture walkthrough, signed IP transfer and 30 days of free support." },
  { code: "SEASON", t: "Growth", d: "Optional retainer: iteration, A/B tests, new pages, performance tuning, monthly reports." },
];

const RADIO = [
  { q: "Every other agency said 6 months. Delivered in 7 days.", by: "Admin — Modern K.B.S.", bars: [40, 90, 60, 100, 30, 70] },
  { q: "Looks 10 times more premium than our competitors. We started getting direct bookings instead of losing them to Google Maps.", by: "Founder — Nandini Travels", bars: [70, 30, 100, 50, 85, 40], red: true },
  { q: "Exactly what we wanted. I will refer Divyansh within my circle for life.", by: "Founder — North Peak Power Systems", bars: [55, 100, 35, 75, 45, 90] },
];

// Writing — the six posts the design lists, titles from the post manifest.
const WRITING = [
  ["measure-ai-assistant-citations", "AI search · 5 min"],
  ["aeo-geo-llmo-ai-seo-explained", "GEO · 6 min"],
  ["entity-graph-schema-node-by-node", "Structured data · 5 min"],
  ["taxi-tour-operator-website-pages", "Travel · 4 min"],
  ["hotel-near-me-landing-pages", "Hotels · 4 min"],
  ["cbse-mandatory-public-disclosure-school-website", "School website · 4 min"],
].map(([slug, meta], i) => {
  const p = POSTS.find((x) => x.slug === slug);
  if (!p) throw new Error(`Home writing list: unknown post "${slug}"`);
  return { href: `/blog/${slug}/`, title: p.title, meta, n: String(i + 1).padStart(2, "0") };
});
---

<Base
  title={META_TITLE}
  description={META_DESCRIPTION}
  canonical={`${SITE}/`}
  keywords="freelance web developer, freelance web designer, hire freelance developer, Divyansh Sood, custom website design and development, hire web developer, conversion-focused website, Next.js developer, Astro developer, ecommerce website developer, web app MVP developer, SEO web developer, Himachal Pradesh, India"
  ogDescription="Custom-coded websites that convert — designed, built and live in 3–4 weeks. You own the code."
  topics={[TOPICS.webDevelopment, TOPICS.webDesign, TOPICS.ecommerce, TOPICS.seo]}
  jsonld={jsonld}
>
  {/* Intro sweep bands (brandbook 06 Motion). Off-canvas until home.js runs. */}
  <div aria-hidden="true" class="bands">
    <div class="band-red" data-band-red></div>
    <div class="band-ink" data-band-ink></div>
  </div>

  <main>
    <section class="hero" data-hero data-sec-hero>
      <div class="hero-red" data-hero-red>
        <div class="wrap">
          <div class="hero-top">
            <div class="hero-meta">
              <div>Divyansh Sood® Studio — Portfolio 2026</div>
              <div>Custom-coded · Conversion-focused · Worldwide</div>
            </div>
            <div class="pill">
              <span class="pill-dot" data-avail-dot></span>
              <span data-avail>Online now</span>
              <span class="pill-t">IST <span data-clock="short">--:--</span></span>
            </div>
          </div>
          <div class="hero-name">
            <div class="hero-line hero-line--1"><div data-name-line>Divyansh</div></div>
            <div class="hero-line hero-line--2"><div data-name-line>Sood<span class="sup">®</span></div></div>
          </div>
        </div>
      </div>
      <div class="wrap hero-body" data-hero-body>
        <div class="hero-copy">
          <h1 class="h-lead">Web designer &amp; developer in Himachal Pradesh — custom-coded websites, stores and web apps that <em>convert</em>.</h1>
          <p>One person, end to end. Live in 3–4 weeks. You own the code.</p>
        </div>
        <div class="btn-row">
          <a href={CALENDLY_URL} class="btn btn--red">Book a 15-min intro <span aria-hidden="true">→</span></a>
          <a href="#work" class="btn btn--ink">See the work</a>
        </div>
      </div>
      <div class="wedge wedge--l" aria-hidden="true" data-wedge></div>
      <div class="wedge wedge--r" aria-hidden="true" data-wedge></div>
    </section>
    <script is:inline>
      // Arm the intro before first paint so the hero doesn't flash, then let
      // home.js play it. Once per browser session (home.js sets the flag);
      // skipped under reduced motion; a failsafe shows the hero if the module
      // never runs.
      (function () {
        try { if (sessionStorage.getItem("ds-intro")) return; } catch (e) {}
        try {
          if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          var d = document.documentElement;
          d.classList.add("intro");
          setTimeout(function () { if (!d.classList.contains("intro-run")) d.classList.remove("intro"); }, 2500);
        } catch (e) {}
      })();
    </script>

    <section id="proof" class="sec" data-sec-stats>
      <div class="wrap">
        <div class="sec-head">
          <div>
            <h2 class="h2 proof-h">Proof</h2>
          </div>
          <p class="sec-note">Numbers from shipped projects, since 2022. Recorded, not projected.</p>
        </div>
        <div class="tiles">
          {PROOF.map((t) => (
            <div class="tile">
              <div class="tile-top"><span>{t.ch}</span><span>{t.tag}</span></div>
              {/* One line on purpose: a line break between these spans renders as a space. */}
              <div class="tile-v">{t.pre && <span class="tile-pre">{t.pre}</span>}<span data-count={t.v} data-dec={t.dec}>{t.v}</span>{t.suf && <span class:list={["tile-suf", { "tile-suf--sm": t.sufSm }]}>{t.suf}</span>}</div>
              <div class="gauge"><div data-gauge={t.w} style={`width:${t.w}%`}></div></div>
              <div class="tile-l">{t.l}</div>
            </div>
          ))}
        </div>
        <div class="links-row proof-links">
          <a href="/results/">The numbers, per project →</a>
          <a href="/testimonials/">Client reviews →</a>
        </div>
      </div>
    </section>

    <section id="about" class="about">
      <div class="wrap about-in">
        <div class="about-l">
          <p class="about-big">I design, build and ship custom-coded websites, stores and web apps that <span>convert</span> — one person, end to end, for founders worldwide.</p>
          <p class="about-sub">No agency layers. No handoff to a junior. The person who replies to your brief is the one who designs it, ships it and reports the results.</p>
        </div>
        <div class="about-r">
          <div class="spec-head"><span>Spec sheet</span><span style="color:var(--red)">No. 07</span></div>
          <dl class="spec">
            <div><dt>Studio</dt><dd>Divyansh Sood® Studio — one person, est. 2022</dd></div>
            <div><dt>Based</dt><dd>Kangra valley, Himachal Pradesh, India · IST (UTC+5:30) · <a href={GOOGLE_MAPS_URL} rel="noopener">on Google Maps ↗</a></dd></div>
            <div><dt>Builds</dt><dd>Marketing sites, e-commerce, web apps &amp; MVPs, AI features</dd></div>
            <div><dt>Stack</dt><dd>Next.js, Astro, React, Angular, Supabase, Tailwind</dd></div>
            <div><dt>Timeline</dt><dd>3–4 weeks for sites &amp; MVPs · 6–10 weeks for larger builds</dd></div>
            <div><dt>Handover</dt><dd>Clean repo, README, architecture walkthrough, signed IP transfer, 30 days support</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <section id="work" class="work" data-work>
      <div class="work-pin" data-work-pin>
        <div class="wrap work-head">
          <div>
            <h2 class="h2 work-h">Selected work</h2>
          </div>
          <div class="work-count">
            <div class="work-n"><span data-work-count>01</span> / {String(WORK.length).padStart(2, "0")}</div>
            <div class="work-bar"><div data-work-bar></div></div>
          </div>
        </div>
        <div class="work-track" data-work-track>
          {WORK.map((w) => (
            <a href={`/projects/${w.slug}/`} class="wcard">
              <div class="wcard-top"><span>{w.pos}</span><span>{w.tags}</span></div>
              <div class="wcard-img">
                <img src={localVariant(w.img, 1080)} srcset={localSrcset(w.img)} sizes="(max-width: 700px) 80vw, 560px" alt={w.alt} loading="lazy" decoding="async" width="1600" height="1000" />
              </div>
              <h3 class="h3card">{w.name}</h3>
              <p>{w.d}</p>
            </a>
          ))}
          <a href="/portfolio/" class="wcard-all">
            <span class="wcard-all-t">Case studies · live links · results</span>
            <span class="wcard-all-h">All twelve projects →</span>
          </a>
        </div>
      </div>
    </section>

    <section id="services" class="services">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <h2 class="h2 services-h">What I do</h2>
          </div>
        </div>
        <div class="rule">
          {SERVICES.map((s, i) => (
            <div class="svc">
              <span class="svc-n">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="svc-t">{s.t}</h3>
              <p class="svc-d">{s.d}</p>
            </div>
          ))}
        </div>
        <div class="svc-chips">
          <div class="chips-lbl">Specialist builds &amp; locations</div>
          <div class="chips">
            {CHIPS.map((c) => (
              <a href={c.href} class:list={["chip", { "chip--red": c.kind === "red", "chip--muted": c.kind === "muted" }]}>{c.label}</a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="process" class="sec sec--tint">
      <div class="wrap">
        <h2 class="h2 process-h">How a project runs</h2>
        <ol class="process">
          {PROCESS.map((s, i) => (
            <li class:list={[{ "is-hot": s.hot }]}>
              <div class="process-top"><span>{s.code}</span><span>{String(i + 1).padStart(2, "0")}</span></div>
              <h3 class="h-step">{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="radio" class="sec">
      <div class="wrap">
        <h2 class="h2 radio-h">What clients say</h2>
        <div class="radio">
          {RADIO.map((r, i) => (
            <figure class:list={["qt", { "qt--red": r.red }]}>
              <div class="qt-top">
                <span class="qt-ch"><span class="qt-dot"></span>RADIO · CH.{String(i + 1).padStart(2, "0")}</span>
                <span class="qt-bars" aria-hidden="true">{r.bars.map((h) => <span style={`height:${h}%`}></span>)}</span>
              </div>
              <blockquote>“{r.q}”</blockquote>
              <figcaption>{r.by}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section id="writing" class="writing">
      <div class="wrap">
        <div class="sec-head writing-head">
          <div>
            <h2 class="h2">Blogs</h2>
          </div>
          <a href="/blog/" class="mono">All posts →</a>
        </div>
        <div class="rule">
          {WRITING.map((p) => (
            <a href={p.href} class="post">
              <span class="post-n">{p.n}</span>
              <span class="post-t">{p.title}</span>
              <span class="post-m">{p.meta}</span>
              <span aria-hidden="true" class="post-a">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="faq" class="faq-sec">
      <div class="wrap">
        <Faq faqs={HOME_FAQ} label="" />
      </div>
    </section>

    <section id="contact" class="contact" data-sec-contact>
      <div class="contact-notch" aria-hidden="true"></div>
      <div class="wrap">
        <div class="contact-top">
          <div class="flag" aria-hidden="true"></div>
        </div>
        <h2 class="contact-h">Let's build.</h2>
        <div class="contact-in">
          <div class="contact-l">
            <a href={CALENDLY_URL} class="contact-cta">Book a 15-min intro <span aria-hidden="true">→</span></a>
            <a href="mailto:hello@divyanshsood.com" class="contact-mail">hello@divyanshsood.com</a>
            <blockquote class="contact-q">“I'll personally review your brief and reply within two hours.” <span>— Divyansh, founder</span></blockquote>
            <div class="contact-row">
              <span>IST <span data-clock="full">--:--:--</span></span>
              <span data-avail>Online now</span>
              <a href="https://wa.me/919816091875">WhatsApp ↗</a>
              <a href={GOOGLE_MAPS_URL} rel="noopener">Google Maps ↗</a>
            </div>
          </div>
          <div class="contact-card">
            <div class="contact-card-top"><span>Or send a brief — no call needed</span><span style="color:var(--red)">●</span></div>
            <form id="ds-start-form" class="form">
              <label class="field" for="st-name">Your name *<input id="st-name" required name="name" autocomplete="name" /></label>
              <label class="field" for="st-email">Email *<input id="st-email" required type="email" name="email" autocomplete="email" /></label>
              <label class="field" for="st-msg">What are you building? *<textarea id="st-msg" required name="brief" rows="3"></textarea></label>
              <div class="hp" aria-hidden="true"><label for="st-hp">Leave this empty</label><input id="st-hp" name="company_website" tabindex="-1" autocomplete="off" /></div>
              <button type="submit" class="form-submit">Send brief →</button>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  import { initHome } from "../scripts/home.js";
  import initContactForms from "../scripts/contact-form.js";
  initHome();
  initContactForms();
</script>

<style>
  /* ---- Intro sweep ---- */
  .bands{position:fixed;inset:0;z-index:300;pointer-events:none;overflow:hidden}
  .band-red{position:absolute;top:0;bottom:0;left:0;width:240vw;background:var(--red);transform:translateX(-240vw);clip-path:polygon(0 0,93% 0,100% 50%,93% 100%,0 100%,7% 50%)}
  .band-ink{position:absolute;top:0;bottom:0;left:0;width:46vw;background:var(--ink);transform:translateX(-46vw);clip-path:polygon(0 0,72% 0,100% 50%,72% 100%,0 100%,28% 50%)}
  :global(html.intro) [data-hero-red],:global(html.intro) [data-hero-body]{opacity:0}
  :global(html.intro) [data-name-line]{transform:translateY(110%)}

  /* ---- 01 Hero ---- */
  .hero{position:relative;padding-bottom:clamp(110px,14vw,170px)}
  .hero-red{background:var(--red);color:#fff;clip-path:var(--chevron);padding:110px var(--gutter) clamp(130px,17vw,260px)}
  .hero-red .wrap{text-align:center}
  .hero-top{display:flex;flex-direction:column;align-items:center;gap:18px;margin-bottom:clamp(24px,4vw,48px)}
  .hero-meta{font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;line-height:1.7}
  .pill{display:flex;align-items:center;gap:10px;background:#fff;color:var(--ink);padding:9px 14px;font-family:var(--mono);font-size:12px;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;flex:none;clip-path:polygon(6px 0,100% 0,calc(100% - 6px) 100%,0 100%)}
  .pill-dot{width:8px;height:8px;border-radius:50%;background:var(--red)}
  .pill-t{color:var(--g5c)}
  .hero-name{font-weight:900;font-style:italic;font-stretch:125%;text-transform:uppercase;line-height:.84;letter-spacing:-0.03em;font-size:clamp(52px,13vw,240px)}
  .hero-line{overflow:hidden;margin-right:-.12em}
  .hero-line--1{padding:.06em .12em 0 0}
  .hero-line--2{padding:.02em .12em .02em 0}
  .hero-body{margin-top:clamp(28px,3vw,44px);padding:0 var(--gutter);display:flex;flex-direction:column;align-items:center;text-align:center;gap:24px}
  .hero-copy{max-width:760px}
  .hero-copy .h-lead{margin-bottom:14px;text-wrap:balance}
  .hero-body .btn-row{justify-content:center}
  .hero-copy p{margin:0;color:var(--g5c);font-size:16px;line-height:1.5}
  .wedge{position:absolute;bottom:0;width:50%;height:clamp(44px,6.5vw,104px);background:var(--red)}
  .wedge--l{left:0;clip-path:polygon(0 0,100% 100%,0 100%)}
  .wedge--r{right:0;clip-path:polygon(100% 0,100% 100%,0 100%)}

  /* Shared section header row (Proof, Services, Writing) */
  .sec-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:clamp(36px,5vw,64px)}
  .sec-note{margin:0;max-width:34ch;color:var(--g5c);font-size:16px;line-height:1.5}

  /* ---- 02 Proof ---- */
  .proof-h{font-size:clamp(56px,10vw,160px)}
  .tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,max(300px,calc((100% - 2px) / 3))),1fr));gap:1px;background:var(--gda);border:1px solid var(--gda)}
  .tile{background:#fff;padding:clamp(20px,2.4vw,32px);display:flex;flex-direction:column;gap:18px}
