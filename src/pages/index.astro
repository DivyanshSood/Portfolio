---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import HelloLoader from "../components/home/HelloLoader.astro";
import Hero from "../components/home/Hero.astro";
import About from "../components/home/About.astro";
import HorizontalScrollWork from "../components/motion/HorizontalScrollWork.astro";
import Testimonials from "../components/home/Testimonials.astro";
import Contact from "../components/home/Contact.astro";
import ClosingCta from "../components/home/ClosingCta.astro";

import HomeScripts from "../components/home/HomeScripts.astro";
import MotionController from "../components/motion/MotionController.astro";
import { homeJsonLd } from "../lib/home-schema.mjs";
import { FOUNDER_PHOTO } from "../lib/site.mjs";

const SITE = "https://www.divyanshsood.com";
const jsonld = homeJsonLd(SITE);
---

<Layout
  title="Divyansh Sood® Studio — Custom Websites That Convert, Live in Weeks"
  description="Divyansh Sood designs and builds custom-coded, conversion-focused websites, stores and web apps for founders worldwide. Live in 3–4 weeks. You own the code."
  canonical={`${SITE}/`}
  keywords="Divyansh Sood, custom website design and development, hire web developer, conversion-focused website, Next.js developer, Astro developer, ecommerce website developer, web app MVP developer, SEO web developer, Himachal Pradesh, India web studio"
  ogDescription="Custom-coded websites that convert — designed, built and live in 3–4 weeks. You own the code."
  preloadImage={{ href: FOUNDER_PHOTO }}
  jsonld={jsonld}
>
  {/* Synchronous, render-blocking: arm scroll-reveal before first paint so
      there is no flash of un-hidden content. Skips when the visitor prefers
      reduced motion. A 3s failsafe reveals everything if the motion bundle
      never runs. */}
  <Fragment slot="head">
    <script is:inline>
      (function () {
        try {
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          var d = document.documentElement;
          d.classList.add("motion");
          setTimeout(function () {
            if (!d.classList.contains("motion-ready")) d.classList.add("motion-fallback");
          }, 3000);
          // Hello curtain: first homepage view this session only. Decided here
          // (before first paint) so repeat visits never flash the overlay.
          try {
            if (!sessionStorage.getItem("dsHello")) {
              sessionStorage.setItem("dsHello", "1");
              d.classList.add("ds-hello");
            }
          } catch (err) {}
        } catch (e) {}
      })();
    </script>
  </Fragment>

  {/* First-visit "Hello" curtain — must be the first thing painted. */}
  <HelloLoader />

  <Nav />

  {/* ---------- Hero ---------- */}
  <Hero />

  {/* ---------- 01 · Selected Work (4 of 9, big visuals — the proof leads) ---------- */}
  <HorizontalScrollWork />

  {/* ---------- 02 · About (short founder intro) ---------- */}
  <About />

  {/* ---------- 03 · Testimonials (3 with context) ---------- */}
  <Testimonials />

  {/* ---------- Closing CTA + WebGL liquid-metal blob ---------- */}
  <ClosingCta />

  {/* ---------- 04 · Contact ---------- */}
  <Contact />
</Layout>

<HomeScripts />
<MotionController />
