  {/* ---------- Case overlay (populated + shown by the engine) ---------- */}
  <div data-overlay role="dialog" aria-modal="true" aria-label="Case study" style="display:none; position:fixed; inset:0; z-index:90; background:#0B0B0C; overflow:auto;">
