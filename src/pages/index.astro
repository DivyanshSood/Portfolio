---
import Studio from "../layouts/Studio.astro";
import { homeJsonLd, HOME_FAQ } from "../lib/home-schema.mjs";
import { SITE, CALENDLY_URL } from "../lib/site.mjs";
import { projects as allProjects } from "../lib/projects/data.mjs";
import { POSTS } from "../lib/blog.mjs";
import { isLocalImage, localSrcset } from "../lib/images.mjs";
import { TOPICS } from "../lib/entity.mjs";

// The homepage is by far the strongest page on the site (it takes ~95% of all
// search impressions) and it linked to /blog/ but to no individual post, and to
// /services/ but to none of the four service pages. These two lists pass some of
// that authority down to the pages that actually target commercial queries.
const SERVICE_LINKS = [
  { label: "AI development", href: "/services/ai-development/" },
  { label: "Web app development", href: "/services/web-app-development/" },
  { label: "E-commerce websites", href: "/services/ecommerce-website-development/" },
  { label: "Landing page design", href: "/services/landing-page-design/" },
  { label: "SEO & GEO", href: "/services/seo-geo-services/" },
  { label: "Web developer in Kangra", href: "/web-developer-kangra/" },
  { label: "Web developer in Dharamshala", href: "/web-developer-dharamshala/" },
];
const LATEST_POSTS = POSTS.slice(0, 6);

// Proof strip. Every figure here is already published elsewhere on the site
// (/portfolio stats strip, /results, the Baglamukhi case study) — the homepage
// simply never showed any of it. Keep these in sync with /portfolio and
// /results if they change; nothing here is rounded up.
const PROOF_STATS = [
  { v: "20+", l: "Projects shipped since 2022" },
  { v: "9/9", l: "Recent clients still on board" },
  { v: "7 days", l: "Fastest full build, vs a 6-month quote" },
  { v: "5.7", l: "Avg. Google position, Baglamukhi Travels" },
];

// Real client words, verbatim from /testimonials/.
const PROOF_QUOTES = [
  { q: "Every other agency said 6 months. Delivered in 7 days.", by: "Admin, Modern K.B.S." },
  { q: "Looks 10 times more premium than our competitors. We started getting direct bookings instead of losing them to Google Maps.", by: "Founder, Nandini Travels" },
  { q: "Exactly what we wanted. I will refer Divyansh within my circle for life.", by: "Founder, North Peak Power Systems" },
];

// Desktop SERP is where the CTR problem is: 327 impressions, 1 click, position
// 6.1. Both of these were also being truncated there — the title at 62 chars,
// the description at 172 — so the snippet was cut mid-phrase.
//
// The old title ("Freelance Web Designer & Developer — Divyansh Sood® Studio")
// carried no geography at all, while every query that actually converts is
// branded or local: "divyansh sood" (50% CTR) and "divyansh sood web developer
// kangra" (13.2%). The generic head terms it did chase — "web development",
// 200 impressions at position 5.0 — returned zero clicks and always will.
// So: keep both role keywords, keep the name, add the country. The individual
// cities stay the job of /web-developer-<city>/, which now have real internal
// link equity pointing at them.
const META_TITLE = "Freelance Web Developer & Designer in India · Divyansh Sood"; // 58 chars
const META_DESCRIPTION =
  "Freelance web designer & developer in Himachal Pradesh, India. Custom-coded, conversion-focused websites, stores and web apps — live in 3–4 weeks."; // 148

const jsonld = homeJsonLd(SITE);

// ---------------------------------------------------------------------------
// "Portfolio 2026" homepage — Anton/JetBrains Mono, near-black + neon green
// (#D9FF3C), stack-marquee hero + sticky deck-of-cards work gallery. Chrome and
// the motion engine come from the shared Studio layout; this page only carries
// its own unique sections (hero, statement, deck, contact + the case overlay).
//
// Curated deck of four case studies. Copy lives here (bespoke to this design);
// images come from data.mjs by slug so the deck can never drift from the real
// case-study assets. Card URLs point at the internal case-study pages. The
// remaining builds (incl. the personal projects) live on /portfolio.
// ---------------------------------------------------------------------------
const IMG_TR = "?tr=w-1600,q-80,f-auto";
// The deck fills the viewport, so serve responsive sources: self-hosted /images
// features ship width variants (`<name>-<w>.webp`); ImageKit URLs resize via ?tr.
const deckImg = (s: string) => (isLocalImage(s) ? s.replace(/\.webp$/, "-1440.webp") : s + IMG_TR);
const deckSrcset = (s: string) => (isLocalImage(s) ? localSrcset(s) : undefined);
const bySlug = new Map(allProjects.map((p) => [p.slug, p]));
const caseFor = (slug: string) => {
  const p = bySlug.get(slug);
  if (!p) throw new Error(`Homepage deck references unknown project slug: ${slug}`);
  return p;
};
const DECK = [
  {
    slug: "redline",
    num: "01",
    name: "Redline Studios",
    client: "Redline Studios",
    tags: "Brand · E-commerce",
    year: "2025",
    scope: "Brand · Storefront · Payments",
    blurb:
      "A motorcycle-apparel brand born out of speed — F1-styled motion, race-car geometry and a colour system pulled from real racing liveries. Custom Next.js + Razorpay, nothing templated.",
    quote: "Bro bro bro! What a thing you've built.",
    quoteBy: "Founder, Redline Studios",
  },
  {
    slug: "cultxberserk",
    num: "02",
    name: "CultXberserk",
    client: "CultXberserk",
    tags: "Brand · D2C",
    year: "2026",
    scope: "Brand · Storefront · Drops",
    blurb:
      "A Berserk-inspired apparel label where the lore and the buy flow are one experience — a custom Next.js storefront with a hand-numbered drop system, no Shopify theme.",
    quote: "Apparel for the damned.",
    quoteBy: "Brand voice, CultXberserk",
  },
  {
    slug: "modernkbs",
    num: "03",
    name: "Modern K.B.S.",
    client: "Modern K.B.S.",
    tags: "Web App · Admin",
    year: "2024",
    scope: "Web App · Admin · Build",
    blurb:
      "A custom web application with a self-serve admin — the team updates everything themselves, with no developer on call.",
    quote: null,
    quoteBy: null,
  },
  {
    slug: "chinkiz",
    num: "04",
    name: "ChinkiZ Knitting Knife",
    client: "ChinkiZ · 600K+ subscribers",
    tags: "D2C · Creator",
    year: "2024",
    scope: "Custom storefront",
    blurb:
      "Shopify and Webflow fought the way her audience shops. A custom-coded storefront puts the video right next to the buy button.",
    quote: "I did not think it could be achieved without going to e-commerce builders and only using custom code.",
    quoteBy: "Chinki, Founder",
  },
  {
    // Added to the deck because it carries the hardest SEO proof on the site —
    // avg position 5.7, 7.25K impressions, 148 clicks in 28 days — and had
    // exactly one inbound link (the /portfolio grid). Best number, worst
    // distribution; the homepage fixes both.
    slug: "baglamukhi-travels",
    num: "05",
    name: "Baglamukhi Travels",
    client: "Baglamukhi Travels · Kangra",
    tags: "Travel · Local SEO",
    year: "2026",
    scope: "Site · Local SEO · Schema",
    blurb:
      "Owner-drivers competing against commission agents for Kangra's airport transfers and the Devi Darshan yatra. Built on Astro with a full local-business schema graph — now averaging position 5.7 on Google, 7.25K impressions in 28 days.",
    quote: null,
    quoteBy: null,
  },
].map((d) => {
  const c = caseFor(d.slug);
  const featSrc = c.feature.src;
  return { ...d, img: deckImg(featSrc), srcset: deckSrcset(featSrc), domain: c.domain, url: `/projects/${d.slug}/` };
});

const ARROW = "M7 17 17 7M8 7h9v9";
---

<Studio
  title={META_TITLE}
  description={META_DESCRIPTION}
  canonical={`${SITE}/`}
  keywords="freelance web developer, freelance web designer, hire freelance developer, Divyansh Sood, custom website design and development, hire web developer, conversion-focused website, Next.js developer, Astro developer, ecommerce website developer, web app MVP developer, SEO web developer, Himachal Pradesh, India"
  ogDescription="Custom-coded websites that convert — designed, built and live in 3–4 weeks. You own the code."
  topics={[TOPICS.webDevelopment, TOPICS.webDesign, TOPICS.ecommerce, TOPICS.seo]}
  jsonld={jsonld}
  preloadImage={{ href: DECK[0].img, srcset: DECK[0].srcset, sizes: "(max-width:900px) 86vw, 46vw" }}
  preloader
  home
>
  {/* ---------- Hero — drift marquees (decoration) + the real headline ----------
      The three Anton bands are DECORATION and are marked aria-hidden. Each one
      repeats its phrase three times and is then duplicated for the seamless
      loop, so the DOM carried "Web Design" x6, "Development" x6 and
      "Conversion" x6 — as the largest text on the page — while the only <h1>
      was clipped to 1x1px by .dsx-sr. An invisible H1 sitting next to a head
      term repeated eighteen times is the worst possible pair of signals: it
      reads as keyword repetition and says nothing a buyer actually searches.
      The bands stay exactly as designed; the headline below them is now real,
      visible, crawlable text. ---------------------------------------------- */}
  <section id="top">
    <div class="hero-fold">
      <div aria-hidden="true" style="display:flex; flex-direction:column; gap:1vw;">
        <div style="overflow:hidden;">
          <div class="dsx-r" data-intro="0">
            <div data-drift="l" style="display:inline-flex; white-space:nowrap; font-family:'Anton',sans-serif; font-weight:400; font-size:clamp(32px, 8.2vw, 112px); line-height:0.94; text-transform:uppercase; will-change:transform;">
              <span style="display:inline-block; padding-right:4vw;">Web Design <span style="color:var(--accent, #D9FF3C);">✦</span> Web Design <span style="color:var(--accent, #D9FF3C);">✦</span> Web Design <span style="color:var(--accent, #D9FF3C);">✦</span></span>
              <span style="display:inline-block; padding-right:4vw;">Web Design <span style="color:var(--accent, #D9FF3C);">✦</span> Web Design <span style="color:var(--accent, #D9FF3C);">✦</span> Web Design <span style="color:var(--accent, #D9FF3C);">✦</span></span>
            </div>
          </div>
        </div>
        <div style="overflow:hidden;">
          <div class="dsx-r" data-intro="110">
            <div data-drift="r" class="hero-band-stroke" style="display:inline-flex; white-space:nowrap; font-family:'Anton',sans-serif; font-weight:400; font-size:clamp(32px, 8.2vw, 112px); line-height:0.94; text-transform:uppercase; color:transparent; will-change:transform;">
              <span style="display:inline-block; padding-right:4vw;">Development ► Development ► Development ►</span>
              <span style="display:inline-block; padding-right:4vw;">Development ► Development ► Development ►</span>
            </div>
          </div>
        </div>
        <div style="overflow:hidden;">
          <div class="dsx-r" data-intro="220">
            <div data-drift="l2" style="display:inline-flex; white-space:nowrap; font-family:'Anton',sans-serif; font-weight:400; font-size:clamp(32px, 8.2vw, 112px); line-height:0.94; text-transform:uppercase; will-change:transform;">
              <span style="display:inline-block; padding-right:4vw;">Conversion <span style="color:var(--accent, #D9FF3C);">↗</span> Conversion <span style="color:var(--accent, #D9FF3C);">↗</span> Conversion <span style="color:var(--accent, #D9FF3C);">↗</span></span>
              <span style="display:inline-block; padding-right:4vw;">Conversion <span style="color:var(--accent, #D9FF3C);">↗</span> Conversion <span style="color:var(--accent, #D9FF3C);">↗</span> Conversion <span style="color:var(--accent, #D9FF3C);">↗</span></span>
            </div>
          </div>
        </div>
      </div>

      {/* The fold's real content: headline, subhead, primary + secondary CTA. */}
      <div class="hero-say">
        <div class="hero-say-main">
          <h1 class="dsx-f" data-intro="300">
            Freelance web designer &amp; developer — custom-coded websites, stores and web apps that <em>convert</em>.
          </h1>
          <p class="hero-sub dsx-f" data-intro="360">One person, end to end. Live in 3–4 weeks. You own the code.</p>
          <div class="hero-cta dsx-f" data-intro="420">
            <a class="dsx-cta hero-cta-1" data-cursor="BOOK" href={CALENDLY_URL} target="_blank" rel="noopener">
              Book a 15-min intro
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d={ARROW}></path></svg>
            </a>
            <a class="hero-cta-2" href="/portfolio/">See the work <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div data-hide-m class="hero-say-meta dsx-f" data-intro="480">
          EST. 2022 — HIMACHAL PRADESH, IN<br />WORLDWIDE · IST <span data-ist>––:––</span>
        </div>
      </div>
    </div>
  </section>

  {/* ---------- Marquee band ---------- */}
  <div class="hp-band">
    <div data-marquee-track style="display:inline-flex; white-space:nowrap; will-change:transform; font-family:'Anton',sans-serif; font-weight:400; font-size:clamp(30px, 4.6vw, 64px); text-transform:uppercase; line-height:1;">
      <span style="display:inline-block; padding-right:3vw;">Custom-coded <span style="color:var(--accent, #D9FF3C);">✦</span> Conversion-focused <span style="color:var(--accent, #D9FF3C);">✦</span> Live in 3–4 weeks <span style="color:var(--accent, #D9FF3C);">✦</span> You own the code <span style="color:var(--accent, #D9FF3C);">✦</span></span>
      <span aria-hidden="true" style="display:inline-block; padding-right:3vw;">Custom-coded <span style="color:var(--accent, #D9FF3C);">✦</span> Conversion-focused <span style="color:var(--accent, #D9FF3C);">✦</span> Live in 3–4 weeks <span style="color:var(--accent, #D9FF3C);">✦</span> You own the code <span style="color:var(--accent, #D9FF3C);">✦</span></span>
    </div>
  </div>

  {/* ---------- Proof ----------------------------------------------------
      The homepage carried no proof of any kind — no numbers, no client words,
      no logos — while /portfolio, /results and /testimonials held all of it
      behind footer-only links. Every figure below is already published
      elsewhere on the site and links to the page that substantiates it. --- */}
  <section class="hp-proof" aria-labelledby="proof-h">
    <h2 id="proof-h" class="dsx-sr">Proof</h2>
    <ul class="hp-stats" role="list">
      {PROOF_STATS.map((s) => (
        <li data-reveal>
          <span class="hp-stat-v">{s.v}</span>
          <span class="hp-stat-l">{s.l}</span>
        </li>
      ))}
    </ul>
    <ul class="hp-quotes" role="list">
      {PROOF_QUOTES.map((qt) => (
        <li data-reveal>
          <blockquote>“{qt.q}”</blockquote>
          <cite>— {qt.by}</cite>
        </li>
      ))}
    </ul>
    <div class="hp-proof-links mono">
      <a href="/results/">The numbers, per project →</a>
      <a href="/testimonials/">Client reviews →</a>
    </div>
  </section>

  {/* ---------- About statement — sticky, word-by-word scroll reveal ---------- */}
  <section data-stmt-sec class="hp-stmt">
    <div class="hp-stmt-pin">
      <div class="hp-eyebrow">
        <span>(ABOUT — 01)</span>
        <span data-hide-m>WHY FOUNDERS HIRE ME</span>
      </div>
      <p data-split-words style="margin:0; font-weight:600; font-size:clamp(26px, 4.8vw, 60px); line-height:1.16; letter-spacing:-0.02em; max-width:1150px;">I design, build and ship custom-coded websites, stores and web apps that convert — one person, end to end, for founders worldwide.</p>
      <p data-split-words style="margin:0.5em 0 0; font-weight:600; font-size:clamp(26px, 4.8vw, 60px); line-height:1.16; letter-spacing:-0.02em; color:var(--accent, #D9FF3C);">No agency layers. You own the code.</p>
    </div>
  </section>

  {/* ---------- Selected work — sticky deck of cards ---------- */}
  <section id="work">
    <div class="hp-work-head">
      <div>
        <div class="hp-eyebrow">(WORK — 02)</div>
        <h2 style="margin:0; overflow:hidden;"><span class="dsx-r" data-rev style="display:block; font-family:'Anton',sans-serif; font-weight:400; font-size:clamp(52px, 9vw, 130px); line-height:0.92; text-transform:uppercase;">Selected work</span></h2>
      </div>
      <div data-hide-m class="hp-eyebrow hp-eyebrow-stack">2024 — 2026<br><span style="color:var(--accent, #D9FF3C);">{String(DECK.length).padStart(2, "0")}</span> OF 09 PROJECTS</div>
    </div>

    {/* A single laptop, pinned centre-stage. On scroll the screenshot inside its
        screen cross-fades from project to project and the copy column beside it
        swaps in sync — the chassis never moves. The engine (Studio.astro) drives
        [data-screen]/[data-copy] opacity off the same scroll-progress math the
        old clip-path deck used. */}
    <div data-deck-sec class="hp-deck" style={`--deck-n:${DECK.length};`}>
      <div class="dsx-lap-stage">
        {/* Copy column — one block per project, absolutely stacked + cross-faded. */}
        <div class="dsx-lap-copy">
          {DECK.map((p, i) => (
            <div data-copy data-idx={i} class="dsx-copy">
              <div style="display:flex; align-items:center; gap:14px; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.12em; color:rgba(244,242,236,0.85); margin-bottom:18px;">
                <span style="color:var(--accent, #D9FF3C);">{p.num}</span>
                <span>{p.tags}</span>
                <span data-hide-m>· {p.year}</span>
              </div>
              <h3 style="margin:0; font-family:'Anton',sans-serif; font-weight:400; font-size:clamp(40px, 5.2vw, 92px); line-height:0.9; text-transform:uppercase;">{p.name}</h3>
              <p style="margin:22px 0 0; max-width:42ch; font-size:clamp(14px, 1.15vw, 17px); line-height:1.62; color:#B8B8BF;">{p.blurb}</p>
              <a href={p.url} data-cursor="OPEN" style="margin-top:30px; display:inline-flex; align-items:center; gap:10px; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.12em; border:1px solid rgba(244,242,236,0.45); border-radius:999px; padding:13px 22px;">VIEW CASE <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d={ARROW}></path></svg></a>
            </div>
          ))}
        </div>

        {/* The laptop. Screen is clickable (opens the case overlay for whichever
            project is active — the engine keeps its data-idx in sync). */}
        <div class="dsx-lap-wrap">
          <div class="dsx-lap">
            <div class="dsx-lap-screen" data-card data-deck-card data-idx="0" data-cursor="VIEW">
              <div class="dsx-lap-chrome" aria-hidden="true">
                <span class="dsx-lap-dots"><i></i><i></i><i></i></span>
                <span class="dsx-lap-url" data-lap-url>{DECK[0].domain}</span>
              </div>
              <div class="dsx-lap-shots">
                {/* width/height are the intrinsic 16:10 of the generated ladder
                    (1920x1200 base). The shots are absolutely positioned and sized by
                    CSS, so these change no layout — they declare the aspect ratio in
                    markup instead of leaving it to be inferred after download. */}
                {DECK.map((p, i) => (
                  <img data-screen data-idx={i} src={p.img} srcset={p.srcset} sizes="(max-width:900px) 86vw, 46vw" alt={`${p.name} — ${p.tags}`} width="1440" height="900" loading={i === 0 ? "eager" : "lazy"} decoding="async" />
                ))}
              </div>
            </div>
            <div class="dsx-lap-base" aria-hidden="true"></div>
          </div>
        </div>

        <div class="hp-deck-count"><span data-deck-num style="color:var(--accent, #D9FF3C); font-size:20px;">01</span><span style="color:#8A8A93; font-size:12px;">/ {String(DECK.length).padStart(2, "0")}</span></div>
        <div class="hp-deck-rail"><div data-deck-bar style="position:absolute; inset:0; transform:scaleX(0); transform-origin:left center; background:var(--accent, #D9FF3C);"></div></div>
      </div>
    </div>

    {/* The deck shows five of nine; this is the only in-page route to the
        other four. Without it /portfolio is reachable from the burger menu and
        the footer alone. */}
    <div class="hp-work-out">
      <a href="/portfolio/" class="hp-work-out-a">See all nine projects <span aria-hidden="true">→</span></a>
      <span class="mono">Case studies · live links · results</span>
    </div>
  </section>

  {/* ---------- Services ---------- */}
  <section id="services">
    <div class="hp-svc">
      <div class="hp-eyebrow">
        <span>(SERVICES — 03)</span>
        <span data-hide-m>ONE PERSON, END TO END</span>
      </div>
      <h2 style="margin:0 0 clamp(30px, 4vw, 54px); overflow:hidden;"><span class="dsx-r" data-rev style="display:block; font-family:'Anton',sans-serif; font-weight:400; font-size:clamp(52px, 9vw, 130px); line-height:0.92; text-transform:uppercase;">What I do</span></h2>
      <ul class="svc" role="list">
        <li class="svc-row" data-reveal>
          <span class="svc-num">01</span>
          <h3 class="svc-t">Web design</h3>
          <p class="svc-d">The design that ships, not the one that wins a Figma community award — I design in code, on a real URL.</p>
        </li>
        <li class="svc-row" data-reveal>
          <span class="svc-num">02</span>
          <h3 class="svc-t">Web development</h3>
          <p class="svc-d">Next.js, Astro, React — custom-coded storefronts, web apps and marketing sites the next developer picks up clean.</p>
        </li>
        <li class="svc-row" data-reveal>
          <span class="svc-num">03</span>
          <h3 class="svc-t">AI features</h3>
          <p class="svc-d">Claude, GPT, Gemini — whichever fits the job. I run my own AI product on all three, so I integrate shipped code, not experiments.</p>
        </li>
        <li class="svc-row" data-reveal>
          <span class="svc-num">04</span>
          <h3 class="svc-t">Strategy &amp; copy</h3>
          <p class="svc-d">What the homepage should say, in what order, to whom — decided before a single pixel moves.</p>
        </li>
      </ul>

      <nav class="svc-links" aria-label="Service and location pages">
        {SERVICE_LINKS.map((s) => <a href={s.href}>{s.label}</a>)}
      </nav>

      <div class="hp-writing">
        <div class="hp-writing-head">
          <span class="mono">(WRITING)</span>
          <a class="mono" href="/blog/">All posts →</a>
        </div>
        <ul class="hp-posts" role="list">
          {LATEST_POSTS.map((p) => (
            <li>
              <a href={`/blog/${p.slug}/`}>
                <span class="hp-post-t">{p.title}</span>
                <span class="hp-post-m mono">{p.tags?.[0]} · {p.readMins} min</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* ---------- FAQ ------------------------------------------------------
      Renders from HOME_FAQ, the same array that builds the FAQPage node in
      home-schema.mjs — the markup and the visible answers cannot drift. --- */}
  <section class="hp-faq" aria-labelledby="faq-h">
    <div class="hp-faq-head">
      <span class="mono">(FAQ — 04)</span>
      <span class="mono" data-hide-m>BEFORE YOU ASK</span>
    </div>
    <h2 id="faq-h" class="hp-faq-h">Questions I get<span style="color:var(--accent, #D9FF3C);">.</span></h2>
    <dl class="hp-faq-list">
      {HOME_FAQ.map((f) => (
        <div class="hp-faq-row" data-reveal>
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </div>
      ))}
    </dl>
  </section>

  {/* ---------- Contact ---------- */}
  <section id="contact">
