      </blockquote>
      <div style="display:flex; flex-wrap:wrap; align-items:center; gap:16px;">
        <a data-o-link class="dsx-cta" data-cursor="OPEN" href="#" style="background:var(--accent, #D9FF3C); color:#0B0B0C; font-weight:600; font-size:14px; padding:16px 26px; border-radius:999px; display:inline-flex; align-items:center; gap:10px;">OPEN FULL CASE STUDY <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d={ARROW}></path></svg></a>
        <button data-o-next class="dsx-pill" style="font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.12em; border:1px solid rgba(244,242,236,0.35); border-radius:999px; padding:15px 24px; cursor:pointer; display:inline-flex; align-items:center; gap:8px;">NEXT PROJECT <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M4 12h16M13 5l7 7-7 7"></path></svg></button>
      </div>
    </div>
  </div>

  {/* Deck data for the engine (overlay content). */}
  <script is:inline type="application/json" id="dsx-data" set:html={JSON.stringify(DECK)} />

  <style>
    /* ---- Hero headline block --------------------------------------------
       Anchored to the bottom of the fold. The marquee bands above it are
       decoration; this is the part Google and a first-time visitor actually
       read, so it carries the H1, the subhead and the only two CTAs in the fold.

       Bands and headline are stacked flex children, never headline-over-bands.
       Absolutely positioning the headline means guessing its height as bottom
       padding — and it changes with viewport width as the copy rewraps, so a
       wrong guess puts the H1 through the middle of the marquees. Stacking
       makes that collision structurally impossible. */
    .hero-fold {
      min-height: 100svh; display: flex; flex-direction: column; justify-content: center;
      overflow: hidden; position: relative;
      /* Tuned so the bands, the H1, the subhead AND the primary button all fit
         above the fold at 1440x900 — putting a CTA in the first screen is the
         entire point of the block. */
      gap: clamp(20px, 3.4vh, 44px);
      padding: calc(var(--header-h) + var(--sp-2xs)) 0 var(--sp-xs);
    }
    /* 1.5px is a hairline against the desktop 112px but reads as muddy fill at
       the mobile size, where it is proportionally ~3x heavier. */
    .hero-band-stroke { -webkit-text-stroke: 1.5px #F4F2EC; }
    @media (max-width: 720px) { .hero-band-stroke { -webkit-text-stroke-width: 1px; } }
    .hero-say {
      padding: 0 var(--gutter);
      display: flex; align-items: flex-end; justify-content: space-between; gap: 32px;
    }
    .hero-say-main { max-width: min(62ch, 58vw); }
    /* The 2.9vw term does not engage until an 828px viewport, so on every phone
       this rendered at its 24px floor — smaller than the aria-hidden marquee
       bands above it, which meant the decoration outweighed the actual pitch.
       Raising the floor only; the desktop curve is untouched. */
    .hero-say h1 {
      margin: 0; font-weight: 600; letter-spacing: -0.02em;
      font-size: clamp(28px, 2.9vw, 42px); line-height: 1.14; text-wrap: balance;
    }
    .hero-say h1 em { font-style: normal; color: var(--accent, #D9FF3C); }
    .hero-sub {
      margin: 16px 0 0; max-width: 46ch; color: #B8B8BF;
      font-size: clamp(14px, 1.15vw, 17px); line-height: 1.6;
    }
    .hero-cta { margin-top: 26px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; }
    .hero-cta-1 {
      background: var(--accent, #D9FF3C); color: #0B0B0C; font-weight: 600;
      font-size: 14px; letter-spacing: 0.02em; padding: 16px 28px; border-radius: 999px;
      display: inline-flex; align-items: center; gap: 10px; white-space: nowrap;
    }
    .hero-cta-2 {
      font-family: "JetBrains Mono", monospace; font-size: 12px; letter-spacing: 0.08em;
      text-transform: uppercase; border-bottom: 1px solid rgba(244, 242, 236, 0.35);
      padding-bottom: 4px; white-space: nowrap;
    }
    .hero-say-meta {
      flex: none; text-align: right; line-height: 1.8; color: #8A8A93;
      font-family: "JetBrains Mono", monospace; font-size: var(--fs-label); letter-spacing: 0.1em;
    }

    /* ---- Shared section furniture ---------------------------------------
       One class, one ramp (see the tokens in base.css). Sections do not
       hand-roll their own eyebrow or padding, and never in an inline style=. */
    .hp-eyebrow {
      font-family: "JetBrains Mono", monospace;
      font-size: var(--fs-label); letter-spacing: var(--ls-label); color: #8A8A93;
      display: flex; justify-content: space-between; gap: 16px;
      margin: 0 0 var(--sp-xs);
    }
    /* Two stacked lines rather than a row — flex would swallow the <br>. */
    .hp-eyebrow-stack { display: block; text-align: right; line-height: 1.9; margin: 0; }
    .hp-band {
      border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule);
      padding: var(--sp-2xs) 0; overflow: hidden;
    }

    /* ---- FAQ -------------------------------------------------------------
       Plain <dl>, always expanded. An accordion would hide answers behind a
       click on the one section whose whole job is answering the question
       before the visitor has to ask it. */
    .hp-faq { padding: var(--sp-m) var(--gutter); }
    .hp-faq-head {
      display: flex; justify-content: space-between; gap: 16px; margin-bottom: 22px;
      font-size: var(--fs-label); letter-spacing: var(--ls-label); color: #8A8A93;
    }
    .hp-faq-h {
      margin: 0 0 clamp(30px, 4vw, 54px); font-family: "Anton", sans-serif; font-weight: 400;
      font-size: clamp(44px, 8vw, 118px); line-height: 0.92; text-transform: uppercase;
    }
    .hp-faq-list {
      margin: 0; padding: 0;
      border-top: 1px solid rgba(244, 242, 236, 0.14);
    }
    .hp-faq-row {
      display: grid; grid-template-columns: minmax(0, 38%) minmax(0, 1fr);
      gap: clamp(18px, 3vw, 48px);
      padding: clamp(22px, 2.8vw, 36px) 0;
      border-bottom: 1px solid rgba(244, 242, 236, 0.14);
    }
    .hp-faq-row dt {
      margin: 0; font-weight: 600; letter-spacing: -0.01em;
      font-size: clamp(17px, 1.7vw, 24px); line-height: 1.3; text-wrap: balance;
    }
    .hp-faq-row dd {
      margin: 0; color: #B8B8BF; max-width: 62ch;
      font-size: clamp(14px, 1.1vw, 16.5px); line-height: 1.68;
    }
    /* ---- Work section outro --------------------------------------------- */
    .hp-work-out {
      display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between;
      gap: 14px 28px; padding: var(--sp-s) var(--gutter) var(--sp-m);
    }
    .hp-work-out-a {
      font-family: "Anton", sans-serif; font-weight: 400; text-transform: uppercase;
      font-size: clamp(24px, 3.4vw, 48px); line-height: 1;
    }
    .hp-work-out-a:hover { color: var(--accent, #D9FF3C); }
    .hp-work-out .mono {
      font-size: var(--fs-label); letter-spacing: var(--ls-label); color: #8A8A93; text-transform: uppercase;
    }

    /* ---- Proof strip ----------------------------------------------------- */
    .hp-proof { padding: var(--sp-m) var(--gutter); }
    .hp-stats {
      list-style: none; margin: 0; padding: 0;
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px;
      background: rgba(244, 242, 236, 0.14);
      border: 1px solid rgba(244, 242, 236, 0.14);
    }
    .hp-stats li {
      background: #0B0B0C; padding: clamp(22px, 2.6vw, 34px) clamp(18px, 2vw, 28px);
      display: flex; flex-direction: column; gap: 10px;
    }
    .hp-stat-v {
      font-family: "Anton", sans-serif; font-weight: 400; line-height: 0.95;
      font-size: clamp(32px, 4vw, 58px); color: var(--accent, #D9FF3C);
    }
    .hp-stat-l {
      font-family: "JetBrains Mono", monospace; font-size: var(--fs-label); letter-spacing: 0.08em;
      line-height: 1.7; color: #8A8A93; text-transform: uppercase;
    }
    .hp-quotes {
      list-style: none; margin: clamp(28px, 3.5vw, 46px) 0 0; padding: 0;
      display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(18px, 2vw, 30px);
    }
    .hp-quotes li {
      border-left: 2px solid var(--accent, #D9FF3C); padding-left: clamp(16px, 1.6vw, 22px);
    }
    .hp-quotes blockquote {
      margin: 0; font-weight: 600; letter-spacing: -0.01em;
      font-size: clamp(15px, 1.35vw, 19px); line-height: 1.5;
    }
    .hp-quotes cite {
      display: block; margin-top: 12px; font-style: normal; color: #8A8A93;
      font-family: "JetBrains Mono", monospace; font-size: var(--fs-label); letter-spacing: 0.1em;
    }
    .hp-proof-links {
      margin-top: clamp(26px, 3vw, 40px); display: flex; flex-wrap: wrap; gap: 12px 28px;
      font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
    }
    .hp-proof-links a { border-bottom: 1px solid rgba(244, 242, 236, 0.3); padding-bottom: 4px; }
    /* ---- About statement + work-section frames --------------------------
       Both scroll-driven sections: a tall track with a pinned child. Both are
       sized in svh, never vh. vh resolves to lvh on mobile (URL bar hidden)
       while the pinned child is svh — that mismatch is what left a dark band
       under the laptop, and it made every URL-bar slide fire a resize that
       rewrote the track height mid-scroll. svh does not move. */
    .hp-stmt { height: 150svh; }
    .hp-stmt-pin {
      position: sticky; top: 0; height: 100svh;
      display: flex; flex-direction: column; justify-content: center;
      padding: 0 var(--gutter);
    }
    .hp-work-head {
      padding: var(--sp-l) var(--gutter) var(--sp-m);
      display: flex; align-items: flex-end; justify-content: space-between; gap: 24px;
    }
    /* 100svh holds the pin, then one step per transition — N-1 of them, not N.
       Counting N ships a step no card can reach. The background lives here
       rather than on the pinned stage so the lvh/svh delta can never show
       through as a seam. */
    .hp-deck {
      --deck-step: 75svh;
      height: calc(100svh + (var(--deck-n) - 1) * var(--deck-step));
      position: relative; background: #131316;
    }
    .hp-deck-count {
      position: absolute; top: calc(var(--header-h) + var(--sp-2xs)); right: var(--gutter);
      font-family: 'JetBrains Mono', monospace; letter-spacing: var(--ls-label);
      display: flex; gap: 8px; align-items: baseline;
    }
    .hp-deck-rail {
      position: absolute; inset-inline: var(--gutter); bottom: var(--sp-2xs);
      height: 1px; background: rgba(244, 242, 236, 0.2);
    }

    /* ---- Pinned-laptop work gallery ------------------------------------- */
    /* The stage is the sticky, viewport-height frame. Two columns on desktop
       (copy | laptop); stacks to one column on phones (still pinned — option A). */
    .dsx-lap-stage {
      position: sticky; top: 0; height: 100svh; overflow: hidden;
      display: flex; flex-direction: row; align-items: stretch;
      gap: clamp(24px, 4vw, 64px); padding: 0 var(--gutter);
    }
    /* Grid-stacked, not absolutely stacked: as an absolute child each card
       contributed no height, so the column had to guess one (34svh) and the
       stage's overflow:hidden silently cut the blurb and the VIEW CASE pill off
       on shorter phones. Grid areas overlap without leaving the flow. */
    .dsx-lap-copy {
      position: relative; flex: 1 1 40%; min-width: 0; align-self: stretch;
      display: grid; align-content: center;
    }
    .dsx-copy {
      grid-area: 1 / 1; display: flex; flex-direction: column; justify-content: center;
      opacity: 0; will-change: opacity, transform;
    }
    .dsx-lap-wrap { flex: 1 1 60%; min-width: 0; display: flex; align-items: center; justify-content: center; }

    /* The device. A CSS-drawn laptop — bezel + browser chrome + hinge base. */
    .dsx-lap { width: min(100%, 820px); }
    .dsx-lap-screen {
      position: relative; aspect-ratio: 16 / 10; background: #0B0B0C;
      border: 9px solid #26262c; border-radius: 16px 16px 4px 4px; overflow: hidden;
      box-shadow: 0 40px 80px -30px rgba(0,0,0,0.8), inset 0 0 0 1px rgba(255,255,255,0.04);
      cursor: pointer;
    }
    .dsx-lap-chrome {
      position: relative; z-index: 2; height: 34px; display: flex; align-items: center; gap: 14px;
      padding: 0 14px; background: #1b1b20; border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .dsx-lap-dots { display: flex; gap: 7px; flex: 0 0 auto; }
    .dsx-lap-dots i { width: 9px; height: 9px; border-radius: 50%; background: #3a3a42; }
    .dsx-lap-url {
      flex: 1 1 auto; min-width: 0; text-align: center; background: #0f0f12; border-radius: 7px;
      padding: 5px 14px; font-family: 'JetBrains Mono', monospace; font-size: var(--fs-label); letter-spacing: 0.03em;
      color: #8A8A93; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .dsx-lap-shots { position: absolute; left: 0; right: 0; top: 34px; bottom: 0; }
    .dsx-lap-shots img {
      position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top center;
      opacity: 0; will-change: opacity;
    }
    /* Hinge / base bar under the screen. */
    .dsx-lap-base {
      position: relative; width: 116%; margin: 0 -8% ; height: 15px;
      background: linear-gradient(#3a3a42, #17171a);
      border-radius: 3px 3px 12px 12px;
      box-shadow: 0 22px 30px -18px rgba(0,0,0,0.75);
    }
    .dsx-lap-base::before {
      content: ""; position: absolute; top: 0; left: 50%; transform: translateX(-50%);
      width: 13%; height: 7px; background: #0d0d10; border-radius: 0 0 8px 8px;
    }

    /* No-JS / pre-boot default: show the first project so the section is never
       blank. The engine overrides these via inline opacity once running. */
    .dsx-copy[data-idx="0"], .dsx-lap-shots img[data-idx="0"] { opacity: 1; }

    /* Services rows. */
    .hp-svc { padding: var(--sp-m) var(--gutter); }
    #services .svc { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(244, 242, 236, 0.16); }
    #services .svc-row {
      display: grid; grid-template-columns: 64px 1fr minmax(240px, 380px);
      gap: 8px 28px; align-items: baseline;
      padding: clamp(20px, 2.6vw, 30px) 0;
      border-bottom: 1px solid rgba(244, 242, 236, 0.16);
    }
    #services .svc-num { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.12em; color: var(--accent, #D9FF3C); }
    #services .svc-t { margin: 0; font-family: 'Anton', sans-serif; font-weight: 400; font-size: clamp(30px, 4.6vw, 64px); line-height: 0.96; text-transform: uppercase; }
    #services .svc-d { margin: 0; font-size: 15px; line-height: 1.62; color: #8A8A93; max-width: 46ch; }

    /* Service / location chips + the latest-writing list under the services
       block — the homepage's links down into the commercial and blog pages. */
    #services .svc-links { display: flex; flex-wrap: wrap; gap: 10px; margin: clamp(26px, 3.4vw, 40px) 0 0; }
    #services .svc-links a {
      font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.06em;
      border: 1px solid rgba(244, 242, 236, 0.22); border-radius: 999px;
      padding: 8px 15px; color: #C9C7C0; text-decoration: none;
      transition: border-color 0.3s ease, color 0.3s ease;
    }
    #services .svc-links a:hover { border-color: var(--accent, #D9FF3C); color: var(--accent, #D9FF3C); }

    #services .hp-writing { margin: clamp(44px, 6vw, 76px) 0 0; border-top: 1px solid rgba(244, 242, 236, 0.16); padding-top: clamp(22px, 3vw, 32px); }
    #services .hp-writing-head { display: flex; justify-content: space-between; gap: 16px; font-size: var(--fs-label); letter-spacing: var(--ls-label); color: #8A8A93; margin-bottom: 18px; }
    #services .hp-writing-head a { color: #8A8A93; text-decoration: none; transition: color 0.3s ease; }
    #services .hp-writing-head a:hover { color: var(--accent, #D9FF3C); }
    #services .hp-posts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    #services .hp-posts a {
      display: flex; flex-direction: column; gap: 6px; height: 100%;
      border: 1px solid rgba(244, 242, 236, 0.12); border-radius: 10px;
      padding: 16px 18px; color: #F4F2EC; text-decoration: none;
      transition: border-color 0.3s ease, background 0.3s ease;
    }
    #services .hp-posts a:hover { border-color: var(--accent, #D9FF3C); background: rgba(217, 255, 60, 0.06); }
    #services .hp-post-t { font-weight: 600; font-size: 15px; line-height: 1.35; letter-spacing: -0.01em; }
    #services .hp-post-m { font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: #8A8A93; }

    /* ---- Contact --------------------------------------------------------
       This was the only section on the page whose padding was driven by
       viewport HEIGHT (clamp(64px, 11vh, 130px)) while every neighbour was
       width-driven — the single biggest source of the uneven rhythm. */
    #contact { padding: var(--sp-l) var(--gutter) 0; overflow: hidden; overflow: clip; }
    .hp-contact-cta {
      display: flex; flex-wrap: wrap; align-items: center; gap: 20px 28px;
      margin: var(--sp-m) 0 var(--sp-s);
    }
    .hp-contact-trust {
      font-family: 'JetBrains Mono', monospace; font-size: var(--fs-label);
      letter-spacing: 0.08em; color: #8A8A93; max-width: 320px; line-height: 1.8;
    }

    /* Homepage project-brief form — matches the Portfolio-2026 field styling. */
    /* --sp-m, not --sp-l: the footer already opens with --sp-l, and stacking
       the two made contact→footer the largest boundary on the page (203px at
       1440 against a 132px standard). */
    .dsx-brief {
      max-width: 560px; margin: 0 0 var(--sp-m);
      border-top: 1px solid var(--rule); padding-top: var(--sp-s);
    }
    #contact .dsx-brief-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
    #contact .dsx-brief-l { display: block; font-family: 'JetBrains Mono', monospace; font-size: var(--fs-label); letter-spacing: var(--ls-label); text-transform: uppercase; color: #8A8A93; margin-bottom: 8px; }
    /* 16px, not 14px: iOS Safari zooms the viewport on focus below 16px and,
       because the viewport meta correctly omits maximum-scale, never zooms
       back out — one tap left the visitor zoomed-in for the rest of the visit. */
    #contact .dsx-brief-i { width: 100%; background: transparent; border: none; border-bottom: 1px solid rgba(244, 242, 236, 0.25); color: #F4F2EC; font-family: 'JetBrains Mono', monospace; font-size: 16px; padding: 12px 2px; outline: none; }
    #contact .dsx-brief-i:focus { border-bottom-color: var(--accent, #D9FF3C); }
    #contact .dsx-brief-t { width: 100%; background: transparent; border: 1px solid rgba(244, 242, 236, 0.18); border-radius: 6px; color: #F4F2EC; font-family: 'JetBrains Mono', monospace; font-size: 16px; padding: 12px; outline: none; resize: vertical; margin-top: 8px; }
    #contact .dsx-brief-t:focus { border-color: var(--accent, #D9FF3C); }

    /* ---- Breakpoints ----------------------------------------------------
       Three, matching the rest of the site: 900 (layout switch), 720 (the
       site-wide mobile line, hard-wired into Studio.astro's [data-hide-m] and
       burger) and 480 (small-phone tail). Adding a fourth is how components end
       up half-collapsed against each other in the band between two steps. */
    @media (max-width: 900px) {
      .hero-say-main { max-width: none; }
      .hp-stats { grid-template-columns: 1fr 1fr; }
      .hp-quotes { grid-template-columns: 1fr; gap: 20px; }
      #services .hp-posts { grid-template-columns: 1fr 1fr; }
      /* Shorten the pin on phones: 400svh of scroll-jacking between the fold
         and the services section is a lot of thumb work on the device most
         visitors are on. 100 + 4x38 = 252svh. Desktop keeps its 400. */
      .hp-deck { --deck-step: 38svh; }
      .hp-stmt { height: 120svh; }
      /* Laptop gallery stays pinned but stacks: laptop on top, copy below. */
      .dsx-lap-stage {
        flex-direction: column; justify-content: center;
        gap: clamp(22px, 4vh, 40px); padding: var(--sp-m) var(--gutter);
        --copy-h: 300px;
      }
      .dsx-lap-wrap { order: -1; flex: 0 0 auto; width: 100%; }
      /* Cap the laptop by what is left after the copy needs its space, so the
         VIEW CASE pill can never be pushed under the stage's overflow:hidden.
         16/10 screen + chrome ≈ 1.6:1. */
      .dsx-lap { width: min(100%, calc((100svh - var(--copy-h) - 2 * var(--sp-m) - 28px) * 1.6)); }
      .dsx-lap-copy { flex: 0 0 auto; width: 100%; align-self: auto; }
      .dsx-copy { justify-content: flex-start; }
      /* Bounds the tallest card (Baglamukhi wraps to 6 lines at 375px). */
      .dsx-copy p { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    }

    @media (max-width: 720px) {
      .hp-faq-row { grid-template-columns: 1fr; gap: 12px; }
      #contact .dsx-brief-grid { grid-template-columns: 1fr; gap: 0; }
      #contact .dsx-brief-grid > div { margin-bottom: 22px; }
      /* Full-width under the CTA row instead of a 320px column beside it. */
      .hp-contact-trust { max-width: none; flex: 1 0 100%; }
      #services .svc-row { grid-template-columns: 34px 1fr; gap: 6px 14px; padding: 20px 0; }
      #services .svc-d { grid-column: 2; }
    }

    @media (max-width: 480px) {
      .hero-cta { gap: 12px 18px; }
      .hero-cta-1 { padding: 15px 24px; font-size: 13px; }
      .hp-stats { grid-template-columns: 1fr; }
      #services .hp-posts { grid-template-columns: 1fr; }
      .dsx-lap-stage { --copy-h: 280px; }
    }

    /* Reduced motion: the statement's word-by-word reveal is skipped by the
       engine, so collapse its scroll track too — otherwise it is 120svh of
       empty scrolling past static text. The deck keeps its cross-fade (that is
       scroll-position state, not autonomous motion) at half the scroll cost. */
    @media (prefers-reduced-motion: reduce) {
      .hp-stmt { height: auto; }
      .hp-stmt-pin { position: static; height: auto; padding-block: var(--sp-m); }
      .hp-deck { --deck-step: 38svh; }
    }
  </style>
</Studio>

<script>
  // Activates the homepage "Send a brief" form (ds-start-form). Posts to
  // /api/contact; falls back to the visitor's mail client if Resend is unset.
  import initContactForms from "../scripts/contact-form.js";
  initContactForms();
</script>
