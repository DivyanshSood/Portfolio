      </div>
      <h2 data-o-name style="margin:0 0 5vh; font-family:'Anton',sans-serif; font-weight:400; font-size:clamp(48px, 10vw, 150px); line-height:0.92; text-transform:uppercase;"></h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr)); gap:16px; border-top:1px solid rgba(244,242,236,0.14); border-bottom:1px solid rgba(244,242,236,0.14); padding:18px 0; margin-bottom:5vh; font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:0.08em; line-height:2;">
        <div><span style="color:#8A8A93;">CLIENT</span><br><span data-o-client></span></div>
        <div><span style="color:#8A8A93;">SECTOR</span><br><span data-o-tags></span></div>
        <div><span style="color:#8A8A93;">YEAR</span><br><span data-o-year></span></div>
        <div><span style="color:#8A8A93;">SCOPE</span><br><span data-o-scope></span></div>
      </div>
      <div style="position:relative; overflow:hidden; aspect-ratio:16 / 9; background:#131316; margin-bottom:5vh;">
        {/* src/alt are filled by the engine when the overlay opens. The wrapper
            already reserves the box via aspect-ratio, so nothing here can shift
            layout; the attributes just declare the ladder's intrinsic 16:10.
            src is a 1×1 transparent GIF, not "" — an empty src makes several
            browsers resolve it against the document and re-request the current
            page as if it were an image. */}
        <img
          data-o-img
          src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
          alt=""
          width="1440"
          height="900"
          loading="lazy"
