---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/home/Hero.astro";
import About from "../components/home/About.astro";
import HorizontalScrollWork from "../components/motion/HorizontalScrollWork.astro";
import Stats from "../components/home/Stats.astro";
import Testimonials from "../components/home/Testimonials.astro";
import Pricing from "../components/home/Pricing.astro";
import Contact from "../components/home/Contact.astro";

// Motion layer
import FilmGrain from "../components/motion/FilmGrain.astro";
import GiantText from "../components/motion/GiantText.astro";
import MotionController from "../components/motion/MotionController.astro";

import HomeScripts from "../components/home/HomeScripts.astro";
import { homeJsonLd } from "../lib/home-schema.mjs";

const SITE = "https://www.divyanshsood.com";
const jsonld = homeJsonLd(SITE);
---

<Layout
  title="Divyansh Sood® Studio — Built from the Himalayas. Shipping for the world."
  description="Independent web designer & developer in Himachal Pradesh, India — custom-coded, conversion-focused websites, stores and web apps for founders worldwide. 7 days vs 6 months quoted. Marketing sites & MVPs in 3–4 weeks; larger builds, 6–10."
  canonical={`${SITE}/`}
  keywords="Divyansh Sood, web designer, web developer, custom website developer, Next.js developer, Astro developer, conversion-focused websites, ecommerce website developer, SEO web developer, AI website builder, Himachal Pradesh, India web studio"
  ogDescription="Built from the Himalayas. Shipping for the world. Custom-coded sites in 3–4 weeks. From $3,000."
  jsonld={jsonld}
>
  <Nav kicker="Himalayas → Worldwide" />

  {/* ---------- 01 · Hero ---------- */}
  <Hero />

  {/* ---------- 02 · About + WhyMe (founder story) ---------- */}
  <About />

  {/* ---------- 03 · Selected Work (top 3 of 9, signature horizontal scroll) ---------- */}
  <HorizontalScrollWork />

  {/* ---------- 04 · Results / Stats ---------- */}
  <Stats />

  {/* ---------- 05 · Testimonials (3 with context) ---------- */}
  <Testimonials />

  {/* ---------- 06 · Pricing ---------- */}
  <Pricing />

  {/* ---------- 07 · Closing CTA ---------- */}
  <GiantText
    lines={["Let's", "build."]}
    align="center"
    theme="accent"
    meta="(01 — Next step)"
  />

  {/* ---------- 08 · Contact ---------- */}
  <Contact />

  {/* ---------- Film grain overlay (fixed, on top) ---------- */}
  <FilmGrain />

  {/* ---------- GSAP / ScrollTrigger orchestrator ---------- */}
  <MotionController />
</Layout>

<HomeScripts />
