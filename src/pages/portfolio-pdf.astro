---
/* ===========================================================================
   Portfolio one-pager — print source for /portfolio.pdf, rendered at
   /portfolio-pdf/ and piped to PDF by scripts/portfolio-pdf.mjs (headless
   Chrome over file://). Brandbook print: A4, red chevron header, ink on white,
   Archivo + Geist Mono. Styles are inline and fonts load by RELATIVE URL
   (../fonts/) so they resolve over file:// as well as over HTTP.
   =========================================================================== */
import { SITE } from "../lib/site.mjs";
import { completeGraph } from "../lib/entity.mjs";
import { projects } from "../lib/projects/data.mjs";

// Print-only source for /portfolio.pdf. Canonical points at the browsable page;
// this route is noindexed so it doesn't compete with it in search.
const canonical = `${SITE}/portfolio/`;
const today = new Date().toISOString().slice(0, 10);

// Pick the projects that have a public liveUrl — i.e. ships we can name.
// Keeps the one-pager honest: nothing here that I can't link out to.
const featured = projects
  .map((p, i) => ({ ...p, pos: `P${String(i + 1).padStart(2, "0")}` }))
  .filter((p) => p.liveUrl && p.year)
  .sort((a, b) => Number(b.year) - Number(a.year))
  .slice(0, 6);

// This page renders its own <head> rather than going through Studio.astro, so
// it has to call completeGraph itself — otherwise the `isPartOf` pointer below
// resolves to a node that only exists on the homepage.
const jsonld = completeGraph(
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${canonical}#page`,
    url: canonical,
    name: "Portfolio one-pager — Divyansh Sood® Studio",
    description: "Print-ready one-page portfolio summary. Custom-coded, conversion-led sites shipped for real clients.",
    isPartOf: { "@id": `${SITE}/#website` },
  }),
);
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Portfolio — Divyansh Sood® Studio</title>
    <meta name="description" content="Print-ready one-pager — what Divyansh Sood ships, who he's shipped for, and how to start." />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Divyansh Sood® Studio" />
    <meta property="og:title" content="Portfolio — Divyansh Sood® Studio" />
    <meta property="og:description" content="Print-ready one-pager — what Divyansh Sood ships, who he's shipped for, and how to start." />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE}/og-home.png`} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    {jsonld && <script type="application/ld+json" is:inline set:html={jsonld} />}
    <style is:inline>
      @font-face{font-family:'Archivo';font-style:normal;font-weight:100 900;font-stretch:62% 125%;src:url('../fonts/archivo.woff2') format('woff2')}
      @font-face{font-family:'Archivo';font-style:italic;font-weight:100 900;font-stretch:62% 125%;src:url('../fonts/archivo-italic.woff2') format('woff2')}
      @font-face{font-family:'Geist Mono';font-style:normal;font-weight:400 700;src:url('../fonts/geist-mono.woff2') format('woff2')}
      @page{size:A4;margin:0}
      *{box-sizing:border-box}
      html{-webkit-print-color-adjust:exact;print-color-adjust:exact}
      body{margin:0;background:#fff;color:#0B0B0C;font-family:'Archivo',system-ui,sans-serif;-webkit-font-smoothing:antialiased}
      a{color:#0B0B0C}
      .page{max-width:210mm;margin:0 auto}
      .mono{font-family:'Geist Mono',monospace;font-size:9pt;letter-spacing:.08em;text-transform:uppercase}
      .hero{background:#E4151F;color:#fff;clip-path:polygon(0 0,100% 0,100% 72%,50% 100%,0 72%);padding:8mm 12mm 17mm}
      .hero-top{display:flex;justify-content:space-between;gap:12px;margin-bottom:6mm}
      .name{margin:0;font-weight:900;font-style:italic;font-stretch:125%;text-transform:uppercase;line-height:.84;letter-spacing:-0.03em;font-size:36pt}
      .name sup{font-size:.3em;vertical-align:top;margin-left:.2em}
      .intro{display:flex;gap:10mm;padding:2mm 12mm 0;align-items:flex-start}
      .intro-copy{flex:1 1 0}
      h1{margin:0 0 3mm;font-weight:650;font-size:14pt;line-height:1.22;letter-spacing:-0.01em}
      .lead{margin:0;color:#5C5C5C;font-size:9.5pt;line-height:1.45}
      .stats{flex:0 0 62mm;margin:0;display:grid;grid-template-columns:1fr 1fr;border-top:2px solid #0B0B0C}
      .stats div{padding:2mm 3mm 2mm 0;border-bottom:1px solid #DADADA}
      .stats dt{font-family:'Geist Mono',monospace;font-size:6.5pt;letter-spacing:.1em;text-transform:uppercase;color:#5C5C5C}
      .stats dd{margin:1mm 0 0;font-weight:900;font-style:italic;font-stretch:125%;font-size:15pt;line-height:1;color:#E4151F}
      .sec{padding:4mm 12mm 0}
      .lbl{font-family:'Geist Mono',monospace;font-size:8pt;letter-spacing:.1em;text-transform:uppercase;color:#E4151F;margin-bottom:2mm}
      h2{margin:0 0 3mm;font-weight:900;font-style:italic;font-stretch:125%;text-transform:uppercase;line-height:.86;letter-spacing:-0.02em;font-size:19pt}
      .grid{display:grid;grid-template-columns:1fr 1fr;gap:3mm 8mm}
      .grid3{grid-template-columns:1fr 1fr 1fr}
      .tile{border-top:2px solid #0B0B0C;padding-top:2mm;break-inside:avoid}
      .tile-top{display:flex;justify-content:space-between;font-family:'Geist Mono',monospace;font-size:7pt;letter-spacing:.08em;text-transform:uppercase;color:#5C5C5C}
      .tile-top span:first-child{color:#E4151F;font-weight:700}
      .tile h3{margin:1.5mm 0 1mm;font-weight:900;font-style:italic;font-stretch:125%;text-transform:uppercase;font-size:11pt;line-height:1}
      .tile h3 a{text-decoration:none}
      .tile p{margin:0;font-size:8pt;line-height:1.4;color:#3E3E3E}
      .tile .stack{margin-top:1.5mm;font-family:'Geist Mono',monospace;font-size:6.5pt;letter-spacing:.06em;text-transform:uppercase;color:#5C5C5C}
      .do h3{font-weight:800;font-style:normal;font-stretch:112%;text-transform:none;font-size:10pt}
      .bar{margin:5mm 0 0;background:#E4151F;color:#fff;padding:5mm 12mm;display:grid;grid-template-columns:repeat(4,1fr);gap:4mm}
      .bar .mono{font-size:6.5pt}
      .bar-v{margin-top:1mm;font-weight:700;font-size:8.5pt;line-height:1.3;overflow-wrap:anywhere}
      .foot{background:#0B0B0C;color:#8A8A8A;padding:4mm 12mm;display:flex;justify-content:space-between;font-family:'Geist Mono',monospace;font-size:6.5pt;letter-spacing:.1em;text-transform:uppercase}
      @media screen and (max-width:760px){.intro,.grid,.grid3,.bar{display:block}.stats{margin-top:6mm}.tile{margin-bottom:5mm}}
    </style>
  </head>
  <body>
    <div class="page">
      <header class="hero">
        <div class="hero-top mono"><span>Divyansh Sood® Studio — Portfolio {new Date().getFullYear()}</span><span>Solo studio · Himachal Pradesh · 2022—{new Date().getFullYear()}</span></div>
        <div class="name">Divyansh<br />Sood<sup>®</sup></div>
      </header>

      <section class="intro">
        <div class="intro-copy">
          <h1>Custom-coded websites for founders who'd rather hire a person than a shop.</h1>
          <p class="lead">Last year I built a school site in 7 days. Other agencies quoted 6 months. That's the kind of timeline I win — most marketing sites &amp; MVPs ship in 3–4 weeks. Fixed quotes, in writing. You own every line.</p>
        </div>
        <dl class="stats">
          <div><dt>Products live since 2022</dt><dd>20+</dd></div>
          <div><dt>Last 9 clients retained</dt><dd>9/9</dd></div>
          <div><dt>Average LCP on shipped sites</dt><dd>&lt;1.5s</dd></div>
          <div><dt>Solo, design + build</dt><dd>1 person</dd></div>
        </dl>
      </section>

      <section class="sec">
        <div class="lbl">(01) Pit lane</div>
        <h2>Selected work</h2>
        <div class="grid">
          {featured.map((p) => (
            <article class="tile">
              <div class="tile-top"><span>{p.pos}</span><span>{p.tags} · {p.year}</span></div>
              <h3><a href={p.liveUrl}>{p.name} ↗</a></h3>
              <p>{p.line}</p>
              <div class="stack">{p.stack}</div>
            </article>
          ))}
        </div>
      </section>

      <section class="sec do">
        <div class="lbl">(02) Setup</div>
        <h2>What I do</h2>
        <div class="grid grid3">
          <div class="tile"><h3>Marketing sites</h3><p>Astro or Next.js. Sub-second LCP, designed in code on a real URL by day three.</p></div>
          <div class="tile"><h3>Stores</h3><p>Custom storefronts with Razorpay or Stripe. No Shopify, no theme marketplaces, no builder lock-in.</p></div>
          <div class="tile"><h3>Web apps</h3><p>Admin panels, dashboards, admissions portals, booking flows. Shipped in custom code, run by the client's own team.</p></div>
          <div class="tile"><h3>AI features</h3><p>Claude, GPT, Gemini integrations. I run my own AI product (WebSeek.ai) on all three.</p></div>
          <div class="tile"><h3>Conversion copy</h3><p>Homepage / pricing / landing-page copy written to the words your buyers actually type.</p></div>
          <div class="tile"><h3>Ongoing retainer</h3><p>Monthly billing, no contract. Most clients keep me on for 6–12 months after launch.</p></div>
        </div>
      </section>

      <section class="bar">
        <div><div class="mono">Book a 15-min intro</div><div class="bar-v">calendly.com/sood-divyansh007/30min</div></div>
        <div><div class="mono">Email</div><div class="bar-v">hello@divyanshsood.com</div></div>
        <div><div class="mono">WhatsApp</div><div class="bar-v">+91 98160 91875</div></div>
        <div><div class="mono">Studio</div><div class="bar-v">Himachal Pradesh, India · IST +5:30</div></div>
      </section>

      <footer class="foot">
        <span>divyanshsood.com/portfolio</span>
        <span>Generated {today} · for prospective clients</span>
      </footer>
    </div>
  </body>
</html>
