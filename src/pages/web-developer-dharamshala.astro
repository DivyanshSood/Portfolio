---
import Base from "../layouts/Base.astro";
import PageHero from "../components/brand/PageHero.astro";
import Section from "../components/brand/Section.astro";
import Rows from "../components/brand/Rows.astro";
import Cards from "../components/brand/Cards.astro";
import ResultGrid from "../components/brand/ResultGrid.astro";
import Faq from "../components/brand/Faq.astro";
import EndCta from "../components/brand/EndCta.astro";
import { SITE, CALENDLY_URL, GOOGLE_MAPS_URL, STARTING_PRICES as P, inr } from "../lib/site.mjs";
import { TOPICS } from "../lib/entity.mjs";

const canonical = `${SITE}/web-developer-dharamshala/`;
const WA = "https://wa.me/919816091875?text=Hi%20Divyansh,%20I%20run%20a%20business%20in%20Dharamshala%20and%20need%20a%20website.";

const offers = [
  { t: "Tour & travel websites", d: "Booking-first sites for tour operators, taxi services and travel agencies — WhatsApp-first, because that's where Dharamshala's customers actually book." },
  { t: "Hotel & homestay sites", d: "Direct-booking websites for guesthouses, homestays and boutique stays in McLeod Ganj, Dharamkot and Naddi — so OTAs stop taking their cut of every room night." },
  { t: "Café & local business sites", d: "Fast, findable one-pagers and small sites for cafés, yoga schools, institutes and shops — built to rank for what tourists search when they land here." },
  { t: "SEO that fits the town", d: "Dharamshala's market is seasonal and search-driven. I build sites that rank for the queries your guests type — in English and for AI assistants like ChatGPT." },
];

const faqs = [
  { q: "What does a website cost for a Dharamshala business?", a: `A tour operator or homestay site starts at ${inr(P.travel)}, and a simple business site at ${inr(P.basic)}. A booking-first site for a tour operator is a different build than a homestay one-pager, so I scope local Himachal projects case by case and quote fixed, in writing, after one conversation — no hourly creep, no surprises later.` },
  { q: "Can we meet in person in Dharamshala?", a: "Yes — I'm based in Himachal Pradesh, so unlike an agency in Delhi or Bangalore, meeting over a coffee in McLeod Ganj is actually possible. Most work still happens over WhatsApp and calls, which keeps things fast." },
  { q: "How long does a website take?", a: "Local business sites typically go live in 1–3 weeks. Dharamshala Tours — a full travel site with booking flows and a self-serve CMS — was live fast enough to catch the season, and now handles part of ~1,000 package bookings a month." },
  { q: "I already get bookings from Google Maps and Instagram. Why a website?", a: "Maps and Instagram rent you visibility; a website owns it. Aggregators take commission on every booking, and Instagram can't rank for 'best tour operator in Dharamshala'. A fast site with real SEO captures that search demand directly — commission-free." },
];

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `${canonical}#service`,
      name: "Web design and development in Dharamshala",
      serviceType: "Website design and development",
      provider: { "@id": `${SITE}/#studio` },
      areaServed: { "@type": "City", name: "Dharamshala", containedInPlace: { "@type": "State", name: "Himachal Pradesh" } },
      description:
        "Custom-coded, booking-first websites for Dharamshala businesses — tour operators, hotels, homestays, cafés and institutes. Built locally in Himachal, SEO included, live in 1–3 weeks.",
      url: canonical,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Services", item: `${SITE}/services/` },
        { "@type": "ListItem", position: 3, name: "Web developer in Dharamshala", item: canonical },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
});
---

<Base
  title="Web Developer in Dharamshala — Booking-First Websites"
  description="Website developer in Dharamshala, Himachal — custom-coded sites for tour operators, hotels, homestays and cafés. Booking-first, SEO included, live in 1–3 weeks."
  canonical={canonical}
  keywords="web developer in Dharamshala, website developer Dharamshala, website design Dharamshala, web designer McLeod Ganj, travel website developer Himachal, hotel website design Dharamshala"
  ogTitle="Web developer in Dharamshala"
  ogDescription="Booking-first websites for Dharamshala's tour operators, stays and local businesses — built in Himachal, not outsourced to a metro."
  topics={[TOPICS.webDevelopment, TOPICS.himachal, TOPICS.tourism, TOPICS.webDesign]}
  jsonld={jsonld}
>
  <main>
    <PageHero
      display="Web developer in Dharamshala."
      size="case"
      kicker="Himachal Pradesh · Dharamshala · McLeod Ganj · 2026"
      lead={`Dharamshala runs on search: tourists planning treks, families booking stays, students finding institutes. I build the websites that catch that demand — custom-coded, booking-first, WhatsApp-friendly — from right here in Himachal, not a metro agency three states away. One of them now handles part of ~1,000 travel bookings a month.`}
    >
      <a class="btn btn--red" href={CALENDLY_URL}>Book a call <span aria-hidden="true">→</span></a>
      <a class="btn btn--ink" href={WA}>Message on WhatsApp</a>
      <Fragment slot="notes"><span>Based in Himachal · <a href={GOOGLE_MAPS_URL} target="_blank" rel="noopener">on Google Maps ↗</a></span><span>Live in 1–3 weeks</span></Fragment>
    </PageHero>

    <Section n={1} term="Setup" note="The offering" title="Built for how Dharamshala works">
      <Rows items={offers} />
    </Section>

    <Section n={2} term="Telemetry" note="Proof, not promises" title="Local work, on the record">
      <ResultGrid stats={[
        { v: `~1,000`, l: `Monthly bookings — Dharamshala Tours` },
        { v: `1-tap`, l: `WhatsApp booking deep-links` },
        { v: `CMS`, l: `Owners edit packages themselves` },
        { v: `llms.txt`, l: `AI-search files on every build` },
      ]} />
      <div class="gap-top">
        <Cards items={[
          { tag: `Dharamshala Tours · travel`, d: `A WhatsApp-first travel site with a self-serve editor, built for phones on mountain networks. Part of ~1,000 packages booked through it monthly. <a href="/projects/dharamshala-tours/">Read the case study →</a>` },
          { tag: `Nandini Travels · Kangra`, d: `Kangra's most-reviewed taxi operator, rebuilt so direct bookings land on a site he owns instead of leaking to a Maps listing. <a href="/projects/nandini/">Read the case study →</a>` },
          { tag: `Sunny Himachal Travels · Dharamshala`, d: `A tour and taxi operator with a page for every trip, transfer and town it serves, plus 1.1 KB of JavaScript and Lighthouse 100 across all four desktop scores. <a href="/projects/sunny-himachal-travels/">Read the case study →</a>` },
          { tag: `Yash Rock Hotel · Dehrian, Kangra`, d: `Seven rooms, a pool, and no booking engine: every enquiry goes to WhatsApp or a call, and 14 “near” pages reach guests heading for NIFT, Tanda Medical College and the airport. <a href="/projects/yash-rock-hotel/">Read the case study →</a>` },
          { tag: `By industry`, wide: true, d: `What I build most in Himachal: <a href="/services/school-website-development/">school websites</a>, <a href="/services/hotel-website-development/">hotel and homestay websites</a>, and <a href="/services/travel-website-development/">travel and taxi websites</a>. For McLeod Ganj and Dharamshala stays, the map pack decides a lot: <a href="/blog/rank-on-google-maps-himachal/">how to rank on Google Maps</a>.` },
          { tag: `Why direct bookings matter here`, wide: true, d: `Every aggregator booking costs a commission that a direct-booking site keeps. I wrote up the math for Himalayan travel businesses. <a href="/blog/hotel-homestay-website-himachal-direct-bookings/">Read the breakdown →</a>` },
        ]} />
      </div>
    </Section>

    <Section bare>
      <Faq faqs={faqs} label="(03) Before you ask" />
    </Section>

    <EndCta
      title="Run a business in Dharamshala?"
      text={`Send a WhatsApp message with what you do and what you need. I'll reply with what I'd build and what it costs — plainly, in writing.`}
      primary={{ href: WA, label: "Message on WhatsApp →" }}
      secondary={{ href: "/services/", label: "See all services →" }}
    />
  </main>
</Base>
