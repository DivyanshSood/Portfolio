---
import Studio from "../layouts/Studio.astro";
import { SITE, CALENDLY_URL, GOOGLE_MAPS_URL } from "../lib/site.mjs";
import { TOPICS } from "../lib/entity.mjs";

const canonical = `${SITE}/web-developer-dharamshala/`;
const WA = "https://wa.me/919816091875?text=Hi%20Divyansh,%20I%20run%20a%20business%20in%20Dharamshala%20and%20need%20a%20website.";

const offers = [
  { t: "Tour & travel websites", d: "Booking-first sites for tour operators, taxi services and travel agencies — WhatsApp-first, because that's where Dharamshala's customers actually book." },
  { t: "Hotel & homestay sites", d: "Direct-booking websites for guesthouses, homestays and boutique stays in McLeod Ganj, Dharamkot and Naddi — so OTAs stop taking their cut of every room night." },
  { t: "Café & local business sites", d: "Fast, findable one-pagers and small sites for cafés, yoga schools, institutes and shops — built to rank for what tourists search when they land here." },
  { t: "SEO that fits the town", d: "Dharamshala's market is seasonal and search-driven. I build sites that rank for the queries your guests type — in English and for AI assistants like ChatGPT." },
];

const faqs = [
  { q: "What does a website cost for a Dharamshala business?", a: "It depends on scope — a booking-first site for a tour operator is a different build than a homestay one-pager. I scope local Himachal projects case by case and quote fixed, in writing, after one conversation — no hourly creep, no surprises later." },
  { q: "Can we meet in person in Dharamshala?", a: "Yes — I'm based in Himachal Pradesh, so unlike an agency in Delhi or Bangalore, meeting over a coffee in McLeod Ganj is actually possible. Most work still happens over WhatsApp and calls, which keeps things fast." },
  { q: "How long does a website take?", a: "Local business sites typically go live in 1–3 weeks. Dharamshala Tours — a full travel site with booking flows and a self-serve CMS — was live fast enough to catch the season, and now handles part of ~1,000 package bookings a month." },
  { q: "I already get bookings from Google Maps and Instagram. Why a website?", a: "Maps and Instagram rent you visibility; a website owns it. Aggregators take commission on every booking, and Instagram can't rank for 'best tour operator in Dharamshala'. A fast site with real SEO captures that search demand directly — commission-free." },
];

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `${canonical}#service`,
      name: "Web design and development in Dharamshala",
      serviceType: "Website design and development",
      provider: { "@id": `${SITE}/#studio` },
      areaServed: { "@type": "City", name: "Dharamshala", containedInPlace: { "@type": "State", name: "Himachal Pradesh" } },
      description:
        "Custom-coded, booking-first websites for Dharamshala businesses — tour operators, hotels, homestays, cafés and institutes. Built locally in Himachal, SEO included, live in 1–3 weeks.",
      url: canonical,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Services", item: `${SITE}/services/` },
        { "@type": "ListItem", position: 3, name: "Web developer in Dharamshala", item: canonical },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
});
---

<Studio
  title="Web Developer in Dharamshala — Booking-First Websites"
  description="Website developer in Dharamshala, Himachal — custom-coded sites for tour operators, hotels, homestays and cafés. Booking-first, SEO included, live in 1–3 weeks."
  canonical={canonical}
  keywords="web developer in Dharamshala, website developer Dharamshala, website design Dharamshala, web designer McLeod Ganj, travel website developer Himachal, hotel website design Dharamshala"
  ogTitle="Web developer in Dharamshala"
  ogDescription="Booking-first websites for Dharamshala's tour operators, stays and local businesses — built in Himachal, not outsourced to a metro."
  topics={[TOPICS.webDevelopment, TOPICS.himachal, TOPICS.tourism, TOPICS.webDesign]}
  jsonld={jsonld}
>
  <main>
    <header class="cs-hero">
      <div class="wrap">
        <div class="cs-eyebrow">
          <span>Himachal Pradesh</span><span>Dharamshala · McLeod Ganj</span><span>2026</span>
        </div>
        <h1 style="margin:14px 0 0;font-family:'Anton',sans-serif;font-weight:400;font-size:clamp(44px,8vw,108px);line-height:.9;letter-spacing:-.01em;text-transform:uppercase;">Web developer<br /><span style="color:var(--accent);">in Dharamshala.</span></h1>
        <p class="cs-lead">Dharamshala runs on search: tourists planning treks, families booking stays, students finding institutes. I build the websites that catch that demand — custom-coded, booking-first, WhatsApp-friendly — from right here in Himachal, not a metro agency three states away. One of them now handles part of ~1,000 travel bookings a month.</p>
        <div class="cs-cta-row">
          <a class="btn btn-ghost" href={WA} target="_blank" rel="noopener">Message on WhatsApp</a>
          <a class="btn btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Book a call <span aria-hidden="true">↗</span></a>
        </div>
        <div class="cs-meta">
          <span>Based in Himachal · <a href={GOOGLE_MAPS_URL} target="_blank" rel="noopener">on Google Maps ↗</a></span><span>Live in 1–3 weeks</span>
        </div>
      </div>
    </header>

    <section class="cs-sec" aria-labelledby="offer-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="offer-h">Built for how Dharamshala works</h2>
          <span class="mono">The offering</span>
        </div>
        <div class="cs-body" data-reveal>
          {offers.map((o) => (
            <div class="cs-card">
              <span class="cs-tag">{o.t}</span>
              <p class="cs-card-h2">{o.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="cs-sec" aria-labelledby="proof-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="proof-h">Local work, on the record</h2>
          <span class="mono">Proof, not promises</span>
        </div>
        <div class="cs-metrics" data-reveal>
          <div class="cs-metric"><span class="cs-metric-v">~1,000</span><span class="cs-metric-l">Monthly bookings — Dharamshala Tours</span></div>
          <div class="cs-metric"><span class="cs-metric-v">1-tap</span><span class="cs-metric-l">WhatsApp booking deep-links</span></div>
          <div class="cs-metric"><span class="cs-metric-v">CMS</span><span class="cs-metric-l">Owners edit packages themselves</span></div>
          <div class="cs-metric"><span class="cs-metric-v">llms.txt</span><span class="cs-metric-l">AI-search files on every build</span></div>
        </div>
        <div class="cs-body" data-reveal style="margin-top:22px;">
          <div class="cs-card">
            <span class="cs-tag">Dharamshala Tours · travel</span>
            <p>A WhatsApp-first travel site with a self-serve editor, built for phones on mountain networks. Part of ~1,000 packages booked through it monthly. <a href="/projects/dharamshala-tours/">Read the case study →</a></p>
          </div>
          <div class="cs-card">
            <span class="cs-tag">Nandini Travels · Kangra</span>
            <p>Kangra's most-reviewed taxi operator, rebuilt so direct bookings land on a site he owns instead of leaking to a Maps listing. <a href="/projects/nandini/">Read the case study →</a></p>
          </div>
          <div class="cs-card span2">
            <span class="cs-tag">Why direct bookings matter here</span>
            <p>Every aggregator booking costs a commission that a direct-booking site keeps. I wrote up the math for Himalayan travel businesses. <a href="/blog/direct-bookings-without-aggregator-commission/">Read the breakdown →</a></p>
          </div>
        </div>
      </div>
    </section>

    <section class="cs-sec" aria-labelledby="faq-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="faq-h">Frequently asked</h2>
          <span class="mono">Dharamshala</span>
        </div>
        <div class="cs-faq">
          {faqs.map((f, i) => (
            <div class="cs-faq-row">
              <button class="cs-faq-q" data-faqtog={i} aria-expanded="false" aria-controls={`faq-dsl-${i}`}>
                <span>{f.q}</span><span class="cs-faq-icon" data-faqicon={i} aria-hidden="true">+</span>
              </button>
              <div class="cs-faq-a" id={`faq-dsl-${i}`} data-faqbody={i}><p>{f.a}</p></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="cs-endcta">
      <div class="wrap">
        <h2>Run a business in Dharamshala?</h2>
        <p>Send a WhatsApp message with what you do and what you need. I'll reply with what I'd build and what it costs — plainly, in writing.</p>
        <div class="cs-cta-row" style="justify-content:center;">
          <a class="btn btn-primary" href={WA} target="_blank" rel="noopener">Message on WhatsApp</a>
          <a class="btn btn-ghost" href="/services/">See all services</a>
        </div>
      </div>
    </section>
  </main>
</Studio>

<script is:inline>
  (function () {
    var root = document.getElementById("ds-root");
    if (!root) return;
    var faq = -1;
    function sync() {
      root.querySelectorAll("[data-faqbody]").forEach(function (el) {
        var open = Number(el.getAttribute("data-faqbody")) === faq;
        el.style.maxHeight = open ? el.scrollHeight + "px" : "0px";
        el.style.opacity = open ? "1" : "0";
      });
      root.querySelectorAll("[data-faqicon]").forEach(function (el) {
        el.style.transform = Number(el.getAttribute("data-faqicon")) === faq ? "rotate(45deg)" : "rotate(0deg)";
      });
      root.querySelectorAll("[data-faqtog]").forEach(function (el) {
        el.setAttribute("aria-expanded", Number(el.getAttribute("data-faqtog")) === faq ? "true" : "false");
      });
    }
    root.querySelectorAll("[data-faqtog]").forEach(function (el) {
      el.addEventListener("click", function () {
        var i = Number(el.getAttribute("data-faqtog"));
        faq = faq === i ? -1 : i;
        sync();
      });
    });
    var rt;
    window.addEventListener("resize", function () {
      if (faq < 0) return;
      clearTimeout(rt);
      rt = setTimeout(sync, 120);
    });
    sync();
  })();
</script>
