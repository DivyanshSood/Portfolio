---
import Base from "../layouts/Base.astro";
import PageHero from "../components/brand/PageHero.astro";
import Section from "../components/brand/Section.astro";
import Rows from "../components/brand/Rows.astro";
import Cards from "../components/brand/Cards.astro";
import Steps from "../components/brand/Steps.astro";
import ResultGrid from "../components/brand/ResultGrid.astro";
import EndCta from "../components/brand/EndCta.astro";
import SpecList from "../components/brand/SpecList.astro";
import { SITE, CALENDLY_URL, FOUNDER_PHOTO_ABOUT, FOUNDER_PHOTO_ALT, HAS_FOUNDER_PHOTO, SAME_AS, GOOGLE_MAPS_URL, GOOGLE_REVIEWS_URL } from "../lib/site.mjs";

const canonical = `${SITE}/about/`;

const WA = "https://wa.me/919816091875?text=Hi%20Divyansh,%20I%20saw%20your%20about%20page%20and%20want%20to%20talk.";

// Snapshot stats — keep the copy honest, update both here and the homepage if any change.
const stats = [
  { v: "20+", l: "Products shipped" },
  { v: "2022", l: "First launch" },
  { v: "1", l: "Person, end to end" },
  { v: "9/9", l: "Last clients still clients" },
];

const skills = [
  { t: "Web design", d: "The design that ships, not the one that wins a Figma community award. I design in code, on a real URL — Nandini Travels' homepage was a real Astro build before it was a Figma file. The bookings started coming in within a week." },
  { t: "Web development", d: "Next.js for Modern K.B.S.'s admission portal — shipped in 7 days, office staff runs it. Astro for marketing sites that load in under a second. React, Angular, Supabase for the bigger builds. I work in code, not in builders — so the next developer picks it up clean." },
  { t: "AI features", d: "Claude, GPT, Gemini — whichever fits the job. I run my own AI product on all three, so when I integrate AI for a client, I'm reusing shipped code, not testing on their dime." },
  { t: "Strategy & copy", d: "What the homepage should say, in what order, to whom. Most projects want it, and it usually makes the biggest difference." },
];

const milestones = [
  { year: "2022", t: "The first ship", d: "First paying website. A local school wanted better than their Google Sites page. I took the brief on a Sunday, learned Next.js the same week, delivered in ten days. I've been working out of Himachal ever since." },
  { year: "2023", t: "Going full-time solo", d: "Closed the side projects, went independent. Hired zero people. Took on 8 sites that year — e-commerce, travel, education, creator brands." },
  { year: "2024", t: "WebSeek.ai ships", d: "Built and launched my own AI website generator — running it as a real product with real users, not a portfolio toy. Now I think about every build the way a founder does." },
  { year: "2025", t: "Modern K.B.S. in 7 days", d: "Admissions portal + admin panel for a school cycle other agencies quoted at six months. Shipped in seven days. The case study people keep referring back to." },
  { year: "2026", t: "Now", d: "Solo studio out of Himachal Pradesh. Limited projects at a time. Async across time zones, calls in yours. 9 of my last 9 clients still working with me." },
];

/* ---------------------------------------------------------------------------
   About me — the personal side. Each section renders only when its list has
   entries, so the page never ships placeholder copy: fill these in and the
   sections (and their numbering) appear.
     life     paragraphs — where I grew up, how I got into this, life today
     hobbies  { t, d }   — what I do away from the desk
     facts    { k, v }   — quick facts; `v` may carry inline HTML
--------------------------------------------------------------------------- */
const life: string[] = [];
const hobbies: { t: string; d: string }[] = [];
const facts: { k: string; v: string }[] = [];

// Section numbers follow whichever personal sections are present.
let sn = 1;
const num = {
  life: life.length ? ++sn : 0,
  hobbies: hobbies.length ? ++sn : 0,
  facts: facts.length ? ++sn : 0,
  stats: ++sn,
  skills: ++sn,
  principles: ++sn,
  journey: ++sn,
  working: ++sn,
};

const principles = [
  { n: "01", t: "Start from the decision, not the design", d: "Most sites are designed to look good. I design to make a decision easier — yours, your buyer's, whoever the page is for." },
  { n: "02", t: "Own the code, own the future", d: "No monthly tax to a platform. No lock-in that makes the next dev rebuild from scratch. You hold the keys, anyone can pick it up when I'm done." },
  { n: "03", t: "Ship like a founder, not an agency", d: "I run my own product. So I make the same calls you do: speed, ownership, ROI, runway. Decisions move in days, not committee weeks." },
  { n: "04", t: "Premium work, honest pricing", d: "My overhead is a laptop in the Himalayas. You get agency-grade custom code at a price that respects what you actually need." },
];

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "@id": `${canonical}#page`,
      url: canonical,
      name: "About Divyansh Sood — solo web developer",
      description:
        "Divyansh Sood runs a 1-person studio out of Himachal Pradesh, India — custom-coded websites, stores and web apps for founders worldwide.",
      isPartOf: { "@id": `${SITE}/#website` },
      // Points at the Person entity rather than repeating a bare name, so the
      // subject of this page resolves to the node carrying the job title,
      // photo, expertise and verified profiles. completeGraph() in
      // Base.astro defines that node in this same document.
      about: { "@id": `${SITE}/#person` },
      mainEntity: { "@id": `${SITE}/#person` },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "About", item: canonical },
      ],
    },
    {
      "@type": "Person",
      "@id": `${SITE}/#person`,
      name: "Divyansh Sood",
      jobTitle: "Web developer",
      description:
        "Solo studio in Himachal Pradesh, India. Custom-coded websites, stores, web apps and AI features for founders worldwide. 20+ products shipped since 2022.",
      url: canonical,
      knowsAbout: [
        "Web design",
        "Web development",
        "Next.js",
        "React",
        "Astro",
        "Supabase",
        "AI integration",
        "Conversion-focused design",
      ],
      // Imported, never hardcoded. A literal copy here drifts from site.mjs
      // on the one page most likely to be read as the identity record. Add a
      // profile in site.mjs and it lands here too.
      sameAs: SAME_AS,
    },
  ],
});
---

<Base
  title="About Divyansh Sood — Freelance Web Designer & Developer"
  description="Divyansh Sood is a freelance web designer & developer in Himachal Pradesh, India. 20+ custom-coded websites, stores and web apps shipped worldwide since 2022."
  canonical={canonical}
  keywords="Divyansh Sood about, independent web developer, Himachal Pradesh web developer, freelance Next.js developer, custom website developer India, hire web developer"
  ogTitle="About Divyansh Sood — freelance web designer & developer"
  ogDescription="One person, 20+ custom-coded websites, stores and web apps shipped for founders worldwide since 2022."
  jsonld={jsonld}
  preloadImage={HAS_FOUNDER_PHOTO ? { href: FOUNDER_PHOTO_ABOUT } : undefined}
>
  <main>
    <PageHero
      display="About me"
      h1="Built from the Himalayas. Shipping for the world."
      kicker="About me · Himalayas · 2022 — 2026"
      lead="I'm Divyansh Sood — a freelance web designer &amp; developer in Himachal Pradesh, India. Since 2022 I've designed and shipped 20+ custom-coded websites, stores, web apps and AI features for founders worldwide. One person, end to end — no agency layers."
      notes={["Solo · Design + Build", `Kangra, Himachal Pradesh · India · <a href="${GOOGLE_MAPS_URL}" rel="noopener">on Google Maps ↗</a>`, "IST +5:30 · Overlap with US / UK / Gulf"]}
    >
      <a class="btn btn--red" href={CALENDLY_URL}>Book a 15-min intro <span aria-hidden="true">→</span></a>
      <a class="btn btn--ink" href={WA}>Message on WhatsApp</a>
    </PageHero>

    <Section n={1} term="Hello" note="One person, end to end" title="Hi, I'm Divyansh">
      <div class="fd">
        <figure class="fd-photo">
          {HAS_FOUNDER_PHOTO && <img src={FOUNDER_PHOTO_ABOUT} alt={FOUNDER_PHOTO_ALT} width="1200" height="1499" fetchpriority="high" decoding="async" />}
        </figure>
        <div class="fd-copy">
          <p class="fd-big">I'm Divyansh. I run a 1-person studio from a small town in Himachal Pradesh, India — no agency floor, no account managers, just me, designing and building websites for founders who care about outcomes, not theme marketplaces.</p>
          <p class="body">Twenty-plus products shipped since 2022 — marketing sites, web apps, stores, dashboards, and my own AI product. Most in 3–4 weeks. Every one custom-coded, conversion-led, built to last longer than the trend that prompted it. IST working hours (10am–7pm) overlap with US mornings, UK afternoons and Gulf evenings — calls in your zone, async when you want it.</p>
          <div class="meta fd-by"><span>Divyansh Sood — founder</span><span>Himachal · India · IST +5:30</span></div>
          <div class="btn-row">
            <a class="btn btn--red" href={CALENDLY_URL}>Book a 15-min intro <span aria-hidden="true">→</span></a>
            <a class="btn btn--ink" href="/portfolio/">See the work</a>
          </div>
          <div>
            <div class="chips-lbl">Find me</div>
            <div class="fd-chips">
              <a class="chip" href="https://www.linkedin.com/in/divyanshsood/" rel="me noopener">LinkedIn ↗</a>
              <a class="chip" href={GOOGLE_MAPS_URL} rel="noopener">Google Maps ↗</a>
              <a class="chip" href={GOOGLE_REVIEWS_URL} rel="noopener">Google reviews ↗</a>
            </div>
          </div>
        </div>
      </div>
    </Section>

    {life.length > 0 && (
      <Section n={num.life} term="Life" note="Off the clock" title="Where I'm from">
        <div class="life">{life.map((para) => <p class="body" set:html={para} />)}</div>
      </Section>
    )}

    {hobbies.length > 0 && (
      <Section n={num.hobbies} term="Life" note="Away from the desk" title="Outside work">
        <Rows items={hobbies} />
      </Section>
    )}

    {facts.length > 0 && (
      <Section n={num.facts} term="Life" note="Quick facts" title="The short version">
        <SpecList items={facts} />
      </Section>
    )}

    <Section n={num.stats} term="Telemetry" note="Snapshot" title="By the numbers">
      <ResultGrid stats={stats} />
    </Section>

    <Section n={num.skills} term="Setup" note="The skillset" title="What I actually do">
      <Rows items={skills} />
    </Section>

    <Section n={num.principles} term="Setup" note="Four principles" title="How I think about the work">
      <Cards items={principles} />
    </Section>

    <Section n={num.journey} term="Pit lane" note="2022 — Now" title="The journey so far">
      <Rows items={milestones.map((m) => ({ n: m.year, t: m.t, d: m.d }))} />
    </Section>

    <Section n={num.working} term="Race weekend" note="What to expect" title="Working with me looks like" tint>
      <Steps items={[
        { t: "A short call", d: "15 minutes, then an honest answer. Tell me what you're building and where it's stuck. I'll tell you whether I'm the right person for it — and if I'm not, who I'd point you toward. No sales script, no pressure." },
        { t: "A clear plan", d: "Fixed scope, real milestones. Within a couple of days you get a written plan with phases, deliverables and dates. You always know what's shipping next and where the budget is going." },
        { t: "A working build", d: "Live link from week one, not a deck. You'll see a working build early — usually by week two — and review it on a real staging link on your phone. No slideshows, no surprises, no agency handoffs." },
      ]} hot={2} />
    </Section>

    <EndCta
      title="Want to work together?"
      text={`Tell me what you're shipping. I'll come back with a clear path from brief to launch — and an honest timeline. Writing about me, or crediting a build? The <a href="/press/">press kit</a> has the bio, headshot and logo, so the details stay accurate.`}
      secondary={{ href: WA, label: "Message on WhatsApp →" }}
    />
  </main>
</Base>

<style>
  .fd{display:flex;flex-wrap:wrap;gap:clamp(28px,5vw,80px);align-items:flex-start}
  .fd-photo{flex:0 1 460px;margin:0;aspect-ratio:4/5;background:var(--tint);overflow:hidden}
  .fd-photo img{width:100%;height:100%;object-fit:cover;display:block}
  .fd-copy{flex:1 1 420px;display:flex;flex-direction:column;gap:26px}
  .fd-copy p{margin:0;max-width:58ch}
  .fd-big{font-weight:800;font-stretch:108%;font-size:clamp(24px,2.6vw,38px);line-height:1.1;letter-spacing:-0.02em;text-wrap:pretty}
  .fd-by{display:flex;flex-wrap:wrap;gap:6px 20px}
  .fd-chips{display:flex;flex-wrap:wrap;gap:10px}
  .life{display:flex;flex-direction:column;gap:20px}
  .life p{margin:0;max-width:64ch}
</style>
