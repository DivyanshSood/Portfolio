---
import Studio from "../layouts/Studio.astro";
import { SITE, CALENDLY_URL, FOUNDER_PHOTO_ABOUT, FOUNDER_PHOTO_ALT, HAS_FOUNDER_PHOTO } from "../lib/site.mjs";

const canonical = `${SITE}/about/`;

const WA = "https://wa.me/919816091875?text=Hi%20Divyansh,%20I%20saw%20your%20about%20page%20and%20want%20to%20talk.";

// Snapshot stats — keep the copy honest, update both here and the homepage if any change.
const stats = [
  { v: "20+", l: "Products shipped" },
  { v: "2022", l: "First launch" },
  { v: "1", l: "Person, end to end" },
  { v: "9/9", l: "Last clients still clients" },
];

const skills = [
  { t: "Web design", d: "The design that ships, not the one that wins a Figma community award. I design in code, on a real URL — Nandini Travels' homepage was a real Astro build before it was a Figma file. The bookings started coming in within a week." },
  { t: "Web development", d: "Next.js for Modern K.B.S.'s admission portal — shipped in 7 days, office staff runs it. Astro for marketing sites that load in under a second. React, Angular, Supabase for the bigger builds. I work in code, not in builders — so the next developer picks it up clean." },
  { t: "AI features", d: "Claude, GPT, Gemini — whichever fits the job. I run my own AI product on all three, so when I integrate AI for a client, I'm reusing shipped code, not testing on their dime." },
  { t: "Strategy & copy", d: "What the homepage should say, in what order, to whom. Most projects want it, and it usually makes the biggest difference." },
];

const milestones = [
  { year: "2022", t: "The first ship", d: "First paying website. A local school wanted better than their Google Sites page. I took the brief on a Sunday, learned Next.js the same week, delivered in ten days. I've been working out of Himachal ever since." },
  { year: "2023", t: "Going full-time solo", d: "Closed the side projects, went independent. Hired zero people. Took on 8 sites that year — e-commerce, travel, education, creator brands." },
  { year: "2024", t: "WebSeek.ai ships", d: "Built and launched my own AI website generator — running it as a real product with real users, not a portfolio toy. Now I think about every build the way a founder does." },
  { year: "2025", t: "Modern K.B.S. in 7 days", d: "Admissions portal + admin panel for a school cycle other agencies quoted at six months. Shipped in seven days. The case study people keep referring back to." },
  { year: "2026", t: "Now", d: "Solo studio out of Himachal Pradesh. Limited projects at a time. Async across time zones, calls in yours. 9 of my last 9 clients still working with me." },
];

const principles = [
  { n: "01", t: "Start from the decision, not the design", d: "Most sites are designed to look good. I design to make a decision easier — yours, your buyer's, whoever the page is for." },
  { n: "02", t: "Own the code, own the future", d: "No monthly tax to a platform. No lock-in that makes the next dev rebuild from scratch. You hold the keys, anyone can pick it up when I'm done." },
  { n: "03", t: "Ship like a founder, not an agency", d: "I run my own product. So I make the same calls you do: speed, ownership, ROI, runway. Decisions move in days, not committee weeks." },
  { n: "04", t: "Premium work, honest pricing", d: "My overhead is a laptop in the Himalayas. You get agency-grade custom code at a price that respects what you actually need." },
];

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "@id": `${canonical}#page`,
      url: canonical,
      name: "About Divyansh Sood — solo web developer",
      description:
        "Divyansh Sood runs a 1-person studio out of Himachal Pradesh, India — custom-coded websites, stores and web apps for founders worldwide.",
      isPartOf: { "@id": `${SITE}/#website` },
      about: { "@type": "Person", name: "Divyansh Sood" },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "About", item: canonical },
      ],
    },
    {
      "@type": "Person",
      "@id": `${SITE}/#person`,
      name: "Divyansh Sood",
      jobTitle: "Web developer",
      description:
        "Solo studio in Himachal Pradesh, India. Custom-coded websites, stores, web apps and AI features for founders worldwide. 20+ products shipped since 2022.",
      url: canonical,
      knowsAbout: [
        "Web design",
        "Web development",
        "Next.js",
        "React",
        "Astro",
        "Supabase",
        "AI integration",
        "Conversion-focused design",
      ],
      sameAs: [
        "https://github.com/DivyanshSood",
        "https://www.linkedin.com/in/divyansh-sood-023556151/",
      ],
    },
  ],
});
---

<Studio
  title="About Divyansh Sood — Freelance Web Designer & Developer"
  description="Divyansh Sood is a freelance web designer & developer in Himachal Pradesh, India. 20+ custom-coded websites, stores and web apps shipped worldwide since 2022."
  canonical={canonical}
  keywords="Divyansh Sood about, independent web developer, Himachal Pradesh web developer, freelance Next.js developer, custom website developer India, hire web developer"
  ogTitle="About Divyansh Sood — freelance web designer & developer"
  ogDescription="One person, 20+ custom-coded websites, stores and web apps shipped for founders worldwide since 2022."
  jsonld={jsonld}
>
  <main>
    <header class="cs-hero">
      <div class="cs-hero-bg" aria-hidden="true"></div>
      <div class="wrap">
        <div class="cs-eyebrow">
          <span>About</span><span>Solo studio · Himalayas</span><span>2022 — 2026</span>
        </div>
        <h1 style="margin:14px 0 0;font-family:'Anton',sans-serif;font-weight:400;font-size:clamp(46px,8.5vw,116px);line-height:.88;letter-spacing:-.01em;text-transform:uppercase;">Built from<br />the <span style="color:var(--accent);">Himalayas.</span><br />Shipping for the world.</h1>
        <p class="cs-lead">I'm Divyansh Sood — a freelance web designer &amp; developer in Himachal Pradesh, India. Since 2022 I've designed and shipped 20+ custom-coded websites, stores, web apps and AI features for founders worldwide. One person, end to end — no agency layers.</p>
        <div class="cs-cta-row">
          <a class="btn btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Book a 15-min intro <span aria-hidden="true">↗</span></a>
          <a class="btn btn-ghost" href={WA} target="_blank" rel="noopener">Message on WhatsApp</a>
        </div>
        <div class="cs-meta">
          <span>Solo · Design + Build</span><span>Himachal Pradesh · India</span><span>IST +5:30 · Overlap with US / UK / Gulf</span>
        </div>
      </div>
    </header>

    {/* ---------- Founder card ---------- */}
    <section class="cs-sec" aria-labelledby="founder-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="founder-h">The founder</h2>
          <span class="mono">One person, end to end</span>
        </div>

        <div class="about-founder" data-reveal>
          {HAS_FOUNDER_PHOTO ? (
            <div
              class="imgfill about-founder-photo"
              style={`background-image:url('${FOUNDER_PHOTO_ABOUT}');background-color:#d0d0d0;`}
              role="img"
              aria-label={FOUNDER_PHOTO_ALT}
            ></div>
          ) : (
            <div
              style="min-height:460px;border:1px solid rgba(255,255,255,.16);border-radius:10px;background:radial-gradient(120% 90% at 30% 10%, rgba(217,255,60,0.4), transparent 55%),linear-gradient(160deg,#1b1b1d,#0b0b0c);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;aspect-ratio:4/5;"
              aria-label={FOUNDER_PHOTO_ALT}
              role="img"
            >
              <span style="font-family:'Archivo';font-weight:900;font-size:clamp(64px,12vw,120px);letter-spacing:-.05em;color:#fff;opacity:.9;">DS</span>
              <span style="position:absolute;bottom:14px;left:0;right:0;text-align:center;font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:#fff;opacity:.5;">Founder photo</span>
            </div>
          )}

          <div style="display:flex;flex-direction:column;">
            <p style="margin:0;font-size:clamp(18px,2vw,21px);line-height:1.5;font-weight:600;max-width:620px;">I'm Divyansh. I run a 1-person studio from a small town in Himachal Pradesh, India — no agency floor, no account managers, just me, designing and building websites for founders who care about outcomes, not theme marketplaces.</p>
            <p style="margin:18px 0 0;font-size:16px;line-height:1.62;max-width:620px;opacity:.84;">Twenty-plus products shipped since 2022 — marketing sites, web apps, stores, dashboards, and my own AI product. Most in 3–4 weeks. Every one custom-coded, conversion-led, built to last longer than the trend that prompted it. IST working hours (10am–7pm) overlap with US mornings, UK afternoons and Gulf evenings — calls in your zone, async when you want it.</p>

            <div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-top:auto;padding-top:26px;font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.12em;text-transform:uppercase;opacity:.62;">
              <span>Divyansh Sood — founder</span>
              <span>Himachal · India · IST +5:30</span>
            </div>

            <div style="display:flex;flex-wrap:wrap;gap:14px;margin-top:22px;">
              <a href={CALENDLY_URL} target="_blank" rel="noopener" class="btn btn-primary">Book a 15-min intro <span aria-hidden="true">↗</span></a>
              <a href="/portfolio/" class="btn btn-ghost">See the work</a>
            </div>

            {/* ---- LinkedIn profile badge ----
                 The on-brand card is the anchor LinkedIn's script looks for
                 (.LI-simple-link) — it paints immediately, then profile.js
                 replaces the container's contents with LinkedIn's iframe. If
                 that script is blocked or fails, the card just stays. */}
            <div class="about-li">
              <span class="mono about-li-label">Verify on LinkedIn</span>

              <div class="about-li-embed">
                <div
                  class="badge-base LI-profile-badge"
                  data-locale="en_US"
                  data-size="large"
                  data-theme="dark"
                  data-type="HORIZONTAL"
                  data-vanity="divyansh-sood-023556151"
                  data-version="v1"
                >
                  <a
                    class="badge-base__link LI-simple-link about-li-card"
                    href="https://in.linkedin.com/in/divyansh-sood-023556151?trk=profile-badge"
                    target="_blank"
                    rel="noopener"
                  >
                    <span class="about-li-mark" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"></path></svg>
                    </span>
                    <span class="about-li-body">
                      <span class="about-li-name">Divyansh Sood</span>
                      <span class="about-li-role">Founder — web design &amp; development · Himachal Pradesh, India</span>
                    </span>
                    <span class="about-li-go mono" aria-hidden="true">View profile ↗</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ---------- Numbers ---------- */}
    <section class="cs-sec" aria-labelledby="num-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="num-h">By the numbers</h2>
          <span class="mono">Snapshot</span>
        </div>
        <div class="cs-metrics" data-reveal>
          {stats.map((m) => (
            <div class="cs-metric"><span class="cs-metric-v">{m.v}</span><span class="cs-metric-l">{m.l}</span></div>
          ))}
        </div>
      </div>
    </section>

    {/* ---------- What I do ---------- */}
    <section class="cs-sec" aria-labelledby="what-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="what-h">What I actually do</h2>
          <span class="mono">The skillset</span>
        </div>
        <div class="cs-body" data-reveal>
          {skills.map((s) => (
            <div class="cs-card">
              <span class="cs-tag">{s.t}</span>
              <h2 class="cs-card-h2">{s.d}</h2>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ---------- Principles ---------- */}
    <section class="cs-sec" aria-labelledby="why-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="why-h">How I think about the work</h2>
          <span class="mono">Four principles</span>
        </div>
        <div class="cs-body" data-reveal>
          {principles.map((p) => (
            <div class="cs-card">
              <span class="cs-tag">({p.n}) {p.t}</span>
              <h2 class="cs-card-h2">{p.d}</h2>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ---------- Journey / Timeline ---------- */}
    <section class="cs-sec" aria-labelledby="journey-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="journey-h">The journey so far</h2>
          <span class="mono">2022 — Now</span>
        </div>

        <ol class="about-time" data-reveal>
          {milestones.map((m) => (
            <li class="about-time-row">
              <div class="about-time-year">{m.year}</div>
              <div class="about-time-body">
                <h3 class="about-time-t">{m.t}</h3>
                <p class="about-time-d">{m.d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* ---------- Working with me ---------- */}
    <section class="cs-sec" aria-labelledby="workwith-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="workwith-h">Working with me looks like</h2>
          <span class="mono">What to expect</span>
        </div>
        <div class="cs-body" data-reveal>
          <div class="cs-card">
            <span class="cs-tag">A short call</span>
            <h2 class="cs-card-h2">15 minutes, then an honest answer. Tell me what you're building and where it's stuck. I'll tell you whether I'm the right person for it — and if I'm not, who I'd point you toward. No sales script, no pressure.</h2>
          </div>
          <div class="cs-card">
            <span class="cs-tag">A clear plan</span>
            <h2 class="cs-card-h2">Fixed scope, real milestones. Within a couple of days you get a written plan with phases, deliverables and dates. You always know what's shipping next and where the budget is going.</h2>
          </div>
          <div class="cs-card span2">
            <span class="cs-tag">A working build</span>
            <h2 class="cs-card-h2">Live link from week one, not a deck. You'll see a working build early — usually by week two — and review it on a real staging link on your phone. No slideshows, no surprises, no agency handoffs.</h2>
          </div>
        </div>
      </div>
    </section>

    {/* ---------- End CTA ---------- */}
    <section class="cs-endcta">
      <div class="wrap">
        <h2>Want to work together?</h2>
        <p>Tell me what you're shipping. I'll come back with a clear path from brief to launch — and an honest timeline.</p>
        <div class="cs-cta-row" style="justify-content:center;">
          <a class="btn btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Book a 15-min intro <span aria-hidden="true">↗</span></a>
          <a class="btn btn-ghost" href={WA} target="_blank" rel="noopener">Message on WhatsApp</a>
        </div>
      </div>
    </section>
  </main>

  {/* LinkedIn badge renderer. is:inline keeps it a real third-party tag
      instead of being pulled into Astro's bundle. */}
  <script src="https://platform.linkedin.com/badges/js/profile.js" async defer type="text/javascript" is:inline></script>

  <style>
    /* ============================================================
       About page — UI polish (scoped). Matches the site-wide Studio
       language (near-black + neon green). Layout, type scale and
       interaction only.
       ============================================================ */

    /* Roomier rhythm + bigger, more editorial section headings. */
    main .cs-sec { padding: clamp(58px, 7vw, 108px) 0; }
    main .cs-sec-head { align-items: flex-end; margin-bottom: clamp(30px, 4vw, 52px); }
    main .cs-sec-head h2 {
      font-family: 'Anton', sans-serif;
      font-weight: 400;
      font-size: clamp(32px, 5vw, 72px);
      line-height: 0.94;
      letter-spacing: 0;
      text-transform: uppercase;
    }
    main .cs-sec-head .mono { color: #8A8A93; }

    /* Hero: tighten the lead and add a hairline accent under the eyebrow. */
    main .cs-hero { padding-top: clamp(120px, 16vw, 160px); }
    main .cs-lead { max-width: 64ch; font-size: clamp(17px, 1.7vw, 21px); }

    /* ---- LinkedIn profile badge ----
       .about-li-embed is the frame: it reserves the iframe's footprint so the
       late-arriving badge doesn't shift the founder card, and gives LinkedIn's
       widget site chrome once it lands. .about-li-card is the pre-load
       fallback inside it — same hover language as .cs-card. */
    main .about-li {
      margin-top: 26px;
      padding-top: 22px;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      max-width: 100%;
    }
    main .about-li-label { display: block; margin-bottom: 12px; color: #8A8A93; }

    main .about-li-card {
      display: flex;
      align-items: center;
      gap: 16px;
      width: 100%;
      padding: 16px 18px;
      border-radius: 8px;
      text-decoration: none;
      color: inherit;
      background: rgba(255, 255, 255, 0.03);
      transition: transform .4s cubic-bezier(.16, 1, .3, 1), background .3s ease;
    }
    main .about-li-card:hover {
      transform: translateY(-3px);
      background: linear-gradient(180deg, rgba(217, 255, 60, 0.09), transparent);
    }
    main .about-li-mark {
      flex: none;
      display: grid;
      place-items: center;
      width: 42px;
      height: 42px;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: #fff;
    }
    main .about-li-card:hover .about-li-mark { color: var(--accent, #d9ff3c); }
    main .about-li-body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
    main .about-li-name { font-weight: 800; font-size: 16px; letter-spacing: -0.01em; }
    main .about-li-role {
      font-size: 12.5px;
      line-height: 1.4;
      opacity: 0.7;
    }
    main .about-li-go {
      margin-left: auto;
      flex: none;
      font-size: 10px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent, #d9ff3c);
      opacity: 0.85;
    }
    @media (max-width: 560px) {
      main .about-li-card { flex-wrap: wrap; }
      main .about-li-go { margin-left: 58px; }
    }

    /* :global is required on the iframe — LinkedIn's script injects it, so it
       never carries Astro's scoping attribute and a scoped selector can't
       match it. */
    main .about-li-embed {
      display: grid;
      place-items: center;
      max-width: 460px;
      min-height: 300px;
      padding: 10px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 10px;
    }
    main .about-li-embed .LI-profile-badge { width: 100%; }
    main .about-li-embed :global(iframe) { max-width: 100%; border: 0; }

    /* ---- By the numbers → borderless giant figures with hairlines ---- */
    main .cs-metrics {
      gap: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.16);
    }
    main .cs-metric {
      border: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 0;
      background: none;
      padding: clamp(22px, 3vw, 34px) 22px clamp(22px, 3vw, 34px) 0;
    }
    main .cs-metric-v { font-size: clamp(40px, 6vw, 88px); line-height: 0.88; }
    main .cs-metric-l { margin-top: 12px; }
    @media (min-width: 721px) {
      main .cs-metric { border-right: 1px solid rgba(255, 255, 255, 0.1); padding-left: clamp(20px, 2.4vw, 34px); }
      main .cs-metric:first-child { padding-left: 0; }
      main .cs-metric:last-child { border-right: 0; }
    }

    /* ---- Cards: subtle lift + accent edge on hover ---- */
    main .cs-card {
      border-radius: 10px;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                  border-color 0.3s ease, background 0.3s ease;
    }
    main .cs-card:hover {
      transform: translateY(-4px);
      border-color: rgba(217,255,60, 0.55);
      background: linear-gradient(180deg, rgba(217,255,60, 0.07), transparent);
    }

    /* ---- Founder card: framed, hover-zoom photo ---- */
    main .about-founder {
      display: grid;
      grid-template-columns: 0.78fr 1.22fr;
      gap: clamp(28px, 4vw, 56px);
      /* Top-align so the photo keeps its own fixed aspect ratio instead of being
         stretched to the text height (which changed the crop per viewport). */
      align-items: start;
    }
    main .about-founder-photo {
      position: relative;
      /* Fixed 4:5 frame → `cover` shows the SAME region of the portrait at every
         viewport width, so the face is never cropped differently. */
      aspect-ratio: 4 / 5;
      min-height: 0;
      /* Bias the crop toward the top-centre where the face sits. */
      background-position: center 26%;
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 12px;
      overflow: hidden;
      transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease;
      transform-origin: center;
    }
    main .about-founder:hover .about-founder-photo { border-color: rgba(217,255,60, 0.5); }

    /* ---- Journey → a real vertical timeline with an accent rail + nodes ---- */
    main .about-time {
      list-style: none;
      margin: 0;
      padding: 0;
      position: relative;
    }
    main .about-time::before {
      content: "";
      position: absolute;
      left: 7px;
      top: 10px;
      bottom: 10px;
      width: 2px;
      background: linear-gradient(180deg, var(--accent, #d9ff3c), rgba(217,255,60, 0.12));
    }
    main .about-time-row {
      position: relative;
      display: grid;
      grid-template-columns: 92px 1fr;
      gap: clamp(18px, 3vw, 40px);
      padding: 0 0 clamp(28px, 3.5vw, 44px) 34px;
    }
    main .about-time-row:last-child { padding-bottom: 0; }
    main .about-time-row::before {
      content: "";
      position: absolute;
      left: 1px;
      top: 5px;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: #0b0b0c;
      border: 2px solid var(--accent, #d9ff3c);
      box-shadow: 0 0 0 4px rgba(11, 11, 12, 1);
    }
    main .about-time-year {
      font-family: "JetBrains Mono", monospace;
      font-size: clamp(15px, 1.6vw, 20px);
      font-weight: 700;
      letter-spacing: 0.02em;
      color: var(--accent, #d9ff3c);
      padding-top: 2px;
    }
    main .about-time-t {
      margin: 0 0 8px;
      font-weight: 800;
      font-size: clamp(18px, 1.9vw, 24px);
