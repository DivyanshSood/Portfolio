---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { projects, projectHead, renderProjectMain } from "../../lib/projects.mjs";

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const head = projectHead(p);
const main = renderProjectMain(p);
---

<Layout {...head}>
  <Nav />
  <Fragment set:html={main} />
  <Footer />
</Layout>

<script is:inline>
  (function () {
    var root = document.getElementById("ds-root");
    if (!root) return;
    var faq = -1;
    function sync() {
      root.querySelectorAll("[data-faqbody]").forEach(function (el) {
        var open = Number(el.getAttribute("data-faqbody")) === faq;
        // Use the real content height so long answers never clip on narrow phones.
        el.style.maxHeight = open ? el.scrollHeight + "px" : "0px";
        el.style.opacity = open ? "1" : "0";
      });
      root.querySelectorAll("[data-faqicon]").forEach(function (el) {
        el.style.transform = Number(el.getAttribute("data-faqicon")) === faq ? "rotate(45deg)" : "rotate(0deg)";
      });
      root.querySelectorAll("[data-faqtog]").forEach(function (el) {
        el.setAttribute("aria-expanded", Number(el.getAttribute("data-faqtog")) === faq ? "true" : "false");
      });
    }
    root.querySelectorAll("[data-faqtog]").forEach(function (el) {
      el.addEventListener("click", function () {
        var i = Number(el.getAttribute("data-faqtog"));
        faq = faq === i ? -1 : i;
        sync();
      });
    });
    // Re-measure the open answer after a resize/rotate so it keeps its full height.
    var rt;
    window.addEventListener("resize", function () {
      if (faq < 0) return;
      clearTimeout(rt);
      rt = setTimeout(sync, 120);
    });
    sync();
  })();
</script>
