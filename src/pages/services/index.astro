---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/brand/PageHero.astro";
import Section from "../../components/brand/Section.astro";
import Rows from "../../components/brand/Rows.astro";
import EndCta from "../../components/brand/EndCta.astro";
import { SITE, CALENDLY_URL } from "../../lib/site.mjs";
import { TOPICS } from "../../lib/entity.mjs";
import { VERTICAL_LIST } from "../../lib/verticals.mjs";

const canonical = `${SITE}/services/`;

const services = [
  {
    href: "/services/website-development/",
    tag: "Websites · the core service",
    name: "Website development",
    d: "Custom-coded business websites, marketing sites and redesigns — technical SEO and page speed built in from the first commit, live in 3–4 weeks, and you own the code.",
  },
  {
    href: "/services/ecommerce-website-development/",
    tag: "Ecommerce · D2C",
    name: "Ecommerce website development",
    d: "Custom-coded storefronts for D2C brands and creators — Razorpay/Stripe payments, drop mechanics, zero Shopify themes, full code ownership.",
  },
  {
    href: "/services/web-app-development/",
    tag: "Web apps · MVPs",
    name: "Web app development",
    d: "MVPs, portals, dashboards and AI products. Full-stack React/Next.js/Astro, a staging link every Friday, live in weeks — fastest build: 7 days.",
  },
  {
    href: "/services/ai-development/",
    tag: "AI features · LLM integration",
    name: "AI development",
    d: "AI features shipped into production, not demoed — retrieval over your own content, AI search and support, whole AI products. I run my own on Claude, GPT and Gemini.",
  },
  {
    href: "/services/landing-page-design/",
    tag: "Landing pages · CRO",
    name: "Landing page design",
    d: "One page, one job. Copy, design and code as a single argument — clear offer, proof, one action, and load speed that respects the visitor.",
  },
  {
    href: "/services/seo-geo-services/",
    tag: "SEO · GEO · AEO",
    name: "SEO & GEO services",
    d: "Technical SEO plus Generative Engine Optimization — structured data, llms.txt, AI-crawler strategy — so Google ranks you and AI assistants cite you.",
  },
];

const alsoFor = [
  { href: "/agencies/", name: "For agencies", d: "White-label & overflow builds under your brand" },
  { href: "/website-audit/", name: "Free website audit", d: "Conversion, speed & SEO leaks — free, in writing" },
];

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": canonical,
      name: "Services — Divyansh Sood® Studio",
      description:
        "Six services from an independent studio: custom website development, ecommerce storefronts, web apps and MVPs, AI features and LLM integration, high-converting landing pages, and SEO/GEO — custom-coded, conversion-focused, you own the code.",
      url: canonical,
      isPartOf: { "@id": `${SITE}/#website` },
      about: [TOPICS.webDevelopment, TOPICS.webDesign, TOPICS.ecommerce, TOPICS.seo],
    },
    {
      "@type": "ItemList",
      "@id": `${canonical}#services`,
      name: "Services — Divyansh Sood® Studio",
      itemListElement: services.map((s, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: s.name,
        url: `${SITE}${s.href}`,
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Services", item: canonical },
      ],
    },
  ],
});
---

<Base
  title="Services — Websites, Stores, Apps, AI, Pages & SEO"
  description="Six ways an independent studio helps: website development, ecommerce, web apps, AI features, landing pages and SEO/GEO. Custom-coded, you own the code."
  canonical={canonical}
  keywords="web development services, custom website development, ecommerce website development, web app development, AI development services, landing page design, SEO services, GEO services, hire web developer, Divyansh Sood"
  ogTitle="Services — Divyansh Sood® Studio"
  ogDescription="Websites, stores, apps, AI features, landing pages and SEO/GEO — custom-coded, conversion-focused, yours to own."
  jsonld={jsonld}
>
  <main>
    <PageHero
      display="Six ways I move the needle."
      size="case"
      kicker="Services · Custom-coded · conversion-focused · 2026"
      lead="Every engagement is custom-coded, conversion-focused and handed over with full code ownership. Pick the shape of the problem — a website that doesn't bring in enquiries, a store that undersells the product, software stuck on a roadmap, an AI feature that never left the demo, a page that doesn't convert, or a brand that's invisible to Google and AI assistants."
      notes={["Fixed written quotes · you own the code", "Live in 3–4 weeks · fastest: 7 days"]}
    >
      <a class="btn btn--red" href={CALENDLY_URL}>Book an intro call <span aria-hidden="true">→</span></a>
      <a class="btn btn--ink" href="/portfolio/">See the work first</a>
    </PageHero>

    <Section n={1} term="Setup" note="Pick your problem" title="The services">
      <Rows items={services.map((s) => ({ t: s.name, href: s.href, d: `<span class="meta">${s.tag}</span><br />${s.d}` }))} />
    </Section>

    <Section n={2} term="Pit lane" note="Schools · hotels · travel" title="By industry">
      <Rows items={VERTICAL_LIST.map((v) => ({ t: v.name, href: `/services/${v.slug}/`, d: `<span class="meta">${v.eyebrow[1]}</span><br />${v.ogDescription}` }))} />
    </Section>

    <Section n={3} term="Setup" note="Partners & audits" title="Also on offer">
      <Rows items={alsoFor.map((s) => ({ t: s.name, href: s.href, d: s.d }))} />
    </Section>

    <Section n={4} term="Setup" note="Himachal · worldwide" title="Where I work">
      <p class="body where">Built from the Himalayas, shipping for the world. Based in Himachal Pradesh, working with founders worldwide — and with businesses across the region:</p>
      <div class="chips">
        <a class="chip chip--muted" href="/web-developer-dharamshala/">Dharamshala</a>
        <a class="chip chip--muted" href="/web-developer-kangra/">Kangra</a>
        <a class="chip chip--muted" href="/web-developer-shimla/">Shimla</a>
        <a class="chip chip--muted" href="/web-developer-manali/">Manali</a>
      </div>
    </Section>

    <EndCta
      title="Not sure which fits?"
      text="Describe the problem in plain words. I'll tell you which shape it is — and what I'd do about it — within 48 hours."
      primary={{ href: CALENDLY_URL, label: "Book an intro call →" }}
      secondary={{ href: "/website-audit/", label: "Start with the free audit →" }}
    />
  </main>
</Base>

<style>
  .where{margin:0 0 22px;max-width:60ch}
</style>
