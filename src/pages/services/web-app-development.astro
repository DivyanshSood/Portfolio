---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/brand/PageHero.astro";
import Section from "../../components/brand/Section.astro";
import Rows from "../../components/brand/Rows.astro";
import Cards from "../../components/brand/Cards.astro";
import Steps from "../../components/brand/Steps.astro";
import ResultGrid from "../../components/brand/ResultGrid.astro";
import Faq from "../../components/brand/Faq.astro";
import EndCta from "../../components/brand/EndCta.astro";
import { SITE, CALENDLY_URL } from "../../lib/site.mjs";
import { TOPICS } from "../../lib/entity.mjs";

const canonical = `${SITE}/services/web-app-development/`;

const offers = [
  { t: "MVPs for startups", d: "The version of your product that can meet users this month — scoped hard, built fast, ready to iterate. Speed to feedback beats completeness." },
  { t: "Portals & admin panels", d: "Dashboards, admissions systems, self-serve editors — the software behind the website. ModernKBS got a public site and an admissions admin panel in the same 7-day sprint." },
  { t: "AI-powered products", d: "I built WebSeek.ai — one prompt to a custom-coded site, with a Claude / GPT / Gemini model picker. If your product needs AI features, I've shipped them in production." },
  { t: "Full-stack, no handoffs", d: "React, Next.js, Astro, Angular, Node. One person designs, codes and deploys — nothing gets lost between a design team and a dev team." },
];

const how = [
  { n: "01", t: "Scope to the bone", d: "Within 48 hours you get it in writing: what ships, what waits, what it costs. Most MVPs fail by being too big, not too small." },
  { n: "02", t: "A real URL every Friday", d: "Staging links, not status meetings. You click through the actual product every week and steer while steering is cheap." },
  { n: "03", t: "Ship in weeks", d: "Typical build: 3–4 weeks. Fastest: 7 days for a full site plus admin panel, where other agencies quoted 6 months." },
  { n: "04", t: "Yours to scale", d: "Clean repo, README, architecture walkthrough, signed IP transfer. When you hire in-house engineers, they inherit a codebase — not a mystery." },
];

const faqs = [
  { q: "What kind of web apps do you build?", a: "MVPs for startups, customer portals, admin dashboards, booking systems and AI-powered products. Recent builds include a school admissions portal shipped in 7 days, a 15-page infrastructure portal with a self-serve admin, and WebSeek.ai — an AI website builder." },
  { q: "How fast can an MVP be live?", a: "Most MVPs ship in 3–4 weeks. The fastest full build — a public website plus an admissions admin panel — went live in 7 days. The honest constraint is scope, which we cut together before writing code." },
  { q: "What stack do you use?", a: "React, Next.js, Astro or Angular on the front end; Node on the back end; deployed on Vercel or your infrastructure. The stack serves the product — I pick the lightest tool that does the job, and you own all of it." },
  { q: "What does web app development cost?", a: "Each build is quoted after a scoping call, fixed and in writing before anything starts. A tightly scoped MVP is the cheapest thing here; portals with admin panels, integrations and AI features scale with complexity. The single biggest lever on the number is scope, which is why we cut it together first — most MVPs fail by being too big, not too small." },
  { q: "Do you work with funded startups outside India?", a: "Yes — most product work is international. Async-friendly across time zones, milestone billing, and a repo your future team can take over on day one." },
];

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `${canonical}#service`,
      name: "Web app and MVP development",
      serviceType: "Web application development",
      provider: { "@id": `${SITE}/#person` },
      areaServed: [{ "@type": "Country", name: "India" }, { "@type": "Place", name: "Worldwide" }],
      description:
        "Custom web application and MVP development for startups and businesses — portals, dashboards, admin panels and AI-powered products. Full-stack (React, Next.js, Astro, Node), live in weeks, full code ownership.",
      url: canonical,
      // Derived from the same `offers` array the page renders, so the catalogue
      // can never advertise something the page doesn't actually describe.
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Web app and MVP development",
        itemListElement: offers.map((o) => ({
          "@type": "Offer",
          itemOffered: { "@type": "Service", name: o.t, description: o.d },
        })),
      },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Services", item: `${SITE}/services/` },
        { "@type": "ListItem", position: 3, name: "Web app development", item: canonical },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
});
---

<Base
  title="Web App Development Services — MVPs, Portals & AI Products"
  description="Custom web app and MVP development — portals, dashboards, admin panels, AI products. Full-stack React/Next.js/Astro, live in weeks, you own the code."
  canonical={canonical}
  keywords="web app development services, MVP development for startups, hire full-stack developer, custom web application development, admin panel development, AI product development, Next.js developer"
  ogTitle="Web app & MVP development"
  ogDescription="The version of your product that can meet users this month. Full-stack, live in weeks, yours to scale."
  topics={[TOPICS.webApp, TOPICS.webDevelopment, TOPICS.react, TOPICS.startup]}
  jsonld={jsonld}
>
  <main>
    <PageHero
      display="Software shipped in weeks, not quarters."
      size="case"
      kicker="Services · Web apps · MVPs · 2026"
      lead={`Web app development services for founders who need working software, not a six-month roadmap. MVPs, customer portals, admin dashboards and AI-powered products — designed and coded by one person, full-stack, with a staging link in your inbox every Friday.`}
    >
      <a class="btn btn--red" href={CALENDLY_URL}>Book a product call <span aria-hidden="true">→</span></a>
      <a class="btn btn--ink" href="/projects/modernkbs/">See a 7-day build</a>
      <Fragment slot="notes"><span>Fixed written quotes · you own the code</span><span>React · Next.js · Astro · Node</span></Fragment>
    </PageHero>

    <Section n={1} term="Setup" note="The offering" title="What I build">
      <Rows items={offers} />
    </Section>

    <Section n={2} term="Telemetry" note="Proof, not promises" title="Apps on the record">
      <ResultGrid stats={[
        { v: `7 days`, l: `Site + admissions portal (agencies quoted 6 months)` },
        { v: `15`, l: `Pages + self-serve admin, North Peak portal` },
        { v: `3`, l: `AI models in one product (WebSeek.ai)` },
        { v: `0`, l: `SaaS fees left behind for clients` },
      ]} />
      <div class="gap-top">
        <Cards items={[
          { tag: `Modern K.B.S. · web app + admin`, d: `Public school site and an admissions admin panel for classes I–XII, delivered in the same 7-day sprint — no recurring SaaS fees. <a href="/projects/modernkbs/">Read the case study →</a>` },
          { tag: `WebSeek.ai · AI product`, d: `One prompt to a custom-coded site, with a Claude / GPT / Gemini model picker. Built and shipped as a real product. <a href="/projects/webseek/">Read the case study →</a>` },
          { tag: `North Peak Power Systems · portal`, wide: true, d: `A 15-page Angular portal with a self-serve admin that lets the team publish projects and lead with a private-sector pitch. <a href="/projects/northpeak/">Read the case study →</a>` },
        ]} />
      </div>
    </Section>

    <Section n={3} term="Race weekend" note="The process" title="How it ships" tint>
      <Steps items={how} hot={3} />
    </Section>

    <Section n={4} term="Journal" note="From the journal" title="Thinking on product builds">
      <Cards items={[
        { tag: `Custom code vs Webflow for startups`, d: `Where no-code stops and product engineering starts — and when each is right. <a href="/blog/custom-code-vs-webflow-for-startups/">Custom code vs Webflow for startups →</a>` },
        { tag: `Renting vs owning the build`, d: `The three-year math of a platform you rent against code you own. <a href="/blog/shopify-alternatives-for-premium-d2c/">Shopify alternatives, judged on ownership →</a>` },
        { tag: `School site + portal in 7 days`, wide: true, d: `The full story of the build other agencies quoted six months for. <a href="/projects/modernkbs/">Read the Modern K.B.S. build in full →</a>` },
      ]} />
    </Section>

    <Section bare>
      <Faq faqs={faqs} label="(05) Before you ask" />
    </Section>

    <EndCta
      title="Have a product in your head?"
      text={`Describe it in three sentences. I'll tell you what the two-week version looks like — and what it costs, in writing, within 48 hours.`}
      primary={{ href: CALENDLY_URL, label: "Book a product call →" }}
      secondary={{ href: "/services/", label: "All services →" }}
    />
  </main>
</Base>
