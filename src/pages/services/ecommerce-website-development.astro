---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/brand/PageHero.astro";
import Section from "../../components/brand/Section.astro";
import Rows from "../../components/brand/Rows.astro";
import Cards from "../../components/brand/Cards.astro";
import Steps from "../../components/brand/Steps.astro";
import ResultGrid from "../../components/brand/ResultGrid.astro";
import Faq from "../../components/brand/Faq.astro";
import EndCta from "../../components/brand/EndCta.astro";
import { SITE, CALENDLY_URL, STARTING_PRICES as P, inr } from "../../lib/site.mjs";
import { TOPICS } from "../../lib/entity.mjs";

const canonical = `${SITE}/services/ecommerce-website-development/`;

const offers = [
  { t: "Custom storefronts", d: "A store coded from scratch around your brand — not a Shopify theme with your logo swapped in. Every product reveal, easing curve and checkout step is yours." },
  { t: "D2C for creators", d: "Turn an audience into a store. A 600K-subscriber YouTuber sells handmade products through a storefront I built — with a native video gallery, no platform fees." },
  { t: "Drops & scarcity", d: "Hand-numbered units, limited runs, lore-driven product pages. Drop mechanics built into the code, not bolted on with apps." },
  { t: "Payments that fit India + worldwide", d: "Razorpay for UPI, cards and COD. Stripe for international. Whatever your buyers actually use — wired in natively." },
];

const how = [
  { n: "01", t: "Brand before build", d: "We start from how the store should feel — because a premium product in a template storefront reads as a discount product." },
  { n: "02", t: "Designed in code", d: "You review a real URL, not a Figma file. What you approve is what ships." },
  { n: "03", t: "Live in 2–4 weeks", d: "ChinkiZ went from brief to a live, selling storefront in two weeks. Redline shipped brand + store + payments in one sprint." },
  { n: "04", t: "You own everything", d: "The code, the design, the customer data. No monthly platform rent, no theme license, no lock-in. Signed IP transfer with the final invoice." },
];

const faqs = [
  { q: "Can a custom store really replace Shopify?", a: "Yes. Payments (Razorpay or Stripe), order management, inventory and email receipts are all solvable without renting a platform. You trade a monthly fee and a theme ceiling for code you own outright. For premium and creator brands, the difference shows in conversion and brand feel." },
  { q: "Who owns the code and the customer data?", a: "You do — 100%. Full repository handover and a signed IP transfer with the final invoice. Your customer list never lives on someone else's platform." },
  { q: "Which payment gateways do you integrate?", a: "Razorpay for Indian stores (UPI, cards, netbanking, COD) and Stripe or PayPal for international buyers. Multi-currency setups are fine too." },
  { q: "How long does a custom ecommerce build take?", a: "Typically 2–4 weeks from brief to live. ChinkiZ — a full storefront with video gallery and payments — took two weeks. Complex catalogs or subscription logic can add a sprint." },
  { q: "What does a custom ecommerce website cost?", a: `A custom online store starts at ${inr(P.store)}. Every store gets a fixed quote in writing after a short call, before any work starts — no hourly creep, no change-order games. What moves the number is catalogue size, how custom the buying flow is, and whether you need drop mechanics or subscriptions. Worth weighing against the three-year total of a platform plan plus its apps, which is the comparison most brands never actually run.` },
];

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `${canonical}#service`,
      name: "Custom ecommerce website development",
      serviceType: "Ecommerce website design and development",
      provider: { "@id": `${SITE}/#person` },
      areaServed: [{ "@type": "Country", name: "India" }, { "@type": "Place", name: "Worldwide" }],
      description:
        "Custom-coded ecommerce websites and D2C storefronts — no Shopify themes, no platform rent. Razorpay and Stripe integration, drop mechanics, full code ownership, live in 2–4 weeks.",
      url: canonical,
      // Derived from the same `offers` array the page renders, so the catalogue
      // can never advertise something the page doesn't actually describe.
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Ecommerce website development",
        itemListElement: offers.map((o) => ({
          "@type": "Offer",
          itemOffered: { "@type": "Service", name: o.t, description: o.d },
        })),
      },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Services", item: `${SITE}/services/` },
        { "@type": "ListItem", position: 3, name: "Ecommerce website development", item: canonical },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
});
---

<Base
  title="Custom Ecommerce Website Development — Divyansh Sood® Studio"
  description="Custom-coded ecommerce stores and D2C storefronts — no Shopify themes, no platform rent. Razorpay/Stripe, drop mechanics, full code ownership, live in weeks."
  canonical={canonical}
  keywords="custom ecommerce website development, D2C website developer, Shopify alternative developer, custom storefront development, ecommerce developer India, creator store developer, Razorpay integration developer"
  ogTitle="Custom ecommerce website development"
  ogDescription="Storefronts coded from scratch around your brand. No themes, no platform rent, full code ownership."
  topics={[TOPICS.ecommerce, TOPICS.webDevelopment, TOPICS.shopify]}
  jsonld={jsonld}
>
  <main>
    <PageHero
      display="Stores that sell, not themes that rent."
      size="case"
      kicker="Services · Ecommerce · D2C · 2026"
      lead={`Custom ecommerce website development for D2C brands and creators who've outgrown the template look. I code storefronts from scratch — payments, drops, video galleries and all — so the store feels like the brand and the code belongs to you. No Shopify rent. No theme ceiling.`}
    >
      <a class="btn btn--red" href={CALENDLY_URL}>Book a store call <span aria-hidden="true">→</span></a>
      <a class="btn btn--ink" href="/website-audit/">Get a free store audit</a>
      <Fragment slot="notes"><span>Fixed written quotes · you own the code</span><span>Live in 2–4 weeks</span></Fragment>
    </PageHero>

    <Section n={1} term="Setup" note="The offering" title="What I build">
      <Rows items={offers} />
    </Section>

    <Section n={2} term="Telemetry" note="Proof, not promises" title="Stores on the record">
      <ResultGrid stats={[
        { v: `600K+`, l: `Subscriber creator selling via a store I built` },
        { v: `2 wks`, l: `ChinkiZ — brief to live storefront` },
        { v: `1 sprint`, l: `Redline — brand + store + payments` },
        { v: `0`, l: `Shopify themes used, ever` },
      ]} />
      <div class="gap-top">
        <Cards items={[
          { tag: `ChinkiZ Knitting Knife · D2C creator`, d: `A 600K-subscriber YouTuber selling handmade products through a custom storefront with a native video gallery and Razorpay — UPI, cards, COD. <a href="/projects/chinkiz/">Read the case study →</a>` },
          { tag: `CultXberserk · drops`, d: `Hand-numbered units 0001–0666, thirteen designs never reprinted. The lore, the drop mechanics and the buy flow are one experience. <a href="/projects/cultxberserk/">Read the case study →</a>` },
          { tag: `Redline Studios · brand + store`, wide: true, d: `Moto-apparel brand identity and storefront hand-built end-to-end in one sprint — not a Shopify theme dressed up in red and black. <a href="/projects/redline/">Read the case study →</a>` },
        ]} />
      </div>
    </Section>

    <Section n={3} term="Race weekend" note="The process" title="How a store gets built" tint>
      <Steps items={how} hot={3} />
    </Section>

    <Section n={4} term="Journal" note="From the journal" title="Thinking on ecommerce">
      <Cards items={[
        { tag: `Why premium brands leave Shopify`, d: `Brands that want to feel like a brand keep hitting a theme-shaped ceiling. <a href="/blog/shopify-alternatives-for-premium-d2c/">Why premium brands leave Shopify →</a>` },
        { tag: `The real cost of renting your storefront`, d: `What you actually pay over three years when your storefront is rented, not owned. <a href="/blog/shopify-alternatives-for-premium-d2c/">The real cost of renting your storefront →</a>` },
        { tag: `A storefront that feels like the brand`, wide: true, d: `Not a theme — an experience where the product, the story and the buy flow belong together. <a href="/blog/storefront-that-feels-like-the-brand/">Build a storefront that feels like the brand →</a>` },
      ]} />
    </Section>

    <Section bare>
      <Faq faqs={faqs} label="(05) Before you ask" />
    </Section>

    <EndCta
      title="Ready to own your store?"
      text={`Tell me what you sell and where it lives today. If it's a fit, I'll map the build in writing within 48 hours.`}
      primary={{ href: CALENDLY_URL, label: "Book a store call →" }}
      secondary={{ href: "/services/", label: "All services →" }}
    />
  </main>
</Base>
