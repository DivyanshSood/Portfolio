---
import Studio from "../../layouts/Studio.astro";
import { SITE, CALENDLY_URL } from "../../lib/site.mjs";

const canonical = `${SITE}/services/landing-page-design/`;

const offers = [
  { t: "Conversion-first structure", d: "One page, one job. Every section either moves the visitor toward the action or gets cut. Message before pixels." },
  { t: "Speed as a feature", d: "Custom-coded, no builder bloat. Landing pages that paint instantly on a phone on hotel Wi-Fi — because page speed is the first thing your brand says." },
  { t: "Copy + design + code", d: "One person owns the headline, the layout and the build, so the argument never gets lost in a handoff between three vendors." },
  { t: "Measured, not guessed", d: "Consent-gated analytics and event tracking wired in from day one. You'll know which section converts — not just how many people visited." },
];

const how = [
  { n: "01", t: "The offer comes first", d: "Before design: who lands here, from where, wanting what? If the offer is fuzzy, no amount of design saves it — and I'll say so." },
  { n: "02", t: "Wireframe in words", d: "The page as an argument: headline, proof, objection handling, action. You approve the argument before it becomes visuals." },
  { n: "03", t: "Designed in code", d: "You review a live URL on your own phone, not a mockup. Motion, speed and responsiveness are part of the review, not a surprise at launch." },
  { n: "04", t: "Launch, measure, iterate", d: "Ship, watch real behaviour, tighten. A landing page is a draft you improve with evidence — not a brochure you frame." },
];

const faqs = [
  { q: "What makes a landing page actually convert?", a: "Clarity of offer, proof close to the claim, one visible action, and load speed. Most pages don't have a traffic problem — they have a message problem. That's why the argument is designed before the visuals." },
  { q: "Landing page vs full website — which do I need?", a: "If you're running ads, validating an offer or launching one product, a landing page gets you live and learning in about a week. If you need to rank for many queries and tell a fuller story, that grows into a site — the landing page's message becomes its homepage." },
  { q: "How fast will it load?", a: "Custom-coded pages with inlined critical CSS and optimised assets — typically scoring high-90s on Lighthouse performance, with no builder JavaScript weighing them down. Speed is treated as part of the brand, not a technical afterthought." },
  { q: "Can you write the copy too?", a: "Yes — the headline, the structure and the objection-handling are half the work. You bring deep knowledge of your customers; I turn it into an argument that fits on one scroll." },
  { q: "What does a landing page cost?", a: "A single page with copy, design, build and tracking is the smallest engagement I take, and the cheapest way to work with me. Add variants for testing, or let the page grow into a small site, and it's quoted as a project instead. Either way you get one fixed number in writing before we start." },
];

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `${canonical}#service`,
      name: "High-converting landing page design",
      serviceType: "Landing page design and conversion optimization",
      provider: { "@id": `${SITE}/#person` },
      areaServed: [{ "@type": "Country", name: "India" }, { "@type": "Place", name: "Worldwide" }],
      description:
        "Conversion-focused landing page design — custom-coded, fast, with copy, tracking and iteration built in. One page, one job: turn visitors into leads or sales.",
      url: canonical,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Services", item: `${SITE}/services/` },
        { "@type": "ListItem", position: 3, name: "Landing page design", item: canonical },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
});
---

<Studio
  title="High-Converting Landing Page Design — Divyansh Sood® Studio"
  description="Conversion-focused landing page design: custom-coded, fast, measured. Copy, design and build by one person — pages with one job: turning visitors into leads."
  canonical={canonical}
  keywords="high converting landing page design, conversion focused website design, landing page developer, CRO landing pages, custom coded landing page, landing page copywriting, conversion rate optimization"
  ogTitle="High-converting landing page design"
  ogDescription="One page, one job. Custom-coded, fast, measured — built to turn visitors into customers."
  jsonld={jsonld}
>
  <main>
    <header class="cs-hero">
      <div class="cs-hero-bg" aria-hidden="true"></div>
      <div class="wrap">
        <div class="cs-eyebrow">
          <span>Services</span><span>Landing pages · CRO</span><span>2026</span>
        </div>
        <h1 style="margin:14px 0 0;font-family:'Anton',sans-serif;font-weight:400;font-size:clamp(44px,8vw,108px);line-height:.9;letter-spacing:-.01em;text-transform:uppercase;">One page.<br /><span style="color:var(--accent);">One job: convert.</span></h1>
        <p class="cs-lead">High-converting landing page design for launches, ads and offers. Your traffic isn't the problem — the page is. I write, design and code landing pages as one continuous argument: clear offer, proof next to every claim, a single action, and load speed that respects the visitor.</p>
        <div class="cs-cta-row">
          <a class="btn btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Book a page call <span aria-hidden="true">↗</span></a>
          <a class="btn btn-ghost" href="/website-audit/">Get a free conversion audit</a>
        </div>
        <div class="cs-meta">
          <span>Copy + design + code, one person</span><span>Live in about a week</span>
        </div>
      </div>
    </header>

    <section class="cs-sec" aria-labelledby="offer-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="offer-h">What you get</h2>
          <span class="mono">The offering</span>
        </div>
        <div class="cs-body" data-reveal>
          {offers.map((o) => (
            <div class="cs-card">
              <span class="cs-tag">{o.t}</span>
              <h2 class="cs-card-h2">{o.d}</h2>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="cs-sec" aria-labelledby="proof-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="proof-h">Pages that pulled weight</h2>
          <span class="mono">Proof, not promises</span>
        </div>
        <div class="cs-metrics" data-reveal>
          <div class="cs-metric"><span class="cs-metric-v">~1,000</span><span class="cs-metric-l">Monthly bookings through one travel site</span></div>
          <div class="cs-metric"><span class="cs-metric-v">10×</span><span class="cs-metric-l">"More premium than competitors" — client founder</span></div>
          <div class="cs-metric"><span class="cs-metric-v">Direct</span><span class="cs-metric-l">Bookings recovered from Google Maps leakage</span></div>
          <div class="cs-metric"><span class="cs-metric-v">100</span><span class="cs-metric-l">Lighthouse SEO / best-practices on this site</span></div>
        </div>
        <div class="cs-body" data-reveal style="margin-top:22px;">
          <div class="cs-card">
            <span class="cs-tag">Nandini Travels · conversion rebuild</span>
            <p>A taxi operator losing every lead to Google Maps now takes direct bookings through an on-site form and one-tap WhatsApp CTA. <a href="/projects/nandini/">Read the case study →</a></p>
          </div>
          <div class="cs-card">
            <span class="cs-tag">Dharamshala Tours · booking flow</span>
            <p>Part of ~1,000 travel packages booked through the site every month — WhatsApp-first, built for phones on mountain networks. <a href="/projects/dharamshala-tours/">Read the case study →</a></p>
          </div>
          <div class="cs-card span2">
            <span class="cs-tag">More outcomes</span>
            <p>Bookings, admissions, sales and speed — the numbers clients actually got, collected in one place. <a href="/results/">See the results →</a></p>
          </div>
        </div>
      </div>
    </section>

    <section class="cs-sec" aria-labelledby="how-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="how-h">How a page gets built</h2>
          <span class="mono">The process</span>
        </div>
        <div class="cs-body" data-reveal>
          {how.map((s) => (
            <div class="cs-card">
              <span class="cs-tag">({s.n}) {s.t}</span>
              <h2 class="cs-card-h2">{s.d}</h2>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="cs-sec" aria-labelledby="read-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="read-h">Thinking on conversion</h2>
          <span class="mono">From the journal</span>
        </div>
        <div class="cs-body" data-reveal>
          <div class="cs-card">
            <span class="cs-tag">Your landing page doesn't have a traffic problem</span>
            <p>Why more visitors won't fix a page that doesn't make an argument. <a href="/blog/landing-page-conversion-not-traffic/">Read →</a></p>
          </div>
          <div class="cs-card">
            <span class="cs-tag">Page speed is a brand statement</span>
            <p>What a slow page says about you before a single word is read. <a href="/blog/page-speed-is-a-brand-statement/">Read →</a></p>
          </div>
          <div class="cs-card span2">
            <span class="cs-tag">Why business websites don't generate leads</span>
            <p>The five patterns that quietly kill conversion — and what to do instead. <a href="/blog/why-indian-websites-dont-generate-leads/">Read →</a></p>
          </div>
        </div>
      </div>
    </section>

    <section class="cs-sec" aria-labelledby="faq-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="faq-h">Frequently asked</h2>
          <span class="mono">Landing pages</span>
        </div>
        <div class="cs-faq">
          {faqs.map((f, i) => (
            <div class="cs-faq-row">
              <button class="cs-faq-q" data-faqtog={i} aria-expanded="false" aria-controls={`faq-lp-${i}`}>
                <span>{f.q}</span><span class="cs-faq-icon" data-faqicon={i} aria-hidden="true">+</span>
              </button>
              <div class="cs-faq-a" id={`faq-lp-${i}`} data-faqbody={i}><p>{f.a}</p></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="cs-endcta">
      <div class="wrap">
        <h2>Launching something?</h2>
        <p>Send the offer and where the traffic comes from. I'll tell you what the page needs to say — and quote the build in writing within 48 hours.</p>
        <div class="cs-cta-row" style="justify-content:center;">
          <a class="btn btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Book a page call <span aria-hidden="true">↗</span></a>
          <a class="btn btn-ghost" href="/services/">All services</a>
        </div>
      </div>
    </section>
  </main>
</Studio>

<script is:inline>
  (function () {
    var root = document.getElementById("ds-root");
    if (!root) return;
    var faq = -1;
    function sync() {
      root.querySelectorAll("[data-faqbody]").forEach(function (el) {
        var open = Number(el.getAttribute("data-faqbody")) === faq;
        el.style.maxHeight = open ? el.scrollHeight + "px" : "0px";
        el.style.opacity = open ? "1" : "0";
      });
      root.querySelectorAll("[data-faqicon]").forEach(function (el) {
        el.style.transform = Number(el.getAttribute("data-faqicon")) === faq ? "rotate(45deg)" : "rotate(0deg)";
      });
      root.querySelectorAll("[data-faqtog]").forEach(function (el) {
        el.setAttribute("aria-expanded", Number(el.getAttribute("data-faqtog")) === faq ? "true" : "false");
      });
    }
    root.querySelectorAll("[data-faqtog]").forEach(function (el) {
      el.addEventListener("click", function () {
        var i = Number(el.getAttribute("data-faqtog"));
        faq = faq === i ? -1 : i;
        sync();
      });
    });
    var rt;
    window.addEventListener("resize", function () {
      if (faq < 0) return;
      clearTimeout(rt);
      rt = setTimeout(sync, 120);
    });
    sync();
  })();
</script>
