---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/brand/PageHero.astro";
import Section from "../../components/brand/Section.astro";
import Rows from "../../components/brand/Rows.astro";
import Cards from "../../components/brand/Cards.astro";
import Steps from "../../components/brand/Steps.astro";
import ResultGrid from "../../components/brand/ResultGrid.astro";
import Faq from "../../components/brand/Faq.astro";
import EndCta from "../../components/brand/EndCta.astro";
import { SITE, CALENDLY_URL } from "../../lib/site.mjs";
import { TOPICS } from "../../lib/entity.mjs";

const canonical = `${SITE}/services/landing-page-design/`;

const offers = [
  { t: "Conversion-first structure", d: "One page, one job. Every section either moves the visitor toward the action or gets cut. Message before pixels." },
  { t: "Speed as a feature", d: "Custom-coded, no builder bloat. Landing pages that paint instantly on a phone on hotel Wi-Fi — because page speed is the first thing your brand says." },
  { t: "Copy + design + code", d: "One person owns the headline, the layout and the build, so the argument never gets lost in a handoff between three vendors." },
  { t: "Measured, not guessed", d: "Consent-gated analytics and event tracking wired in from day one. You'll know which section converts — not just how many people visited." },
];

const how = [
  { n: "01", t: "The offer comes first", d: "Before design: who lands here, from where, wanting what? If the offer is fuzzy, no amount of design saves it — and I'll say so." },
  { n: "02", t: "Wireframe in words", d: "The page as an argument: headline, proof, objection handling, action. You approve the argument before it becomes visuals." },
  { n: "03", t: "Designed in code", d: "You review a live URL on your own phone, not a mockup. Motion, speed and responsiveness are part of the review, not a surprise at launch." },
  { n: "04", t: "Launch, measure, iterate", d: "Ship, watch real behaviour, tighten. A landing page is a draft you improve with evidence — not a brochure you frame." },
];

const faqs = [
  { q: "What makes a landing page actually convert?", a: "Clarity of offer, proof close to the claim, one visible action, and load speed. Most pages don't have a traffic problem — they have a message problem. That's why the argument is designed before the visuals." },
  { q: "Landing page vs full website — which do I need?", a: "If you're running ads, validating an offer or launching one product, a landing page gets you live and learning in about a week. If you need to rank for many queries and tell a fuller story, that grows into a site — the landing page's message becomes its homepage." },
  { q: "How fast will it load?", a: "Custom-coded pages with inlined critical CSS and optimised assets — typically scoring high-90s on Lighthouse performance, with no builder JavaScript weighing them down. Speed is treated as part of the brand, not a technical afterthought." },
  { q: "Can you write the copy too?", a: "Yes — the headline, the structure and the objection-handling are half the work. You bring deep knowledge of your customers; I turn it into an argument that fits on one scroll." },
  { q: "What does a landing page cost?", a: "A single page with copy, design, build and tracking is the smallest engagement I take, and the cheapest way to work with me. Add variants for testing, or let the page grow into a small site, and it's quoted as a project instead. Either way you get one fixed number in writing before we start." },
];

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `${canonical}#service`,
      name: "High-converting landing page design",
      serviceType: "Landing page design and conversion optimization",
      provider: { "@id": `${SITE}/#person` },
      areaServed: [{ "@type": "Country", name: "India" }, { "@type": "Place", name: "Worldwide" }],
      description:
        "Conversion-focused landing page design — custom-coded, fast, with copy, tracking and iteration built in. One page, one job: turn visitors into leads or sales.",
      url: canonical,
      // Derived from the same `offers` array the page renders, so the catalogue
      // can never advertise something the page doesn't actually describe.
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Landing page design",
        itemListElement: offers.map((o) => ({
          "@type": "Offer",
          itemOffered: { "@type": "Service", name: o.t, description: o.d },
        })),
      },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Services", item: `${SITE}/services/` },
        { "@type": "ListItem", position: 3, name: "Landing page design", item: canonical },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
});
---

<Base
  title="High-Converting Landing Page Design — Divyansh Sood® Studio"
  description="Conversion-focused landing page design: custom-coded, fast, measured. Copy, design and build by one person — pages with one job: turning visitors into leads."
  canonical={canonical}
  keywords="high converting landing page design, conversion focused website design, landing page developer, CRO landing pages, custom coded landing page, landing page copywriting, conversion rate optimization"
  ogTitle="High-converting landing page design"
  ogDescription="One page, one job. Custom-coded, fast, measured — built to turn visitors into customers."
  topics={[TOPICS.cro, TOPICS.webDesign, TOPICS.webDevelopment]}
  jsonld={jsonld}
>
  <main>
    <PageHero
      display="One page. One job: convert."
      size="case"
      kicker="Services · Landing pages · CRO · 2026"
      lead={`High-converting landing page design for launches, ads and offers. Your traffic isn't the problem — the page is. I write, design and code landing pages as one continuous argument: clear offer, proof next to every claim, a single action, and load speed that respects the visitor.`}
    >
      <a class="btn btn--red" href={CALENDLY_URL}>Book a page call <span aria-hidden="true">→</span></a>
      <a class="btn btn--ink" href="/website-audit/">Get a free conversion audit</a>
      <Fragment slot="notes"><span>Copy + design + code, one person</span><span>Live in about a week</span></Fragment>
    </PageHero>

    <Section n={1} term="Setup" note="The offering" title="What you get">
      <Rows items={offers} />
    </Section>

    <Section n={2} term="Telemetry" note="Proof, not promises" title="Pages that pulled weight">
      <ResultGrid stats={[
        { v: `~1,000`, l: `Monthly bookings through one travel site` },
        { v: `10×`, l: `"More premium than competitors" — client founder` },
        { v: `Direct`, l: `Bookings recovered from Google Maps leakage` },
        { v: `100`, l: `Lighthouse SEO / best-practices on this site` },
      ]} />
      <div class="gap-top">
        <Cards items={[
          { tag: `Nandini Travels · conversion rebuild`, d: `A taxi operator losing every lead to Google Maps now takes direct bookings through an on-site form and one-tap WhatsApp CTA. <a href="/projects/nandini/">Read the case study →</a>` },
          { tag: `Dharamshala Tours · booking flow`, d: `Part of ~1,000 travel packages booked through the site every month — WhatsApp-first, built for phones on mountain networks. <a href="/projects/dharamshala-tours/">Read the case study →</a>` },
          { tag: `More outcomes`, wide: true, d: `Bookings, admissions, sales and speed — the numbers clients actually got, collected in one place. <a href="/results/">See the results →</a>` },
        ]} />
      </div>
    </Section>

    <Section n={3} term="Race weekend" note="The process" title="How a page gets built" tint>
      <Steps items={how} hot={3} />
    </Section>

    <Section n={4} term="Journal" note="From the journal" title="Thinking on conversion">
      <Cards items={[
        { tag: `A storefront that feels like the brand`, d: `Why a page built for your brand converts differently from a theme with your logo dropped in. <a href="/blog/storefront-that-feels-like-the-brand/">What separates a brand from a theme →</a>` },
        { tag: `Framer vs custom code`, d: `Where a builder is enough for a landing page, and the ceiling it hits once the page has to perform. <a href="/blog/framer-vs-custom-code-2026/">Framer vs custom code →</a>` },
        { tag: `Is your page leaking leads?`, wide: true, d: `Speed, the first screen, the call to action and the contact form, checked on your real page. <a href="/website-audit/">Get a free website audit →</a>` },
      ]} />
    </Section>

    <Section bare>
      <Faq faqs={faqs} label="(05) Before you ask" />
    </Section>

    <EndCta
      title="Launching something?"
      text={`Send the offer and where the traffic comes from. I'll tell you what the page needs to say — and quote the build in writing within 48 hours.`}
      primary={{ href: CALENDLY_URL, label: "Book a page call →" }}
      secondary={{ href: "/services/", label: "All services →" }}
    />
  </main>
</Base>
