---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/brand/PageHero.astro";
import Section from "../../components/brand/Section.astro";
import Rows from "../../components/brand/Rows.astro";
import Cards from "../../components/brand/Cards.astro";
import Steps from "../../components/brand/Steps.astro";
import ResultGrid from "../../components/brand/ResultGrid.astro";
import Faq from "../../components/brand/Faq.astro";
import EndCta from "../../components/brand/EndCta.astro";
import { SITE, CALENDLY_URL } from "../../lib/site.mjs";
import { TOPICS } from "../../lib/entity.mjs";

const canonical = `${SITE}/services/seo-geo-services/`;

const offers = [
  { t: "Technical SEO, done in code", d: "Clean semantic markup, structured data graphs, honest sitemaps, canonical discipline, Core Web Vitals — built into the site, not sprinkled on after." },
  { t: "GEO — be the answer, not a link", d: "Search is splitting into links and answers. Generative Engine Optimization makes ChatGPT, Claude, Gemini and Perplexity cite you when buyers ask." },
  { t: "AI-crawler access & llms.txt", d: "Robots rules that welcome answer-engine crawlers, server-rendered pages they can actually read, and an llms.txt at the root. Google ignores that file and I'll say so — the crawler access and the readable pages are what carry this line." },
  { t: "Schema that search trusts", d: "Organization, Service, FAQ, Breadcrumb and Article graphs wired to your real entities — your Google Business Profile, your reviews, your work." },
];

const how = [
  { n: "01", t: "Audit what engines see", d: "Crawl, indexing, structured data, entity signals, AI-citability. You get the gap list in plain language — what's broken, what's missing, what it's worth." },
  { n: "02", t: "Fix in the codebase", d: "I implement in your actual code — not a report you have to hand to another developer. Markup, schema, speed, llms.txt, sitemaps." },
  { n: "03", t: "Make the brand quotable", d: "Tight, factual, source-worthy copy blocks that both Google snippets and AI answers can quote — with your name attached." },
  { n: "04", t: "Measure both halves", d: "Rankings and clicks from classic search; AI-referred sessions from the answer half. Both tracked, both reported monthly." },
];

const faqs = [
  { q: "What is GEO (Generative Engine Optimization)?", a: "GEO is optimizing your site so AI assistants — ChatGPT, Claude, Gemini, Perplexity — cite and recommend your business in their answers. It combines structured data, quotable factual copy, llms.txt and crawler access, and it compounds with classic SEO rather than replacing it." },
  { q: "Does llms.txt actually work?", a: "Not the way it's usually sold. Google confirmed in 2026 that its search systems ignore llms.txt entirely, and independent analysis across roughly 300,000 domains found no statistically significant relationship between having the file and being cited by AI. I publish that despite selling GEO and giving away an llms.txt generator. Every site I ship still gets one, because it costs half an hour and genuinely helps when an agent or a person points a model straight at your domain — but it is the smallest part of this service. What actually moves AI citations is the structured data, the entity graph and the quotable copy, which is the bulk of what you're buying here." },
  { q: "Is this a retainer or a one-time project?", a: "Both exist. A technical SEO + GEO implementation is a one-time project on your codebase. Ongoing content, tracking and iteration can run as a light monthly engagement — but nothing here requires a forever-contract." },
  { q: "Do you also handle classic SEO?", a: "Yes — technical SEO is the foundation: crawlability, structured data, Core Web Vitals, canonical hygiene, honest sitemaps. GEO is built on top of that. A site that's illegible to Googlebot is illegible to AI crawlers too." },
  { q: "What does SEO / GEO work cost?", a: "It depends on whether it rides along with a build or stands alone, and on how much of the technical foundation already exists. The honest first step costs nothing: send your URL for a free website audit and you'll get the findings whether or not you hire me. If implementation makes sense after that, it's quoted fixed and in writing." },
];

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": `${canonical}#service`,
      name: "SEO and Generative Engine Optimization (GEO) services",
      serviceType: "SEO, AEO and Generative Engine Optimization",
      provider: { "@id": `${SITE}/#person` },
      areaServed: [{ "@type": "Country", name: "India" }, { "@type": "Place", name: "Worldwide" }],
      description:
        "Technical SEO and Generative Engine Optimization implemented directly in your codebase — structured data, Core Web Vitals, llms.txt and AI-crawler strategy, so both Google and AI assistants recommend you.",
      url: canonical,
      // Derived from the same `offers` array the page renders, so the catalogue
      // can never advertise something the page doesn't actually describe.
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "SEO and Generative Engine Optimization",
        itemListElement: offers.map((o) => ({
          "@type": "Offer",
          itemOffered: { "@type": "Service", name: o.t, description: o.d },
        })),
      },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Services", item: `${SITE}/services/` },
        { "@type": "ListItem", position: 3, name: "SEO & GEO services", item: canonical },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
});
---

<Base
  title="SEO & GEO Services — Get Found by Google and Cited by AI"
  description="Technical SEO plus Generative Engine Optimization, built into your codebase: structured data, Core Web Vitals, llms.txt and AI-crawler strategy. Be the answer."
  canonical={canonical}
  keywords="generative engine optimization services, GEO services, AI SEO consultant, llms.txt implementation, AEO services, technical SEO developer, get cited by ChatGPT, structured data implementation"
  ogTitle="SEO & GEO services"
  ogDescription="Search is splitting into links and answers. I make you visible in both halves — implemented in code, not slides."
  topics={[TOPICS.seo, TOPICS.ai, TOPICS.webDevelopment]}
  jsonld={jsonld}
>
  <main>
    <PageHero
      display="Ranked by Google. Quoted by AI."
      size="case"
      kicker="Services · SEO · GEO · AEO · 2026"
      lead={`Search is splitting in two: links and answers. Classic SEO gets you the links half. Generative Engine Optimization — structured data, quotable copy, llms.txt, AI-crawler access — gets ChatGPT, Claude, Gemini and Perplexity to cite you in the answers half. I implement both, directly in your codebase, as a developer — not as a slide deck.`}
    >
      <a class="btn btn--red" href={CALENDLY_URL}>Book an SEO/GEO call <span aria-hidden="true">→</span></a>
      <a class="btn btn--ink" href="/website-audit/">Get a free audit first</a>
      <Fragment slot="notes"><span>Implemented in code, not reports</span><span>Google + AI assistants, both halves</span></Fragment>
    </PageHero>

    <Section n={1} term="Setup" note="The offering" title="What's in the work">
      <Rows items={offers} />
    </Section>

    <Section n={2} term="Telemetry" note="Proof, not promises" title="Practised, not preached">
      <ResultGrid stats={[
        { v: `llms.txt`, l: `At the root of every site I ship` },
        { v: `100`, l: `Lighthouse SEO score, this site` },
        { v: `25+`, l: `AI crawlers explicitly welcomed on this site` },
        { v: `JSON-LD`, l: `Entity graph on every page, not just home` },
      ]} />
      <div class="gap-top">
        <Cards items={[
          { tag: `Free tool · llms.txt generator`, d: `I built the generator I use on client work and left it open to everyone — fill in a few fields, get a valid file for your own root. <a href="/tools/llms-txt-generator/">Generate yours free →</a>` },
          { tag: `This site · the lab`, d: `Everything I sell runs here first: schema graphs, honest sitemaps, llms.txt, IndexNow, analytics. View source — it's all inspectable.` },
        ]} />
      </div>
    </Section>

    <Section n={3} term="Race weekend" note="The process" title="How the work runs" tint>
      <Steps items={how} hot={3} />
    </Section>

    <Section n={4} term="Journal" note="From the journal" title="Thinking on search & AI">
      <Cards items={[
        { tag: `Free tool`, wide: true, d: `<strong>Try the free llms.txt generator.</strong> Write a clean plain-text brief of your business in your browser, no sign-up. Google ignores the file; the exercise of stating plainly what you do is the part that pays. <a href="/tools/llms-txt-generator/">Open the free llms.txt generator →</a>` },
        { tag: `AEO, GEO, LLMO and AI SEO`, d: `Which of the new acronyms name something real, and what the work actually collapses into. <a href="/blog/aeo-geo-llmo-ai-seo-explained/">AEO vs GEO vs LLMO, explained →</a>` },
        { tag: `Ranking on Google Maps`, d: `The seven things that decide whether a local business shows in the map pack, in order of impact. <a href="/blog/rank-on-google-maps-himachal/">How to rank on Google Maps in Himachal →</a>` },
        { tag: `What is llms.txt?`, d: `What the file is, what the evidence says about it, and why I still ship one. <a href="/blog/what-is-llms-txt/">An honest answer on whether llms.txt works →</a>` },
        { tag: `AI website builders vs a human developer`, wide: true, d: `Where AI tooling genuinely helps, and where judgment still wins. <a href="/blog/ai-website-builder-vs-developer-india/">AI website builders vs a human developer →</a>` },
      ]} />
    </Section>

    <Section bare>
      <Faq faqs={faqs} label="(05) Before you ask" />
    </Section>

    <EndCta
      title="Invisible in AI answers?"
      text={`Ask ChatGPT about your category. If a competitor comes up and you don't, send me your URL — the free audit will show you why.`}
      primary={{ href: "/website-audit/", label: "Get the free audit →" }}
      secondary={{ href: CALENDLY_URL, label: "Book a call →" }}
    />
  </main>
</Base>
