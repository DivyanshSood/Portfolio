---
import Tool from "../../layouts/Tool.astro";

const faqs = [
  { q: "What contrast ratio do I need?", a: "WCAG 2.2 level AA, the usual legal and practical target, asks for 4.5:1 for normal text and 3:1 for large text (about 24 px regular or 18.7 px bold and up) and for icons, borders and other interface parts. Level AAA asks for 7:1 and 4.5:1." },
  { q: "How is the ratio calculated?", a: "From the relative luminance of the two colours, (L1 + 0.05) / (L2 + 0.05), with the lighter colour on top, exactly as WCAG defines it. It runs from 1:1 (identical colours) to 21:1 (black on white)." },
  { q: "How does “nearest passing shade” work?", a: "It keeps your text colour’s hue and saturation and darkens or lightens it step by step until it passes, so the fix stays as close to your brand colour as possible. Copy the hex and try it in your design." },
  { q: "Is this the same check Lighthouse runs?", a: "Yes, Lighthouse’s colour-contrast audit uses the same WCAG formula and thresholds. Lighthouse checks the colours as rendered on the page, including text over images, which a two-colour checker can’t see." },
];
---

<Tool
  slug="color-contrast-checker"
  title="Colour Contrast Checker: WCAG AA & AAA with Fix Suggestions"
  description="Check text and background colours against WCAG 2.2 AA and AAA, see the contrast ratio, and get the nearest shade that passes. Free, in your browser."
  keywords="color contrast checker, colour contrast checker, wcag contrast checker, contrast ratio calculator, accessible colors, aa contrast, aaa contrast"
  ogTitle="Colour contrast checker"
  ogDescription="WCAG AA and AAA contrast for any two colours, plus the nearest shade that passes. Free."
  display="Readable for everyone."
  kicker="Free tool · Accessibility · WCAG · No sign-up"
  lead="Pick a text colour and a background. You get the <strong>WCAG contrast ratio</strong>, a pass or fail for <strong>AA and AAA</strong> at normal and large sizes and for interface parts, and the <strong>nearest shade</strong> of your colour that passes, so you can keep the brand and still be readable."
  appName="Colour Contrast Checker"
  appDescription="A free, browser-based WCAG 2.2 colour contrast checker that shows the ratio, AA/AAA results for text and UI components, and suggests the nearest passing shade. No sign-up."
  category="DesignApplication"
  toolTitle="Check two colours"
  toolNote="Live result"
  cards={[
    { tag: "Red is hard", d: "Bright brand reds and oranges rarely reach 4.5:1 on white at body-text size. A common fix: keep the bright red for large headings and buttons, and use a darker red for small text." },
    { tag: "Audit the whole page", d: `Lighthouse checks every text element as rendered. <a href="/tools/lighthouse-report-explainer/">Explain a Lighthouse report →</a>` },
  ]}
  faqs={faqs}
  end={{ title: "Want an accessible site by default?", text: "Every site I build is checked for contrast, labels, focus and tap sizes before it launches.", primary: { href: "/services/website-development/", label: "Website development →" } }}
>
  <div class="tk">
    <form class="form" id="cc-form" autocomplete="off" novalidate>
      <div class="cc-pair">
        <label class="field" for="cc-fg">Text colour<span class="cc-in"><input type="color" id="cc-fgc" value="#E4151F" aria-label="Pick text colour" /><input type="text" id="cc-fg" value="#E4151F" spellcheck="false" maxlength="7" /></span></label>
        <button type="button" class="tk-add cc-swap" id="cc-swap" aria-label="Swap colours">⇄</button>
        <label class="field" for="cc-bg">Background<span class="cc-in"><input type="color" id="cc-bgc" value="#FFFFFF" aria-label="Pick background colour" /><input type="text" id="cc-bg" value="#FFFFFF" spellcheck="false" maxlength="7" /></span></label>
      </div>
      <div class="cc-sample" id="cc-sample">
        <p class="cc-lg">Large text · 24px</p>
        <p>Normal text at 16px. The quick brown fox jumps over the lazy dog.</p>
        <p class="cc-sm">Small print at 12px, where low contrast hurts most.</p>
        <span class="cc-btn">Button border</span>
      </div>
    </form>
    <div class="tk-out">
      <div class="tk-bar"><span>Contrast</span></div>
      <div class="tk-body">
        <div class="tk-big" id="cc-ratio">–</div>
        <table class="tk-table" id="cc-table"></table>
        <div id="cc-fix"></div>
      </div>
    </div>
  </div>
</Tool>

<script>
  import { $, live, copyText, track } from "../../scripts/tools-kit.js";
  const TOOL = "contrast";
  const fg = $("cc-fg") as HTMLInputElement, bg = $("cc-bg") as HTMLInputElement;
  const fgc = $("cc-fgc") as HTMLInputElement, bgc = $("cc-bgc") as HTMLInputElement;

  const hex = (s: string) => { s = s.trim().replace(/^#?/, "#"); if (/^#[0-9a-f]{3}$/i.test(s)) s = "#" + [...s.slice(1)].map((c) => c + c).join(""); return /^#[0-9a-f]{6}$/i.test(s) ? s.toUpperCase() : ""; };
  const rgb = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
  const lum = (h: string) => { const [r, g, b] = rgb(h).map((v) => { v /= 255; return v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4; }); return 0.2126 * r + 0.7152 * g + 0.0722 * b; };
  const ratio = (a: string, b: string) => { const [x, y] = [lum(a), lum(b)].sort((m, n) => n - m); return (x + 0.05) / (y + 0.05); };

  function hsl(h: string) {
    const [r, g, b] = rgb(h).map((v) => v / 255);
    const mx = Math.max(r, g, b), mn = Math.min(r, g, b), l = (mx + mn) / 2;
    let hh = 0, s = 0;
    if (mx !== mn) {
      const d = mx - mn; s = l > 0.5 ? d / (2 - mx - mn) : d / (mx + mn);
      hh = mx === r ? (g - b) / d + (g < b ? 6 : 0) : mx === g ? (b - r) / d + 2 : (r - g) / d + 4; hh /= 6;
    }
    return [hh, s, l];
  }
  function fromHsl(h: number, s: number, l: number) {
    const f = (n: number) => { const k = (n + h * 12) % 12, a = s * Math.min(l, 1 - l); return Math.round(255 * (l - a * Math.max(-1, Math.min(k - 3, 9 - k, 1)))); };
    return "#" + [f(0), f(8), f(4)].map((v) => v.toString(16).padStart(2, "0")).join("").toUpperCase();
  }
  // Walk the text colour's lightness away from the background until it passes.
  function nearest(f: string, b: string, target: number) {
    const [h, s, l] = hsl(f);
    const dir = lum(b) > 0.18 ? -1 : 1;
    for (let step = 0; step <= 100; step++) {
      const c = fromHsl(h, s, Math.min(1, Math.max(0, l + dir * step / 100)));
      if (ratio(c, b) >= target) return c;
    }
    return dir < 0 ? "#000000" : "#FFFFFF";
  }

  function render() {
    const f = hex(fg.value), b = hex(bg.value);
    if (!f || !b) { $("cc-ratio")!.textContent = "–"; return; }
    fgc.value = f; bgc.value = b;
    const r = ratio(f, b);
    const s = $("cc-sample")!; s.style.color = f; s.style.background = b; s.style.setProperty("--cc", f);
    $("cc-ratio")!.textContent = (Math.floor(r * 100) / 100).toFixed(2) + " : 1";
    const rows: [string, number, number][] = [["Normal text", 4.5, 7], ["Large text (24px+, or 18.7px bold)", 3, 4.5], ["Icons, borders, UI parts", 3, 0]];
    const pill = (ok: boolean) => `<span class="tk-pill ${ok ? "tk-pill--ok" : "tk-pill--bad"}">${ok ? "Pass" : "Fail"}</span>`;
    $("cc-table")!.innerHTML = `<thead><tr><th></th><th>AA</th><th>AAA</th></tr></thead><tbody>${rows.map(([n, aa, aaa]) => `<tr><td>${n}</td><td>${pill(r >= aa)}</td><td>${aaa ? pill(r >= aaa) : "–"}</td></tr>`).join("")}</tbody>`;
    const fixes = [[4.5, "AA normal text"], [7, "AAA normal text"]].filter(([t]) => r < (t as number)).map(([t, n]) => {
      const c = nearest(f, b, t as number);
      return `<button type="button" class="cc-fixbtn" data-c="${c}"><i style="background:${c}"></i><span><b>${c}</b> passes ${n} (${ratio(c, b).toFixed(2)}:1). Tap to use.</span></button>`;
    });
    $("cc-fix")!.innerHTML = fixes.length ? `<p class="tk-msg">Nearest passing shade of your text colour:</p>${fixes.join("")}` : `<p class="tk-msg">Passes everything at every size.</p>`;
  }

  fgc.addEventListener("input", () => { fg.value = fgc.value.toUpperCase(); render(); });
  bgc.addEventListener("input", () => { bg.value = bgc.value.toUpperCase(); render(); });
  $("cc-swap")!.addEventListener("click", () => { [fg.value, bg.value] = [bg.value, fg.value]; render(); });
  $("cc-fix")!.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest("[data-c]") as HTMLElement | null;
    if (b) { fg.value = b.dataset.c!; copyText(b.dataset.c!); render(); track(TOOL, "use_fix"); }
  });
  live("cc-form", render, TOOL);
</script>

<style>
  .cc-pair{display:grid;grid-template-columns:1fr auto 1fr;gap:12px;align-items:end}
  .cc-in{display:flex;gap:10px;align-items:center}
  .cc-in input[type=color]{width:52px;height:52px;padding:0;border:1px solid var(--gda);flex:none;cursor:pointer}
  .cc-swap{min-width:48px;padding:0}
  .cc-sample{padding:24px;border:1px solid var(--gda)}
  .cc-sample p{margin:0 0 10px;font-size:16px;line-height:1.5}
  .cc-lg{font-size:24px !important;font-weight:700}
  .cc-sm{font-size:12px !important}
  .cc-btn{display:inline-block;padding:10px 16px;border:2px solid var(--cc);font-size:14px}
  #cc-fix :global(.cc-fixbtn){display:flex;gap:12px;align-items:center;width:100%;margin-top:10px;padding:10px;border:1px solid var(--gda);background:#fff;cursor:pointer;text-align:left;font-size:15px;color:var(--ink)}
  #cc-fix :global(.cc-fixbtn i){width:32px;height:32px;flex:none;border:1px solid var(--gda)}
  #cc-fix :global(.cc-fixbtn:hover){border-color:var(--ink)}
</style>
