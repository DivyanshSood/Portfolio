---
import Studio from "../../layouts/Studio.astro";
import { SITE, CALENDLY_URL } from "../../lib/site.mjs";
import { TOPICS } from "../../lib/entity.mjs";

const canonical = `${SITE}/tools/llms-txt-generator/`;

const faqs = [
  { q: "What is llms.txt?", a: "llms.txt is a plain-text file you place at the root of your domain (yoursite.com/llms.txt) holding a clean, machine-readable summary of your business: what you do, your key pages, and how to contact you. It was proposed as a way to hand a language model a curated brief instead of making it infer one from your HTML. It's a community convention rather than a standard any major search engine has adopted — see the next answer for what the evidence says about it." },
  { q: "Is this llms.txt generator really free?", a: "Yes — completely free, no sign-up, nothing stored. Everything runs in your browser; your inputs never leave your device. Fill the fields, copy or download the file, and upload it to your site's root." },
  { q: "Where do I put the file once it's generated?", a: "Upload it to the root of your domain so it's reachable at https://yoursite.com/llms.txt. On most hosts that means dropping it in your public / static folder. Optionally link to it from your robots.txt as a comment, and allow AI crawlers there too." },
  { q: "Does llms.txt actually help me get cited by AI?", a: "On the evidence so far, no — not on its own. Google confirmed in 2026 that its search systems, generative features included, ignore llms.txt, and independent analysis across roughly 300,000 domains found no statistically significant relationship between having the file and being cited by AI. Server logs show AI crawlers requesting it in around a tenth of a percent of their hits. It's still worth the half hour: it helps in the narrow case where an agent or a person points a model straight at your domain, and writing it forces you to state plainly what your business does. What actually earns citations is being indexed and ranking, answering the question directly on the page, structured data that says who wrote it, and copy that survives being quoted. That fuller implementation is what I do as a service — this file is the free, easy part." },
  { q: "What's the difference between llms.txt and llms-full.txt?", a: "llms.txt is the concise index — summary, services, key pages, contact. llms-full.txt is an optional expanded corpus with your full positioning, FAQs and detail, for models that want more context. This generator produces the concise llms.txt; the deep version is part of a full GEO implementation." },
];

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "@id": `${canonical}#app`,
      name: "Free llms.txt Generator",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Web browser",
      url: canonical,
      description:
        "A free, browser-based tool that generates an llms.txt file for your business — a machine-readable plain-text brief of what you do and which pages matter. No sign-up, nothing stored.",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      author: { "@id": `${SITE}/#person` },
      provider: { "@id": `${SITE}/#studio` },
      isAccessibleForFree: true,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Tools", item: `${SITE}/tools/` },
        { "@type": "ListItem", position: 3, name: "llms.txt generator", item: canonical },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
});
---

<Studio
  title="Free llms.txt Generator — Make Your Site Readable by AI"
  description="Generate a spec-correct llms.txt — a plain-text brief of your business for language models. Free, no sign-up, nothing stored, plus an honest note on what it does."
  ogDescription="Write a spec-correct llms.txt from five fields, free and in your browser — with a straight answer on what the file actually does."
  canonical={canonical}
  keywords="llms.txt generator, free llms.txt tool, generate llms.txt, llms.txt file, AI SEO tool, GEO tool, make website readable by AI, llms.txt example"
  ogTitle="Free llms.txt generator"
  ogDescription="Make your site legible to ChatGPT, Claude, Gemini & Perplexity. Fill five fields, copy the file, ship it. Free."
  topics={[TOPICS.ai, TOPICS.llm, TOPICS.seo]}
  jsonld={jsonld}
>
  <main>
    <header class="cs-hero">
      <div class="wrap">
        <div class="cs-eyebrow">
          <span>Free tool</span><span>GEO · AI search</span><span>No sign-up</span>
        </div>
        <h1 style="margin:14px 0 0;font-family:'Anton',sans-serif;font-weight:400;font-size:clamp(40px,7.5vw,96px);line-height:.9;letter-spacing:-.01em;text-transform:uppercase;">The free<br /><span style="color:var(--accent);">llms.txt generator.</span></h1>
        <p class="cs-lead">An <em>llms.txt</em> is a plain-text brief of your business at your domain root. Fill in five fields below, copy the file, drop it at <strong>yoursite.com/llms.txt</strong>. Runs entirely in your browser — nothing is stored or sent anywhere. <strong>Straight answer before you start:</strong> Google has confirmed its search systems ignore this file, and at ~300,000 domains there's no measurable link between having one and being cited by AI. It's worth thirty minutes, not a budget line — <a href="/blog/what-is-llms-txt/">here's the full evidence and what does work</a>.</p>
      </div>
    </header>

    <section class="cs-sec" aria-labelledby="tool-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="tool-h">Build your llms.txt</h2>
          <span class="mono">Live preview →</span>
        </div>

        <div class="lg-grid">
          <form class="lg-form" id="lg-form" autocomplete="off" novalidate>
            <label class="lg-field">
              <span class="lg-label">Business / brand name <b>*</b></span>
              <input type="text" id="lg-name" placeholder="Acme Studio" required />
            </label>
            <label class="lg-field">
              <span class="lg-label">Website URL <b>*</b></span>
              <input type="url" id="lg-url" placeholder="https://acme.com" inputmode="url" required />
            </label>
            <label class="lg-field">
              <span class="lg-label">One-line summary <b>*</b></span>
              <input type="text" id="lg-summary" placeholder="Independent design studio for D2C brands." required />
            </label>
            <label class="lg-field">
              <span class="lg-label">Services — one per line</span>
              <textarea id="lg-services" rows="4" placeholder="Brand identity&#10;E-commerce design&#10;Packaging"></textarea>
            </label>
            <label class="lg-field">
              <span class="lg-label">Key pages — <span class="mono lg-hint">Label | https://url</span> per line</span>
              <textarea id="lg-pages" rows="4" placeholder="Services | https://acme.com/services&#10;Work | https://acme.com/work&#10;Contact | https://acme.com/contact"></textarea>
            </label>
            <div class="lg-two">
              <label class="lg-field">
                <span class="lg-label">Contact email</span>
                <input type="email" id="lg-email" placeholder="hello@acme.com" inputmode="email" />
              </label>
              <label class="lg-field">
                <span class="lg-label">Location <span class="lg-hint">(optional)</span></span>
                <input type="text" id="lg-location" placeholder="Lisbon, Portugal" />
              </label>
            </div>
          </form>

          <div class="lg-out">
            <div class="lg-out-bar">
              <span class="mono lg-file">llms.txt</span>
              <div class="lg-actions">
                <button type="button" class="lg-btn" id="lg-copy" data-cursor="COPY">Copy</button>
                <button type="button" class="lg-btn lg-btn-solid" id="lg-download" data-cursor="SAVE">Download</button>
              </div>
            </div>
            <pre class="lg-pre" id="lg-preview" aria-live="polite" tabindex="0"></pre>
          </div>
        </div>

        <p class="lg-note mono">Nothing here is uploaded — the file is built in your browser. After downloading, place it at your domain root so it resolves at <b>/llms.txt</b>, and allow AI crawlers in your robots.txt.</p>
      </div>
    </section>

    <section class="cs-sec" aria-labelledby="next-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="next-h">llms.txt is the small step</h2>
          <span class="mono">Go further</span>
        </div>
        <div class="cs-body" data-reveal>
          <div class="cs-card">
            <span class="cs-tag">Understand it</span>
            <p>The plain-English explainer: what the file is, what Google and the research actually say about it, and why I still ship one. <a href="/blog/what-is-llms-txt/">An honest answer on whether llms.txt works →</a></p>
          </div>
          <div class="cs-card">
            <span class="cs-tag">Get quoted by AI</span>
            <p>This is the part that actually moves citations: rank for the question, answer it on the page, and write copy that survives being quoted. <a href="/blog/make-your-brand-quotable-by-ai-geo-2026/">The 2026 GEO playbook →</a></p>
          </div>
          <div class="cs-card span2">
            <span class="cs-tag">Done properly, for you</span>
            <p>Want the full implementation — llms.txt, schema graphs, AI-crawler strategy and quotable copy wired into your codebase so Google ranks you <strong>and</strong> AI assistants recommend you? That's my <a href="/services/seo-geo-services/">SEO &amp; GEO service →</a></p>
          </div>
        </div>
      </div>
    </section>

    <section class="cs-sec" aria-labelledby="faq-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="faq-h">Frequently asked</h2>
          <span class="mono">llms.txt</span>
        </div>
        <div class="cs-faq">
          {faqs.map((f, i) => (
            <div class="cs-faq-row">
              <button class="cs-faq-q" data-faqtog={i} aria-expanded="false" aria-controls={`faq-lg-${i}`}>
                <span>{f.q}</span><span class="cs-faq-icon" data-faqicon={i} aria-hidden="true">+</span>
              </button>
              <div class="cs-faq-a" id={`faq-lg-${i}`} data-faqbody={i}><p>{f.a}</p></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="cs-endcta">
      <div class="wrap">
        <h2>Want AI to actually recommend you?</h2>
        <p>The generator gets you a file. Getting cited in AI answers takes the full GEO stack — implemented in your codebase. Let's talk about your site.</p>
        <div class="cs-cta-row" style="justify-content:center;">
          <a class="btn btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Book a GEO call <span aria-hidden="true">↗</span></a>
          <a class="btn btn-ghost" href="/tools/">More free tools</a>
        </div>
      </div>
    </section>
  </main>
</Studio>

<style>
  .lg-grid { display:grid; grid-template-columns:1fr 1fr; gap:22px; align-items:start; }
  @media (max-width:900px){ .lg-grid { grid-template-columns:1fr; } }
  .lg-form { display:flex; flex-direction:column; gap:16px; }
  .lg-two { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  @media (max-width:480px){ .lg-two { grid-template-columns:1fr; } }
  .lg-field { display:flex; flex-direction:column; gap:7px; }
  .lg-label { font-family:'JetBrains Mono',monospace; font-size:var(--fs-label-lg); letter-spacing:.1em; text-transform:uppercase; color:#8A8A93; }
  .lg-label b { color:var(--accent); font-weight:400; }
  .lg-hint { text-transform:none; letter-spacing:.02em; color:#6f6f77; }
  .lg-field input, .lg-field textarea {
    width:100%; background:#131316; border:1px solid rgba(244,242,236,.16); border-radius:9px;
    color:#F4F2EC; font-family:inherit; font-size:15px; padding:12px 14px; line-height:1.5; resize:vertical;
  }
  .lg-field textarea { font-family:'JetBrains Mono',monospace; font-size:13px; }
  .lg-field input:focus, .lg-field textarea:focus { outline:none; border-color:var(--accent); box-shadow:0 0 0 3px rgba(217,255,60,.14); }
  .lg-field input::placeholder, .lg-field textarea::placeholder { color:#55555C; }

  .lg-out { position:sticky; top:86px; border:1px solid rgba(244,242,236,.16); border-radius:12px; overflow:hidden; background:#0b0b0c; }
  @media (max-width:900px){ .lg-out { position:static; } }
  .lg-out-bar { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:12px 14px; border-bottom:1px solid rgba(244,242,236,.12); background:#131316; }
  .lg-file { font-size:var(--fs-label-lg); letter-spacing:var(--ls-label); text-transform:uppercase; color:#8A8A93; }
  .lg-actions { display:flex; gap:8px; }
  .lg-btn { font-family:'JetBrains Mono',monospace; font-size:var(--fs-label); letter-spacing:.1em; text-transform:uppercase; padding:8px 14px; border-radius:999px; cursor:pointer; border:1px solid rgba(244,242,236,.28); background:transparent; color:#F4F2EC; transition:transform .15s ease, background .15s ease; }
  .lg-btn:hover { transform:translateY(-1px); }
  .lg-btn-solid { background:var(--accent); color:#0b0b0c; border-color:var(--accent); }
  .lg-btn.is-done { background:var(--accent); color:#0b0b0c; border-color:var(--accent); }
  .lg-pre { margin:0; padding:18px 16px; font-family:'JetBrains Mono',monospace; font-size:12.5px; line-height:1.7; color:#C9C7C0; white-space:pre-wrap; word-break:break-word; max-height:560px; overflow:auto; }
  .lg-note { margin-top:20px; font-size:var(--fs-label-lg); letter-spacing:.05em; color:#6f6f77; line-height:1.7; }
  .lg-note b { color:#8A8A93; }
</style>

<script is:inline>
  (function () {
    var root = document.getElementById("ds-root");
    if (!root) return;

    // ---- FAQ accordion (same pattern as the service pages) ----
    var faq = -1;
    function syncFaq() {
      root.querySelectorAll("[data-faqbody]").forEach(function (el) {
        var open = Number(el.getAttribute("data-faqbody")) === faq;
        el.style.maxHeight = open ? el.scrollHeight + "px" : "0px";
        el.style.opacity = open ? "1" : "0";
      });
      root.querySelectorAll("[data-faqicon]").forEach(function (el) {
        el.style.transform = Number(el.getAttribute("data-faqicon")) === faq ? "rotate(45deg)" : "rotate(0deg)";
      });
      root.querySelectorAll("[data-faqtog]").forEach(function (el) {
        el.setAttribute("aria-expanded", Number(el.getAttribute("data-faqtog")) === faq ? "true" : "false");
      });
    }
    root.querySelectorAll("[data-faqtog]").forEach(function (el) {
      el.addEventListener("click", function () {
        var i = Number(el.getAttribute("data-faqtog"));
        faq = faq === i ? -1 : i;
        syncFaq();
      });
    });
    window.addEventListener("resize", function () { if (faq >= 0) syncFaq(); });
    syncFaq();

    // ---- llms.txt generator ----
    var $ = function (id) { return document.getElementById(id); };
    var fields = ["lg-name", "lg-url", "lg-summary", "lg-services", "lg-pages", "lg-email", "lg-location"];
    var preview = $("lg-preview");

    function cleanUrl(u) {
      u = (u || "").trim();
      if (!u) return "";
      if (!/^https?:\/\//i.test(u)) u = "https://" + u;
      return u.replace(/\/+$/, "");
    }
    function lines(v) {
      return (v || "").split("\n").map(function (s) { return s.trim(); }).filter(Boolean);
    }

    function build() {
      var name = ($("lg-name").value || "").trim() || "Your Business";
      var url = cleanUrl($("lg-url").value) || "https://yoursite.com";
      var summary = ($("lg-summary").value || "").trim() || "A short one-line description of what you do.";
      var services = lines($("lg-services").value);
      var pages = lines($("lg-pages").value);
      var email = ($("lg-email").value || "").trim();
      var location = ($("lg-location").value || "").trim();

      var out = [];
      out.push("# " + name);
      out.push("");
      out.push("> " + summary);
      out.push("");
      if (location) { out.push("- Location: " + location); out.push(""); }

      if (services.length) {
        out.push("## Services");
        out.push("");
        services.forEach(function (s) { out.push("- " + s); });
        out.push("");
      }

      if (pages.length) {
        out.push("## Key pages");
        out.push("");
        pages.forEach(function (line) {
          var parts = line.split("|");
          if (parts.length >= 2) {
            var label = parts[0].trim();
            var href = cleanUrl(parts.slice(1).join("|"));
            out.push("- [" + label + "](" + href + ")");
          } else {
            out.push("- " + cleanUrl(line));
          }
        });
        out.push("");
      }

      out.push("## Contact");
      out.push("");
      out.push("- Website: " + url);
      if (email) out.push("- Email: " + email);
      out.push("");

      out.push("<!-- Generated free at https://www.divyanshsood.com/tools/llms-txt-generator/ -->");
      out.push("");
      return out.join("\n");
    }

    function render() { preview.textContent = build(); }
    fields.forEach(function (id) {
      var el = $(id);
      if (el) el.addEventListener("input", render);
    });
    render();

    // Copy
    var copyBtn = $("lg-copy");
    copyBtn.addEventListener("click", function () {
      var text = build();
      var done = function () {
        copyBtn.textContent = "Copied ✓";
        copyBtn.classList.add("is-done");
        setTimeout(function () { copyBtn.textContent = "Copy"; copyBtn.classList.remove("is-done"); }, 1600);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(done, function () { fallbackCopy(text); done(); });
      } else { fallbackCopy(text); done(); }
    });
    function fallbackCopy(text) {
      var ta = document.createElement("textarea");
      ta.value = text; ta.style.position = "fixed"; ta.style.opacity = "0";
      document.body.appendChild(ta); ta.select();
      try { document.execCommand("copy"); } catch (e) {}
      document.body.removeChild(ta);
    }

    // Download
    $("lg-download").addEventListener("click", function () {
      var blob = new Blob([build()], { type: "text/plain;charset=utf-8" });
      var a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = "llms.txt";
      document.body.appendChild(a); a.click();
      setTimeout(function () { URL.revokeObjectURL(a.href); document.body.removeChild(a); }, 100);
    });
  })();
</script>
