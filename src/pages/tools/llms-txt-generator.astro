---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/brand/PageHero.astro";
import Section from "../../components/brand/Section.astro";
import Cards from "../../components/brand/Cards.astro";
import Faq from "../../components/brand/Faq.astro";
import EndCta from "../../components/brand/EndCta.astro";
import { SITE, CALENDLY_URL } from "../../lib/site.mjs";
import { TOPICS } from "../../lib/entity.mjs";

const canonical = `${SITE}/tools/llms-txt-generator/`;

const faqs = [
  { q: "What is llms.txt?", a: "llms.txt is a plain-text file you place at the root of your domain (yoursite.com/llms.txt) holding a clean, machine-readable summary of your business: what you do, your key pages, and how to contact you. It was proposed as a way to hand a language model a curated brief instead of making it infer one from your HTML. It's a community convention rather than a standard any major search engine has adopted — see the next answer for what the evidence says about it." },
  { q: "Is this llms.txt generator really free?", a: "Yes — completely free, no sign-up, nothing stored. Everything runs in your browser; your inputs never leave your device. Fill the fields, copy or download the file, and upload it to your site's root." },
  { q: "Where do I put the file once it's generated?", a: "Upload it to the root of your domain so it's reachable at https://yoursite.com/llms.txt. On most hosts that means dropping it in your public / static folder. Optionally link to it from your robots.txt as a comment, and allow AI crawlers there too." },
  { q: "Does llms.txt actually help me get cited by AI?", a: "On the evidence so far, no — not on its own. Google confirmed in 2026 that its search systems, generative features included, ignore llms.txt, and independent analysis across roughly 300,000 domains found no statistically significant relationship between having the file and being cited by AI. Server logs show AI crawlers requesting it in around a tenth of a percent of their hits. It's still worth the half hour: it helps in the narrow case where an agent or a person points a model straight at your domain, and writing it forces you to state plainly what your business does. What actually earns citations is being indexed and ranking, answering the question directly on the page, structured data that says who wrote it, and copy that survives being quoted. That fuller implementation is what I do as a service — this file is the free, easy part." },
  { q: "What's the difference between llms.txt and llms-full.txt?", a: "llms.txt is the concise index — summary, services, key pages, contact. llms-full.txt is an optional expanded corpus with your full positioning, FAQs and detail, for models that want more context. This generator produces the concise llms.txt; the deep version is part of a full GEO implementation." },
];

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "@id": `${canonical}#app`,
      name: "Free llms.txt Generator",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Web browser",
      url: canonical,
      description:
        "A free, browser-based tool that generates an llms.txt file for your business — a machine-readable plain-text brief of what you do and which pages matter. No sign-up, nothing stored.",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      author: { "@id": `${SITE}/#person` },
      provider: { "@id": `${SITE}/#studio` },
      isAccessibleForFree: true,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Tools", item: `${SITE}/tools/` },
        { "@type": "ListItem", position: 3, name: "llms.txt generator", item: canonical },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
    },
  ],
});
---

<Base
  title="Free llms.txt Generator — Make Your Site Readable by AI"
  description="Generate a spec-correct llms.txt — a plain-text brief of your business for language models. Free, no sign-up, nothing stored, plus an honest note on what it does."
  ogDescription="Write a spec-correct llms.txt from five fields, free and in your browser — with a straight answer on what the file actually does."
  canonical={canonical}
  keywords="llms.txt generator, free llms.txt tool, generate llms.txt, llms.txt file, AI SEO tool, GEO tool, make website readable by AI, llms.txt example"
  ogTitle="Free llms.txt generator"
  ogDescription="Make your site legible to ChatGPT, Claude, Gemini & Perplexity. Fill five fields, copy the file, ship it. Free."
  topics={[TOPICS.ai, TOPICS.llm, TOPICS.seo]}
  jsonld={jsonld}
>
  <main>
    <PageHero
      display="The free llms.txt generator."
      size="case"
      kicker="Free tool · GEO · AI search · No sign-up"
      lead={`An <em>llms.txt</em> is a plain-text brief of your business at your domain root. Fill in five fields below, copy the file, drop it at <strong>yoursite.com/llms.txt</strong>. Runs entirely in your browser — nothing is stored or sent anywhere. <strong>Straight answer before you start:</strong> Google has confirmed its search systems ignore this file, and at ~300,000 domains there's no measurable link between having one and being cited by AI. It's worth thirty minutes, not a budget line — <a href="/blog/what-is-llms-txt/">here's the full evidence and what does work</a>.`}
    />

    <Section n={1} term="Setup" note="Live preview" title="Build your llms.txt">
      <div class="lg">
        <form class="form lg-form" id="lg-form" autocomplete="off" novalidate>
          <label class="field" for="lg-name">Business / brand name *<input type="text" id="lg-name" placeholder="Acme Studio" required /></label>
          <label class="field" for="lg-url">Website URL *<input type="url" id="lg-url" placeholder="https://acme.com" inputmode="url" required /></label>
          <label class="field" for="lg-summary">One-line summary *<input type="text" id="lg-summary" placeholder="Independent design studio for D2C brands." required /></label>
          <label class="field" for="lg-services">Services — one per line<textarea id="lg-services" rows="4" placeholder="Brand identity&#10;E-commerce design&#10;Packaging"></textarea></label>
          <label class="field" for="lg-pages">Key pages — Label | https://url per line<textarea id="lg-pages" rows="4" placeholder="Services | https://acme.com/services&#10;Work | https://acme.com/work&#10;Contact | https://acme.com/contact"></textarea></label>
          <div class="lg-two">
            <label class="field" for="lg-email">Contact email<input type="email" id="lg-email" placeholder="hello@acme.com" inputmode="email" /></label>
            <label class="field" for="lg-location">Location (optional)<input type="text" id="lg-location" placeholder="Lisbon, Portugal" /></label>
          </div>
        </form>
        <div class="lg-out">
          <div class="lg-bar">
            <span>llms.txt</span>
            <div class="lg-actions">
              <button type="button" class="lg-btn" id="lg-copy">Copy</button>
              <button type="button" class="lg-btn lg-btn--red" id="lg-download">Download</button>
            </div>
          </div>
          <pre class="lg-pre" id="lg-preview" aria-live="polite" tabindex="0"></pre>
        </div>
      </div>
      <p class="meta lg-note">Nothing here is uploaded — the file is built in your browser. After downloading, place it at your domain root so it resolves at /llms.txt, and allow AI crawlers in your robots.txt.</p>
    </Section>

    <Section n={2} term="Setup" note="Go further" title="llms.txt is the small step">
      <Cards items={[
        { tag: "Understand it", d: `The plain-English explainer: what the file is, what Google and the research actually say about it, and why I still ship one. <a href="/blog/what-is-llms-txt/">An honest answer on whether llms.txt works →</a>` },
        { tag: "Get quoted by AI", d: `This is the part that actually moves citations: rank for the question, answer it on the page, and write copy that survives being quoted. <a href="/blog/aeo-geo-llmo-ai-seo-explained/">AEO vs GEO vs LLMO, explained →</a>` },
        { tag: "Done properly, for you", wide: true, d: `Want the full implementation — llms.txt, schema graphs, AI-crawler strategy and quotable copy wired into your codebase so Google ranks you <strong>and</strong> AI assistants recommend you? That's my <a href="/services/seo-geo-services/">SEO &amp; GEO service →</a>` },
      ]} />
    </Section>

    <Section bare>
      <Faq faqs={faqs} label="(03) Before you ask" />
    </Section>

    <EndCta
      title="Want AI to actually recommend you?"
      text="The generator gets you a file. Getting cited in AI answers takes the full GEO stack — implemented in your codebase. Let's talk about your site."
      primary={{ href: CALENDLY_URL, label: "Book a GEO call →" }}
      secondary={{ href: "/tools/", label: "More free tools →" }}
    />
  </main>
</Base>

<script is:inline>
  (function () {
    // ---- llms.txt generator ----
    var $ = function (id) { return document.getElementById(id); };
    var fields = ["lg-name", "lg-url", "lg-summary", "lg-services", "lg-pages", "lg-email", "lg-location"];
    var preview = $("lg-preview");

    function cleanUrl(u) {
      u = (u || "").trim();
      if (!u) return "";
      if (!/^https?:\/\//i.test(u)) u = "https://" + u;
      return u.replace(/\/+$/, "");
    }
    function lines(v) {
      return (v || "").split("\n").map(function (s) { return s.trim(); }).filter(Boolean);
    }

    function build() {
      var name = ($("lg-name").value || "").trim() || "Your Business";
      var url = cleanUrl($("lg-url").value) || "https://yoursite.com";
      var summary = ($("lg-summary").value || "").trim() || "A short one-line description of what you do.";
      var services = lines($("lg-services").value);
      var pages = lines($("lg-pages").value);
      var email = ($("lg-email").value || "").trim();
      var location = ($("lg-location").value || "").trim();

      var out = [];
      out.push("# " + name);
      out.push("");
      out.push("> " + summary);
      out.push("");
      if (location) { out.push("- Location: " + location); out.push(""); }

      if (services.length) {
        out.push("## Services");
        out.push("");
        services.forEach(function (s) { out.push("- " + s); });
        out.push("");
      }

      if (pages.length) {
        out.push("## Key pages");
        out.push("");
        pages.forEach(function (line) {
          var parts = line.split("|");
          if (parts.length >= 2) {
            var label = parts[0].trim();
            var href = cleanUrl(parts.slice(1).join("|"));
            out.push("- [" + label + "](" + href + ")");
          } else {
            out.push("- " + cleanUrl(line));
          }
        });
        out.push("");
      }

      out.push("## Contact");
      out.push("");
      out.push("- Website: " + url);
      if (email) out.push("- Email: " + email);
      out.push("");

      out.push("<!-- Generated free at https://www.divyanshsood.com/tools/llms-txt-generator/ -->");
      out.push("");
      return out.join("\n");
    }

    function render() { preview.textContent = build(); }
    fields.forEach(function (id) {
      var el = $(id);
      if (el) el.addEventListener("input", render);
    });
    render();

    // Copy
    var copyBtn = $("lg-copy");
    copyBtn.addEventListener("click", function () {
      var text = build();
      var done = function () {
        copyBtn.textContent = "Copied ✓";
        setTimeout(function () { copyBtn.textContent = "Copy"; }, 1600);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(done, function () { fallbackCopy(text); done(); });
      } else { fallbackCopy(text); done(); }
    });
    function fallbackCopy(text) {
      var ta = document.createElement("textarea");
      ta.value = text; ta.style.position = "fixed"; ta.style.opacity = "0";
      document.body.appendChild(ta); ta.select();
      try { document.execCommand("copy"); } catch (e) {}
      document.body.removeChild(ta);
    }

    // Download
    $("lg-download").addEventListener("click", function () {
      var blob = new Blob([build()], { type: "text/plain;charset=utf-8" });
      var a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = "llms.txt";
      document.body.appendChild(a); a.click();
      setTimeout(function () { URL.revokeObjectURL(a.href); document.body.removeChild(a); }, 100);
    });
  })();
</script>

<style>
  .lg{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:clamp(28px,4vw,64px);align-items:start}
  .lg-two{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:16px}
  .lg-out{border:1px solid var(--gda);border-top:3px solid var(--ink);position:sticky;top:88px}
  .lg-bar{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 16px;border-bottom:1px solid var(--gda);font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--g5c)}
  .lg-actions{display:flex;gap:8px}
  .lg-btn{background:var(--ink);color:#fff;border:0;min-height:40px;padding:0 18px;font-family:var(--display);font-weight:800;font-stretch:112%;font-size:12px;letter-spacing:.04em;text-transform:uppercase;cursor:pointer;clip-path:polygon(6px 0,100% 0,calc(100% - 6px) 100%,0 100%)}
  .lg-btn:hover{background:var(--red)}
  .lg-btn--red{background:var(--red)}
  .lg-btn--red:hover{background:var(--ink)}
  .lg-pre{margin:0;padding:18px 16px;min-height:320px;overflow-x:auto;font-family:var(--mono);font-size:13px;line-height:1.6;color:var(--ink);white-space:pre-wrap;word-break:break-word}
  .lg-note{margin:28px 0 0;max-width:90ch;line-height:1.6;text-transform:none;letter-spacing:.02em}
  @media (max-width:899.98px){.lg-out{position:static}}
</style>
