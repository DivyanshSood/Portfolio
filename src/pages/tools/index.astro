---
import Studio from "../../layouts/Studio.astro";
import { SITE } from "../../lib/site.mjs";
import { TOPICS } from "../../lib/entity.mjs";

const canonical = `${SITE}/tools/`;

// The tools hub. Add new tools here — each becomes a card + an ItemList entry.
const tools = [
  {
    href: "/tools/llms-txt-generator/",
    tag: "GEO · AI search",
    name: "llms.txt generator",
    desc: "Write a spec-correct llms.txt — a plain-text brief of your business — from five fields. Free, in your browser, nothing stored. Includes a straight answer on what the file does and doesn't do.",
    live: true,
    who: "Founders, marketers and developers who've been told they need an llms.txt and want one that's actually valid — plus anyone being quoted for a \"GEO package\" who wants to know what the cheap part looks like.",
    what: "Five fields: business name, one-line summary, services, key pages, contact. It writes the H1, the blockquote summary and the linked sections in the order the spec calls for, then hands you the file to copy or download. Nothing is uploaded — the whole thing runs client-side.",
    honest:
      "Google has confirmed its search systems ignore llms.txt, and analysis across ~300,000 domains found no measurable link between having one and being cited by AI. This tool is free because the file is the cheap part of GEO, not the valuable part.",
  },
];

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#page`,
      name: "Free tools for founders & marketers",
      url: canonical,
      description:
        "Free web tools by Divyansh Sood — practical utilities for SEO, GEO and building a better site. No sign-up.",
      isPartOf: { "@id": `${SITE}/#website` },
    },
    {
      "@type": "ItemList",
      itemListElement: tools.map((t, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: t.name,
        url: `${SITE}${t.href}`,
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Tools", item: canonical },
      ],
    },
  ],
});
---

<Studio
  title="Free Web Tools — SEO, GEO & Site Utilities · Divyansh Sood"
  description="Free, no-sign-up web tools by Divyansh Sood — starting with an llms.txt generator that writes a spec-correct file in your browser. Nothing stored, no email wall."
  canonical={canonical}
  keywords="free web tools, llms.txt generator, GEO tools, SEO tools, free developer tools, AI SEO tools"
  ogTitle="Free web tools"
  ogDescription="Practical, free tools for founders and marketers — starting with an llms.txt generator. No sign-up."
  topics={[TOPICS.seo, TOPICS.ai, TOPICS.webDevelopment]}
  jsonld={jsonld}
>
  <main>
    <header class="cs-hero">
      <div class="wrap">
        <div class="cs-eyebrow">
          <span>Tools</span><span>Free · no sign-up</span><span>2026</span>
        </div>
        <h1 style="margin:14px 0 0;font-family:'Anton',sans-serif;font-weight:400;font-size:clamp(44px,8vw,108px);line-height:.9;letter-spacing:-.01em;text-transform:uppercase;">Free tools,<br /><span style="color:var(--accent);">no strings.</span></h1>
        <p class="cs-lead">Small, genuinely useful utilities I've built while doing client work. No sign-up, no upsell wall — everything runs in your browser. If one saves you an afternoon, that's the point.</p>
      </div>
    </header>

    <section class="cs-sec" aria-labelledby="why-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="why-h">Why these exist</h2>
          <span class="mono">The deal</span>
        </div>
        <div class="cs-body" data-reveal>
          <div class="cs-card span2">
            <span class="cs-tag">No email wall</span>
            <p>
              Every tool here came out of a job. A client needed something, I wrote it once properly instead of
              twice badly, and it turned out to be useful to more than one person. So it's on the site, free, with
              no form in front of it. You don't give me an email address, I don't get a lead, and you get the
              thing you came for. If it's useful and you later want the full build done properly, you know where
              I am — that's the entire funnel.
            </p>
          </div>
          <div class="cs-card">
            <span class="cs-tag">Runs in your browser</span>
            <p>
              Nothing you type is uploaded, logged or stored. These are static pages with the logic in
              client-side JavaScript, so your business details, draft copy and URLs never leave your device.
              Works offline once the page has loaded.
            </p>
          </div>
          <div class="cs-card">
            <span class="cs-tag">Honest about limits</span>
            <p>
              Each tool says what it does and what it doesn't. The llms.txt generator tells you up front that
              Google ignores the file it produces — because a tool that oversells itself costs you more than the
              half hour it saved.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="cs-sec" aria-labelledby="tools-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="tools-h">The toolbox</h2>
          <span class="mono">More coming</span>
        </div>
        <div class="cs-body" data-reveal>
          {tools.map((t) => (
            <a class="cs-card span2" href={t.href} style="text-decoration:none;color:inherit;display:block;">
              <span class="cs-tag">{t.tag}</span>
              <h3 class="cs-card-h2" style="font-family:'Anton',sans-serif;font-weight:400;text-transform:uppercase;font-size:clamp(22px,3vw,32px);letter-spacing:0;line-height:1;margin-bottom:12px;">{t.name}</h3>
              <p>{t.desc}</p>
              {t.what && (
                <p style="margin-top:12px;">
                  <strong>What it does.</strong> {t.what}
                </p>
              )}
              {t.who && (
                <p style="margin-top:12px;">
                  <strong>Who it's for.</strong> {t.who}
                </p>
              )}
              {t.honest && (
                <p style="margin-top:12px;color:#A8A69E;">
                  <strong>The honest caveat.</strong> {t.honest}
                </p>
              )}
              <p style="margin-top:14px;color:var(--accent);font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.06em;">Open the {t.name} →</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="cs-endcta">
      <div class="wrap">
        <h2>Need the real thing, not a tool?</h2>
        <p>Tools get you started. When you want it built and shipped properly, that's what the studio is for.</p>
        <div class="cs-cta-row" style="justify-content:center;">
          <a class="btn btn-primary" href="/services/">See services</a>
          <a class="btn btn-ghost" href="/website-audit/">Free website audit</a>
        </div>
      </div>
    </section>
  </main>
</Studio>
