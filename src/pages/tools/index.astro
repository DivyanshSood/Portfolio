---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/brand/PageHero.astro";
import Section from "../../components/brand/Section.astro";
import Cards from "../../components/brand/Cards.astro";
import EndCta from "../../components/brand/EndCta.astro";
import { SITE } from "../../lib/site.mjs";
import { TOPICS } from "../../lib/entity.mjs";
import { TOOLS, TOOL_GROUPS, toolPath } from "../../lib/tools.mjs";

const canonical = `${SITE}/tools/`;
// The hub reads src/lib/tools.mjs: add a tool there and it gets a card here
// and an ItemList entry.
const groups = TOOL_GROUPS.map((g) => ({ ...g, tools: TOOLS.filter((t) => t.group === g.id) }));
const count = TOOLS.length;

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#page`,
      name: "Free tools for local businesses, founders and developers",
      url: canonical,
      description:
        "Free web tools by Divyansh Sood: practical utilities for pricing a website, bookings and reviews, local SEO, AI search and site building. No sign-up, everything runs in the browser.",
      isPartOf: { "@id": `${SITE}/#website` },
    },
    {
      "@type": "ItemList",
      numberOfItems: count,
      itemListElement: TOOLS.map((t, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: t.name,
        url: `${SITE}${toolPath(t.slug)}`,
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Tools", item: canonical },
      ],
    },
  ],
});
---

<Base
  title={`${count} Free Web Tools: SEO, Local Business & Dev Utilities`}
  description="Free, no-sign-up tools: website cost calculator, review and UPI QR cards, WhatsApp links, SERP preview, schema, robots.txt, favicons and more."
  canonical={canonical}
  keywords="free web tools, website cost calculator, google review qr code, upi qr code generator, whatsapp link generator, serp preview, schema generator, robots.txt generator, favicon generator, free SEO tools"
  ogTitle={`${count} free web tools`}
  ogDescription="Practical, free tools for local businesses, founders and developers: pricing, bookings, reviews, SEO, schema and site files. No sign-up."
  topics={[TOPICS.seo, TOPICS.ai, TOPICS.webDevelopment]}
  jsonld={jsonld}
>
  <main>
    <PageHero
      display="Free tools, no strings."
      size="case"
      kicker={`Tools · ${count} free · no sign-up · 2026`}
      lead="Small, genuinely useful utilities from client work: for hotels, homestays and taxi operators, for anyone planning a website, and for the people who build them. No sign-up, no upsell wall, and everything runs in your browser."
    />

    <Section n={1} term="Setup" note="The deal" title="Why these exist">
      <Cards items={[
        { tag: "No email wall", wide: true, d: "Every tool here came out of a job. A client needed something, I wrote it once properly instead of twice badly, and it turned out to be useful to more than one person. So it's on the site, free, with no form in front of it. You don't give me an email address, I don't get a lead, and you get the thing you came for. If it's useful and you later want the full build done properly, you know where I am — that's the entire funnel." },
        { tag: "Runs in your browser", d: "What you type isn't uploaded, logged or stored. These are static pages with the logic in client-side JavaScript, so your business details, prices and URLs stay on your device. The only thing sent is an anonymous count of which tool was used." },
        { tag: "Honest about limits", d: "Each tool says what it does and what it doesn't. The llms.txt generator tells you up front that Google ignores the file it produces, and the cost calculator won't invent a total, because a tool that oversells itself costs you more than the time it saved." },
      ]} />
    </Section>

    {groups.map((g, gi) => (
      <Section n={gi + 2} term="Pit lane" note={g.note} title={g.title}>
        <div class="tg">
          {g.tools.map((t) => (
            <a class="tg-card" href={toolPath(t.slug)}>
              <span class="tg-tag">{t.tag}</span>
              <h3 class="tg-name">{t.name}</h3>
              <p class="tg-d">{t.short}</p>
              <span class="tg-cta">Open <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </Section>
    ))}

    <EndCta
      title="Need the real thing, not a tool?"
      text="Tools get you started. When you want it built and shipped properly, that's what the studio is for."
      primary={{ href: "/services/", label: "See services →" }}
      secondary={{ href: "/website-audit/", label: "Free website audit →" }}
    />
  </main>
</Base>

<style>
  .tg{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));gap:16px}
  .tg-card{display:flex;flex-direction:column;gap:10px;padding:22px 20px;border:1px solid var(--gda);border-top:3px solid var(--ink);color:var(--ink);text-decoration:none;background:#fff}
  .tg-card:hover{border-top-color:var(--red);color:var(--ink)}
  .tg-tag{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--g5c)}
  .tg-name{margin:0;font-weight:900;font-style:italic;font-stretch:118%;text-transform:uppercase;font-size:clamp(20px,1.8vw,24px);line-height:1.02}
  .tg-d{margin:0;font-size:15px;line-height:1.5;color:var(--g3e);flex:1}
  .tg-cta{font-family:var(--mono);font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--red-on-tint,#D0131C)}
  .tg-card:hover .tg-cta{color:var(--ink)}
</style>
