---
import Studio from "../../layouts/Studio.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import PostFaq from "../../components/PostFaq.astro";
import { SITE, DEFAULT_OG, CALENDLY_URL, fmtDate, iso, POSTS, authorNode, publisherNode, websiteNode, topicsForTags } from "../../lib/blog.mjs";
import { coverBase, coverSrcset, COVER_SIZES_POST } from "../../lib/images.mjs";

const slug = "hotel-homestay-website-himachal-direct-bookings";
const idx = POSTS.findIndex((p) => p.slug === slug);
const post = POSTS[idx];

const canonical = `${SITE}/blog/${slug}/`;
const ogImage = post.coverImage ? `${SITE}${post.coverImage}` : DEFAULT_OG;
const primaryTag = post.tags[0] || "Notes";
const readMins = post.readMins;
const showUpdated = post.updatedDate && +new Date(post.updatedDate) > +new Date(post.pubDate);
const updatedLabel = showUpdated ? `Updated ${fmtDate(post.updatedDate)}` : null;

/* Questions real buyers ask, answered in full. This array is the single
   source for both the visible accordion and the FAQPage node above — Google
   requires FAQ markup to match content on the page, and deriving both from one
   array is what stops them drifting. */
const faqs = [
  {
    q: "How much commission do OTAs take from Himachal hotels and homestays?",
    a: "Typically 15–30% of every booking. On a property doing meaningful volume through the season, that's the difference between a good year and a flat one, and it recurs on every single reservation for as long as you use the channel. The point of a direct-booking website is not to leave the OTAs — it's to stop paying that rate on the guests who were already looking for you by name.",
  },
  {
    q: "Do direct bookings actually work for a small Himachal homestay?",
    a: "Yes, for the specific guest who already knows your name. Someone who saw you on Instagram, got a recommendation, or stayed last season will search for the property directly — and if there's nowhere to book, they go back to the OTA and you pay commission on a guest you found yourself. That's the booking a direct site captures, and it's the cheapest booking you'll ever get.",
  },
  {
    q: "What does a direct-booking website for a homestay actually need?",
    a: "Real photographs, honest room and rate information, availability a guest can trust, and one-tap WhatsApp booking — because in Himachal that is how the conversation actually happens. It needs to load fast on a phone in a valley with two bars of signal, and it needs seasonal content that ranks before the season rather than during it.",
  },
  {
    q: "Should I stop using Booking.com and MakeMyTrip?",
    a: "No. OTAs are genuinely good at reaching people who don't know you exist, and that discovery is worth paying for. The goal is to shift the guests who already know your name onto your own channel, so you're paying commission for new customers rather than for repeat ones and referrals. Run both, and measure which one each booking actually came from.",
  },
  {
    q: "When should I build the site — before or during the season?",
    a: "Before, by a comfortable margin. Search visibility for seasonal terms accumulates over months, so a site that goes live as the season starts misses the window it was built for. Building in the off-season also means you're not troubleshooting a booking flow while guests are trying to use it.",
  },
];

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": `${canonical}#post`,
      headline: post.title,
      description: post.description,
      datePublished: iso(post.pubDate),
      dateModified: iso(post.updatedDate || post.pubDate),
      author: authorNode(SITE),
      publisher: publisherNode(SITE),
      isPartOf: websiteNode(SITE),
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      image: ogImage,
      articleSection: primaryTag,
      keywords: post.tags.join(", "),
      // Resolves the free-text tags above to public concept identifiers, so a
      // parser knows "Astro" means the framework and "GEO" isn't geography.
      about: topicsForTags(post.tags),
      wordCount: post.wordCount,
      timeRequired: `PT${readMins}M`,
      speakable: {
        "@type": "SpeakableSpecification",
        cssSelector: [".post-title", ".post-lead"],
      },
      inLanguage: "en",
      url: canonical,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE}/blog/` },
        { "@type": "ListItem", position: 3, name: post.title, item: canonical },
      ],
    },
    {
      // Google retired FAQ rich results in May 2026, so this earns no SERP
      // enhancement. It stays because answer engines read Q&A pairs well, and
      // because every question below is rendered visibly by <PostFaq>.
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
});
---

<Studio
  title={post.seoTitle ?? `${post.title} · Divyansh Sood`}
  description={post.description}
  canonical={canonical}
  keywords={post.tags.join(", ")}
  ogType="article"
  ogTitle={post.title}
  ogImage={ogImage}
  ogImageW={1200}
  ogImageH={750}
  articlePublished={iso(post.pubDate)}
  articleModified={iso(post.updatedDate || post.pubDate)}
  tags={post.tags}
  preloadImage={{ href: coverBase(post.coverImage), srcset: coverSrcset(post.coverImage), sizes: COVER_SIZES_POST }}
  jsonld={jsonld}
>
  <main>
    <header class="post-hero">
      <div class="wrap narrow">
        <div class="eyebrow">
          <span>{primaryTag}</span>
          <span>{fmtDate(post.pubDate)}</span>
          {updatedLabel && <span class="post-updated">{updatedLabel}</span>}
          <span>{readMins} min read</span>
        </div>
        <h1 class="post-title">{post.title}</h1>
        <p class="post-lead">{post.description}</p>
        <div class="post-meta">
          <span>By Divyansh Sood</span><span>{fmtDate(post.pubDate)}</span><span>{readMins} min read</span>
        </div>
      </div>
    </header>

    {post.coverImage && (
      <div class="wrap narrow">
        <figure class="post-cover">
          <img
            src={coverBase(post.coverImage)}
            srcset={coverSrcset(post.coverImage)}
            sizes={COVER_SIZES_POST}
            alt={post.coverAlt ?? post.title}
            width="1200"
            height="750"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </div>
    )}

    <article class="wrap narrow post-body">
<p>Every season in Himachal, the same transfer happens quietly: lakhs of rupees move from the people who own the rooms to the platforms that list them.</p>
<p>OTA commission runs 15–30% per booking. On a homestay doing decent season business, that’s often a staff salary’s worth of margin — paid for the privilege of being one listing among forty identical ones. And the guest, their contact details, their repeat booking? The platform keeps those too.</p>
<p>The fix isn’t leaving the OTAs. It’s making them your <em>second</em> channel.</p>
<hr>
<h2 id="the-math-that-changes-minds">The math that changes minds</h2>
<p>Say your property does 60 room-nights a month in season at ₹4,000 average. At 20% commission, that’s ₹48,000 a month flowing to aggregators — roughly ₹2.5–3 lakh over a season.</p>
<p>Now the honest question: what share of those guests searched your property <em>by name</em> before booking? Those guests wanted you, found the OTA, and you paid commission on demand you had already earned. Shifting only those bookings direct — never mind winning new ones — usually pays for a website inside a single season.</p>
<hr>
<h2 id="what-a-direct-booking-site-actually-needs">What a direct-booking site actually needs</h2>
<p>Not a booking engine clone. Himachal guests don’t finish checkout forms on mountain networks — they confirm on WhatsApp. The site that converts here is specific:</p>
<ul>
<li><strong>WhatsApp-first booking.</strong> Every room and package gets a one-tap WhatsApp deep-link with the enquiry pre-filled. The conversation closes the booking; the site starts it.</li>
<li><strong>Photography that carries the property.</strong> Your rooms at golden hour, the view from the balcony — full-width, fast-loading. This is the entire pitch; treat it that way.</li>
<li><strong>Rates and honesty on the page.</strong> Price ranges, seasons, what’s included. Guests cross-check against OTAs; matching or beating (“book direct, breakfast on us”) converts them.</li>
<li><strong>Speed on a phone on 4G.</strong> Your guest is researching from a bus on NH-5. A custom-coded static site loads where builder sites time out.</li>
<li><strong>Search structure for how guests actually search.</strong> “Homestay in Jibhi with mountain view,” “pet friendly stay Bir” — pages structured around real queries, with LocalBusiness schema wired to your Google Business Profile so Maps and site reinforce each other.</li>
</ul>
<hr>
<h2 id="proof-this-works-here">Proof this works here — not in a case study from Portugal</h2>
<p>This isn’t theory imported from abroad. <a href="/projects/dharamshala-tours/">Dharamshala Tours</a> — a travel operator I built for — takes part of roughly 1,000 package bookings a month through a WhatsApp-first site with a self-serve editor. On top of that sits the newer layer every build gets: structured data and <code>llms.txt</code>, so an assistant can quote your rooms, rates and location accurately — which matters because “best homestays in Himachal” is increasingly a question being asked of ChatGPT rather than typed into Google.</p>
<p>The deeper commission math, including when OTAs are still worth it, is in <a href="/blog/direct-bookings-without-aggregator-commission/">direct bookings without aggregator commission</a>.</p>
<hr>
<h2 id="the-playbook-for-one-season">The playbook, compressed</h2>
<ul>
<li>Ship a fast, WhatsApp-first site with real photos and honest rates.</li>
<li>Put the URL everywhere the OTA guest looks: Google Business Profile, Instagram bio, the thank-you message after checkout.</li>
<li>Offer one small, real reason to book direct.</li>
<li>Collect every guest’s WhatsApp with consent — next season, your repeat guests cost you zero commission.</li>
</ul>
<p>The OTAs stay in the mix. They become what they should have been all along: a discovery channel you exploit, not a landlord you pay.</p>
<hr>
<p><em>I’m Divyansh Sood — a web developer based in Himachal, building booking-first sites for the region’s stays and operators. If your property is in <a href="/web-developer-manali/">Manali</a>, <a href="/web-developer-shimla/">Shimla</a>, <a href="/web-developer-dharamshala/">Dharamshala</a> or anywhere in <a href="/web-developer-kangra/">Kangra</a>, message me on <a href="https://wa.me/919816091875">WhatsApp</a> with your property name — I’ll reply with what I’d build and a fixed quote, in writing.</em></p>
      <div class="tags">{post.tags.map((t) => <span>{t}</span>)}</div>
    </article>

    <PostFaq faqs={faqs} />

    <RelatedPosts slug={slug} audience={post.audience} />

    <section class="post-foot-cta">
      <div class="wrap narrow">
        {post.audience === "indian-smb" ? (
          <>
            <h2>Working on something in India?</h2>
            <p>If a post here matches what you're building, send me the brief. WhatsApp reply in under an hour, 9 AM–9 PM IST — I'll tell you within a day if it's a fit.</p>
            <div class="cta-row">
              <a class="btn btn-primary" href="https://wa.me/919816091875" target="_blank" rel="noopener"
                >Message me on WhatsApp <span aria-hidden="true">↗</span></a
              >
              <a class="btn btn-ghost" href="/#work">See the work</a>
            </div>
          </>
        ) : post.audience === "d2c-brand" ? (
          <>
            <h2>Building a brand a theme can't carry?</h2>
            <p>If your store has a model that off-the-shelf builders fight — hand-numbered drops, creator commerce, premium D2C — tell me about it. I read every brief personally.</p>
            <div class="cta-row">
              <a class="btn btn-primary" href="mailto:hello@divyanshsood.com"
                >Email me <span aria-hidden="true">↗</span></a
              >
              <a class="btn btn-ghost" href="/#work">See the work</a>
            </div>
          </>
        ) : (
          <>
            <h2>Working on something similar?</h2>
            <p>If a post here matches what you're building, send me the brief. I reply personally, usually within a couple of hours — and I'll tell you within a day if it's a fit.</p>
            <div class="cta-row">
              <a class="btn btn-primary" href="mailto:hello@divyanshsood.com"
                >Email me <span aria-hidden="true">↗</span></a
              >
              <a class="btn btn-ghost" href={CALENDLY_URL} target="_blank" rel="noopener"
                >Book a 15-min intro <span aria-hidden="true">↗</span></a
              >
            </div>
          </>
        )}
      </div>
    </section>
  </main>
</Studio>
