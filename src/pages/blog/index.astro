---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/brand/PageHero.astro";
import PostList from "../../components/brand/PostList.astro";
import { SITE, DEFAULT_OG, fmtDate, POSTS, TOPICS } from "../../lib/blog.mjs";

const canonical = `${SITE}/blog/`;
const posts = POSTS;

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Blog",
      "@id": `${canonical}#blog`,
      name: "Divyansh Sood® Studio — Journal",
      description:
        "Notes and case studies on building custom-coded, conversion-focused websites for businesses worldwide.",
      url: canonical,
      inLanguage: "en",
      publisher: { "@id": `${SITE}/#studio` },
      about: [TOPICS.webDevelopment, TOPICS.webDesign, TOPICS.seo, TOPICS.ai],
    },
    {
      "@type": "ItemList",
      itemListElement: posts.map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${SITE}/blog/${p.slug}/`,
        name: p.title,
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Blog", item: canonical },
      ],
    },
  ],
});
---

<Base
  title="Web Design & SEO Journal — Divyansh Sood® Studio"
  description="Notes and case studies from web developer Divyansh Sood — custom-coded websites, conversion, page speed, SEO and getting your brand cited in AI search."
  canonical={canonical}
  keywords="web development blog, custom-coded websites, conversion-focused web design, D2C e-commerce, Shopify alternative, custom code vs Webflow, Astro developer, page speed, GEO AI search, llms.txt, web design case studies, Divyansh Sood"
  ogTitle="Journal — Divyansh Sood® Studio"
  ogImage={DEFAULT_OG}
  ogImageW={1200}
  ogImageH={630}
  jsonld={jsonld}
>
  <main>
    <PageHero
      display="Writing"
      sup={String(posts.length)}
      meta="Notes & case studies"
      h1="Notes on websites that earn."
      lead="What I've learned shipping twenty-plus sites since 2022 — what works, what the consultants won't tell you, and the parts I keep changing my mind about."
    >
      <div class="meta">Journal · <span class="bl-n">{String(posts.length).padStart(2, "0")}</span> posts</div>
    </PageHero>

    <section class="bl">
      <div class="wrap">
        {/* Topic hubs: the list below runs in publish order, which is the wrong
            shape for someone arriving on a subject rather than a date. */}
        <nav aria-label="Browse by topic" class="bl-topics">
          <div class="chips-lbl">Start with a topic</div>
          <div class="chips"><a class="chip chip--red" href="/blog/topics/ai-web-development/">AI in web development →</a></div>
        </nav>
        <div class="lbl">(01) Journal — all posts, newest first</div>
        <PostList items={posts.map((p) => ({ href: `/blog/${p.slug}/`, title: p.title, meta: `${fmtDate(p.pubDate)} · ${p.tags[0] || "Notes"} · ${p.readMins} min` }))} />
      </div>
    </section>
  </main>
</Base>

<style>
  .bl-n{color:var(--red)}
  .bl{padding:clamp(28px,4vw,48px) var(--gutter) var(--sec-y)}
  .bl-topics{margin-bottom:clamp(40px,5vw,64px)}
</style>
