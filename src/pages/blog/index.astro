---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { SITE, DEFAULT_OG, fmtDate, gradient, POSTS } from "../../lib/blog.mjs";

const canonical = `${SITE}/blog/`;
const posts = POSTS;

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Blog",
      "@id": `${canonical}#blog`,
      name: "Divyansh Sood® Studio — Journal",
      description:
        "Notes and case studies on building custom-coded, conversion-focused websites for businesses worldwide.",
      url: canonical,
      inLanguage: "en",
      publisher: { "@id": `${SITE}/#studio` },
    },
    {
      "@type": "ItemList",
      itemListElement: posts.map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${SITE}/blog/${p.slug}/`,
        name: p.title,
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Blog", item: canonical },
      ],
    },
  ],
});
---

<Layout
  title="Journal — Notes & case studies · Divyansh Sood® Studio"
  description="Notes and case studies on building custom-coded, conversion-focused websites that turn attention into outcomes — for businesses worldwide."
  canonical={canonical}
  keywords="web development blog, custom-coded websites, conversion-focused web design, D2C e-commerce, Shopify alternative, custom code vs Webflow, website cost India, Astro developer, page speed, GEO AI search, llms.txt, web design case studies, Divyansh Sood"
  ogTitle="Journal — Divyansh Sood® Studio"
  ogImage={DEFAULT_OG}
  ogImageW={1600}
  ogImageH={1000}
  jsonld={jsonld}
>
  <Nav kicker="Journal" />
  <main>
    <header class="post-hero">
      <div class="post-hero-bg" aria-hidden="true"></div>
      <div class="wrap">
        <div class="eyebrow">
          <span>(Journal — {String(posts.length).padStart(2, "0")} posts)</span>
          <span>Notes &amp; case studies</span>
          <span>Divyansh Sood® Studio</span>
        </div>
        <h1 class="post-title">Notes on websites<br />that earn.</h1>
        <p class="post-lead">
          What I've learned shipping twenty-plus sites since 2022 — what works, what the
          consultants won't tell you, and the parts I keep changing my mind about.
        </p>
      </div>
    </header>

    <section class="wrap" aria-label="All posts">
      <div class="blog-grid">
        {
          posts.map((p) => (
            <a class="blog-card" href={`/blog/${p.slug}/`} data-reveal>
              <div class="thumb">
                {p.coverImage ? (
                  <img src={p.coverImage} alt={p.title} width="640" height="400" loading="lazy" decoding="async" />
                ) : (
                  <span class="thumb-grad" style={`background:${gradient(p.slug)}`} />
                )}
              </div>
              <div class="pad">
                <span class="date">
                  {fmtDate(p.pubDate)} · {p.tags[0] || "Notes"}
                </span>
                <span class="ttl">{p.title}</span>
                <span class="desc">{p.description}</span>
                <span class="read">Read · {p.readMins} min →</span>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </main>
  <Footer />
</Layout>
