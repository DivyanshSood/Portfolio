---
import Studio from "../../layouts/Studio.astro";
import { SITE, DEFAULT_OG, fmtDate, gradient, POSTS, TOPICS } from "../../lib/blog.mjs";
import { coverBase, coverSrcset, COVER_SIZES_CARD } from "../../lib/images.mjs";

const canonical = `${SITE}/blog/`;
const posts = POSTS;

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Blog",
      "@id": `${canonical}#blog`,
      name: "Divyansh Sood® Studio — Journal",
      description:
        "Notes and case studies on building custom-coded, conversion-focused websites for businesses worldwide.",
      url: canonical,
      inLanguage: "en",
      publisher: { "@id": `${SITE}/#studio` },
      about: [TOPICS.webDevelopment, TOPICS.webDesign, TOPICS.seo, TOPICS.ai],
    },
    {
      "@type": "ItemList",
      itemListElement: posts.map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${SITE}/blog/${p.slug}/`,
        name: p.title,
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Blog", item: canonical },
      ],
    },
  ],
});
---

<Studio
  title="Web Design & SEO Journal — Divyansh Sood® Studio"
  description="Notes and case studies from web developer Divyansh Sood — custom-coded websites, conversion, page speed, SEO and getting your brand cited in AI search."
  canonical={canonical}
  keywords="web development blog, custom-coded websites, conversion-focused web design, D2C e-commerce, Shopify alternative, custom code vs Webflow, Astro developer, page speed, GEO AI search, llms.txt, web design case studies, Divyansh Sood"
  ogTitle="Journal — Divyansh Sood® Studio"
  ogImage={DEFAULT_OG}
  ogImageW={1200}
  ogImageH={630}
  jsonld={jsonld}
>
  <main>
    <header class="post-hero">
      <div class="wrap">
        <div class="eyebrow">
          <span>(Journal — {String(posts.length).padStart(2, "0")} posts)</span>
          <span>Notes &amp; case studies</span>
          <span>Divyansh Sood® Studio</span>
        </div>
        <h1 class="post-title">Notes on websites<br />that earn.</h1>
        <p class="post-lead">
          What I've learned shipping twenty-plus sites since 2022 — what works, what the
          consultants won't tell you, and the parts I keep changing my mind about.
        </p>
      </div>
    </header>

    {/* Topic hubs. The index lists posts in publish order, which is the wrong
        shape for someone arriving on a subject rather than a date — and it left
        the cluster hubs reachable only from inside individual posts. */}
    <section class="wrap" aria-label="Browse by topic">
      <nav class="post-hubs" style="margin:0 0 34px;">
        <span
          style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:.14em;color:#8A8A93;align-self:center;text-transform:uppercase;"
          >Start with a topic</span
        >
        <a href="/blog/topics/ai-web-development/">AI in web development →</a>
      </nav>
    </section>

    <section class="wrap" aria-label="All posts">
      <div class="blog-grid">
        {
          posts.map((p, i) => (
            <a class="blog-card" href={`/blog/${p.slug}/`} data-reveal>
              <div class="thumb">
                {p.coverImage ? (
                  /* This page shows every post at once, so covers come from
                     the WebP ladder at card width rather than the full-size
                     JPEG. The first row is above the fold and holds the LCP
                     element, so it loads eagerly; the rest wait. */
                  <img
                    src={coverBase(p.coverImage)}
                    srcset={coverSrcset(p.coverImage)}
                    sizes={COVER_SIZES_CARD}
                    alt={p.coverAlt ?? p.title}
                    width="640"
                    height="400"
                    loading={i < 3 ? "eager" : "lazy"}
                    fetchpriority={i === 0 ? "high" : undefined}
                    decoding="async"
                  />
                ) : (
                  <span class="thumb-grad" style={`background:${gradient(p.slug)}`} />
                )}
              </div>
              <div class="pad">
                <span class="date">
                  {fmtDate(p.pubDate)} · {p.tags[0] || "Notes"}
                </span>
                <span class="ttl">{p.title}</span>
                <span class="desc">{p.description}</span>
                <span class="read">Read · {p.readMins} min →</span>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</Studio>
