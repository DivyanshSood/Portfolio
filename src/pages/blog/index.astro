---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { SITE, DEFAULT_OG, fmtDate, readingTime, gradient, orderPosts } from "../../lib/blog.mjs";

const canonical = `${SITE}/blog/`;
const posts = orderPosts(await getCollection("blog"));

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Blog",
      "@id": `${canonical}#blog`,
      name: "Divyansh Sood® Studio — Journal",
      description:
        "Notes and case studies on building custom-coded, conversion-focused websites for businesses worldwide.",
      url: canonical,
      inLanguage: "en",
      publisher: { "@id": `${SITE}/#studio` },
    },
    {
      "@type": "ItemList",
      itemListElement: posts.map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${SITE}/blog/${p.id}/`,
        name: p.data.title,
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Blog", item: canonical },
      ],
    },
  ],
});
---

<Layout
  title="Journal — Notes & case studies · Divyansh Sood® Studio"
  description="Notes and case studies on building custom-coded, conversion-focused websites that turn attention into outcomes — for businesses worldwide."
  canonical={canonical}
  ogTitle="Journal — Divyansh Sood® Studio"
  ogImage={DEFAULT_OG}
  ogImageW={1600}
  ogImageH={1000}
  jsonld={jsonld}
>
  <Nav kicker="Journal" />
  <main>
    <header class="post-hero">
      <div class="post-hero-bg" aria-hidden="true"></div>
      <div class="wrap">
        <div class="eyebrow">
          <span>(Journal — {String(posts.length).padStart(2, "0")} posts)</span>
          <span>Notes &amp; case studies</span>
          <span>Divyansh Sood® Studio</span>
        </div>
        <h1 class="post-title">Notes on websites<br />that earn.</h1>
        <p class="post-lead">
          Practical writing on custom code, SEO, conversion and getting real businesses found — plus
          case studies from the work.
        </p>
      </div>
    </header>

    <section class="wrap" aria-label="All posts">
      <div class="blog-grid">
        {
          posts.map((p) => (
            <a class="blog-card" href={`/blog/${p.id}/`} data-cursor data-reveal>
              <div class="thumb" style={`background:${gradient(p.id)};`} />
              <div class="pad">
                <span class="date">
                  {fmtDate(p.data.pubDate)} · {p.data.tags[0] || "Notes"}
                </span>
                <span class="ttl">{p.data.title}</span>
                <span class="desc">{p.data.description}</span>
                <span class="read">Read · {readingTime(p.body)} min →</span>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </main>
  <Footer />
</Layout>
