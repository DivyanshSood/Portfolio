---
import Studio from "../../layouts/Studio.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import PostFaq from "../../components/PostFaq.astro";
import { SITE, DEFAULT_OG, CALENDLY_URL, fmtDate, iso, POSTS, authorNode, publisherNode, websiteNode, topicsForTags } from "../../lib/blog.mjs";
import { coverBase, coverSrcset, COVER_SIZES_POST } from "../../lib/images.mjs";

const slug = "google-business-profile-vs-website-himachal";
const idx = POSTS.findIndex((p) => p.slug === slug);
const post = POSTS[idx];

const canonical = `${SITE}/blog/${slug}/`;
const ogImage = post.coverImage ? `${SITE}${post.coverImage}` : DEFAULT_OG;
const primaryTag = post.tags[0] || "Notes";
const readMins = post.readMins;
const showUpdated = post.updatedDate && +new Date(post.updatedDate) > +new Date(post.pubDate);
const updatedLabel = showUpdated ? `Updated ${fmtDate(post.updatedDate)}` : null;

/* Questions real buyers ask, answered in full. This array is the single
   source for both the visible accordion and the FAQPage node above — Google
   requires FAQ markup to match content on the page, and deriving both from one
   array is what stops them drifting. */
const faqs = [
  {
    q: "Do I need a website if I have a Google Business Profile?",
    a: "You need both, and they do different jobs. A Google Business Profile gets you onto the map and into local search — it's how people find you. A website is what convinces them once they have, because it's the only place you control the full story: your packages, your prices, your proof, your booking. The profile generates the visit; the website converts it.",
  },
  {
    q: "What does a Google Business Profile do that a website can't?",
    a: "It puts you on the map, literally — in Maps results, in the local pack, and in the panel beside a search for your name. It collects reviews where people look for them and shows your hours, phone number and directions without anyone visiting a site. For a walk-in business it is often the single highest-return thing you can set up, and it's free.",
  },
  {
    q: "Where does a Google Business Profile stop being enough?",
    a: "The moment a customer needs more than your address. You can't lay out packages properly, explain what makes you different, show a portfolio, publish policies, or take a booking on your own terms. And you're a policy change or a suspension away from losing the listing entirely, with no way to reach the customers it was bringing you.",
  },
  {
    q: "Which should an Indian small business set up first?",
    a: "The Google Business Profile, almost always — it's free, it's fast, and for a local business it produces results within weeks. Build the website next, and build it to answer what the profile can't. Doing it in the other order isn't wrong, but it means paying for a website before you've claimed the free thing that sends people to it.",
  },
  {
    q: "What's the most common mistake businesses make here?",
    a: "Treating them as alternatives and picking one. Businesses with a good profile and no website lose every customer who wanted detail before deciding; businesses with a good website and no profile are invisible to anyone searching on a map. They're two halves of the same job, and the businesses doing well locally are the ones running both properly.",
  },
];

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": `${canonical}#post`,
      headline: post.title,
      description: post.description,
      datePublished: iso(post.pubDate),
      dateModified: iso(post.updatedDate || post.pubDate),
      author: authorNode(SITE),
      publisher: publisherNode(SITE),
      isPartOf: websiteNode(SITE),
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      image: ogImage,
      articleSection: primaryTag,
      keywords: post.tags.join(", "),
      // Resolves the free-text tags above to public concept identifiers, so a
      // parser knows "Astro" means the framework and "GEO" isn't geography.
      about: topicsForTags(post.tags),
      wordCount: 987,
      timeRequired: `PT${readMins}M`,
      speakable: {
        "@type": "SpeakableSpecification",
        cssSelector: [".post-title", ".post-lead"],
      },
      inLanguage: "en",
      url: canonical,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE}/blog/` },
        { "@type": "ListItem", position: 3, name: post.title, item: canonical },
      ],
    },
    {
      // Google retired FAQ rich results in May 2026, so this earns no SERP
      // enhancement. It stays because answer engines read Q&A pairs well, and
      // because every question below is rendered visibly by <PostFaq>.
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
});
---

<Studio
  title={post.seoTitle ?? `${post.title} · Divyansh Sood`}
  description={post.description}
  canonical={canonical}
  keywords={post.tags.join(", ")}
  ogType="article"
  ogTitle={post.title}
  ogImage={ogImage}
  ogImageW={1200}
  ogImageH={750}
  articlePublished={iso(post.pubDate)}
  articleModified={iso(post.updatedDate || post.pubDate)}
  tags={post.tags}
  preloadImage={{ href: coverBase(post.coverImage), srcset: coverSrcset(post.coverImage), sizes: COVER_SIZES_POST }}
  jsonld={jsonld}
>
  <main>
    <header class="post-hero">
      <div class="wrap narrow">
        <div class="eyebrow">
          <span>{primaryTag}</span>
          <span>{fmtDate(post.pubDate)}</span>
          {updatedLabel && <span class="post-updated">{updatedLabel}</span>}
          <span>{readMins} min read</span>
        </div>
        <h1 class="post-title">{post.title}</h1>
        <p class="post-lead">{post.description}</p>
        <div class="post-meta">
          <span>By Divyansh Sood</span><span>{fmtDate(post.pubDate)}</span><span>{readMins} min read</span>
        </div>
      </div>
    </header>

    {post.coverImage && (
      <div class="wrap narrow">
        <figure class="post-cover">
          <img
            src={coverBase(post.coverImage)}
            srcset={coverSrcset(post.coverImage)}
            sizes={COVER_SIZES_POST}
            alt={post.coverAlt ?? post.title}
            width="1200"
            height="750"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </div>
    )}

    <article class="wrap narrow post-body">
      <p>I get this question every few weeks.</p>
<p>A tour operator. A clinic. A carpentry shop. They’ve claimed their Google Business Profile, they’re showing up on Google Maps, they’re getting some calls — and they’re wondering: <em>do I actually need a website too?</em></p>
<p>The answer is yes. But the more useful answer is understanding what each one does — and where each one fails.</p>
<hr>
<h2 id="what-a-google-business-profile-actually-does">What a Google Business Profile actually does</h2>
<p>A Google Business Profile is a listing. Think of it as a structured entry in Google’s local database: your business name, category, address, phone number, hours, photos, and reviews — displayed when someone searches for you by name or finds you in a local map search.</p>
<p>It is powerful for exactly one thing: <strong>being found when someone is already looking for something near a specific location.</strong></p>
<p>When someone opens Google Maps and types “clinic near me” — your GBP is what shows up. If your profile is complete, has good photos, and has recent positive reviews, you rank higher. The person calls. Or taps for directions. Or visits.</p>
<p>For discovery in local search — particularly map-based search — a GBP is the most important single thing a physical business can have. More valuable than any amount of Instagram followers. More directly tied to walk-in traffic and phone calls than almost any other digital asset.</p>
<p><strong>So: claim it, complete it, photograph it, collect reviews on it. That part is not optional.</strong></p>
<hr>
<h2 id="where-a-google-business-profile-stops">Where a Google Business Profile stops</h2>
<p>A GBP is a listing. It can show someone your hours and your phone number. It cannot:</p>
<ul>
<li>Tell a complex story about your services</li>
<li>Show a portfolio of your past work</li>
<li>Let someone book directly without calling</li>
<li>Rank for long-tail searches like “custom web developer with admin panel” or “D2C storefront Razorpay integration”</li>
<li>Capture leads from people who are researching and not yet ready to call</li>
<li>Work for service businesses with no physical location</li>
<li>Rank in AI-powered search results (ChatGPT, Perplexity, Claude)</li>
</ul>
<p>The moment a customer’s question goes beyond “where are you and when are you open” — your GBP can’t answer it. Your website can.</p>
<hr>
<h2 id="what-a-website-actually-does">What a website actually does</h2>
<p>A website is infrastructure. It can do things a GBP cannot:</p>
<p><strong>Rank for intent-based searches.</strong> “Best custom web developer for school portal.” “WhatsApp commerce website India.” “Tax accountant Pune who understands startups.” These searches happen before someone opens Maps. They’re driven by intent, not geography. Only your website can rank for them.</p>
<p><strong>Convert researchers into customers.</strong> Someone who found you on Google Maps calls. Someone who finds you through search, reads about your work, sees your prices, reads client testimonials, and then fills out a form — that person is warmer, more qualified, and more likely to become a long-term client.</p>
<p><strong>Capture leads passively.</strong> A well-built website with a WhatsApp integration captures enquiries at 11 PM when you’re asleep. A GBP shows your phone number. The calls stop when you stop answering.</p>
<p><strong>Build trust at scale.</strong> For any engagement worth deciding on — a business website, a school portal, a D2C storefront — customers need to see more than a Google listing to commit. A professional website is the signal that you take your own business seriously.</p>
<p><strong>Rank in AI search.</strong> Increasingly, potential customers are asking AI assistants — ChatGPT, Perplexity, Claude — for recommendations. These tools synthesise information from websites. A GBP doesn’t appear in an AI-generated recommendation. A well-structured website does.</p>
<hr>
<h2 id="the-practical-breakdown-by-business-type">The practical breakdown by business type</h2>
<p><strong>Physical retail, restaurants, salons, clinics:</strong> Your GBP does the heaviest lifting — foot traffic, map discovery, calls. You still need a website for credibility, service pages, and online booking. Priority: GBP first, website second.</p>
<p><strong>Service businesses (contractors, accountants, lawyers, coaches, developers, designers):</strong> Your website is the primary asset. There’s no location-based walk-in traffic. Clients find you through search, referrals, or your portfolio — all of which require a website to convert. Priority: website first, GBP second.</p>
<p><strong>Travel operators, homestays, tour companies:</strong> Both matter equally. GBP for map discovery and reviews. Website for booking funnels, package pages, WhatsApp integration, and AI-search visibility. Priority: build both simultaneously.</p>
<p><strong>D2C brands and e-commerce:</strong> Your website <em>is</em> your business. GBP is largely irrelevant unless you have a physical showroom. Priority: website only.</p>
<hr>
<h2 id="the-common-mistake">The common mistake</h2>
<p>Most businesses treat a GBP as a substitute for a website because it’s free and faster to set up.</p>
<p>That works until it doesn’t. The GBP gets the phone ringing. But if the caller asks to “see some examples of your work” or “check your prices online” or “book without calling” — and you have no website — you’ve already lost a percentage of those leads.</p>
<p>The two tools complement each other. A GBP drives discovery. A website converts the discovered.</p>
<hr>
<h2 id="how-to-prioritise">How to prioritise</h2>
<p>If you have neither: claim your GBP first this week. It’s free and takes 30 minutes. Start collecting reviews.</p>
<p>If you have a GBP but no website: get a website. Even a well-built 5-page custom site pays for itself if it converts two or three enquiries that would otherwise have gone to a competitor with a website.</p>
<p>If you have a website but no GBP: claim it today. Add 20 real photos. Ask your last ten satisfied clients for reviews. It costs nothing and the search benefit is immediate.</p>
<p>If you have both but they’re mediocre: the website is almost always the more urgent fix. A slow, template-looking website undermines the credibility that your GBP reviews are building.</p>
<hr>
<p><em>I’m Divyansh, solo developer out of Kangra Valley. I build websites for Indian service businesses, travel operators, schools, D2C brands and creators — custom-coded, mobile-first, WhatsApp-integrated, live in 14 days.</em></p>
<p><em><a href="/projects/baglamukhi-travels/">Baglamukhi Travels</a> is what happens when both are set up properly — the site averages position 5.7 on Google against aggregators with far bigger budgets. I build these as a <a href="/web-developer-kangra/">web developer in Kangra</a>. If your business has a Google Business Profile but no website — or vice versa — <a href="https://wa.me/919816091875">WhatsApp me</a> and I’ll tell you within a day what to fix first.</em></p>
      <div class="tags">{post.tags.map((t) => <span>{t}</span>)}</div>
    </article>

    <PostFaq faqs={faqs} />

    <RelatedPosts slug={slug} audience={post.audience} />

    <section class="post-foot-cta">
      <div class="wrap narrow">
        {post.audience === "indian-smb" ? (
          <>
            <h2>Working on something in India?</h2>
            <p>If a post here matches what you're building, send me the brief. WhatsApp reply in under an hour, 9 AM–9 PM IST — I'll tell you within a day if it's a fit.</p>
            <div class="cta-row">
              <a class="btn btn-primary" href="https://wa.me/919816091875" target="_blank" rel="noopener"
                >Message me on WhatsApp <span aria-hidden="true">↗</span></a
              >
              <a class="btn btn-ghost" href="/#work">See the work</a>
            </div>
          </>
        ) : post.audience === "d2c-brand" ? (
          <>
            <h2>Building a brand a theme can't carry?</h2>
            <p>If your store has a model that off-the-shelf builders fight — hand-numbered drops, creator commerce, premium D2C — tell me about it. I read every brief personally.</p>
            <div class="cta-row">
              <a class="btn btn-primary" href="mailto:hello@divyanshsood.com"
                >Email me <span aria-hidden="true">↗</span></a
              >
              <a class="btn btn-ghost" href="/#work">See the work</a>
            </div>
          </>
        ) : (
          <>
            <h2>Working on something similar?</h2>
            <p>If a post here matches what you're building, send me the brief. I reply personally, usually within a couple of hours — and I'll tell you within a day if it's a fit.</p>
            <div class="cta-row">
              <a class="btn btn-primary" href="mailto:hello@divyanshsood.com"
                >Email me <span aria-hidden="true">↗</span></a
              >
              <a class="btn btn-ghost" href={CALENDLY_URL} target="_blank" rel="noopener"
                >Book a 15-min intro <span aria-hidden="true">↗</span></a
              >
            </div>
          </>
        )}
      </div>
    </section>
  </main>
</Studio>
