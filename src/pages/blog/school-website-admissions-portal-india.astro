---
import Studio from "../../layouts/Studio.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import PostFaq from "../../components/PostFaq.astro";
import { SITE, DEFAULT_OG, CALENDLY_URL, fmtDate, iso, POSTS, authorNode, publisherNode, websiteNode, topicsForTags } from "../../lib/blog.mjs";
import { coverBase, coverSrcset, COVER_SIZES_POST } from "../../lib/images.mjs";

const slug = "school-website-admissions-portal-india";
const idx = POSTS.findIndex((p) => p.slug === slug);
const post = POSTS[idx];

const canonical = `${SITE}/blog/${slug}/`;
const ogImage = post.coverImage ? `${SITE}${post.coverImage}` : DEFAULT_OG;
const primaryTag = post.tags[0] || "Notes";
const readMins = post.readMins;
const showUpdated = post.updatedDate && +new Date(post.updatedDate) > +new Date(post.pubDate);
const updatedLabel = showUpdated ? `Updated ${fmtDate(post.updatedDate)}` : null;

/* Questions real buyers ask, answered in full. This array is the single
   source for both the visible accordion and the FAQPage node above — Google
   requires FAQ markup to match content on the page, and deriving both from one
   array is what stops them drifting. */
const faqs = [
  {
    q: "What do parents actually look for on a school website?",
    a: "Fees, admission dates, curriculum, results, safety, and how to reach a human — usually in that order, usually on a phone, usually in a hurry. Most Indian school websites lead with a principal's message and a photo gallery and bury all six. The single highest-return change is putting the answers parents came for on the page they land on.",
  },
  {
    q: "Does a school need an ERP or an admissions portal?",
    a: "Most schools need the admissions portal and are being sold the ERP. A portal handles the part that's genuinely painful — enquiry to application to document upload to status, with an admin view of where every applicant is. A full ERP adds attendance, fees, timetabling and payroll, carries a recurring subscription, and typically gets used at a fraction of its capacity.",
  },
  {
    q: "How long does a school website with an admissions portal take to build?",
    a: "Weeks, not months. Divyansh Sood built the Modern K.B.S. school website plus its admissions web app and admin panel in 7 days, where other agencies had quoted six months. That was a compressed timeline for a specific scope, not the standard promise — but it establishes what the honest ceiling looks like when the requirements are clear.",
  },
  {
    q: "Should a school website be built for parents or for the school?",
    a: "For parents, and this is where most school sites go wrong. A site organised around the school's internal structure — departments, committees, notices — makes sense to the people who commissioned it and fails the parent trying to find out whether admissions are open. If the homepage doesn't answer the top three parent questions, the rest of the site is decoration.",
  },
  {
    q: "What should a school insist on when commissioning a website?",
    a: "Ownership of the code and the data, a working admissions flow tested on a real phone on a real connection, the ability to update dates and notices without calling the developer, and a plan for what happens when three hundred parents apply in the same week. Ask about the last one specifically — it's where cheap builds fall over.",
  },
];

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": `${canonical}#post`,
      headline: post.title,
      description: post.description,
      datePublished: iso(post.pubDate),
      dateModified: iso(post.updatedDate || post.pubDate),
      author: authorNode(SITE),
      publisher: publisherNode(SITE),
      isPartOf: websiteNode(SITE),
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      image: ogImage,
      articleSection: primaryTag,
      keywords: post.tags.join(", "),
      // Resolves the free-text tags above to public concept identifiers, so a
      // parser knows "Astro" means the framework and "GEO" isn't geography.
      about: topicsForTags(post.tags),
      wordCount: post.wordCount,
      timeRequired: `PT${readMins}M`,
      speakable: {
        "@type": "SpeakableSpecification",
        cssSelector: [".post-title", ".post-lead"],
      },
      inLanguage: "en",
      url: canonical,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE}/blog/` },
        { "@type": "ListItem", position: 3, name: post.title, item: canonical },
      ],
    },
    {
      // Google retired FAQ rich results in May 2026, so this earns no SERP
      // enhancement. It stays because answer engines read Q&A pairs well, and
      // because every question below is rendered visibly by <PostFaq>.
      "@type": "FAQPage",
      "@id": `${canonical}#faq`,
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
});
---

<Studio
  title={post.seoTitle ?? `${post.title} · Divyansh Sood`}
  description={post.description}
  canonical={canonical}
  keywords={post.tags.join(", ")}
  ogType="article"
  ogTitle={post.title}
  ogImage={ogImage}
  ogImageW={1200}
  ogImageH={750}
  articlePublished={iso(post.pubDate)}
  articleModified={iso(post.updatedDate || post.pubDate)}
  tags={post.tags}
  preloadImage={{ href: coverBase(post.coverImage), srcset: coverSrcset(post.coverImage), sizes: COVER_SIZES_POST }}
  jsonld={jsonld}
>
  <main>
    <header class="post-hero">
      <div class="wrap narrow">
        <div class="eyebrow">
          <span>{primaryTag}</span>
          <span>{fmtDate(post.pubDate)}</span>
          {updatedLabel && <span class="post-updated">{updatedLabel}</span>}
          <span>{readMins} min read</span>
        </div>
        <h1 class="post-title">{post.title}</h1>
        <p class="post-lead">{post.description}</p>
        <div class="post-meta">
          <span>By Divyansh Sood</span><span>{fmtDate(post.pubDate)}</span><span>{readMins} min read</span>
        </div>
      </div>
    </header>

    {post.coverImage && (
      <div class="wrap narrow">
        <figure class="post-cover">
          <img
            src={coverBase(post.coverImage)}
            srcset={coverSrcset(post.coverImage)}
            sizes={COVER_SIZES_POST}
            alt={post.coverAlt ?? post.title}
            width="1200"
            height="750"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      </div>
    )}

    <article class="wrap narrow post-body">
<p>Most school websites in India are built to satisfy the management, not the parents. A slider of the annual function, a principal’s message, a marquee tag if the site is old enough — and none of the three things a parent actually came for.</p>
<p>I know what parents come for because I built a school website that had to work in seven days, and there was no time to build anything that didn’t matter.</p>
<hr>
<h2 id="what-parents-actually-look-for">What parents actually look for</h2>
<p>Watch a parent evaluate a school online and the list is short:</p>
<ul>
<li><strong>Admissions</strong> — is it open, for which classes, what documents, what’s the process, whom do I call?</li>
<li><strong>Proof of seriousness</strong> — facilities, faculty, results, affiliations. Real photographs, not stock images of children who are visibly not from your school.</li>
<li><strong>Practicalities</strong> — fees or at least a fee-enquiry path, transport routes, contact that answers.</li>
</ul>
<p>A school site that nails those three earns the visit. Everything else — the vision statement, the founder’s garland photos — is for the management, and parents scroll past it.</p>
<hr>
<h2 id="the-admissions-portal-is-the-real-upgrade">The admissions portal is the real upgrade</h2>
<p>The bigger shift isn’t the website — it’s moving admissions from a physical register to a portal. When I built <a href="/projects/modernkbs/">Modern K.B.S.</a>, the school got both in the same sprint: a public site, plus an admin panel where staff manage admissions for classes I–XII — applications in one place, no lost forms, no “come back tomorrow with a photocopy.”</p>
<p>What surprises school managements: this doesn’t require an expensive “school ERP” subscription. Those platforms charge annually, forever, for modules you’ll never open. A custom-built portal that does exactly your admissions flow — and only that — is a one-time build with <strong>zero recurring SaaS fees</strong>. The Modern K.B.S. build runs on none.</p>
<hr>
<h2 id="what-it-costs-and-what-it-shouldnt">What it costs — and what it shouldn’t</h2>
<p>The Indian market quotes school websites anywhere from ₹8,000 to several lakhs, which tells you pricing here is about the buyer, not the build. The honest framing:</p>
<ul>
<li>A static informational site — pages, photos, admissions info, enquiry form — is the entry tier. It is the fastest to ship and the cheapest to run, and for many schools it is genuinely enough.</li>
<li>Add an admissions portal with an admin panel and you’re in web-app territory — more than a brochure site, but a one-time cost that replaces a recurring ERP subscription, so the three-year math usually favors it decisively.</li>
<li>Timelines are the tell: agencies quoted Modern K.B.S. six months. The site and portal shipped in seven days. If a vendor needs half a year for a school website, you’re paying for their process, not your product.</li>
</ul>
<hr>
<h2 id="the-checklist-for-your-school">The checklist, if you run a school</h2>
<ul>
<li>Admissions status visible on the homepage, one tap from anywhere on mobile.</li>
<li>Real photography — the campus you have, not the campus stock photos wish you had.</li>
<li>A working enquiry path: form plus WhatsApp, answered by a named person.</li>
<li>An admissions portal if you process more than a handful of applications — staff time saved pays for it.</li>
<li>Ownership: the school should own its domain, its hosting and its code. Not the vendor. In writing.</li>
</ul>
<p>The full build story — what shipped on each of the seven days — is in the <a href="/blog/modernkbs-school-website-case-study/">Modern K.B.S. case study</a>.</p>
<hr>
<p><em>I’m Divyansh Sood, a developer based in Kangra district, Himachal — I build school websites and <a href="/services/web-app-development/">admissions portals</a> as one-time projects with no recurring fees, and schools anywhere in India can work with me remotely. If you’re near <a href="/web-developer-kangra/">Kangra</a>, we can even meet. Message me on <a href="https://wa.me/919816091875">WhatsApp</a> with your school’s name — I’ll reply with what I’d build and a fixed written quote.</em></p>
      <div class="tags">{post.tags.map((t) => <span>{t}</span>)}</div>
    </article>

    <PostFaq faqs={faqs} />

    <RelatedPosts slug={slug} audience={post.audience} />

    <section class="post-foot-cta">
      <div class="wrap narrow">
        {post.audience === "indian-smb" ? (
          <>
            <h2>Working on something in India?</h2>
            <p>If a post here matches what you're building, send me the brief. WhatsApp reply in under an hour, 9 AM–9 PM IST — I'll tell you within a day if it's a fit.</p>
            <div class="cta-row">
              <a class="btn btn-primary" href="https://wa.me/919816091875" target="_blank" rel="noopener"
                >Message me on WhatsApp <span aria-hidden="true">↗</span></a
              >
              <a class="btn btn-ghost" href="/#work">See the work</a>
            </div>
          </>
        ) : post.audience === "d2c-brand" ? (
          <>
            <h2>Building a brand a theme can't carry?</h2>
            <p>If your store has a model that off-the-shelf builders fight — hand-numbered drops, creator commerce, premium D2C — tell me about it. I read every brief personally.</p>
            <div class="cta-row">
              <a class="btn btn-primary" href="mailto:hello@divyanshsood.com"
                >Email me <span aria-hidden="true">↗</span></a
              >
              <a class="btn btn-ghost" href="/#work">See the work</a>
            </div>
          </>
        ) : (
          <>
            <h2>Working on something similar?</h2>
            <p>If a post here matches what you're building, send me the brief. I reply personally, usually within a couple of hours — and I'll tell you within a day if it's a fit.</p>
            <div class="cta-row">
              <a class="btn btn-primary" href="mailto:hello@divyanshsood.com"
                >Email me <span aria-hidden="true">↗</span></a
              >
              <a class="btn btn-ghost" href={CALENDLY_URL} target="_blank" rel="noopener"
                >Book a 15-min intro <span aria-hidden="true">↗</span></a
              >
            </div>
          </>
        )}
      </div>
    </section>
  </main>
</Studio>
