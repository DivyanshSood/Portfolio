---
import Base from "../layouts/Base.astro";
import PageHero from "../components/brand/PageHero.astro";
import Section from "../components/brand/Section.astro";
import EndCta from "../components/brand/EndCta.astro";
import Quote from "../components/brand/Quote.astro";
import GoogleReviews from "../components/brand/GoogleReviews.astro";
import GoogleRating from "../components/brand/GoogleRating.astro";
import { getGoogleReviews } from "../lib/google-reviews.mjs";
import { SITE, CALENDLY_URL, GOOGLE_REVIEWS_URL } from "../lib/site.mjs";
import { TESTIMONIALS, testimonialPerson, testimonialOrg, canMarkUp } from "../data/testimonials.mjs";

const canonical = `${SITE}/testimonials/`;

// Build-time Google Business Profile reviews; [] without an API key, in which
// case the section is left out and the client quotes become (01).
const googleCount = (await getGoogleReviews()).length;
const n0 = googleCount ? 1 : 0;

// Every quote is real and comes from src/data/testimonials.mjs (the same file
// as the homepage "What clients say" block).
const reviews = TESTIMONIALS;

// Review nodes only for quotes from a NAMED client who gave written
// permission (canMarkUp). No reviewRating: these are quotes, not star ratings,
// and the studio's Google rating is never marked up (no AggregateRating).
const reviewNodes = reviews.filter(canMarkUp).map((t) => ({
  "@type": "Review",
  "@id": `${canonical}#review-${t.projectSlug}`,
  url: canonical,
  itemReviewed: { "@id": `${SITE}/#studio` },
  author: {
    "@type": "Person",
    name: t.name,
    jobTitle: t.role,
    worksFor: { "@type": "Organization", name: t.org, url: t.liveUrl },
  },
  reviewBody: t.quote,
}));

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#page`,
      url: canonical,
      name: "Testimonials — Divyansh Sood® Studio",
      description: "What clients say about working with Divyansh Sood — founders of travel, e-commerce, education and creator brands.",
      isPartOf: { "@id": `${SITE}/#website` },
      about: { "@id": `${SITE}/#studio` },
      ...(reviewNodes.length ? { hasPart: reviewNodes.map((r) => ({ "@id": r["@id"] })) } : {}),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Testimonials", item: canonical },
      ],
    },
    ...reviewNodes,
  ],
});
---

<Base
  title="Client Reviews & Testimonials — Divyansh Sood® Studio"
  description="What clients say about web developer Divyansh Sood — real founders, from a school admin to a 585K-subscriber creator and a Kangra taxi operator."
  canonical={canonical}
  keywords="Divyansh Sood reviews, client testimonials, web developer reviews, freelance web developer reviews"
  ogTitle="Testimonials — what clients say"
  ogDescription="Real words from real founders — travel, e-commerce, education and creator brands."
  jsonld={jsonld}
>
  <main>
    <PageHero
      display="What clients actually say."
      size="case"
      kicker="Testimonials · In their own words · 2025—2026"
      lead="No stock quotes, no invented names. These are real founders — a school admin, a 585K-subscriber creator, a taxi operator — describing what changed after I shipped."
    >
      <a class="btn btn--red" href={CALENDLY_URL}>Book an intro call <span aria-hidden="true">→</span></a>
      <a class="btn btn--ink" href={GOOGLE_REVIEWS_URL}>Read my Google reviews <span aria-hidden="true">↗</span></a>
      <GoogleRating class="tm-rating" />
    </PageHero>

    {googleCount > 0 && (
      <Section n={1} term="Google Maps" note="Public reviews" title="On my Google Business Profile">
        <GoogleReviews />
      </Section>
    )}

    <Section n={n0 + 1} term="Team radio" note={`${reviews.length} clients`} title="Every word is real">
      <div class="tm">
        {reviews.map((t, i) => (
          <Quote text={t.quote} by={`${testimonialPerson(t)}, ${testimonialOrg(t)}`} ch={i + 1} red={i === 0} photo={t.photo} photoAlt={t.name ?? ""}>
            {t.metric && (
              <p class="tm-metric">
                <strong>{t.metric.value}</strong> {t.metric.label}
                <span class="tm-src">Source: {t.metric.source}</span>
              </p>
            )}
            <div class="tm-links">
              <a href={t.liveUrl} class="qt-link" rel="noopener">Live site <span aria-hidden="true">↗</span><span class="sr-only"> ({t.org})</span></a>
              <a href={`/projects/${t.projectSlug}/`} class="qt-link">Case study <span aria-hidden="true">→</span><span class="sr-only"> ({t.org})</span></a>
              {t.reviewUrl && (
                <a href={t.reviewUrl} class="qt-link" rel="noopener">Google review <span aria-hidden="true">↗</span><span class="sr-only"> ({t.org})</span></a>
              )}
            </div>
          </Quote>
        ))}
      </div>
      <div class="links-row gap-top">
        <a href={GOOGLE_REVIEWS_URL} rel="noopener">Read all Google reviews <span aria-hidden="true">↗</span></a>
        <a href="/results/">See the results →</a>
        <a href="/press/">Writing about the studio? Press kit →</a>
      </div>
    </Section>

    <EndCta
      title="Be the next one."
      text="Custom-coded, no builder lock-in, most projects live in 7–14 days. Tell me what you're building and I'll tell you within a day if it's a fit."
      primary={{ href: CALENDLY_URL, label: "Book an intro call →" }}
      secondary={{ href: "/portfolio/", label: "See all work →" }}
    />
  </main>
</Base>

<style>
  .tm{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:clamp(14px,1.6vw,24px)}
  .tm-links{display:flex;flex-wrap:wrap;column-gap:20px;margin-top:-10px}
  .tm-metric{margin:0;font-size:15px;line-height:1.4}
  .tm-src{display:block;margin-top:4px;font-size:13px;opacity:.85}
  /* The rating sits on its own row under the hero buttons. */
  :global(.ph-aside > .tm-rating){flex-basis:100%}
</style>
