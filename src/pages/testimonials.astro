---
import Base from "../layouts/Base.astro";
import PageHero from "../components/brand/PageHero.astro";
import Section from "../components/brand/Section.astro";
import EndCta from "../components/brand/EndCta.astro";
import Quote from "../components/brand/Quote.astro";
import { SITE, CALENDLY_URL, GOOGLE_REVIEWS_URL } from "../lib/site.mjs";

const canonical = `${SITE}/testimonials/`;

// Every quote here is real and already used in case studies / homepage schema.
const reviews = [
  { quote: "The website is so beautiful — looks 10 times more premium than our competitors. We started getting direct bookings instead of losing them to Google Maps.", who: "Founder", org: "Nandini Travels · Kangra", slug: "nandini" },
  { quote: "Every other agency said 6 months. Delivered in 7 days.", who: "Admin", org: "Modern K.B.S. · Ladwara", slug: "modernkbs" },
  { quote: "I did not think it could be achieved without going to e-commerce builders and only using custom code.", who: "Chinki, Founder", org: "ChinkiZ Knitting Knife · 600K+ subs", slug: "chinkiz" },
  { quote: "Exactly what we wanted. I will refer Divyansh within my circle for life.", who: "Founder", org: "North Peak Power Systems", slug: "northpeak" },
  { quote: "Incredible — no ordinary agency could have delivered this.", who: "Founder", org: "Redline Studios", slug: "redline" },
];

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#page`,
      url: canonical,
      name: "Testimonials — Divyansh Sood® Studio",
      description: "What clients say about working with Divyansh Sood — founders of travel, e-commerce, education and creator brands.",
      isPartOf: { "@id": `${SITE}/#website` },
      about: { "@id": `${SITE}/#studio` },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Testimonials", item: canonical },
      ],
    },
    // itemReviewed must carry its own @type, not a bare { "@id" } reference:
    // that node is only *defined* in the homepage graph, so here it resolves to
    // nothing and Search Console flags "Invalid object type for field
    // itemReviewed". Restating type and name keeps each Review self-contained
    // while the @id still stitches it to the same entity site-wide.
    ...reviews.map((r) => ({
      "@type": "Review",
      reviewRating: { "@type": "Rating", ratingValue: "5", bestRating: "5", worstRating: "1" },
      author: { "@type": "Organization", name: r.org.split(" · ")[0] },
      itemReviewed: {
        "@type": ["ProfessionalService", "Organization"],
        "@id": `${SITE}/#studio`,
        name: "Divyansh Sood® Studio",
        url: `${SITE}/`,
      },
      reviewBody: r.quote,
    })),
  ],
});
---

<Base
  title="Client Reviews & Testimonials — Divyansh Sood® Studio"
  description="What clients say about web developer Divyansh Sood — real founders, from a school admin to a 600K-subscriber creator and Kangra's most-reviewed taxi operator."
  canonical={canonical}
  keywords="Divyansh Sood reviews, client testimonials, web developer reviews, freelance web developer reviews"
  ogTitle="Testimonials — what clients say"
  ogDescription="Real words from real founders — travel, e-commerce, education and creator brands."
  jsonld={jsonld}
>
  <main>
    <PageHero
      display="What clients actually say."
      size="case"
      kicker="Testimonials · In their own words · 2022—2026"
      lead="No stock quotes, no invented names. These are real founders — a school admin, a 600K-subscriber creator, a taxi operator — describing what changed after we shipped."
    >
      <a class="btn btn--red" href={CALENDLY_URL}>Book an intro call <span aria-hidden="true">→</span></a>
      <a class="btn btn--ink" href={GOOGLE_REVIEWS_URL}>Read our Google reviews ↗</a>
    </PageHero>

    <Section n={1} term="Team radio" note={`${reviews.length} clients`} title="Every word is real">
      <div class="tm">
        {reviews.map((r, i) => (
          <Quote text={r.quote} by={`${r.who}, ${r.org}`} ch={i + 1} red={i === 0}>
            <a href={`/projects/${r.slug}/`} class="qt-link">Case study →</a>
          </Quote>
        ))}
      </div>
      <div class="links-row gap-top"><a href="/results/">See the results →</a></div>
    </Section>

    <EndCta
      title="Be the next one."
      text="Custom-coded, no builder lock-in, most projects live in 3–4 weeks. Tell me what you're building and I'll tell you within a day if it's a fit."
      primary={{ href: CALENDLY_URL, label: "Book an intro call →" }}
      secondary={{ href: "/portfolio/", label: "See all work →" }}
    />
  </main>
</Base>

<style>
  .tm{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:clamp(14px,1.6vw,24px)}
</style>
