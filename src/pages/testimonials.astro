---
import Studio from "../layouts/Studio.astro";
import { SITE, CALENDLY_URL, GOOGLE_REVIEWS_URL } from "../lib/site.mjs";

const canonical = `${SITE}/testimonials/`;

// Every quote here is real and already used in case studies / homepage schema.
const reviews = [
  { quote: "The website is so beautiful — looks 10 times more premium than our competitors. We started getting direct bookings instead of losing them to Google Maps.", who: "Founder", org: "Nandini Travels · Kangra", slug: "nandini" },
  { quote: "Every other agency said 6 months. Delivered in 7 days.", who: "Admin", org: "Modern K.B.S. · Ladwara", slug: "modernkbs" },
  { quote: "I did not think it could be achieved without going to e-commerce builders and only using custom code.", who: "Chinki, Founder", org: "ChinkiZ Knitting Knife · 600K+ subs", slug: "chinkiz" },
  { quote: "Exactly what we wanted. I will refer Divyansh within my circle for life.", who: "Founder", org: "North Peak Power Systems", slug: "northpeak" },
  { quote: "Incredible — no ordinary agency could have delivered this.", who: "Founder", org: "Redline Studios", slug: "redline" },
];

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#page`,
      url: canonical,
      name: "Testimonials — Divyansh Sood® Studio",
      description: "What clients say about working with Divyansh Sood — founders of travel, e-commerce, education and creator brands.",
      isPartOf: { "@id": `${SITE}/#website` },
      about: { "@id": `${SITE}/#studio` },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Testimonials", item: canonical },
      ],
    },
    // itemReviewed must carry its own @type. It previously held a bare
    // { "@id": ".../#studio" } reference, but that node is only *defined* in
    // the homepage graph — on this page it resolves to nothing, which is
    // exactly the "Invalid object type for field itemReviewed" Search Console
    // flags. Restating the type and name here makes each Review self-contained
    // while the @id still stitches it to the same entity site-wide.
    ...reviews.map((r) => ({
      "@type": "Review",
      reviewRating: { "@type": "Rating", ratingValue: "5", bestRating: "5", worstRating: "1" },
      author: { "@type": "Organization", name: r.org.split(" · ")[0] },
      itemReviewed: {
        "@type": ["ProfessionalService", "Organization"],
        "@id": `${SITE}/#studio`,
        name: "Divyansh Sood® Studio",
        url: `${SITE}/`,
      },
      reviewBody: r.quote,
    })),
  ],
});
---

<Studio
  title="Client Reviews & Testimonials — Divyansh Sood® Studio"
  description="What clients say about web developer Divyansh Sood — real founders, from a school admin to a 600K-subscriber creator and Kangra's most-reviewed taxi operator."
  canonical={canonical}
  keywords="Divyansh Sood reviews, client testimonials, web developer reviews, freelance web developer reviews"
  ogTitle="Testimonials — what clients say"
  ogDescription="Real words from real founders — travel, e-commerce, education and creator brands."
  jsonld={jsonld}
>
  <main>
    <header class="cs-hero">
      <div class="cs-hero-bg" aria-hidden="true"></div>
      <div class="wrap">
        <div class="cs-eyebrow">
          <span>Testimonials</span><span>In their own words</span><span>2022—2026</span>
        </div>
        <h1 style="margin:14px 0 0;font-family:'Anton',sans-serif;font-weight:400;font-size:clamp(44px,8vw,108px);line-height:.9;letter-spacing:-.01em;text-transform:uppercase;">What clients <span style="color:var(--accent);">actually say.</span></h1>
        <p class="cs-lead">No stock quotes, no invented names. These are real founders — a school admin, a 600K-subscriber creator, a taxi operator — describing what changed after we shipped.</p>
        <div class="cs-cta-row">
          <a class="btn btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Book an intro call <span aria-hidden="true">↗</span></a>
          <a class="btn btn-ghost" href={GOOGLE_REVIEWS_URL} target="_blank" rel="noopener">Read our Google reviews ↗</a>
          <a class="btn btn-ghost" href="/results/">See the results</a>
        </div>
      </div>
    </header>

    <section class="cs-sec" aria-labelledby="rev-h">
      <div class="wrap">
        <div class="cs-sec-head">
          <h2 id="rev-h">Every word is real</h2>
          <span class="mono">Six clients</span>
        </div>
        <div class="tm-grid" data-reveal>
          {reviews.map((r) => (
            <figure class="tm-card">
              <span class="tm-mark" aria-hidden="true">"</span>
              <span class="cs-tag">{r.org.split(" · ")[0]}</span>
              <blockquote class="tm-quote">{r.quote}</blockquote>
              <figcaption class="tm-cap">
                <span class="tm-who">{r.who}, {r.org}</span>
                <a href={`/projects/${r.slug}/`} class="tm-link">Case study →</a>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="cs-endcta">
      <div class="wrap">
        <h2>Be the next one.</h2>
        <p>Custom-coded, no builder lock-in, most projects live in 3–4 weeks. Tell me what you're building and I'll tell you within a day if it's a fit.</p>
        <div class="cs-cta-row" style="justify-content:center;">
          <a class="btn btn-primary" href={CALENDLY_URL} target="_blank" rel="noopener">Book an intro call <span aria-hidden="true">↗</span></a>
          <a class="btn btn-ghost" href="/portfolio/">See all work</a>
        </div>
      </div>
    </section>
  </main>

  <style>
    /* ============================================================
       Testimonials — UI polish (scoped). Matches About / Results /
       Portfolio; quote cards with hover lift and a lead card that
       spans the row.
       ============================================================ */
    main .cs-sec { padding: clamp(58px, 7vw, 108px) 0; }
    main .cs-hero { padding-top: clamp(120px, 16vw, 160px); }
    main .cs-lead { max-width: 64ch; font-size: clamp(17px, 1.7vw, 21px); }
    main .cs-sec-head { align-items: flex-end; margin-bottom: clamp(30px, 4vw, 52px); }
    main .cs-sec-head h2 {
      font-family: 'Anton', sans-serif;
      font-weight: 400;
      font-size: clamp(32px, 5vw, 72px);
      line-height: 0.94;
      letter-spacing: 0;
      text-transform: uppercase;
    }
    main .cs-sec-head .mono { color: #8A8A93; }

    main .tm-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
    main .tm-card {
      position: relative;
      display: flex;
      flex-direction: column;
      margin: 0;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 12px;
      padding: 30px 26px 24px;
      overflow: hidden;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.03), transparent);
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, background 0.3s ease;
    }
    main .tm-card:hover {
      transform: translateY(-4px);
      border-color: rgba(217,255,60, 0.5);
      background: linear-gradient(180deg, rgba(217,255,60, 0.06), transparent);
    }
    /* First quote reads as the lead — spans two columns. */
    main .tm-card:first-child { grid-column: span 2; }
    main .tm-mark {
      position: absolute;
      top: 2px; right: 20px;
      font-family: "Anton", cursive;
      font-size: 130px;
      line-height: 1;
      color: var(--accent, #d9ff3c);
      opacity: 0.16;
      pointer-events: none;
    }
    main .tm-card .cs-tag { position: relative; margin-bottom: 16px; }
    main .tm-quote {
      position: relative;
      margin: 0 0 22px;
      font-weight: 700;
      font-size: clamp(18px, 1.7vw, 22px);
      line-height: 1.38;
      letter-spacing: -0.015em;
      flex: 1;
    }
    main .tm-card:first-child .tm-quote { font-size: clamp(22px, 2.6vw, 34px); line-height: 1.3; }
    main .tm-cap {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
      padding-top: 18px;
      border-top: 1px solid rgba(255, 255, 255, 0.14);
    }
    main .tm-who {
      font-family: "JetBrains Mono", monospace;
      font-size: 11px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      opacity: 0.66;
    }
    main .tm-link {
      font-family: "JetBrains Mono", monospace;
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent, #d9ff3c);
      text-decoration: none;
      white-space: nowrap;
    }
    main .tm-link:hover { text-decoration: underline; }

    @media (max-width: 860px) {
      main .tm-grid { grid-template-columns: 1fr 1fr; }
      main .tm-card:first-child { grid-column: span 2; }
    }
    @media (max-width: 720px) {
      /* `main .cs-sec` above out-specifies the shared responsive.css phone
         rules, so re-tighten the section rhythm here. */
      main .cs-sec { padding: 44px 0; }
      main .cs-sec-head { margin-bottom: 22px; }
      main .cs-hero { padding-top: 104px; }
    }
    @media (max-width: 560px) {
      main .tm-grid { grid-template-columns: 1fr; }
      main .tm-card:first-child { grid-column: auto; }
    }
  </style>
</Studio>
