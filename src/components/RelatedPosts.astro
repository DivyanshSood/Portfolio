---
// ===========================================================================
// RelatedPosts.astro — the end-of-post internal-link block.
//
// Replaces the old single "read next" chain link. Each post now emits one
// primary next link plus its topic cluster, and a row of hub links (blog
// index, the matching service page, the matching location page). That turns
// 32 near-orphan posts — reachable only from /blog/ — into a linked cluster
// Googlebot has a reason to crawl past the index.
// ===========================================================================
import { related } from "../lib/blog.mjs";

export interface Props {
  /** Slug of the post this block is rendered on. */
  slug: string;
  /** Audience tag from the post manifest — picks the contextual hub links. */
  audience?: string;
}

const { slug, audience } = Astro.props;

const [next, ...more] = related(slug, 5);

// Contextual hubs, one cluster per audience track.
//
// This used to be a ternary that hardcoded Kangra and Dharamshala for every
// Indian post, which meant /web-developer-shimla/ and /web-developer-manali/
// received ZERO hub links — the two pages meant to rank for "web developer
// <city>" were the least-linked commercial pages on the site. The location
// links are now rotated per post (deterministically, by slug) so all four
// cities accumulate links, and each track gets a stable set of service hubs.
const LOCATIONS = [
  { label: "Web developer in Kangra", href: "/web-developer-kangra/" },
  { label: "Web developer in Dharamshala", href: "/web-developer-dharamshala/" },
  { label: "Website designer in Shimla", href: "/web-developer-shimla/" },
  { label: "Web developer in Manali", href: "/web-developer-manali/" },
];

// Stable per-slug offset so a given post always shows the same two cities
// (no layout churn between builds) while the set as a whole spreads evenly.
const offset = [...slug].reduce((n, c) => n + c.charCodeAt(0), 0) % LOCATIONS.length;
const twoCities = [LOCATIONS[offset], LOCATIONS[(offset + 1) % LOCATIONS.length]];

type Hub = { label: string; href: string };
const TRACKS: Record<string, Hub[]> = {
  "indian-smb": [...twoCities, { label: "Results", href: "/results/" }],
  "d2c-brand": [
    { label: "E-commerce development", href: "/services/ecommerce-website-development/" },
    { label: "AI development", href: "/services/ai-development/" },
    { label: "Selected work", href: "/portfolio/" },
  ],
  international: [
    { label: "Services", href: "/services/" },
    { label: "AI development", href: "/services/ai-development/" },
    { label: "Selected work", href: "/portfolio/" },
  ],
};

const HUBS = (audience && TRACKS[audience]) || TRACKS.international;
---

<section class="wrap narrow" aria-label="Keep reading">
  {
    next && (
      <a class="post-next" href={`/blog/${next.slug}/`}>
        <span>
          <span class="label">Read next</span>
          <br />
          <span class="name">{next.title}</span>
        </span>
        <span class="arrow" aria-hidden="true">
          →
        </span>
      </a>
    )
  }

  {
    more.length > 0 && (
      <nav class="post-related" aria-label="Related posts">
        <h2 class="post-related-h">Related reading</h2>
        <ul>
          {more.map((p) => (
            <li>
              <a href={`/blog/${p.slug}/`}>
                <span class="rp-title">{p.title}</span>
                <span class="rp-meta">
                  {p.tags?.[0]} · {p.readMins} min read
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <nav class="post-hubs" aria-label="More from the studio">
    {HUBS.map((h) => <a href={h.href}>{h.label}</a>)}
    <a href="/blog/">All writing</a>
  </nav>
</section>
