<style>
  .ft{background:var(--ink);color:#fff;padding:clamp(64px,8vw,110px) var(--gutter) 76px;overflow:hidden}
  .ft-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,180px),1fr));gap:36px 24px}
  .ft-about{margin:0 0 16px;font-size:15px;line-height:1.5;color:var(--gbd);max-width:30ch}
  .ft-where{margin:0;font-family:var(--mono);font-size:12px;letter-spacing:.08em;color:var(--g8a);line-height:1.8}
  .ft-col{display:flex;flex-direction:column;gap:10px;font-size:15px}
  .ft-col span{font-family:var(--mono);font-size:12px;letter-spacing:.1em;color:var(--red);margin-bottom:4px}
  .ft-col a{color:#fff;text-decoration:none}
  .ft-col a:hover{color:var(--red)}
  .ft-stripe{margin-top:clamp(56px,7vw,96px);display:flex;height:10px}
  .ft-stripe span:nth-child(1){flex:3;background:var(--red)}
  .ft-stripe span:nth-child(2){flex:1;background:#fff}
  .ft-stripe span:nth-child(3){flex:3;background:var(--red);clip-path:polygon(0 0,100% 0,96% 100%,0 100%)}
  .ft-name{font-weight:900;font-style:italic;font-stretch:125%;text-transform:uppercase;line-height:.8;letter-spacing:-0.03em;font-size:clamp(40px,8.2vw,200px);margin-top:18px;overflow-wrap:anywhere}
  .ft-name span{color:var(--red);font-size:.4em;vertical-align:top}
  .ft-bar{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;margin-top:28px;font-family:var(--mono);font-size:11px;letter-spacing:.1em;color:var(--g8a)}
  .ft-bar a{color:#fff}
  .ft-bar a.ft-muted{color:var(--g8a)}
  .ft-bar a:hover{color:var(--red)}
</style>
