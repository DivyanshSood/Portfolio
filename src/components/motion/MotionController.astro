---
// MotionController — orchestrates every GSAP/ScrollTrigger animation on the
// homepage. Lives at the bottom of <body> so it can rely on all DOM nodes
// being present. Respects prefers-reduced-motion.
//
// Bundles GSAP from npm (Vite/Astro handles the chunk), so no CDN dependency.
---

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (reduce) {
    // No animations: just make sure hidden states are visible.
    document
      .querySelectorAll<HTMLElement>("[data-rise], [data-reveal], .ds-giant-line")
      .forEach((el) => {
        el.style.opacity = "1";
        el.style.transform = "none";
      });
  } else {
    initMotion();
  }

  function initMotion() {
    initGiantText();
    initParallax();
    initStatCounters();
    initColorBlocks();
    initSectionHeadings();
    initHorizontalWork();
    initZoomReveal();
  }

  /* ---------- Scroll zoom reveal (Framer ScrollZoomRevel) ------------ */
  function initZoomReveal() {
    const items = gsap.utils.toArray<HTMLElement>("[data-zoom-reveal]");
    items.forEach((item) => {
      const target = item.querySelector<HTMLElement>("[data-zoom-target]");
      if (!target) return;
      // spring-like settle (stiffness 90 / damping 25 / mass 0.6 ≈ slight overshoot)
      gsap.from(target, {
        scale: 0.62,
        opacity: 0,
        duration: 1.2,
        ease: "back.out(1.4)",
        scrollTrigger: {
          trigger: item,
          start: "top 80%",
          toggleActions: "play none none reverse",
        },
      });
    });
  }

  /* ---------- Giant text reveals -------------------------------------- */
  function initGiantText() {
    const sections = gsap.utils.toArray<HTMLElement>("[data-giant-text]");
    sections.forEach((section) => {
      const lines = section.querySelectorAll<HTMLElement>(".ds-giant-line");
      gsap.set(lines, { yPercent: 110, opacity: 0 });
      gsap.to(lines, {
        yPercent: 0,
        opacity: 1,
        duration: 1.1,
        ease: "expo.out",
        stagger: 0.08,
        scrollTrigger: {
          trigger: section,
          start: "top 70%",
          end: "bottom 40%",
          toggleActions: "play none none reverse",
        },
      });
    });
  }

  /* ---------- Parallax images ---------------------------------------- */
  function initParallax() {
    const wraps = gsap.utils.toArray<HTMLElement>("[data-parallax]");
    wraps.forEach((wrap) => {
      const img = wrap.querySelector<HTMLElement>("[data-parallax-img]");
      if (!img) return;
      const speed = parseFloat(wrap.dataset.parallaxSpeed || "0.2");
      gsap.fromTo(
        img,
        { yPercent: -speed * 50 },
        {
          yPercent: speed * 50,
          ease: "none",
          scrollTrigger: {
            trigger: wrap,
            start: "top bottom",
            end: "bottom top",
            scrub: true,
          },
        }
      );
    });
  }

  /* ---------- Stat counters ------------------------------------------ */
  function initStatCounters() {
    const counters = gsap.utils.toArray<HTMLElement>("[data-counter]");
    counters.forEach((el) => {
      const target = parseFloat(el.dataset.counter || "0");
      const decimals = parseInt(el.dataset.counterDecimals || "0", 10);
      const prefix = el.dataset.counterPrefix || "";
      const suffix = el.dataset.counterSuffix || "";
      const obj = { v: 0 };
      gsap.to(obj, {
        v: target,
        duration: 2.2,
        ease: "power3.out",
        scrollTrigger: {
          trigger: el,
          start: "top 80%",
          toggleActions: "play none none reverse",
        },
        onUpdate: () => {
          el.textContent = prefix + obj.v.toFixed(decimals) + suffix;
        },
      });
    });
  }

  /* ---------- Horizontal scroll work (signature scroll piece) ------ */
  function initHorizontalWork() {
    const sections = gsap.utils.toArray<HTMLElement>("[data-h-work]");
    sections.forEach((section) => {
      const track = section.querySelector<HTMLElement>("[data-h-work-track]");
      if (!track) return;
      const dots = gsap.utils.toArray<HTMLElement>("[data-h-progress-dot]", section);
      const fill = section.querySelector<HTMLElement>("[data-h-progress-fill]");
      const getDistance = () => track.scrollWidth - window.innerWidth;

      // Per-card parallax on the signature mark — the big letter M/C/W on each
      // card. Each mark drifts at its own speed relative to the h-scroll so the
      // marks feel layered, not pasted on. Driven off the same ScrollTrigger
      // instance as the track so refreshes stay in sync.
      const marks = gsap.utils.toArray<HTMLElement>("[data-h-work-mark]", section);

      const st = gsap.to(track, {
        x: () => -getDistance(),
        ease: "none",
        scrollTrigger: {
          trigger: section,
          start: "top top",
          end: () => "+=" + getDistance(),
          pin: true,
          scrub: 0.6,
          invalidateOnRefresh: true,
          anticipatePin: 1,
          onUpdate: (self) => {
            const p = self.progress;
            // Map scroll progress 0→1 to 4 stops (3 cards + 1 CTA card).
            const idx = Math.min(dots.length - 1, Math.floor(p * dots.length * 0.999));
            dots.forEach((dot, i) => dot.classList.toggle("is-active", i === idx));
            if (fill) fill.style.width = (p * 100).toFixed(2) + "%";
            // Parallax the marks: each card's mark gets a phase offset so they
            // breathe at different points in the scroll. Translate the mark
            // from -28px (early) to +28px (late) within its own window.
            marks.forEach((mark, i) => {
              const local = Math.max(0, Math.min(1, p * marks.length - i));
              const eased = (local - 0.5) * 56; // -28..+28
              mark.style.transform = `translateY(${eased.toFixed(2)}px)`;
            });
          },
        },
      });

      // Make the dots clickable — clicking jumps the scroll to that card.
      dots.forEach((dot, i) => {
        dot.addEventListener("click", () => {
          const total = dots.length;
          const targetProgress = (i + 0.5) / total;
          const scrollTarget =
            st.scrollTrigger!.start +
            (st.scrollTrigger!.end - st.scrollTrigger!.start) * targetProgress;
          window.scrollTo({ top: scrollTarget, behavior: "smooth" });
        });
        dot.style.cursor = "pointer";
        dot.setAttribute("role", "button");
        dot.setAttribute("aria-label", `Go to card ${i + 1}`);
      });
    });
  }

  /* ---------- Work row stagger (vertical list reveal) --------------- */
  function initWorkRows() {
    const rows = gsap.utils.toArray<HTMLElement>(".work-row");
    if (!rows.length) return;
    gsap.set(rows, { opacity: 0, y: 30 });
    ScrollTrigger.batch(rows, {
      start: "top 85%",
      onEnter: (batch) =>
        gsap.to(batch, {
          opacity: 1,
          y: 0,
          duration: 0.8,
          ease: "power3.out",
          stagger: 0.06,
        }),
      onEnterBack: (batch) =>
        gsap.to(batch, {
          opacity: 1,
          y: 0,
          duration: 0.6,
          ease: "power3.out",
          stagger: 0.04,
        }),
    });
  }

  /* ---------- Color block crossfades --------------------------------- */
  function initColorBlocks() {
    const blocks = gsap.utils.toArray<HTMLElement>("[data-colorblock]");
    blocks.forEach((block) => {
      const bg = block.dataset.colorblockBg || "dark";
      const color =
        bg === "light"
          ? "#ededed"
          : bg === "accent"
          ? "#ff4612"
          : bg === "ink"
          ? "#0f1416"
          : "#0b0b0c";
      gsap.fromTo(
        block,
        { backgroundColor: "#0b0b0c" },
        {
          backgroundColor: color,
          ease: "none",
          scrollTrigger: {
            trigger: block,
            start: "top 80%",
            end: "top 30%",
            scrub: true,
          },
        }
      );
    });
  }

  /* ---------- Section heading word reveal ---------------------------- */
  function initSectionHeadings() {
    const headings = gsap.utils.toArray<HTMLElement>("[data-heading-reveal]");
    headings.forEach((h) => {
      gsap.from(h, {
        y: 60,
        opacity: 0,
        duration: 1,
        ease: "power3.out",
        scrollTrigger: {
          trigger: h,
          start: "top 85%",
          toggleActions: "play none none reverse",
        },
      });
    });
  }
</script>