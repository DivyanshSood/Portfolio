---
// MotionController — orchestrates every GSAP/ScrollTrigger animation on the
// homepage, driven by Lenis smooth scroll. Lives at the bottom of <body> so it
// can rely on all DOM nodes being present. Strictly respects
// prefers-reduced-motion: when set, it reveals everything and adds no motion.
//
// Bundles GSAP + Lenis from npm (Vite/Astro handles the chunk) — no CDN.
---

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import Lenis from "lenis";

  gsap.registerPlugin(ScrollTrigger);

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const docEl = document.documentElement;

  if (reduce) {
    // No animation: ensure every motion target is fully visible.
    document
      .querySelectorAll<HTMLElement>("[data-reveal], [data-heading-reveal], .ds-giant-line, [data-zoom-target]")
      .forEach((el) => {
        el.style.opacity = "1";
        el.style.transform = "none";
      });
    docEl.classList.add("motion-fallback");
  } else {
    boot();
  }

  function boot() {
    initSmoothScroll();
    initHero();
    initReveal();
    initGiantText();
    initParallax();
    initStatCounters();
    initSectionHeadings();
    initZoomReveal();
    // Recalculate once fonts/images settle, then mark ready (cancels failsafe).
    ScrollTrigger.refresh();
    docEl.classList.add("motion-ready");
    window.addEventListener("load", () => ScrollTrigger.refresh());
  }

  /* ---------- Lenis smooth scroll, driven by GSAP's ticker --------------- */
  function initSmoothScroll() {
    const lenis = new Lenis({
      duration: 1.1,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true,
    });
    lenis.on("scroll", ScrollTrigger.update);
    gsap.ticker.add((time) => lenis.raf(time * 1000));
    gsap.ticker.lagSmoothing(0);
    // Expose for anchor links / programmatic scroll (e.g. progress dots).
    (window as any).__lenis = lenis;

    // Smooth in-page anchor jumps through Lenis. Also catches "/#section"
    // links (shared components like the nav use that form so they work from
    // inner pages) — on the homepage they're the same in-page target.
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"], a[href^="/#"]').forEach((a) => {
      a.addEventListener("click", (e) => {
        const id = (a.getAttribute("href") || "").replace(/^\//, "");
        if (!id || id === "#" || id.length < 2) return;
        const target = document.querySelector(id);
        if (!target) return;
        e.preventDefault();
        lenis.scrollTo(target as HTMLElement, { offset: -10 });
      });
    });
  }

  /* ---------- Hero depth: exit scrub + pointer parallax ----------------- */
  // The hero's *entrance* stays in its own CSS keyframes (Hero.astro). Here we
  // add what CSS can't: the card releasing upward as the fold scrolls away,
  // a slow push-in on the portrait, and a desktop-only pointer parallax.
  // Scale-only on the background so the approved framing at rest never shifts.
  function initHero() {
    const hero = document.querySelector<HTMLElement>("#top.ds-hero");
    if (!hero) return;
    const bg = hero.querySelector<HTMLElement>(".ds-hero-bg");
    const card = hero.querySelector<HTMLElement>(".hero-card");

    if (bg) {
      gsap.fromTo(
        bg,
        { scale: 1.02 },
        {
          scale: 1.1,
          ease: "none",
          scrollTrigger: { trigger: hero, start: "top top", end: "bottom top", scrub: true },
        }
      );
    }
    if (card) {
      gsap.to(card, {
        y: -70,
        opacity: 0,
        ease: "none",
        scrollTrigger: { trigger: hero, start: "top top", end: "72% top", scrub: true },
      });
    }
    if (bg && window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
      // ±0.8% drift max — the 1.02 base scale leaves 1% overscan per side,
      // so the photo's edges can never enter the frame.
      const xTo = gsap.quickTo(bg, "xPercent", { duration: 0.9, ease: "power3.out" });
      const yTo = gsap.quickTo(bg, "yPercent", { duration: 0.9, ease: "power3.out" });
      hero.addEventListener("pointermove", (e) => {
        const r = hero.getBoundingClientRect();
        xTo(((e.clientX - r.left) / r.width - 0.5) * -1.6);
        yTo(((e.clientY - r.top) / r.height - 0.5) * -1.2);
      });
      hero.addEventListener("pointerleave", () => {
        xTo(0);
        yTo(0);
      });
    }
  }

  /* ---------- Generic scroll reveal (data-reveal) ----------------------- */
  function initReveal() {
    const items = gsap.utils.toArray<HTMLElement>("[data-reveal]");
    if (!items.length) return;
    gsap.set(items, { opacity: 0, y: 28 });
    ScrollTrigger.batch(items, {
      start: "top 90%",
      onEnter: (batch) =>
        gsap.to(batch, {
          opacity: 1,
          y: 0,
          duration: 0.9,
          ease: "power3.out",
          stagger: 0.07,
          overwrite: true,
        }),
    });
  }

  /* ---------- Scroll zoom reveal (Framer ScrollZoomReveal) -------------- */
  function initZoomReveal() {
    const items = gsap.utils.toArray<HTMLElement>("[data-zoom-reveal]");
    items.forEach((item) => {
      const target = item.querySelector<HTMLElement>("[data-zoom-target]");
      if (!target) return;
      gsap.from(target, {
        scale: 0.62,
        opacity: 0,
        duration: 1.2,
        ease: "back.out(1.4)",
        scrollTrigger: {
          trigger: item,
          start: "top 80%",
          toggleActions: "play none none reverse",
        },
      });
    });
  }

  /* ---------- Giant text reveals --------------------------------------- */
  function initGiantText() {
    const sections = gsap.utils.toArray<HTMLElement>("[data-giant-text]");
    sections.forEach((section) => {
      const lines = section.querySelectorAll<HTMLElement>(".ds-giant-line");
      if (!lines.length) return;
      // 120% matches the CSS pre-hide in base.css (html.motion .ds-giant-line)
      // so there's no jump when GSAP takes over from the pre-paint state.
      // y:0 matters: GSAP parses the CSS translateY(120%) out of the computed
      // matrix as an absolute `y` px offset — clear it, or the line keeps that
      // extra offset forever and stays hidden behind its mask.
      gsap.set(lines, { y: 0, yPercent: 120, opacity: 0 });
      gsap.to(lines, {
        yPercent: 0,
        opacity: 1,
        duration: 1.1,
        ease: "expo.out",
        stagger: 0.08,
        scrollTrigger: {
          trigger: section,
          start: "top 75%",
          end: "bottom 40%",
          toggleActions: "play none none reverse",
        },
      });
    });
  }

  /* ---------- Parallax images ------------------------------------------ */
  function initParallax() {
    const wraps = gsap.utils.toArray<HTMLElement>("[data-parallax]");
    wraps.forEach((wrap) => {
      const img = wrap.querySelector<HTMLElement>("[data-parallax-img]");
      if (!img) return;
      const speed = parseFloat(wrap.dataset.parallaxSpeed || "0.2");
      gsap.fromTo(
        img,
        { yPercent: -speed * 50 },
        {
          yPercent: speed * 50,
          ease: "none",
          scrollTrigger: { trigger: wrap, start: "top bottom", end: "bottom top", scrub: true },
        }
      );
    });
  }

  /* ---------- Stat counters -------------------------------------------- */
  function initStatCounters() {
    const counters = gsap.utils.toArray<HTMLElement>("[data-counter]");
    counters.forEach((el) => {
      const target = parseFloat(el.dataset.counter || "0");
      const decimals = parseInt(el.dataset.counterDecimals || "0", 10);
      const prefix = el.dataset.counterPrefix || "";
      const suffix = el.dataset.counterSuffix || "";
      const obj = { v: 0 };
      gsap.to(obj, {
        v: target,
        duration: 2.2,
        ease: "power3.out",
        scrollTrigger: { trigger: el, start: "top 85%", toggleActions: "play none none none" },
        onUpdate: () => {
          el.textContent = prefix + obj.v.toFixed(decimals) + suffix;
        },
      });
    });
  }

  /* ---------- Section heading reveal ----------------------------------- */
  function initSectionHeadings() {
    const headings = gsap.utils.toArray<HTMLElement>("[data-heading-reveal]");
    headings.forEach((h) => {
      gsap.from(h, {
        y: 60,
        opacity: 0,
        duration: 1,
        ease: "power3.out",
        scrollTrigger: { trigger: h, start: "top 88%", toggleActions: "play none none reverse" },
      });
    });
  }
</script>
