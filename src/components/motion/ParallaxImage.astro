---
// Image wrapper with parallax + fade-up. The inner <img> translates slower
// than the page scroll, giving a subtle depth effect. Driven by ScrollTrigger.

export interface Props {
  src: string;
  alt: string;
  speed?: number; // 0.1 = subtle, 0.4 = strong
  height?: string; // any CSS value: "60vh", "420px", etc.
  radius?: string;
  fit?: "cover" | "contain";
}

const {
  src,
  alt,
  speed = 0.22,
  height = "70vh",
  radius = "0px",
  fit = "cover",
} = Astro.props;
---

<div
  class="ds-parallax"
  data-parallax
  data-parallax-speed={speed}
  style={`height:${height};border-radius:${radius};`}
>
  <img
    src={src}
    alt={alt}
    class="ds-parallax-img"
    data-parallax-img
    loading="lazy"
    decoding="async"
    style={`object-fit:${fit};`}
  />
</div>

<style>
  .ds-parallax {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #1a1a1c;
  }
  .ds-parallax-img {
    position: absolute;
    inset: -15% 0; /* extra room for parallax travel */
    width: 100%;
    height: 130%;
    display: block;
  }
</style>