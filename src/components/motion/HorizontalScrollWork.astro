---
// Selected work — the homepage's proof section (no horizontal scroll; the
// filename is historical). "Show, don't tell": each of the 4 featured builds
// is a LARGE live screenshot with a scroll parallax drift, laid out as an
// editorial grid — lead project full-width, two side-by-side, closer
// full-width. The index row under each image carries the number, name, meta
// and result metric. Links to the full portfolio.
import { projects } from "../../lib/projects/data.mjs";

// Homepage-only presentational copy (result chip + meta line) keyed by slug.
// The canonical slug + name + feature image come from the single project
// source (data.mjs) so they can never drift from the case studies.
const featured = [
  { slug: "webseek",           metric: "1 → live",  meta: "AI product · 2026 · Astro · 3 AI models" },
  { slug: "modernkbs",         metric: "6 → 7",     meta: "School · Web app · 2024 · Next.js + admin" },
  { slug: "dharamshala-tours", metric: "1,000/mo",  meta: "Travel booking · 2025 · self-serve CMS" },
  { slug: "redline",           metric: "1 sprint",  meta: "Brand + e-commerce · 2025 · Razorpay" },
];
const bySlug = Object.fromEntries(projects.map((p) => [p.slug, p]));
// ImageKit render-time transform: right-sized, auto-format.
const ik = (src: string, w: number) => `${src}?tr=w-${w},q-82,f-auto`;
const items = featured.map((f, i) => {
  const p = bySlug[f.slug];
  const wide = i === 0 || i === 3; // editorial rhythm: full · half · half · full
  return {
    n: String(i + 1).padStart(2, "0"),
    href: `/projects/${f.slug}`,
    name: p.name,
    metric: f.metric,
    meta: f.meta,
    img: ik(p.feature.src, wide ? 1600 : 1100),
    alt: p.feature.alt,
    wide,
  };
});
---

<section class="ds-work" id="work" aria-label="Selected work">
  <div class="ds-work-inner">
    {/* Top mono label bar */}
    <div class="ds-work-bar mono" data-reveal>
      <span>(Works — 01)</span>
      <span class="ds-work-bar-mid">A glimpse — 4 of 9 selected builds</span>
      <span>2026 ©</span>
    </div>

    <div class="ds-work-head">
      <h2 class="ds-work-title" data-giant-text>
        <span class="ds-giant-mask"><span class="ds-giant-line">Selected</span></span>
        <span class="ds-giant-mask"><span class="ds-giant-line">work.</span></span>
      </h2>
      <a href="/portfolio/" class="ds-link ds-link-light ds-work-head-link" data-reveal>
        See all 9 projects <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="ds-workv-grid">
      {items.map((p) => (
        <a class:list={["ds-workv", { "ds-workv-wide": p.wide }]} href={p.href} data-reveal>
          <span class="ds-workv-media" data-parallax data-parallax-speed="0.14">
            <span class="ds-workv-zoom">
              <img
                data-parallax-img
                src={p.img}
                alt={p.alt}
                loading="lazy"
                decoding="async"
              />
            </span>
          </span>
          <span class="ds-workv-row">
            <span class="ds-workv-num mono">{p.n}</span>
            <span class="ds-workv-main">
              <span class="ds-workv-name">{p.name}</span>
              <span class="ds-workv-meta mono">{p.meta}</span>
            </span>
            <span class="ds-workv-metric mono">{p.metric}</span>
            <span class="ds-workv-cta mono">
              <span class="ds-workv-cta-text">Case study</span>
              <span class="ds-workv-arrow" aria-hidden="true">↗</span>
            </span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .ds-work {
    position: relative;
    z-index: 2;
    background: #0b0b0c;
    color: #fff;
    padding: clamp(64px, 8vw, 120px) 30px clamp(64px, 8vw, 120px);
  }
  .ds-work-inner { position: relative; z-index: 1; max-width: 1180px; margin: 0 auto; }

  .ds-work-bar {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    margin-bottom: clamp(34px, 4vw, 56px);
  }
  .ds-work-bar-mid { color: rgba(255, 255, 255, 0.8); }

  .ds-work-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: clamp(36px, 4.5vw, 64px);
  }
  .ds-work-title {
    margin: 0;
    font-weight: 900;
    font-size: clamp(46px, 8vw, 124px);
    line-height: 0.86;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: var(--accent, #ff1f1f);
  }
  .ds-work-head-link { margin-bottom: 10px; }

  /* Editorial image grid: lead full-width, two half-width, closer full-width. */
  .ds-workv-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(20px, 2.6vw, 36px);
    row-gap: clamp(44px, 6vw, 88px);
  }
  .ds-workv {
    display: block;
    min-width: 0;
    text-decoration: none;
    color: #fff;
  }
  .ds-workv-wide { grid-column: 1 / -1; }

  /* Media: fixed aspect (no CLS), overflow-hidden crop. Inside it, the zoom
     layer handles the hover scale (CSS) and the img handles the scroll
     parallax (GSAP yPercent) — separate layers so the two transforms never
     fight over one element. The img is overscanned 118% to cover the ±7%
     parallax drift without exposing edges. */
  .ds-workv-media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #161618;
  }
  .ds-workv-wide .ds-workv-media { aspect-ratio: 21 / 10; }
  .ds-workv-zoom {
    position: absolute;
    inset: 0;
    display: block;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ds-workv-media img {
    position: absolute;
    left: 0;
    top: -9%;
    width: 100%;
    height: 118%;
    object-fit: cover;
    object-position: center top;
  }
  @media (hover: hover) {
    .ds-workv:hover .ds-workv-zoom { transform: scale(1.045); }
  }
  .ds-workv:focus-visible { outline: none; }
  .ds-workv:focus-visible .ds-workv-media { outline: 2px solid var(--accent, #ff1f1f); outline-offset: 4px; }

  /* Index row under each image */
  .ds-workv-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: "num main metric" "num main cta";
    align-items: center;
    column-gap: clamp(14px, 2vw, 28px);
    padding-top: 18px;
  }
  .ds-workv-num {
    grid-area: num;
    font-size: 12px;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.4);
    font-variant-numeric: tabular-nums;
  }
  .ds-workv-main { grid-area: main; min-width: 0; }
  .ds-workv-name {
    display: block;
    font-weight: 900;
    font-size: clamp(24px, 3.2vw, 44px);
    letter-spacing: -0.03em;
    line-height: 0.96;
    text-transform: uppercase;
    transition: color 0.25s ease;
  }
  .ds-workv-meta {
    display: block;
    margin-top: 9px;
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }
  .ds-workv:hover .ds-workv-name,
  .ds-workv:focus-visible .ds-workv-name { color: var(--accent, #ff1f1f); }

  .ds-workv-metric {
    grid-area: metric;
    justify-self: end;
    text-align: right;
    font-weight: 700;
    font-size: clamp(14px, 1.4vw, 18px);
    letter-spacing: 0.01em;
    color: var(--accent, #ff1f1f);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ds-workv-cta {
    grid-area: cta;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    transition: color 0.25s ease;
  }
  .ds-workv:hover .ds-workv-cta,
  .ds-workv:focus-visible .ds-workv-cta { color: rgba(255, 255, 255, 0.85); }
  .ds-workv-arrow {
    color: var(--accent, #ff1f1f);
    font-weight: 700;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ds-workv:hover .ds-workv-arrow,
  .ds-workv:focus-visible .ds-workv-arrow { transform: translate(3px, -3px); }

  /* ≤900px: single column, everything full-width. */
  @media (max-width: 900px) {
    .ds-workv-grid { grid-template-columns: 1fr; row-gap: 52px; }
    .ds-workv-wide { grid-column: auto; }
    .ds-workv-media,
    .ds-workv-wide .ds-workv-media { aspect-ratio: 16 / 10; }
  }
  /* ≤560px: row stacks — number+metric up top, name, then meta + CTA. */
  @media (max-width: 560px) {
    .ds-workv-row {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        "num metric"
        "main main"
        "cta cta";
      row-gap: 10px;
    }
    .ds-workv-metric { align-self: center; }
    .ds-workv-cta { justify-self: start; margin-top: 0; }
  }
</style>
