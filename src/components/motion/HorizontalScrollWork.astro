---
// Selected work — a compact "insight" of 4 projects (no horizontal scroll).
// An editorial numbered index list: each project is a full-width row with an
// oversized name on the left and its result metric + case-study cue on the
// right, hairlines between. No screenshots on the home page (images live on
// each case study) and nothing is hover-gated, so it reads the same on mobile.
// Links to the full portfolio.
import { projects } from "../../lib/projects/data.mjs";

// Homepage-only presentational copy (result chip + meta line) keyed by slug.
// The canonical slug + name come from the single project source (data.mjs) so
// they can never drift from the case studies.
const featured = [
  { slug: "webseek",           metric: "1 → live",  meta: "AI product · 2026 · Astro · 3 AI models" },
  { slug: "modernkbs",         metric: "6 → 7",     meta: "School · Web app · 2024 · Next.js + admin" },
  { slug: "dharamshala-tours", metric: "1,000/mo",  meta: "Travel booking · 2025 · self-serve CMS" },
  { slug: "redline",           metric: "1 sprint",  meta: "Brand + e-commerce · 2025 · Razorpay" },
];
const bySlug = Object.fromEntries(projects.map((p) => [p.slug, p]));
const items = featured.map((f, i) => ({
  n: String(i + 1).padStart(2, "0"),
  slug: `/projects/${f.slug}`,
  name: bySlug[f.slug].name,
  metric: f.metric,
  meta: f.meta,
}));
---

<section class="ds-work" id="work" aria-label="Selected work">
  <div class="ds-work-inner">
    {/* Top mono label bar */}
    <div class="ds-work-bar mono" data-reveal>
      <span>(Works — 02)</span>
      <span class="ds-work-bar-mid">A glimpse — 4 of 9 selected builds</span>
      <span>2026 ©</span>
    </div>

    <div class="ds-work-head">
      <h2 class="ds-work-title" data-reveal>Selected<br />work.</h2>
      <a href="/portfolio" class="ds-link ds-link-light ds-work-head-link" data-reveal>
        See all 9 projects <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="ds-work-list" data-reveal>
      {items.map((p) => (
        <a class="ds-work-row" href={p.slug}>
          <span class="ds-work-num mono">{p.n}</span>
          <span class="ds-work-main">
            <span class="ds-work-name">{p.name}</span>
            <span class="ds-work-tags mono">{p.meta}</span>
          </span>
          <span class="ds-work-metric mono">{p.metric}</span>
          <span class="ds-work-cta mono">
            <span class="ds-work-cta-text">Case study</span>
            <span class="ds-work-cta-arrow" aria-hidden="true">↗</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .ds-work {
    position: relative;
    z-index: 2;
    background: #0b0b0c;
    color: #fff;
    padding: clamp(64px, 8vw, 120px) 30px clamp(64px, 8vw, 120px);
  }
  .ds-work-inner { position: relative; z-index: 1; max-width: 1180px; margin: 0 auto; }

  .ds-work-bar {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    margin-bottom: clamp(34px, 4vw, 56px);
  }
  .ds-work-bar-mid { color: rgba(255, 255, 255, 0.8); }

  .ds-work-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: clamp(36px, 4.5vw, 64px);
  }
  .ds-work-title {
    margin: 0;
    font-weight: 900;
    font-size: clamp(46px, 8vw, 124px);
    line-height: 0.86;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: var(--accent, #ff1f1f);
  }
  .ds-work-head-link { margin-bottom: 10px; }

  /* Editorial index list — each project is a full-width row. Big name on the
     left, result metric + case-study cue on the right, hairlines between.
     Reads the same on desktop and mobile (it just stacks). No hover-gated
     content: the metric and CTA are always visible. */
  .ds-work-list { border-top: 1px solid rgba(255, 255, 255, 0.16); }

  .ds-work-row {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: "num main metric" "num main cta";
    align-items: center;
    column-gap: clamp(18px, 3vw, 44px);
    text-decoration: none;
    color: #fff;
    padding: clamp(24px, 3.2vw, 40px) 0;
    padding-left: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    transition: padding-left 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* Accent rail slides in from the left on hover/focus. */
  .ds-work-row::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--accent, #ff1f1f);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (hover: hover) {
    .ds-work-row:hover { padding-left: clamp(14px, 1.6vw, 26px); }
    .ds-work-row:hover::before { transform: scaleY(1); }
  }
  .ds-work-row:focus-visible {
    outline: none;
    padding-left: clamp(14px, 1.6vw, 26px);
  }
  .ds-work-row:focus-visible::before { transform: scaleY(1); }

  .ds-work-num {
    grid-area: num;
    font-size: 12px;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.4);
    font-variant-numeric: tabular-nums;
  }

  .ds-work-main { grid-area: main; min-width: 0; }
  .ds-work-name {
    display: block;
    margin: 0;
    font-weight: 900;
    font-size: clamp(30px, 5vw, 68px);
    letter-spacing: -0.035em;
    line-height: 0.94;
    text-transform: uppercase;
    transition: color 0.25s ease;
  }
  .ds-work-tags {
    display: block;
    margin-top: 12px;
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }
  .ds-work-row:hover .ds-work-name,
  .ds-work-row:focus-visible .ds-work-name { color: var(--accent, #ff1f1f); }

  /* Result metric — the proof, right-aligned as a bold red figure. */
  .ds-work-metric {
    grid-area: metric;
    justify-self: end;
    text-align: right;
    font-weight: 700;
    font-size: clamp(15px, 1.5vw, 20px);
    letter-spacing: 0.01em;
    color: var(--accent, #ff1f1f);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .ds-work-cta {
    grid-area: cta;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    transition: color 0.25s ease;
  }
  .ds-work-row:hover .ds-work-cta,
  .ds-work-row:focus-visible .ds-work-cta { color: rgba(255, 255, 255, 0.85); }
  .ds-work-cta-arrow {
    color: var(--accent, #ff1f1f);
    font-weight: 700;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ds-work-row:hover .ds-work-cta-arrow,
  .ds-work-row:focus-visible .ds-work-cta-arrow { transform: translate(3px, -3px); }

  /* ≤720px: number + metric share the top line, name below, meta + CTA under. */
  @media (max-width: 720px) {
    .ds-work-row {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        "num metric"
        "main main"
        "cta cta";
      row-gap: 12px;
      align-items: center;
    }
    .ds-work-num { align-self: center; }
    .ds-work-metric { justify-self: end; align-self: center; }
    .ds-work-cta { justify-self: start; margin-top: 4px; }
  }
</style>
