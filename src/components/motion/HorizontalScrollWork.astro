---
// Selected work — 3 project cards in a static grid (motion disabled
// site-wide, so the signature horizontal-scroll pin is replaced with a
// straightforward 3-up grid). Each card carries the same Mattis-style
// corner-bracketed "frame" so the section reads as one system with the
// hero.
import Frame from "../home/Frame.astro";

const projects = [
  {
    n: "01",
    slug: "/projects/modernkbs",
    name: "Modern K.B.S.",
    lede: "Every other agency said 6 months. I shipped in 7 days. A CBSE school in Ladwara with an admissions portal that office staff runs without calling a developer.",
    metric: "6 → 7",
    metricLabel: "MONTHS → DAYS",
    stack: "Next.js · Admin panel",
    tag: "School · Web app",
    year: "2024",
    bg: "linear-gradient(135deg, #0f1218 0%, #1a2030 60%, #0f1218 100%)",
    accent: "#7a8fa6",
    thumbMark: "M",
  },
  {
    n: "02",
    slug: "/projects/chinkiz",
    name: "ChinkiZ Knitting Knife",
    lede: "A 600K-subscriber YouTuber tried two e-commerce builders. Both fought the way her audience shops. We built a custom storefront where the video sits next to the buy button.",
    metric: "600K",
    metricLabel: "YOUTUBE SUBSCRIBERS",
    stack: "Next.js · Razorpay · COD",
    tag: "Creator · D2C",
    year: "2024",
    bg: "linear-gradient(135deg, #14101a 0%, #2a1828 60%, #14101a 100%)",
    accent: "#e8a4a4",
    thumbMark: "C",
  },
  {
    n: "03",
    slug: "/projects/webseek",
    name: "WebSeek.ai",
    lede: "Every AI website builder on the market produces the same generic marketing page. We built the opposite: one prompt, custom-coded output, model picker for Claude, GPT and Gemini.",
    metric: "1 → live",
    metricLabel: "PROMPT → SITE",
    stack: "Astro · Three AI models",
    tag: "AI product",
    year: "2026",
    bg: "linear-gradient(135deg, #16110e 0%, #2a1814 60%, #16110e 100%)",
    accent: "#ff4612",
    thumbMark: "W",
  },
];
---

<section class="ds-h-work" id="work" aria-label="Selected work">
  <div class="ds-h-work-pin">
    <Frame label="Works" index="02" note="3 of 9 — every project below is a real client" tone="dark">
      <h2 class="ds-h-work-title">
        The work, in scroll.
      </h2>

      <div class="ds-h-work-track">
        {projects.map((p) => (
          <article class="ds-h-work-card" style={`background:${p.bg};--accent:${p.accent};`}>
            <header class="ds-h-work-head">
              <span class="ds-h-work-num mono">{p.n}</span>
              <span class="ds-h-work-tag mono">{p.tag} · {p.year}</span>
            </header>

            <h3 class="ds-h-work-name">{p.name}</h3>

            <div class="ds-h-work-thumb">
              <div class="ds-h-work-thumb-grid" />
              <div class="ds-h-work-thumb-mark">{p.thumbMark}</div>
              <div class="ds-h-work-thumb-glow" />
            </div>

            <p class="ds-h-work-lede">{p.lede}</p>

            <div class="ds-h-work-metric">
              <span class="ds-h-work-metric-num">{p.metric}</span>
              <span class="ds-h-work-metric-label mono">{p.metricLabel}</span>
            </div>

            <footer class="ds-h-work-foot">
              <span class="ds-h-work-stack mono">{p.stack}</span>
              <a class="ds-h-work-link mono" href={p.slug}>
                View case <span aria-hidden="true">↗</span>
              </a>
            </footer>
          </article>
        ))}
      </div>
    </Frame>
  </div>
</section>

<style>
  .ds-h-work {
    position: relative;
    width: 100%;
    background: #0b0b0c;
    padding: 60px 30px;
  }
  .ds-h-work-pin {
    position: relative;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
  }

  .ds-h-work-title {
    margin: 0 0 28px;
    font-weight: 900;
    font-size: clamp(38px, 5.6vw, 86px);
    line-height: 0.92;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .ds-h-work-track {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .ds-h-work-card {
    display: grid;
    grid-template-rows: auto auto 1fr auto auto auto;
    gap: 16px;
    padding: 26px 26px;
    border-radius: 6px;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
    overflow: hidden;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.7);
    min-height: 540px;
  }

  .ds-h-work-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.6;
  }
  .ds-h-work-num {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  .ds-h-work-name {
    margin: 0;
    font-weight: 900;
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 0.94;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .ds-h-work-thumb {
    position: relative;
    width: 100%;
    height: 140px;
    border-radius: 3px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ds-h-work-thumb-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 36px 36px;
  }
  .ds-h-work-thumb-mark {
    position: relative;
    z-index: 2;
    font-family: "Archivo", sans-serif;
    font-weight: 900;
    font-size: clamp(64px, 9vw, 130px);
    line-height: 1;
    color: var(--accent);
    opacity: 0.9;
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
  }
  .ds-h-work-thumb-glow {
    position: absolute;
    width: 70%;
    height: 200%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 30%, transparent), transparent 70%);
    z-index: 1;
    filter: blur(20px);
  }

  .ds-h-work-lede {
    margin: 0;
    font-size: clamp(13.5px, 1.25vw, 16px);
    line-height: 1.55;
    opacity: 0.82;
    font-weight: 500;
  }

  .ds-h-work-metric {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 14px 0 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .ds-h-work-metric-num {
    font-family: "Archivo", sans-serif;
    font-weight: 900;
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .ds-h-work-metric-label {
    font-size: 10px;
    letter-spacing: 0.18em;
    opacity: 0.65;
  }

  .ds-h-work-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .ds-h-work-stack { opacity: 0.65; }
  .ds-h-work-link {
    color: #fff;
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding-bottom: 3px;
    font-weight: 700;
  }
  .ds-h-work-link:hover { color: var(--accent); }

  @media (max-width: 980px) {
    .ds-h-work-track { grid-template-columns: 1fr; }
    .ds-h-work-card { min-height: auto; }
  }
  @media (max-width: 720px) {
    .ds-h-work { padding: 40px 16px; }
    .ds-h-work-card { padding: 22px 22px; gap: 12px; }
    .ds-h-work-thumb { height: 110px; }
    .ds-h-work-lede { font-size: 13px; }
  }
</style>
