---
// Full-viewport text reveal — used as visual punctuation between sections.
// Each line slides in + fades up as it enters the viewport, driven by
// ScrollTrigger via the .ds-giant-text selector (see MotionController).

export interface Props {
  lines: string[];
  align?: "left" | "center" | "right";
  theme?: "dark" | "light" | "accent";
  emphasis?: "soft" | "bold";
  accentIndex?: number; // which line (0-indexed) gets the orange/accent color
  meta?: string; // small mono caption above
}

const {
  lines,
  align = "center",
  theme = "dark",
  emphasis = "bold",
  accentIndex = -1,
  meta,
} = Astro.props;

const bg =
  theme === "light"
    ? "#ededed"
    : theme === "accent"
    ? "var(--accent, #ff4612)"
    : "#0b0b0c";
const fg =
  theme === "light"
    ? "#0b0b0c"
    : theme === "accent"
    ? "#0b0b0c"
    : "#ffffff";
---

<section
  class={`ds-giant-text ds-giant-${theme} ds-giant-${align} ds-giant-${emphasis}`}
  style={`background:${bg};color:${fg};`}
  data-giant-text
>
  {meta && (
    <div class="ds-giant-meta">
      <span>{meta}</span>
    </div>
  )}
  <h2 class="ds-giant-stack" aria-label={lines.join(" ")}>
    {lines.map((line, i) => (
      <span class="ds-giant-line-wrap">
        <span
          class={`ds-giant-line ${i === accentIndex ? "is-accent" : ""}`}
        >{line}</span>
      </span>
    ))}
  </h2>
</section>

<style>
  .ds-giant-text {
    position: relative;
    width: 100%;
    /* Compact punctuation, not a full viewport moment. */
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 70px 30px;
    overflow: hidden;
  }

  .ds-giant-meta {
    font-family: "Space Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.55;
    margin-bottom: 22px;
  }
  .ds-giant-left .ds-giant-meta { text-align: left; }
  .ds-giant-center .ds-giant-meta {
    text-align: center;
    width: 100%;
  }
  .ds-giant-right .ds-giant-meta { text-align: right; }

  .ds-giant-stack {
    margin: 0;
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    font-size: clamp(32px, 5.5vw, 88px);
  }
  .ds-giant-soft .ds-giant-stack {
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .ds-giant-line-wrap {
    display: block;
    overflow: hidden;
  }
  .ds-giant-line {
    display: inline-block;
    will-change: transform, opacity;
  }

  .ds-giant-left { text-align: left; }
  .ds-giant-center { text-align: center; }
  .ds-giant-center .ds-giant-line-wrap { text-align: center; }
  .ds-giant-right { text-align: right; }
  .ds-giant-right .ds-giant-line-wrap { text-align: right; }

  .ds-giant-line.is-accent {
    color: var(--accent, #ff4612);
    font-family: "Caveat", cursive;
    font-weight: 700;
    text-transform: none;
    letter-spacing: -0.01em;
    font-size: 1.22em;
  }

  @media (max-width: 720px) {
    .ds-giant-text {
      padding: 50px 22px;
    }
    .ds-giant-stack {
      font-size: clamp(28px, 8vw, 52px);
      line-height: 1.08;
    }
    .ds-giant-meta {
      margin-bottom: 16px;
    }
  }
</style>