---
// Closing CTA — full-bleed orange block with the site's one real WebGL moment:
// a near-black "liquid-metal" sphere (OGL) that slowly morphs via 3D simplex
// noise and bends toward the cursor. Degrades gracefully: a static CSS sphere
// renders if WebGL is unavailable, and the animation runs a single frame (then
// stops) under prefers-reduced-motion. The canvas is decorative (aria-hidden).
---

<section id="lets-build" class="ds-closing" aria-label="Let's build">
  <div class="ds-closing-fallback" aria-hidden="true"></div>
  <canvas class="ds-closing-canvas" aria-hidden="true"></canvas>

  <div class="ds-closing-inner">
    <span class="ds-closing-meta mono" data-reveal>— Next step</span>
    <h2 class="ds-closing-title" data-reveal>Let's<br />build.</h2>
    <a href="#contact" class="ds-link ds-closing-cta" data-reveal>
      Get in touch <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<style>
  .ds-closing {
    position: relative;
    z-index: 2;
    background: var(--accent, #ff1f1f);
    color: #fff;
    min-height: clamp(520px, 78vh, 760px);
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 80px 30px;
  }
  .ds-closing-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    display: block;
  }
  /* Static fallback sphere (shown only when WebGL is unavailable). */
  .ds-closing-fallback {
    position: absolute;
    z-index: 1;
    top: 50%;
    right: 12%;
    width: min(46vw, 460px);
    aspect-ratio: 1;
    transform: translateY(-50%);
    border-radius: 50%;
    background:
      radial-gradient(38% 38% at 38% 32%, #4a4a4f 0%, #18181b 38%, #060607 70%, #000 100%);
    box-shadow: inset -22px -26px 60px rgba(0, 0, 0, 0.7), 0 40px 80px -30px rgba(0, 0, 0, 0.6);
    display: none;
  }
  .ds-closing.is-fallback .ds-closing-fallback { display: block; }
  .ds-closing.is-fallback .ds-closing-canvas { display: none; }

  .ds-closing-inner {
    position: relative;
    z-index: 2;
    max-width: 1180px;
    margin: 0 auto;
    width: 100%;
    pointer-events: none;
  }
  .ds-closing-inner > * { pointer-events: auto; }
  .ds-closing-meta {
    display: block;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: 18px;
  }
  .ds-closing-title {
    margin: 0 0 28px;
    font-weight: 900;
    font-size: clamp(72px, 16vw, 230px);
    line-height: 0.82;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    color: #fff;
  }
  .ds-closing-cta { color: #fff; }

  @media (max-width: 760px) {
    .ds-closing { min-height: 90vh; }
    .ds-closing-fallback { right: 50%; top: 32%; transform: translate(50%, -50%); width: 70vw; opacity: 0.55; }
  }
</style>

<script>
  import { Renderer, Camera, Program, Mesh, Sphere, Vec2 } from "ogl";

  const section = document.getElementById("lets-build");
  const canvas = section?.querySelector(".ds-closing-canvas") as HTMLCanvasElement | null;
  if (section && canvas) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const vertex = /* glsl */ `
      precision highp float;
      attribute vec3 position;
      attribute vec3 normal;
      uniform mat4 modelViewMatrix;
      uniform mat4 projectionMatrix;
      uniform mat3 normalMatrix;
      uniform float uTime;
      uniform vec2 uMouse;
      uniform float uHover;
      varying vec3 vNormal;
      varying vec3 vView;
      varying float vDisp;

      vec4 permute(vec4 x){return mod(((x*34.0)+1.0)*x,289.0);}
      vec4 taylorInvSqrt(vec4 r){return 1.79284291400159 - 0.85373472095314 * r;}
      float snoise(vec3 v){
        const vec2 C = vec2(1.0/6.0, 1.0/3.0);
        const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);
        vec3 i  = floor(v + dot(v, C.yyy));
        vec3 x0 = v - i + dot(i, C.xxx);
        vec3 g = step(x0.yzx, x0.xyz);
        vec3 l = 1.0 - g;
        vec3 i1 = min(g.xyz, l.zxy);
        vec3 i2 = max(g.xyz, l.zxy);
        vec3 x1 = x0 - i1 + C.xxx;
        vec3 x2 = x0 - i2 + 2.0*C.xxx;
        vec3 x3 = x0 - 1.0 + 3.0*C.xxx;
        i = mod(i,289.0);
        vec4 p = permute(permute(permute(
                  i.z + vec4(0.0,i1.z,i2.z,1.0))
                + i.y + vec4(0.0,i1.y,i2.y,1.0))
                + i.x + vec4(0.0,i1.x,i2.x,1.0));
        float n_ = 1.0/7.0;
        vec3 ns = n_ * D.wyz - D.xzx;
        vec4 j = p - 49.0 * floor(p * ns.z * ns.z);
        vec4 x_ = floor(j * ns.z);
        vec4 y_ = floor(j - 7.0 * x_);
        vec4 x = x_ * ns.x + ns.yyyy;
        vec4 y = y_ * ns.x + ns.yyyy;
        vec4 h = 1.0 - abs(x) - abs(y);
        vec4 b0 = vec4(x.xy, y.xy);
        vec4 b1 = vec4(x.zw, y.zw);
        vec4 s0 = floor(b0)*2.0 + 1.0;
        vec4 s1 = floor(b1)*2.0 + 1.0;
        vec4 sh = -step(h, vec4(0.0));
        vec4 a0 = b0.xzyw + s0.xzyw*sh.xxyy;
        vec4 a1 = b1.xzyw + s1.xzyw*sh.zzww;
        vec3 p0 = vec3(a0.xy, h.x);
        vec3 p1 = vec3(a0.zw, h.y);
        vec3 p2 = vec3(a1.xy, h.z);
        vec3 p3 = vec3(a1.zw, h.w);
        vec4 norm = taylorInvSqrt(vec4(dot(p0,p0),dot(p1,p1),dot(p2,p2),dot(p3,p3)));
        p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;
        vec4 m = max(0.6 - vec4(dot(x0,x0),dot(x1,x1),dot(x2,x2),dot(x3,x3)), 0.0);
        m = m*m;
        return 42.0 * dot(m*m, vec4(dot(p0,x0),dot(p1,x1),dot(p2,x2),dot(p3,x3)));
      }

      vec3 displace(vec3 p){
        float t = uTime * 0.26;
        float n = snoise(p*1.05 + vec3(0.0,0.0,t));
        n += 0.45 * snoise(p*2.4 + vec3(t*0.7, 0.0, 0.0));
        vec3 mdir = normalize(vec3(uMouse * 1.6, 1.0));
        float bulge = smoothstep(0.35, 1.0, dot(normalize(p), mdir)) * uHover;
        return p + normal * (n * 0.17 + bulge * 0.24);
      }

      void main(){
        vec3 dp = displace(position);
        vec3 tangent = normalize(cross(normal, vec3(0.0,1.0,0.0)) + vec3(0.0001));
        vec3 bitangent = normalize(cross(normal, tangent));
        vec3 p1 = displace(position + tangent * 0.012);
        vec3 p2 = displace(position + bitangent * 0.012);
        vec3 newNormal = normalize(cross(p1 - dp, p2 - dp));
        if (dot(newNormal, normal) < 0.0) newNormal = -newNormal;
        vDisp = snoise(position*1.05 + vec3(0.0,0.0,uTime*0.26));
        vNormal = normalize(normalMatrix * newNormal);
        vec4 mv = modelViewMatrix * vec4(dp, 1.0);
        vView = -mv.xyz;
        gl_Position = projectionMatrix * mv;
      }
    `;

    const fragment = /* glsl */ `
      precision highp float;
      varying vec3 vNormal;
      varying vec3 vView;
      varying float vDisp;
      void main(){
        vec3 N = normalize(vNormal);
        vec3 V = normalize(vView);
        vec3 L = normalize(vec3(0.55, 0.85, 0.65));
        float fres = pow(1.0 - max(dot(N, V), 0.0), 2.6);
        float spec = pow(max(dot(reflect(-L, N), V), 0.0), 26.0);
        vec3 base = vec3(0.018);
        vec3 col = base + fres * vec3(0.26, 0.26, 0.30) + spec * vec3(1.0);
        col *= 0.85 + 0.15 * smoothstep(-1.0, 1.0, vDisp);
        gl_FragColor = vec4(col, 1.0);
      }
    `;

    try {
      const sec = section; // narrowed, non-null (used inside closures)
      const renderer = new Renderer({ canvas, alpha: true, antialias: true, dpr: Math.min(window.devicePixelRatio || 1, 1.6) });
      const gl = renderer.gl;
      gl.clearColor(0, 0, 0, 0);

      const camera = new Camera(gl, { fov: 32 });
      camera.position.set(0, 0, 6);

      const geometry = new Sphere(gl, { radius: 1.35, widthSegments: 128, heightSegments: 96 });
      const program = new Program(gl, {
        vertex,
        fragment,
        uniforms: {
          uTime: { value: 0 },
          uMouse: { value: new Vec2(0, 0) },
          uHover: { value: 0 },
        },
      });
      const mesh = new Mesh(gl, { geometry, program });
      mesh.setParent(null);

      function resize() {
        const r = sec.getBoundingClientRect();
        renderer.setSize(r.width, r.height);
        camera.perspective({ aspect: r.width / r.height });
        // Sit the blob to the right on wide screens, centred on narrow.
        mesh.position.x = r.width > 760 ? 1.55 : 0;
        mesh.position.y = r.width > 760 ? 0 : 0.2;
      }
      window.addEventListener("resize", resize);
      resize();

      // Pointer tracking (smoothed).
      const target = new Vec2(0, 0);
      let hoverTarget = 0;
      sec.addEventListener("pointermove", (e) => {
        const r = sec.getBoundingClientRect();
        target.set(((e.clientX - r.left) / r.width) * 2 - 1, -(((e.clientY - r.top) / r.height) * 2 - 1));
        hoverTarget = 1;
      });
      sec.addEventListener("pointerleave", () => { hoverTarget = 0; });

      let raf = 0;
      let running = false;
      const start = performance.now();

      function frame(now: number) {
        program.uniforms.uTime.value = (now - start) / 1000;
        const m = program.uniforms.uMouse.value as Vec2;
        m.x += (target.x - m.x) * 0.06;
        m.y += (target.y - m.y) * 0.06;
        program.uniforms.uHover.value += (hoverTarget - program.uniforms.uHover.value) * 0.05;
        mesh.rotation.y += 0.0016;
        mesh.rotation.x = 0.12;
        renderer.render({ scene: mesh, camera });
        if (running) raf = requestAnimationFrame(frame);
      }

      function play() { if (!running && !reduce) { running = true; raf = requestAnimationFrame(frame); } }
      function pause() { running = false; cancelAnimationFrame(raf); }

      // Render one frame immediately (covers reduced-motion + first paint).
      frame(performance.now());

      if (!reduce) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => (e.isIntersecting ? play() : pause()));
        }, { threshold: 0.05 });
        io.observe(sec);
        document.addEventListener("visibilitychange", () => (document.hidden ? pause() : play()));
      }
    } catch (err) {
      // No WebGL (or context lost) → show the CSS fallback sphere.
      section.classList.add("is-fallback");
    }
  }
</script>
