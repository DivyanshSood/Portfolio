---
// Pricing — Mattis p18–19 language: a quote + giant "PRICING." over a single
// hairline comparison table (no separate price cards). Three columns
// (Foundation / Growth* / Scale), Growth subtly tinted as the featured tier.
// Plain ✓ / — / text cells so a cold-traffic buyer scans tiers in seconds.
// USD-only, Himalayas-positioned. Copy/data unchanged.
const plans = [
  { name: "Foundation", price: "$3,000", blurb: "Everything you need to launch a serious site.", featured: false },
  { name: "Growth", price: "$6,000", blurb: "The plan most international founders pick.", featured: true },
  { name: "Scale", price: "$12,000", blurb: "Web apps, stores, dashboards.", featured: false },
];

const compareRows = [
  { label: "Pages", cells: ["Up to 6", "Up to 12", "Unlimited"] },
  { label: "Custom-coded (no builders)", cells: [true, true, true] },
  { label: "Strategy & behavioural audit", cells: [true, true, true] },
  { label: "Conversion wireframes", cells: [true, true, true] },
  { label: "A/B testing setup", cells: [false, true, true] },
  { label: "Advanced copywriting", cells: [false, true, true] },
  { label: "Admin panel / dashboard", cells: ["Add-on", "Add-on", "Included"] },
  { label: "E-commerce / payments integration", cells: ["Add-on", "Add-on", "Included"] },
  { label: "Monthly reporting", cells: [false, false, true] },
  { label: "Ongoing retainer", cells: [false, false, true] },
  { label: "Post-launch support", cells: ["30 days", "90 days", "Monthly"] },
  { label: "Timeline to live", cells: ["3–4 wks", "4–6 wks", "6–10 wks"] },
];
---

<section id="pricing" class="ds-pricing" aria-label="Pricing">
  <div class="ds-pricing-inner">
    <div class="ds-pricing-bar mono" data-reveal>
      <span>(Pricing — 05)</span>
      <span class="ds-pricing-bar-mid">Plans</span>
      <span>USD · every project scoped to you</span>
    </div>

    <div class="ds-pricing-head">
      <div class="ds-pricing-quote" data-reveal>
        <p class="ds-pricing-quote-text">"The hardest part of building a website isn't the code — it's knowing what to leave out. Every element here earns its place."</p>
        <span class="ds-pricing-quote-attr mono">— Divyansh, from the studio</span>
      </div>
      <h2 class="ds-pricing-title" data-giant-text>
        <span class="ds-giant-mask"><span class="ds-giant-line">Pricing.</span></span>
      </h2>
    </div>

    <div class="ds-price-scroll" role="region" aria-label="Plan comparison" tabindex="0" data-reveal>
      <table class="ds-price-table">
        <thead>
          <tr>
            <th scope="col"><span class="ds-price-sr">Feature</span></th>
            {plans.map((pl) => (
              <th scope="col" class={pl.featured ? "is-featured" : ""}>
                <span class="ds-price-th-name">{pl.name}{pl.featured ? " ★" : ""}</span>
                <span class="ds-price-th-from">from {pl.price}</span>
                <span class="ds-price-th-blurb">{pl.blurb}</span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {compareRows.map((row) => (
            <tr>
              <th scope="row" class="ds-price-row-label">{row.label}</th>
              {row.cells.map((cell, i) => (
                <td class={plans[i].featured ? "is-featured" : ""}>
                  {cell === true ? (
                    <span class="ds-price-yes" aria-label="Included">✓</span>
                  ) : cell === false ? (
                    <span class="ds-price-no" aria-label="Not included">—</span>
                  ) : (
                    <span class="ds-price-note">{cell}</span>
                  )}
                </td>
              ))}
            </tr>
          ))}
          <tr class="ds-price-cta-row">
            <td></td>
            {plans.map((pl) => (
              <td class={pl.featured ? "is-featured" : ""}>
                <a href="#contact" class={`ds-price-cta ${pl.featured ? "is-featured" : ""}`}>Get started <span aria-hidden="true">↗</span></a>
              </td>
            ))}
          </tr>
        </tbody>
      </table>
    </div>

    {/* Phone layout (≤720px): the same plans/rows rendered as stacked cards.
        The 760px-wide comparison table hid every price and ✓ off-screen on
        phones; cards keep all three tiers fully visible with zero copy drift
        (same data source as the table above). */}
    <div class="ds-price-cards" data-reveal>
      {plans.map((pl, i) => (
        <article class={`ds-price-card ${pl.featured ? "is-featured" : ""}`}>
          <header class="ds-price-card-head">
            <span class="ds-price-th-name">{pl.name}{pl.featured ? " ★" : ""}</span>
            <span class="ds-price-th-from">from {pl.price}</span>
            <span class="ds-price-th-blurb">{pl.blurb}</span>
          </header>
          <ul class="ds-price-card-rows">
            {compareRows.map((row) => (
              <li>
                <span class="ds-price-card-label">{row.label}</span>
                {row.cells[i] === true ? (
                  <span class="ds-price-yes" aria-label="Included">✓</span>
                ) : row.cells[i] === false ? (
                  <span class="ds-price-no" aria-label="Not included">—</span>
                ) : (
                  <span class="ds-price-note">{row.cells[i]}</span>
                )}
              </li>
            ))}
          </ul>
          <a href="#contact" class={`ds-price-cta ${pl.featured ? "is-featured" : ""}`}>Get started <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>

    <p class="ds-pricing-note" data-reveal>
      <span class="ds-pricing-note-strong">Projects start at $3,000.</span> Prices are starting points in USD — every project is quoted to its real scope on a short call. Independent studio, low overhead — honest pricing, no agency markup. <a href="/website-audit/">Want a free audit of your current site first? ↗</a><br /><br />Indian SMB? The same scope in ₹ is roughly ₹55K–₹3L+ — see the <a href="/blog/website-development-cost-india-2026/">2026 India cost guide ↗</a> for what each plan includes locally.
    </p>
  </div>
</section>

<style>
  .ds-pricing {
    position: relative;
    z-index: 2;
    background: #0b0b0c;
    color: #fff;
    padding: clamp(64px, 8vw, 120px) 30px clamp(72px, 9vw, 130px);
  }
  .ds-pricing-inner { position: relative; z-index: 1; max-width: 1180px; margin: 0 auto; }

  .ds-pricing-bar {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    margin-bottom: clamp(36px, 5vw, 64px);
  }
  .ds-pricing-bar-mid { color: rgba(255, 255, 255, 0.8); }

  .ds-pricing-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 4vw, 56px);
    align-items: end;
    margin-bottom: clamp(40px, 5vw, 64px);
  }
  .ds-pricing-quote-text {
    margin: 0;
    font-weight: 600;
    font-size: clamp(18px, 2vw, 27px);
    line-height: 1.32;
    letter-spacing: -0.01em;
    max-width: 30ch;
  }
  .ds-pricing-quote-attr {
    display: block;
    margin-top: 16px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .ds-pricing-title {
    margin: 0;
    text-align: right;
    font-weight: 900;
    font-size: clamp(56px, 10vw, 168px);
    line-height: 0.82;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }

  /* ---------------- Comparison table ---------------- */
  .ds-price-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }
  /* On desktop the table fits, so drop the scroll clip — this lets the plan
     header pin to the page (position: sticky) as the buyer scrolls the rows.
     Narrow screens keep horizontal scroll via the base rule above. */
  @media (min-width: 821px) {
    .ds-price-scroll { overflow: visible; }
  }
  .ds-price-sr {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }
  /* Separate borders (not collapse) so the sticky header keeps its rules and
     the featured column's vertical lines render cleanly. */
  .ds-price-table {
    width: 100%;
    min-width: 760px;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 14.5px;
  }

  /* ----- Sticky plan header: name · price · blurb ----- */
  .ds-price-table thead th {
    position: sticky;
    top: 64px;                  /* clears the fixed top nav strip */
    z-index: 3;
    text-align: left;
    padding: 24px 22px 22px;
    vertical-align: top;
    background: #0b0b0c;        /* opaque so scrolled rows don't bleed through */
    /* box-shadow, not border-bottom, survives position: sticky reliably */
    box-shadow: inset 0 -1px 0 rgba(255, 255, 255, 0.22);
  }
  .ds-price-th-name {
    display: block;
    font-family: "Space Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: 12px;
  }
  .ds-price-th-from {
    display: block;
    font-weight: 900;
    font-size: clamp(24px, 2.5vw, 34px);
    letter-spacing: -0.025em;
    line-height: 1;
  }
  .ds-price-th-blurb {
    display: block;
    margin-top: 10px;
    font-family: "Space Mono", monospace;
    font-size: 10.5px;
    line-height: 1.5;
    opacity: 0.5;
    max-width: 22ch;
    text-transform: none;
    letter-spacing: 0;
  }

  /* ----- Body rows ----- */
  .ds-price-table tbody th,
  .ds-price-table tbody td {
    padding: 15px 22px;
    vertical-align: middle;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .ds-price-row-label {
    text-align: left;
    font-weight: 600;
    font-size: 14px;
    opacity: 0.86;
    width: 38%;
  }
  .ds-price-table tbody td {
    text-align: center;
    font-size: 14px;
    opacity: 0.92;
    font-variant-numeric: tabular-nums;
  }
  /* Full-row hover lift for scannability (the CTA row is excluded). */
  .ds-price-table tbody tr:not(.ds-price-cta-row):hover th,
  .ds-price-table tbody tr:not(.ds-price-cta-row):hover td {
    background-color: rgba(255, 255, 255, 0.04);
  }

  /* ----- Featured (Growth) column: a highlighted lane through the table ----- */
  .ds-price-table thead th.is-featured,
  .ds-price-table tbody td.is-featured {
    background: rgba(255, 31, 31, 0.08);
    border-left: 1px solid rgba(255, 31, 31, 0.3);
    border-right: 1px solid rgba(255, 31, 31, 0.3);
  }
  .ds-price-table thead th.is-featured {
    background: #21100d;        /* opaque tint so the sticky header never bleeds */
    border-top: 2px solid var(--accent, #ff1f1f);
    box-shadow: inset 0 -1px 0 rgba(255, 31, 31, 0.35);
  }
  .ds-price-table thead th.is-featured .ds-price-th-name { color: var(--accent, #ff1f1f); opacity: 1; }
  .ds-price-table tbody tr:not(.ds-price-cta-row):hover td.is-featured {
    background-color: rgba(255, 31, 31, 0.13);
  }

  .ds-price-yes {
    display: inline-block;
    width: 24px; height: 24px; line-height: 24px;
    border-radius: 50%;
    background: rgba(255, 31, 31, 0.16);
    color: var(--accent, #ff1f1f);
    font-weight: 800; font-size: 13px;
  }
  .ds-price-no { opacity: 0.32; font-size: 18px; line-height: 1; }
  .ds-price-note {
    font-family: "Space Mono", monospace;
    font-size: 11.5px;
    letter-spacing: 0.04em;
    opacity: 0.82;
  }

  /* ----- CTA row: closes the featured lane at the bottom ----- */
  .ds-price-cta-row td { padding-top: 26px; padding-bottom: 8px; border-bottom: 0; }
  .ds-price-cta-row td.is-featured { border-bottom: 1px solid rgba(255, 31, 31, 0.3); }
  .ds-price-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: "Space Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    text-decoration: none;
    padding: 12px 18px;
    border-radius: 2px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #fff;
    transition: border-color 0.25s ease, background 0.25s ease, color 0.25s ease;
  }
  .ds-price-cta:hover { border-color: rgba(255, 255, 255, 0.7); }
  .ds-price-cta span { transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
  .ds-price-cta:hover span { transform: translate(3px, -3px); }
  .ds-price-cta.is-featured { background: var(--accent, #ff1f1f); color: #0b0b0c; border-color: var(--accent, #ff1f1f); }
  .ds-price-cta.is-featured:hover { background: #ff5a5a; border-color: #ff5a5a; }

  .ds-pricing-note {
    margin: clamp(30px, 4vw, 44px) 2px 0;
    font-family: "Space Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.04em;
    line-height: 1.7;
    opacity: 0.5;
    max-width: 720px;
  }
  .ds-pricing-note-strong { color: #fff; opacity: 0.92; }
  .ds-pricing-note a { color: var(--accent, #ff1f1f); text-decoration: underline; }

  @media (max-width: 760px) {
    .ds-pricing-head { grid-template-columns: 1fr; align-items: start; gap: 18px; }
    .ds-pricing-title { text-align: left; }
  }

  /* ----- Phone plan cards (replace the table ≤720px) ----- */
  .ds-price-cards { display: none; }
  @media (max-width: 720px) {
    .ds-price-scroll { display: none; }
    .ds-price-cards {
      display: grid;
      gap: 18px;
      border-top: 1px solid rgba(255, 255, 255, 0.2);
      padding-top: 22px;
    }
    .ds-price-card {
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 10px;
      padding: 22px 20px 20px;
      background: rgba(255, 255, 255, 0.02);
    }
    .ds-price-card.is-featured {
      border-color: rgba(255, 31, 31, 0.45);
      background: rgba(255, 31, 31, 0.06);
      border-top: 2px solid var(--accent, #ff1f1f);
    }
    .ds-price-card.is-featured .ds-price-th-name { color: var(--accent, #ff1f1f); opacity: 1; }
    .ds-price-card-head {
      padding-bottom: 14px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }
    .ds-price-card-rows {
      list-style: none;
      margin: 0 0 18px;
      padding: 0;
    }
    .ds-price-card-rows li {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 14px;
      padding: 11px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      font-size: 14px;
    }
    .ds-price-card-label { font-weight: 600; opacity: 0.86; }
    .ds-price-card .ds-price-cta { width: 100%; justify-content: center; }
  }
</style>
