---
// About — rebuilt as a full-bleed ORANGE editorial block in the Mattis
// "Strategy before pixels" language (p2–3): mono micro-labels across the top, a
// giant right-aligned heading, body copy left, a borderless B&W portrait with
// parallax, and the three reasons as a hairline-divided list. No frames, no
// container cards. Copy is unchanged. `home-section` keeps the mobile padding.
import { CALENDLY_URL } from "../../lib/site.mjs";

const reasons = [
  {
    n: "01",
    t: "Weeks, not quarters",
    d: "Agencies scope in months. I scope tight and ship in weeks — so your site starts earning sooner, not 'next quarter'.",
  },
  {
    n: "02",
    t: "You own every line",
    d: "The right tool for the job, not a builder's template. No monthly tax, no lock-in — you keep the code.",
  },
  {
    n: "03",
    t: "I run my own product",
    d: "I don't only build for clients — I run my own live product, with real users. So I make the same calls on your site I'd make on mine.",
  },
];
---

<section id="about" class="home-section ds-about">
  <div class="ds-about-inner">
    {/* Top mono micro-labels */}
    <div class="ds-about-labels mono" data-reveal>
      <span>(About — 01)</span>
      <span class="ds-about-labels-mid">How I work differently</span>
      <span>2026 ©</span>
    </div>

    {/* Heading right, body left */}
    <div class="ds-about-top">
      <div class="ds-about-body">
        <p class="ds-about-lead" data-reveal>
          I'm Divyansh — a 1-person studio in Himachal Pradesh. No agency floor,
          no account managers. Just me, building sites for founders who'd rather
          hire a person than a shop.
        </p>
        <p class="ds-about-world mono" data-reveal aria-label="Worldwide collaboration">
          ↗ Async across US · UK · Gulf · Australia
          <span class="ds-about-world-dim">— IST 10am–7pm · US mornings, UK afternoons, Gulf evenings</span>
        </p>
        <div class="ds-about-links" data-reveal>
          <a href={CALENDLY_URL} target="_blank" rel="noopener" class="ds-link">
            Book a 15-min intro <span aria-hidden="true">↗</span>
          </a>
          <a href="/#work" class="ds-link ds-link-soft">
            See the work <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <h2 class="ds-about-h2" data-reveal>
        Three things<br />I do that<br /><span class="ds-about-h2-em">agencies won't.</span>
      </h2>
    </div>

    {/* Reasons — full-width hairline list */}
    <ol class="ds-about-reasons">
        {reasons.map((r) => (
          <li class="ds-about-reason" data-reveal>
            <div class="ds-about-reason-head">
              <span class="ds-about-reason-n mono">{r.n}</span>
              <h3 class="ds-about-reason-t">{r.t}</h3>
            </div>
            <p class="ds-about-reason-d">{r.d}</p>
          </li>
        ))}
      </ol>
  </div>
</section>

<style>
  .ds-about {
    position: relative;
    z-index: 2;
    background: var(--accent, #ff1f1f);
    color: #0b0b0c;
    padding: clamp(64px, 9vw, 132px) 30px clamp(60px, 8vw, 120px);
    overflow: hidden;
    --snum-ink: rgba(11, 11, 12, 0.16);
  }
  .ds-about-inner { position: relative; z-index: 1; max-width: 1180px; margin: 0 auto; }

  /* Top mono labels */
  .ds-about-labels {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #0b0b0c;
    opacity: 0.7;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(11, 11, 12, 0.28);
    margin-bottom: clamp(36px, 5vw, 64px);
  }
  .ds-about-labels-mid { opacity: 0.9; }

  /* Centred intro — heading on top, body beneath, all centre-aligned. */
  .ds-about-top {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(26px, 4vw, 52px);
    margin-bottom: clamp(48px, 7vw, 100px);
  }
  .ds-about-h2 {
    order: -1;
    margin: 0;
    text-align: center;
    font-weight: 900;
    font-size: clamp(42px, 7vw, 116px);
    line-height: 0.88;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: #0b0b0c;
  }
  /* Emphasis stays in the 2-colour palette: black text knocked out as an
     outline so it reads as a separate beat without a third hue. */
  .ds-about-h2-em {
    -webkit-text-stroke: 2px #0b0b0c;
    color: transparent;
  }

  .ds-about-body { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px; padding-top: 8px; }
  .ds-about-lead {
    margin: 0 auto;
    font-size: clamp(19px, 2vw, 26px);
    line-height: 1.4;
    font-weight: 600;
    letter-spacing: -0.01em;
    max-width: 34ch;
  }
  .ds-about-world {
    margin: 6px auto 0;
    padding-top: 14px;
    border-top: 1px solid rgba(11, 11, 12, 0.28);
    font-size: 11px;
    letter-spacing: 0.04em;
    line-height: 1.6;
    max-width: 52ch;
  }
  .ds-about-world-dim { opacity: 0.62; }

  .ds-about-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 26px; margin-top: 8px; }

  /* Reasons — full-width hairline list, each row two columns */
  .ds-about-reasons {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(11, 11, 12, 0.28);
  }
  .ds-about-reason {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(14px, 4vw, 56px);
    align-items: baseline;
    padding: clamp(22px, 2.6vw, 34px) 0;
    border-bottom: 1px solid rgba(11, 11, 12, 0.28);
  }
  .ds-about-reason-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }
  .ds-about-reason-n { font-size: 12px; letter-spacing: 0.12em; opacity: 0.6; }
  .ds-about-reason-t {
    margin: 0;
    font-weight: 800;
    font-size: clamp(22px, 2.6vw, 34px);
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: #fff;
  }
  .ds-about-reason-d {
    margin: 0;
    font-size: clamp(14px, 1.1vw, 16px);
    line-height: 1.55;
    max-width: 52ch;
    opacity: 0.82;
  }
  @media (max-width: 900px) {
    .ds-about-top { gap: 30px; }
    .ds-about-reason { grid-template-columns: 1fr; gap: 10px; }
  }
  @media (max-width: 560px) {
    .ds-about-h2-em { -webkit-text-stroke-width: 1.4px; }
  }
</style>
