---
// About — short founder intro on the full-bleed accent block ("show, don't
// tell" pass, July 2026: the work section above carries the proof, so this
// shrank to one giant statement + a three-line lead + booking link — the
// numbered reasons list was cut). The headline is promoted from the lead's
// own closing line ("One person, end to end — no agency layers"), so no new
// claims were invented. `home-section` keeps the mobile padding.
// Ink: mixed white/black on the red — see the contrast note by .ds-about-h2.
import { CALENDLY_URL } from "../../lib/site.mjs";
---

<section id="about" class="home-section ds-about">
  <div class="ds-about-inner">
    {/* Top mono micro-labels */}
    <div class="ds-about-labels mono" data-reveal>
      <span>(About — 02)</span>
      <span class="ds-about-labels-mid">Why founders hire me</span>
      <span>2026 ©</span>
    </div>

    {/* One giant statement + short lead */}
    <div class="ds-about-top">
      <div class="ds-about-body">
        <p class="ds-about-lead" data-reveal>
          I'm Divyansh Sood — an independent web designer &amp; developer in
          Himachal Pradesh, India. I build custom-coded, conversion-focused
          websites, stores and web apps for founders worldwide. No agency
          layers.
        </p>
        <p class="ds-about-world mono" data-reveal aria-label="Worldwide collaboration">
          ↗ Async across US · UK · Gulf · Australia
          <span class="ds-about-world-dim">— IST 10am–7pm · US mornings, UK afternoons, Gulf evenings</span>
        </p>
        <div class="ds-about-links" data-reveal>
          <a href={CALENDLY_URL} target="_blank" rel="noopener" class="ds-link">
            Book a 15-min intro <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <h2 class="ds-about-h2" data-giant-text>
        <span class="ds-giant-mask"><span class="ds-giant-line">One person.</span></span>
        <span class="ds-giant-mask"><span class="ds-giant-line"><span class="ds-about-h2-em">End to end.</span></span></span>
      </h2>
    </div>
  </div>
</section>

<style>
  .ds-about {
    position: relative;
    z-index: 2;
    background: var(--accent, #ff1f1f);
    color: #0b0b0c;
    padding: clamp(64px, 9vw, 132px) 30px clamp(60px, 8vw, 120px);
    overflow: hidden;
    --snum-ink: rgba(11, 11, 12, 0.16);
  }
  .ds-about-inner { position: relative; z-index: 1; max-width: 1180px; margin: 0 auto; }

  /* Top mono labels */
  .ds-about-labels {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #0b0b0c;
    opacity: 0.7;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(11, 11, 12, 0.28);
    margin-bottom: clamp(36px, 5vw, 64px);
  }
  .ds-about-labels-mid { opacity: 0.9; }

  /* Centred intro — heading on top, body beneath, all centre-aligned. */
  .ds-about-top {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(26px, 4vw, 52px);
  }
  /* Mixed ink on the red (July 2026): the display type runs white so the
     section reads as the white-on-black site "heated up" rather than a
     palette break, while every small line stays near-black — white on this
     red is only ~3.8:1, fine for large bold type but a WCAG/axe contrast
     failure at caption sizes (needs 4.5:1). Black on it is ~5.5:1. */
  .ds-about-h2 {
    order: -1;
    margin: 0;
    text-align: center;
    font-weight: 900;
    font-size: clamp(42px, 7vw, 116px);
    line-height: 0.88;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: #fff;
  }
  /* Emphasis stays in the 2-ink system: white text knocked out as an outline
     so it reads as a separate beat without a third hue. */
  .ds-about-h2-em {
    -webkit-text-stroke: 2px #fff;
    color: transparent;
  }

  .ds-about-body { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px; padding-top: 8px; }
  /* White lead: weight 700 + ≥19px keeps it in WCAG's "large text" class
     (≥18.66px bold), where white-on-this-red's 3.8:1 passes AA. Don't drop
     either value below that line. */
  .ds-about-lead {
    margin: 0 auto;
    font-size: clamp(19px, 2vw, 26px);
    line-height: 1.4;
    font-weight: 700;
    letter-spacing: -0.01em;
    max-width: 34ch;
    color: #fff;
  }
  .ds-about-world {
    margin: 6px auto 0;
    padding-top: 14px;
    border-top: 1px solid rgba(11, 11, 12, 0.28);
    font-size: 11px;
    letter-spacing: 0.04em;
    line-height: 1.6;
    max-width: 52ch;
  }
  .ds-about-world-dim { opacity: 0.62; }

  .ds-about-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 26px; margin-top: 8px; }

  @media (max-width: 900px) {
    .ds-about-top { gap: 30px; }
  }
  @media (max-width: 560px) {
    .ds-about-h2-em { -webkit-text-stroke-width: 1.4px; }
  }
</style>
