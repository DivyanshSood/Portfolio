---
// Testimonials — 3 strongest quotes, each prefixed with a 2-3 line "context"
// so the buyer reads the *transformation*, not just the line. The logo wall
// below the cards ships as designed text wordmarks; drop a real logo `src`
// into lib/site.mjs → CLIENT_LOGOS and it slots into the same tile without
// any layout shift.
import Frame from "./Frame.astro";
import { CLIENT_LOGOS, HAS_CLIENT_LOGOS, GOOGLE_REVIEWS_URL } from "../../lib/site.mjs";
const symbols = ["✦", "◆", "●", "▲", "✺", "◇", "■"];

const items = [
  {
    q: "The website is so beautiful — looks 10 times more premium than our competitors. We started getting direct bookings instead of losing them to Google Maps.",
    c: "Kangra's most-reviewed taxi operator. Every booking used to leak to Google Maps. After we rebuilt the site, direct bookings started flowing through the funnel they own.",
    who: "Founder",
    org: "Nandini Travels · Kangra",
    initials: "NT",
    big: true,
  },
  {
    q: "I did not think it could be achieved without going to e-commerce builders and only using custom code.",
    c: "Chinki tried Shopify and Webflow before coming to us — both fought the way her audience shops. We built a custom storefront that puts the video next to the buy button.",
    who: "Chinki, Founder",
    org: "ChinkiZ Knitting Knife · 600K+ subs",
    initials: "CZ",
  },
  {
    q: "Exactly what we wanted. I will refer Divyansh within my circle for life.",
    c: "North Peak Power needed a portal that finally lets the team lead with a private-sector pitch. We shipped 15 pages and a self-serve admin the marketing team uses without calling me.",
    who: "Founder",
    org: "North Peak Power · Infra",
    initials: "NP",
  },
];
---

<section id="reviews" class="home-section" style="position:relative;z-index:2;background:#e8e8e8;color:#0b0b0c;padding:90px 30px;">
  <Frame label="Clients" index="03" note="What changed after we shipped" tone="light">
  <h2 data-reveal style="margin:0 0 18px;font-weight:900;font-size:clamp(46px,8vw,128px);line-height:.86;letter-spacing:-.04em;text-transform:uppercase;">What changed<br />after we shipped.</h2>
  <a data-reveal href={GOOGLE_REVIEWS_URL} target="_blank" rel="noopener" data-cursor style="display:inline-flex;align-items:center;gap:8px;margin-bottom:50px;font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#0b0b0c;text-decoration:none;border-bottom:1px solid #0b0b0c;padding-bottom:3px;">Read our reviews on Google <span aria-hidden="true">↗</span></a>

  <div class="g-3" style="display:grid;grid-template-columns:1fr 1fr;gap:22px;align-items:start;">
    {items.map((it) => (
      <figure style={`margin:0;border:1px solid rgba(0,0,0,.14);border-radius:10px;padding:28px 26px;background:rgba(255,255,255,.5);${it.big ? "grid-column:span 2;" : ""}`}>
        <div style="font-family:'Caveat',cursive;font-weight:700;font-size:48px;color:var(--accent,#ff4612);line-height:.5;height:24px;margin-bottom:6px;">"</div>
        <blockquote style="margin:0 0 18px;font-weight:600;font-size:clamp(20px,2.2vw,28px);line-height:1.32;letter-spacing:-.01em;">{it.q}</blockquote>
        <p style="margin:0 0 20px;font-size:14.5px;line-height:1.6;opacity:.78;border-top:1px solid rgba(0,0,0,.1);padding-top:16px;">{it.c}</p>
        <figcaption style="display:flex;align-items:center;gap:12px;">
          <span style={`width:42px;height:42px;border-radius:50%;background:linear-gradient(135deg,#ff4612,#7a1e00);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px;color:#fff;flex:0 0 auto;`}>{it.initials}</span>
          <span>
            <span style="display:block;font-weight:700;font-size:14px;">{it.who}</span>
            <span style="font-family:'Space Mono',monospace;font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;opacity:.6;">{it.org}</span>
          </span>
        </figcaption>
      </figure>
    ))}
  </div>

  <div style="margin-top:50px;display:flex;flex-wrap:wrap;gap:18px;align-items:center;">
    <a href="/testimonials" data-cursor style="font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#0b0b0c;text-decoration:none;border-bottom:1px solid #0b0b0c;padding-bottom:3px;">See all 6 testimonials <span aria-hidden="true">↗</span></a>
    <span style="font-family:'Space Mono',monospace;font-size:11px;opacity:.5;">+ 2 more in Hinglish/Hindi — kept them on the dedicated page</span>
  </div>

  {/* Logo wall — each tile is a fixed-size slot. When a real logo src is filled
      in (see src/lib/site.mjs → CLIENT_LOGOS), the <img> renders. Until then,
      the slot shows a designed text wordmark in a consistent system so the wall
      reads as a system, not as missing content. */}
  <div class="ds-logo-wall" role="list" aria-label="Clients Divyansh Sood has shipped for">
    {CLIENT_LOGOS.map((m, i) => (
      <div class="ds-logo-tile" role="listitem" data-reveal>
        {HAS_CLIENT_LOGOS && m.src ? (
          <a
            href={m.url || "#"}
            target={m.url ? "_blank" : undefined}
            rel={m.url ? "noopener" : undefined}
            data-cursor
            aria-label={m.name}
            class="ds-logo-link"
          >
            <img src={m.src} alt={m.name} loading="lazy" decoding="async" />
          </a>
        ) : (
          <a
            href={m.url || undefined}
            target={m.url ? "_blank" : undefined}
            rel={m.url ? "noopener" : undefined}
            data-cursor={m.url ? "" : undefined}
            aria-label={m.name}
            class={`ds-logo-wordmark ds-logo-wm-${i % 5}`}
          >
            <span class="ds-logo-symbol" aria-hidden="true">{symbols[i % symbols.length]}</span>
            <span class="ds-logo-name">{m.name}</span>
          </a>
        )}
      </div>
    ))}
  </div>
  <p class="ds-logo-note mono">↑ Some logos live under NDA — wordmarks shown until permission comes through.</p>
  </Frame>
</section>
