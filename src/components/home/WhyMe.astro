---
// "Built from the Himalayas" founder story + "Why work with me" reasons.
// `home-section` = mobile side-padding hook. Photo falls back to a styled
// monogram until FOUNDER_PHOTO is set in src/lib/site.mjs.
import { CALENDLY_URL, FOUNDER_PHOTO, FOUNDER_PHOTO_ALT, HAS_FOUNDER_PHOTO } from "../../lib/site.mjs";

const reasons = [
  { t: "The first reply comes from me", d: "Not a bot, not an account manager, not a 'we'll be in touch' autoresponder. Within 2 hours during IST work hours, with a real answer." },
  { t: "You see a working build by week two", d: "On a real URL, on your phone. Not a Figma review, not a slideshow, not 'we'll get to that next.'" },
  { t: "I push back when the idea won't work", d: "And I lose the arguments when the data says I'm wrong. That's the call doing its job — not the call performing a sales script." },
  { t: "You get a clean handoff at the end", d: "Repo, README, a Loom walking through what I built. Hand it to your team, your in-house dev, the next freelancer. Up to you." },
];
---

<section id="why" class="home-section" style="position:relative;z-index:2;background:#0b0b0c;color:#fff;padding:96px 30px;border-top:1px solid rgba(255,255,255,.14);">
  <div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-family:'Space Mono',monospace;font-size:10px;letter-spacing:.16em;text-transform:uppercase;opacity:.55;border-bottom:1px solid rgba(255,255,255,.14);padding-bottom:14px;margin-bottom:54px;">
    <span>(Why work with me — A)</span><span>Built from the Himalayas</span>
  </div>

  <div class="g-split" style="display:grid;grid-template-columns:.85fr 1.15fr;gap:54px;align-items:start;">
    <div data-reveal>
      {HAS_FOUNDER_PHOTO ? (
        <div class="imgfill" style={`width:100%;aspect-ratio:4/5;border-radius:8px;border:1px solid rgba(255,255,255,.14);background-image:url('${FOUNDER_PHOTO}');`} role="img" aria-label={FOUNDER_PHOTO_ALT}></div>
      ) : (
        <div aria-label={FOUNDER_PHOTO_ALT} role="img" style="width:100%;aspect-ratio:4/5;border-radius:8px;border:1px solid rgba(255,255,255,.14);background:radial-gradient(120% 90% at 30% 10%,rgba(255,70,18,.4),transparent 55%),linear-gradient(160deg,#1b1b1d,#0b0b0c);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;">
          <span style="font-family:'Archivo';font-weight:900;font-size:clamp(64px,12vw,120px);letter-spacing:-.05em;opacity:.9;">DS</span>
          <span style="position:absolute;bottom:14px;left:0;right:0;text-align:center;font-family:'Space Mono',monospace;font-size:9px;letter-spacing:.16em;text-transform:uppercase;opacity:.5;">Founder photo</span>
        </div>
      )}
      <div style="display:flex;justify-content:space-between;margin-top:14px;font-family:'Space Mono',monospace;font-size:10px;letter-spacing:.12em;text-transform:uppercase;opacity:.55;">
        <span>Divyansh Sood — founder</span><span>Himachal · India</span>
      </div>
    </div>

    <div data-reveal>
      <h2 style="margin:0;font-weight:900;font-size:clamp(34px,5.2vw,72px);line-height:.94;letter-spacing:-.03em;text-transform:uppercase;">What working<br />with me looks<br /><span style="color:var(--accent,#ff4612);">like in practice.</span></h2>
      <p style="margin:24px 0 0;font-size:16px;line-height:1.62;max-width:560px;opacity:.86;">The copy on most studio sites is wishful thinking. Here's what the work actually looks like when you hire me — what you get, when you get it, and what I push back on.</p>

      <div class="g-2" style="display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:38px;">
        {reasons.map((r) => (
          <div style="border:1px solid rgba(255,255,255,.14);border-radius:8px;padding:24px 22px;background:linear-gradient(180deg,rgba(255,255,255,.03),transparent);">
            <span style="display:block;font-family:'Space Mono',monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin-bottom:10px;">{r.t}</span>
            <h2 class="cs-card-h2" style="margin:0;font-size:16px;line-height:1.55;opacity:.84;">{r.d}</h2>
          </div>
        ))}
      </div>

      <div style="display:flex;flex-wrap:wrap;gap:14px;margin-top:34px;">
        <a href={CALENDLY_URL} target="_blank" rel="noopener" data-cursor class="btn btn-primary">Book an intro call <span aria-hidden="true">↗</span></a>
        <a href="/#work" data-cursor class="btn btn-ghost">See the work</a>
      </div>
    </div>
  </div>
</section>
