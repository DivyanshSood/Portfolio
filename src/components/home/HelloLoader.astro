---
// "Hello" preloader — a dark curtain that greets in eight languages, then
// lifts with a curved bottom edge to reveal the hero (the Dennis Snellenberg
// touch, ending on नमस्ते instead of his Dutch "Hallo").
//
// Gating (all decided synchronously in the index.astro head script, before
// first paint, so there is never a flash either way):
//   - html.ds-hello present  → overlay shows, page scroll locks, and the
//     hero/pill entrance animations sit paused behind it.
//   - class absent (repeat visit this session, reduced motion, or JS off) →
//     display:none, zero cost.
// The word cycle + exit run from the inline script below; the curtain removes
// itself from the DOM when done. Total time on screen ≈ 2.2s + 0.8s slide.
---

<div id="ds-hello" aria-hidden="true">
  <p class="ds-hello-word">
    <span class="ds-hello-dot"></span>
    <span id="ds-hello-text">Hello</span>
  </p>
  {/* Bulge below the curtain — becomes the curved bottom edge during the
      slide-up, flattening as it exits. */}
  <svg class="ds-hello-curve" viewBox="0 0 100 12" preserveAspectRatio="none" focusable="false">
    <path d="M0 0 H100 V2 Q50 12 0 2 Z"></path>
  </svg>
</div>

<script is:inline>
  (function () {
    var el = document.getElementById("ds-hello");
    if (!el) return;
    var d = document.documentElement;
    if (!d.classList.contains("ds-hello")) { el.remove(); return; }
    var words = ["Hello", "Bonjour", "Ciao", "Olá", "やあ", "Hallå", "Guten Tag", "नमस्ते"];
    var t = document.getElementById("ds-hello-text");
    var i = 0;
    function next() {
      i++;
      if (i < words.length) {
        t.textContent = words[i];
        // Snap between words; linger on नमस्ते before the curtain lifts.
        setTimeout(next, i === words.length - 1 ? 420 : 190);
      } else {
        // Unpause the hero entrance as the curtain starts to lift, so the
        // reveal and the entrance read as one move.
        d.classList.remove("ds-hello");
        el.classList.add("is-done");
        el.addEventListener("transitionend", function () { el.remove(); }, { once: true });
        setTimeout(function () { if (el.parentNode) el.remove(); }, 1500);
      }
    }
    setTimeout(next, 620);
  })();
</script>

<style is:global>
  #ds-hello { display: none; }
  html.ds-hello #ds-hello {
    display: flex;
    align-items: center;
    justify-content: center;
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #111113;
  }
  /* Keep the page still and the entrances waiting while the curtain is up. */
  html.ds-hello { overflow: hidden; }
  html.ds-hello .ds-hero *,
  html.ds-hello #ds-sticky-book {
    animation-play-state: paused !important;
  }

  .ds-hello-word {
    display: flex;
    align-items: center;
    gap: 0.35em;
    margin: 0;
    font-family: "Archivo", sans-serif;
    font-weight: 700;
    font-size: clamp(34px, 5vw, 58px);
    letter-spacing: -0.02em;
    color: #ece5d8;
  }
  .ds-hello-dot {
    width: 0.17em;
    height: 0.17em;
    border-radius: 50%;
    background: var(--accent, #ff1f1f);
    flex: none;
  }

  .ds-hello-curve {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 10vh;
    transform-origin: top;
  }
  .ds-hello-curve path { fill: #111113; }

  /* Exit: curtain slides up while the bulge flattens, so the curved edge
     sweeps the page and lands clean. */
  #ds-hello.is-done {
    transform: translateY(-100%);
    transition: transform 0.8s cubic-bezier(0.76, 0, 0.24, 1);
  }
  #ds-hello.is-done .ds-hello-curve {
    transform: scaleY(0);
    transition: transform 0.8s cubic-bezier(0.76, 0, 0.24, 1);
  }
</style>
