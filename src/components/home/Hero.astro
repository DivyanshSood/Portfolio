---
// Homepage hero — Mattis-style fold.
//
// Visual stack:
//   1. Dark base with a B&W founder photo as a large soft background (right
//      side of the page, low opacity). Same photo also feeds the avatar and
//      the bottom-right thumbnail preview so the system reads as one image.
//   2. Centered hero card with the four corner brackets (the "frame" that
//      every other section also uses via <Frame>).
//   3. Top mono tag → giant wordmark → description → author block → red
//      signature → three disciplines separated by a hairline.
//   4. Bottom-left and bottom-right page-meta chips, sitting on the hero so
//      they read like the chrome of the design, not as page furniture.
//
// Motion is disabled site-wide, so no entrance staggers, no scroll reveals,
// no hover transitions, no signature flourish. Everything renders in place.
import { CALENDLY_URL, FOUNDER_PHOTO, FOUNDER_PHOTO_ALT, HAS_FOUNDER_PHOTO } from "../../lib/site.mjs";

// ISO date for the bottom-right chip. Computed at build time so the date
// shows the page's build date (more useful than "live wall-clock" which would
// drift across timezones and crawlers).
const builtDate = new Date().toISOString().slice(0, 10); // YYYY-MM-DD
const builtDatePretty = new Date()
  .toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" })
  .toUpperCase();
---

<section id="top" class="ds-hero">
  {/* Full-bleed B&W founder portrait behind everything. */}
  <div class="ds-hero-bg" role="img" aria-label={FOUNDER_PHOTO_ALT} style={`background-image:url('${FOUNDER_PHOTO}');`}></div>
  <div class="ds-hero-bg-overlay" aria-hidden="true"></div>

  <div class="hero-card">
    {/* Four corner ticks — the Mattis card chrome. */}
    <span class="hero-tick hero-tick-tl" aria-hidden="true"></span>
    <span class="hero-tick hero-tick-tr" aria-hidden="true"></span>
    <span class="hero-tick hero-tick-bl" aria-hidden="true"></span>
    <span class="hero-tick hero-tick-br" aria-hidden="true"></span>

    {/* Top mono tag */}
    <div class="hero-eyebrow mono">
      <span>Est. 2026 — Version 12.14</span>
    </div>

    {/* Wordmark + small "studio" + signature overlap */}
    <div class="hero-namewrap">
      <h1 class="hero-name">
        <span class="hero-name-main">DIVYANSH<sup>®</sup></span>
        <span class="hero-name-studio">Studio</span>
      </h1>
      <div class="hero-sig" aria-hidden="true">Divyansh&nbsp;Sood</div>
    </div>

    {/* Description + author block, two-column on wide screens */}
    <div class="hero-body">
      <p class="hero-brandline">
        Custom websites, web apps, and storefronts — built for founders who'd
        rather hire a person than an agency. 20+ products live since 2022, all
        custom-coded, conversion-led, built to last.
      </p>

      <div class="hero-author">
        {HAS_FOUNDER_PHOTO ? (
          <span
            class="hero-avatar"
            role="img"
            aria-label={FOUNDER_PHOTO_ALT}
            style={`background-image:url('${FOUNDER_PHOTO}');`}
          ></span>
        ) : (
          <span class="hero-avatar hero-avatar-fallback" aria-hidden="true">DS</span>
        )}
        <span class="hero-author-meta">
          <span class="hero-author-name">Divyansh Sood</span>
          <span class="hero-author-role mono">Founder &amp; Lead Engineer</span>
        </span>
      </div>
    </div>

    {/* Bottom hairline + three disciplines, with the Mattis slash separators. */}
    <div class="hero-disciplines">
      <span>Design</span>
      <span class="hero-slash" aria-hidden="true">/</span>
      <span>Development</span>
      <span class="hero-slash" aria-hidden="true">/</span>
      <span>Marketing</span>
    </div>
  </div>

  {/* Bottom-left page meta */}
  <a href="#work" class="hero-corner-mark mono">
    <span>Elite folio · 2026</span>
    <span class="hero-corner-mark-sep" aria-hidden="true">|</span>
    <span class="hero-corner-mark-alert">Alert</span>
    <span class="hero-corner-mark-arrow" aria-hidden="true">↗</span>
  </a>

  {/* Bottom-right page meta — tiny site preview + name + build date */}
  <div class="hero-corner-page mono">
    <span class="hero-corner-thumb" style={`background-image:url('${FOUNDER_PHOTO}');`} aria-hidden="true"></span>
    <span class="hero-corner-page-text">
      <span>Divyansh Sood® Template</span>
      <span class="hero-corner-page-date">{builtDatePretty} · build {builtDate}</span>
    </span>
  </div>
</section>

<style>
  .ds-hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #0b0b0c;
    color: #fff;
    padding: 92px 0 88px;
  }

  /* ---------- Background portrait + dark wash ---------- */
  .ds-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: 72% 28%;
    background-repeat: no-repeat;
    /* Desaturate the portrait so it reads as mood, not as a focal photo. */
    filter: grayscale(1) contrast(1.08) brightness(0.78);
    z-index: 1;
  }
  .ds-hero-bg-overlay {
    position: absolute;
    inset: 0;
    background:
      /* Strong dark wash over the left half so the card text always wins. */
      linear-gradient(90deg, rgba(11, 11, 12, 0.92) 0%, rgba(11, 11, 12, 0.7) 38%, rgba(11, 11, 12, 0.32) 72%, rgba(11, 11, 12, 0.5) 100%),
      /* Vertical falloff so the top/bottom don't feel lit. */
      linear-gradient(180deg, rgba(11, 11, 12, 0.55) 0%, rgba(11, 11, 12, 0.18) 35%, rgba(11, 11, 12, 0.78) 100%);
    z-index: 2;
  }

  /* ---------- Hero card with Mattis corner ticks ---------- */
  .hero-card {
    position: relative;
    z-index: 4;
    width: min(900px, 92vw);
    padding: 36px 52px 32px;
  }
  .hero-tick {
    position: absolute;
    width: 22px;
    height: 22px;
    border: 1.5px solid rgba(255, 255, 255, 0.7);
    pointer-events: none;
  }
  .hero-tick-tl { top: -11px; left: -11px; border-right: 0; border-bottom: 0; }
  .hero-tick-tr { top: -11px; right: -11px; border-left: 0; border-bottom: 0; }
  .hero-tick-bl { bottom: -11px; left: -11px; border-right: 0; border-top: 0; }
  .hero-tick-br { bottom: -11px; right: -11px; border-left: 0; border-top: 0; }

  /* ---------- Top eyebrow ---------- */
  .hero-eyebrow {
    display: flex;
    justify-content: flex-start;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.6;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    padding-bottom: 14px;
    margin-bottom: 22px;
  }

  /* ---------- Wordmark + studio + signature ---------- */
  .hero-namewrap {
    position: relative;
    padding-bottom: 14px;
  }
  .hero-name {
    margin: 0;
    font-weight: 900;
    font-size: clamp(56px, 10.4vw, 168px);
    line-height: 0.86;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    display: flex;
    align-items: flex-start;
    gap: clamp(8px, 1.4vw, 20px);
    flex-wrap: wrap;
  }
  .hero-name-main {
    display: inline-block;
  }
  .hero-name-main sup {
    font-size: 0.18em;
    top: -1.7em;
    font-weight: 700;
    margin-left: 0.05em;
  }
  .hero-name-studio {
    display: inline-block;
    font-weight: 600;
    font-size: 0.2em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.78;
    margin-top: clamp(4px, 1vw, 14px);
  }

  .hero-sig {
    position: absolute;
    right: -6px;
    top: 38%;
    font-family: "Caveat", cursive;
    font-weight: 700;
    font-size: clamp(48px, 7vw, 96px);
    color: var(--accent, #ff4612);
    transform: rotate(-7deg);
    line-height: 1;
    pointer-events: none;
    white-space: nowrap;
    text-transform: none;
    letter-spacing: -0.01em;
  }

  /* ---------- Body row: description + author ---------- */
  .hero-body {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: end;
    margin-top: 36px;
  }
  .hero-brandline {
    margin: 0;
    font-size: clamp(13px, 1.15vw, 15px);
    line-height: 1.65;
    font-weight: 500;
    letter-spacing: 0.005em;
    color: rgba(255, 255, 255, 0.78);
    max-width: 56ch;
  }

  .hero-author {
    display: flex;
    align-items: center;
    gap: 14px;
    justify-self: end;
  }
  .hero-avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background-size: cover;
    background-position: center 18%;
    border: 1.5px solid rgba(255, 255, 255, 0.45);
    flex: none;
    filter: grayscale(1) contrast(1.05);
  }
  .hero-avatar-fallback {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--accent, #ff4612);
    color: #0b0b0c;
    font-weight: 900;
    font-size: 18px;
    letter-spacing: -0.04em;
  }
  .hero-author-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .hero-author-name {
    font-weight: 700;
    font-size: 14px;
    letter-spacing: -0.005em;
    color: #fff;
  }
  .hero-author-role {
    font-size: 9.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  /* ---------- Disciplines row ---------- */
  .hero-disciplines {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 38px;
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    font-weight: 700;
    font-size: clamp(13px, 1.4vw, 16px);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .hero-slash { opacity: 0.35; font-weight: 400; }

  /* ---------- Bottom-left meta (Elite folio) ---------- */
  .hero-corner-mark {
    position: absolute;
    left: 30px;
    bottom: 26px;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
    text-decoration: none;
  }
  .hero-corner-mark:hover { color: #fff; }
  .hero-corner-mark-sep { opacity: 0.45; }
  .hero-corner-mark-alert {
    color: var(--accent, #ff4612);
    font-weight: 700;
  }
  .hero-corner-mark-arrow {
    display: inline-block;
    margin-left: 2px;
    font-size: 11px;
  }

  /* ---------- Bottom-right meta (Template preview) ---------- */
  .hero-corner-page {
    position: absolute;
    right: 30px;
    bottom: 26px;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
    max-width: 50vw;
  }
  .hero-corner-thumb {
    width: 30px;
    height: 30px;
    border-radius: 3px;
    background-size: cover;
    background-position: center 22%;
    border: 1px solid rgba(255, 255, 255, 0.18);
    flex: none;
    filter: grayscale(1) contrast(1.05) brightness(0.9);
  }
  .hero-corner-page-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    line-height: 1.2;
  }
  .hero-corner-page-date {
    font-size: 9px;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.5);
  }

  /* ---------- Tablet ---------- */
  @media (max-width: 860px) {
    .ds-hero { padding: 84px 0 96px; }
    .hero-card { width: 92vw; padding: 30px 28px 26px; }
    .hero-body { grid-template-columns: 1fr; gap: 20px; align-items: start; }
    .hero-author { justify-self: start; }
    .hero-sig { top: 30%; font-size: clamp(40px, 9vw, 70px); }
    .hero-corner-mark { font-size: 9px; left: 16px; bottom: 18px; max-width: 60vw; }
    .hero-corner-page { right: 16px; bottom: 18px; font-size: 9px; }
    .hero-corner-thumb { width: 24px; height: 24px; }
  }

  /* ---------- Phones ---------- */
  @media (max-width: 560px) {
    .hero-card { padding: 24px 20px 22px; }
    .hero-name { gap: 6px; }
    .hero-sig { position: static; transform: rotate(-6deg); margin: 6px 0 0; text-align: right; }
    .hero-disciplines { gap: 10px 14px; font-size: 12px; margin-top: 28px; }
    .hero-corner-mark-sep { display: none; }
    .hero-corner-mark-alert { display: none; }
    .hero-corner-mark { gap: 6px; }
  }

  @media (max-width: 420px) {
    .hero-corner-page-text > :first-child { display: none; }
    .hero-corner-page-date { letter-spacing: 0.12em; }
  }
</style>
