---
// Homepage hero. `hero-card` is a responsive hook (mobile side-padding only).
---

<section id="top" style="position:relative;min-height:100vh;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#0b0b0c;">
  <div style="position:absolute;inset:0;width:100%;height:100%;background:radial-gradient(90% 70% at 72% 18%, rgba(255,70,18,.22), transparent 55%),radial-gradient(60% 55% at 18% 92%, rgba(255,70,18,.10), transparent 60%),linear-gradient(180deg,#161618 0%,#0b0b0c 72%);"></div>
  <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(11,11,12,.72) 0%,rgba(11,11,12,.35) 35%,rgba(11,11,12,.55) 100%);"></div>
  <div style="position:absolute;inset:0;background:radial-gradient(120% 90% at 50% 50%,transparent 40%,rgba(11,11,12,.6) 100%);"></div>

  <div class="hero-card" style="position:relative;z-index:3;width:min(820px,90vw);padding:40px 46px 34px;">
    <div style="position:absolute;top:-9px;left:-9px;width:18px;height:18px;border-top:1.5px solid rgba(255,255,255,.5);border-left:1.5px solid rgba(255,255,255,.5);"></div>
    <div style="position:absolute;top:-9px;right:-9px;width:18px;height:18px;border-top:1.5px solid rgba(255,255,255,.5);border-right:1.5px solid rgba(255,255,255,.5);"></div>
    <div style="position:absolute;bottom:-9px;left:-9px;width:18px;height:18px;border-bottom:1.5px solid rgba(255,255,255,.5);border-left:1.5px solid rgba(255,255,255,.5);"></div>
    <div style="position:absolute;bottom:-9px;right:-9px;width:18px;height:18px;border-bottom:1.5px solid rgba(255,255,255,.5);border-right:1.5px solid rgba(255,255,255,.5);"></div>

    <div data-rise="0.05" style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-family:'Space Mono',monospace;font-size:10px;letter-spacing:.16em;text-transform:uppercase;opacity:.7;border-bottom:1px solid rgba(255,255,255,.18);padding-bottom:14px;margin-bottom:22px;">
      <span>Est. 2022</span><span>Portfolio — Vol. 02</span><span>Available for work</span>
    </div>

    <div data-rise="0.16" style="position:relative;">
      <h1 style="margin:0;font-weight:900;font-size:clamp(54px,8vw,118px);line-height:.86;letter-spacing:-.035em;text-transform:uppercase;">DIVYANSH<br />SOOD<sup style="font-size:.16em;top:-1.7em;font-weight:700;">®</sup> <span style="font-weight:600;font-size:.2em;letter-spacing:.04em;vertical-align:super;opacity:.8;">STUDIO</span></h1>
      <div class="hero-sig" style="position:absolute;right:-6px;bottom:-46px;font-family:'Caveat',cursive;font-weight:700;font-size:clamp(46px,7vw,86px);color:var(--accent,#ff4612);transform:rotate(-7deg);line-height:1;pointer-events:none;">Divyansh Sood</div>
    </div>

    <div data-rise="0.3" class="hero-meta" style="display:flex;justify-content:space-between;align-items:flex-end;gap:30px;flex-wrap:wrap;margin-top:30px;">
      <p style="margin:0;max-width:300px;font-family:'Space Mono',monospace;font-size:11px;line-height:1.7;letter-spacing:.02em;opacity:.72;">I design and build websites that turn attention into outcomes — strategy, interface, and engineering under one roof. Currently taking on a handful of projects for 2026.</p>
      <a href="https://github.com/DivyanshSood" target="_blank" rel="noopener" data-cursor style="font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase;opacity:.7;white-space:nowrap;color:#fff;text-decoration:none;">@divyansh ↗</a>
    </div>

    <div data-rise="0.42" class="hero-disciplines" style="display:flex;gap:40px;flex-wrap:wrap;margin-top:28px;padding-top:18px;border-top:1px solid rgba(255,255,255,.18);font-weight:700;font-size:clamp(13px,1.4vw,16px);letter-spacing:.04em;text-transform:uppercase;">
      <span>Design</span><span style="opacity:.35;">/</span><span>Development</span><span style="opacity:.35;">/</span><span style="opacity:.6;">Strategy</span>
    </div>
  </div>

  <div style="position:absolute;left:30px;bottom:24px;font-family:'Space Mono',monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;opacity:.55;z-index:3;">Scroll to explore</div>
  <div style="position:absolute;left:50%;bottom:22px;transform:translateX(-50%);z-index:3;font-size:18px;animation:ds-bounce 1.8s infinite;opacity:.7;">↓</div>
  <div style="position:absolute;right:30px;bottom:24px;font-family:'Space Mono',monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;opacity:.55;z-index:3;">01 — 13</div>
</section>
