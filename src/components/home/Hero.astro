---
// Homepage hero — Mattis-style fold.
//
// Visual stack:
//   1. Dark base with a B&W founder photo as a large soft background (right
//      side of the page, low opacity). Same photo also feeds the avatar and
//      the bottom-right thumbnail preview so the system reads as one image.
//   2. Centered hero card with the four corner brackets (the "frame" that
//      every other section also uses via <Frame>).
//   3. Top mono tag → giant wordmark → description → author block → red
//      wordmark stamp (bottom-right, in the logo's heavy caps — the cursive
//      signature moved up into the nav as the site's brand, July 2026) →
//      three disciplines separated by a hairline.
//   4. Bottom-left and bottom-right page-meta chips, sitting on the hero so
//      they read like the chrome of the design, not as page furniture.
//
// Motion: a staggered entrance on load (CSS keyframes gated on html.motion),
// a left-to-right wipe on the wordmark stamp, and a subtle pointer parallax on
// the portrait for depth. All disabled under prefers-reduced-motion.
import { FOUNDER_PHOTO, FOUNDER_PHOTO_ALT } from "../../lib/site.mjs";
---

<section id="top" class="ds-hero">
  {/* Full-bleed B&W founder portrait behind everything. */}
  <div class="ds-hero-bg" role="img" aria-label={FOUNDER_PHOTO_ALT} style={`background-image:url('${FOUNDER_PHOTO}');`}></div>
  <div class="ds-hero-bg-overlay" aria-hidden="true"></div>

  <div class="hero-card">
    {/* Four corner ticks — the Mattis card chrome. */}
    <span class="hero-tick hero-tick-tl" aria-hidden="true"></span>
    <span class="hero-tick hero-tick-tr" aria-hidden="true"></span>
    <span class="hero-tick hero-tick-bl" aria-hidden="true"></span>
    <span class="hero-tick hero-tick-br" aria-hidden="true"></span>

    {/* Top mono tag */}
    <div class="hero-eyebrow mono">
      <span>Est. 2022</span>
      {/* Custom press-mark asterisk — slow spin, balances the eyebrow row. */}
      <svg class="hero-asterisk" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
        <line x1="20" y1="3" x2="20" y2="37" />
        <line x1="3" y1="20" x2="37" y2="20" />
        <line x1="8" y1="8" x2="32" y2="32" />
        <line x1="32" y1="8" x2="8" y2="32" />
      </svg>
    </div>

    {/* Photo-forward hero: the signature is the identity. A visually-hidden h1
        keeps a real page heading for SEO/screen readers. */}
    <h1 class="hero-sr-title">Divyansh Sood — independent web designer &amp; developer. Custom-coded, conversion-focused websites, stores and web apps for founders worldwide.</h1>

    {/* Bottom hairline + disciplines, with the Mattis slash separators. */}
    <div class="hero-disciplines">
      <span>Design</span>
      <span class="hero-slash" aria-hidden="true">/</span>
      <span>Development</span>
      <span class="hero-slash" aria-hidden="true">/</span>
      <span>SEO</span>
    </div>
  </div>

  {/* Red wordmark — stamps the portrait from the bottom-right in the logo's
      heavy caps. (The cursive signature that used to live here is now the
      nav brand: the two treatments swapped roles, July 2026.) */}
  <span class="hero-sig">Divyansh&nbsp;Sood<sup>®</sup></span>

  {/* Bottom-left page meta */}
  <a href="#work" class="hero-corner-mark mono">
    <span>Selected work · 2026</span>
    <span class="hero-corner-mark-sep" aria-hidden="true">|</span>
    <span class="hero-corner-mark-alert">Now booking</span>
    <span class="hero-corner-mark-arrow" aria-hidden="true">↗</span>
  </a>

  {/* Bottom-center scroll cue — a red dash travels down a hairline track. */}
  <div class="hero-scroll-cue" aria-hidden="true">
    <svg viewBox="0 0 2 56" focusable="false">
      <line class="hero-cue-track" x1="1" y1="0" x2="1" y2="56" />
      <line class="hero-cue-dash" x1="1" y1="0" x2="1" y2="56" />
    </svg>
  </div>

</section>

<style>
  .ds-hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #0b0b0c;
    /* Warm off-white instead of pure #fff — reads more premium against the
       B&W portrait and stops the small mono labels looking stark/cheap. */
    color: #ece5d8;
    padding: 92px 0 88px;
  }

  /* ---------- Background portrait + dark wash ---------- */
  .ds-hero-bg {
    position: absolute;
    inset: 0;
    /* Full-bleed portrait: the source is pre-composited onto a wide 16:10
       canvas with the subject seated on the RIGHT and the studio backdrop
       extended across the left, so the face sits clear of the centered type
       at every aspect ratio. Anchoring right/top keeps the head in frame
       when `cover` crops the canvas. */
    background-size: cover;
    background-position: right top;
    background-repeat: no-repeat;
    /* Keep the palette (grayscale) but lighter than before so the photo stays
       legible and sharp rather than a dim wash. */
    filter: grayscale(1) contrast(1.04) brightness(0.9);
    /* Minimal overscan — just enough for the pointer-parallax drift
       (MotionController starts its scrub from this same value). */
    transform: scale(1.02);
    z-index: 1;
  }
  .ds-hero-bg-overlay {
    position: absolute;
    inset: 0;
    background:
      /* Dark over the left (type) half, light over the right so the portrait
         reads clearly — just enough wash there to keep the author text legible. */
      linear-gradient(90deg, rgba(11, 11, 12, 0.9) 0%, rgba(11, 11, 12, 0.6) 40%, rgba(11, 11, 12, 0.28) 70%, rgba(11, 11, 12, 0.44) 100%),
      /* Vertical falloff so the top/bottom don't feel lit. */
      linear-gradient(180deg, rgba(11, 11, 12, 0.42) 0%, rgba(11, 11, 12, 0.12) 38%, rgba(11, 11, 12, 0.64) 100%);
    z-index: 2;
  }

  /* ---------- Hero card with Mattis corner ticks ---------- */
  .hero-card {
    position: relative;
    z-index: 4;
    width: min(900px, 92vw);
    padding: 36px 52px 32px;
  }
  .hero-tick {
    position: absolute;
    width: 22px;
    height: 22px;
    border: 1.5px solid rgba(255, 255, 255, 0.7);
    pointer-events: none;
  }
  .hero-tick-tl { top: -11px; left: -11px; border-right: 0; border-bottom: 0; }
  .hero-tick-tr { top: -11px; right: -11px; border-left: 0; border-bottom: 0; }
  .hero-tick-bl { bottom: -11px; left: -11px; border-right: 0; border-top: 0; }
  .hero-tick-br { bottom: -11px; right: -11px; border-left: 0; border-top: 0; }

  /* ---------- Top eyebrow ---------- */
  .hero-eyebrow {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.66;
    margin-bottom: 16px;
  }
  .hero-asterisk {
    width: 16px;
    height: 16px;
    flex: none;
    overflow: visible;
  }
  .hero-asterisk line {
    stroke: var(--accent, #ff1f1f);
    stroke-width: 3;
  }

  /* ---------- Wordmark + studio + signature ---------- */
  .hero-namewrap {
    position: relative;
    padding-bottom: 14px;
  }
  .hero-name {
    margin: 0;
    font-weight: 900;
    font-size: clamp(56px, 10.4vw, 168px);
    line-height: 0.86;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    display: flex;
    align-items: flex-start;
    gap: clamp(8px, 1.4vw, 20px);
    flex-wrap: wrap;
  }
  .hero-name-main {
    display: inline-block;
  }
  .hero-name-main sup {
    font-size: 0.18em;
    top: -1.7em;
    font-weight: 700;
    margin-left: 0.05em;
  }
  .hero-name-studio {
    display: inline-block;
    font-weight: 600;
    font-size: 0.2em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.78;
    margin-top: clamp(4px, 1vw, 14px);
  }

  /* Signature — a separated flourish sitting beneath the author block, never
     overlapping the wordmark. */
  /* Visually-hidden page heading (kept for SEO / screen readers). */
  .hero-sr-title {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Logo-caps treatment: same weight/tracking as the old nav wordmark so the
     stamp on the portrait *is* the logo, not a third type voice. Sits level
     (no rotation) — a logotype reads stamped, a script reads signed. */
  .hero-sig {
    position: absolute;
    right: clamp(20px, 5vw, 68px);
    bottom: clamp(64px, 11vh, 116px);
    z-index: 5;
    font-weight: 900;
    font-size: clamp(34px, 4.8vw, 72px);
    letter-spacing: -0.035em;
    text-transform: uppercase;
    color: var(--accent, #ff1f1f);
    line-height: 1;
    pointer-events: none;
    white-space: nowrap;
  }
  .hero-sig sup {
    font-size: 0.2em;
    top: -1.8em;
    font-weight: 700;
    margin-left: 0.06em;
  }

  /* ---------- Body row: description + author ---------- */
  .hero-author-col {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 16px;
    justify-self: end;
    text-align: right;
  }
  .hero-brandline {
    margin: 0;
    font-size: clamp(28px, 4.2vw, 62px);
    line-height: 1.04;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: #fff;
    max-width: 18ch;
  }

  .hero-author {
    display: flex;
    align-items: center;
    gap: 14px;
    justify-self: end;
  }
  .hero-avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background-size: cover;
    background-position: center 18%;
    border: 1.5px solid rgba(255, 255, 255, 0.45);
    flex: none;
    filter: grayscale(1) contrast(1.05);
  }
  .hero-avatar-fallback {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--accent, #ff1f1f);
    color: #0b0b0c;
    font-weight: 900;
    font-size: 18px;
    letter-spacing: -0.04em;
  }
  .hero-author-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .hero-author-name {
    font-weight: 700;
    font-size: 14px;
    letter-spacing: -0.005em;
    color: #fff;
  }
  .hero-author-role {
    font-size: 9.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  /* ---------- Disciplines row ---------- */
  .hero-disciplines {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 14px;
    font-weight: 700;
    font-size: clamp(15px, 1.7vw, 20px);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .hero-slash { opacity: 0.4; font-weight: 400; }

  /* ---------- Bottom-left meta (Elite folio) ---------- */
  .hero-corner-mark {
    position: absolute;
    left: 30px;
    bottom: 26px;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(236, 229, 216, 0.6);
    text-decoration: none;
  }
  .hero-corner-mark:hover { color: #ece5d8; }
  .hero-corner-mark-sep { opacity: 0.45; }
  .hero-corner-mark-alert {
    color: var(--accent, #ff1f1f);
    font-weight: 700;
  }
  .hero-corner-mark-arrow {
    display: inline-block;
    margin-left: 2px;
    font-size: 11px;
  }

  /* ---------- Bottom-center scroll cue ---------- */
  .hero-scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 20px;
    transform: translateX(-50%);
    z-index: 5;
    pointer-events: none;
  }
  .hero-scroll-cue svg {
    display: block;
    width: 2px;
    height: 56px;
    overflow: visible;
  }
  .hero-cue-track {
    stroke: rgba(236, 229, 216, 0.22);
    stroke-width: 2;
  }
  .hero-cue-dash {
    stroke: var(--accent, #ff1f1f);
    stroke-width: 2;
    /* Static state (reduced motion / no-JS): a short red tick at the base. */
    stroke-dasharray: 12 44;
    stroke-dashoffset: 12;
  }

  /* ---------- Bottom-right meta (Template preview) ---------- */
  .hero-corner-page {
    position: absolute;
    right: 30px;
    bottom: 26px;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
    max-width: 50vw;
  }
  .hero-corner-thumb {
    width: 30px;
    height: 30px;
    border-radius: 3px;
    background-size: cover;
    background-position: center 22%;
    border: 1px solid rgba(255, 255, 255, 0.18);
    flex: none;
    filter: grayscale(1) contrast(1.05) brightness(0.9);
  }
  .hero-corner-page-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    line-height: 1.2;
  }
  .hero-corner-page-date {
    font-size: 9px;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.5);
  }

  /* ---------- Entrance + signature draw keyframes ---------- */
  @keyframes heroRise {
    from { opacity: 0; transform: translateY(34px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes heroSigDraw {
    /* Wipe left→right; the negative insets keep the raised ® from clipping. */
    from { opacity: 0; clip-path: inset(-30% 100% -30% 0); }
    to   { opacity: 1; clip-path: inset(-30% -30% -30% 0); }
  }
  html.motion .hero-eyebrow     { animation: heroRise 0.9s 0.10s both cubic-bezier(0.16, 1, 0.3, 1); }
  html.motion .hero-namewrap    { animation: heroRise 1.0s 0.22s both cubic-bezier(0.16, 1, 0.3, 1); }
  html.motion .hero-disciplines { animation: heroRise 0.9s 0.58s both cubic-bezier(0.16, 1, 0.3, 1); }
  html.motion .hero-corner-mark { animation: heroRise 0.9s 0.85s both ease-out; }
  html.motion .hero-sig         { animation: heroSigDraw 1.1s 1.05s both ease-out; }
  html.motion .hero-scroll-cue  { animation: heroRise 0.9s 1.15s both ease-out; }

  /* SVG micro-motion — all gated on html.motion, so prefers-reduced-motion
     (which blocks the class) leaves every mark static and visible. */
  @keyframes heroSpin { to { transform: rotate(360deg); } }
  html.motion .hero-asterisk {
    animation: heroSpin 14s linear infinite;
  }
  /* Red dash rides down the track; 12+44 = one 56-unit period per loop. */
  @keyframes heroCueTravel {
    from { stroke-dashoffset: 68; }
    to   { stroke-dashoffset: 12; }
  }
  html.motion .hero-cue-dash {
    animation: heroCueTravel 2.4s linear 2s infinite;
  }

  /* ---------- Tablet ---------- */
  @media (max-width: 860px) {
    .ds-hero { padding: 84px 0 96px; }
    /* Narrow viewports crop the wide canvas to a vertical slice — pan toward
       the subject (he sits at ~65-72% of the canvas width) so the face stays
       centered in frame instead of showing the empty backdrop. */
    .ds-hero-bg { background-size: cover; background-position: 71% top; }
    .hero-card { width: 92vw; padding: 30px 28px 26px; }
    .hero-sig { right: 20px; bottom: 92px; font-size: clamp(24px, 5.6vw, 44px); }
    .hero-corner-mark { font-size: 9px; left: 16px; bottom: 18px; max-width: 60vw; }
    .hero-corner-page { right: 16px; bottom: 18px; font-size: 9px; }
    .hero-corner-thumb { width: 24px; height: 24px; }
  }

  /* ---------- Phones ---------- */
  @media (max-width: 560px) {
    .hero-card { padding: 24px 20px 22px; }
    .hero-name { gap: 6px; }
    .hero-sig { right: 16px; bottom: 86px; font-size: clamp(20px, 7.6vw, 30px); }
    .hero-disciplines { gap: 10px 14px; font-size: 12px; margin-top: 28px; }
    .hero-corner-mark-sep { display: none; }
    .hero-corner-mark-alert { display: none; }
    .hero-corner-mark { gap: 6px; }
    /* Phones: the bottom strip already holds the corner mark, signature and
       Book-a-call pill — the scroll cue just crowds the signature there. */
    .hero-scroll-cue { display: none; }
  }

  @media (max-width: 420px) {
    .hero-corner-page-text > :first-child { display: none; }
    .hero-corner-page-date { letter-spacing: 0.12em; }
  }
</style>
