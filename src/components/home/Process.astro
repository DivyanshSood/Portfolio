---
// How a project runs — a tight 5-step timeline. Keeps the "live in 3–4 weeks"
// promise concrete. `home-section` = mobile side-padding; steps stack on phones.
const steps = [
  { n: "01", t: "Discovery", d: "A short call. I learn your business, your buyers, and what a win looks like. No pitch, no deck." },
  { n: "02", t: "Strategy", d: "I read your current site like a hostile customer. The first draft of the brief is usually a list of things I'd fix in week one." },
  { n: "03", t: "Design", d: "High-fidelity screens and a clickable prototype. You approve the look before any code is written." },
  { n: "04", t: "Build", d: "Custom-coded, fast, accessible. Pixel-accurate to the design, easy to update. You see a working URL by week two." },
  { n: "05", t: "Launch & grow", d: "We go live on a Tuesday so I'm awake when something breaks. Then we watch the numbers for two weeks before touching anything." },
];
---

<section id="process" class="home-section" style="position:relative;z-index:2;background:#0b0b0c;color:#fff;padding:90px 30px;border-top:1px solid rgba(255,255,255,.14);">
  <div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-family:'Space Mono',monospace;font-size:10px;letter-spacing:.16em;text-transform:uppercase;opacity:.55;border-bottom:1px solid rgba(255,255,255,.14);padding-bottom:14px;margin-bottom:50px;">
    <span>(Process — D)</span><span>MVPs &amp; sites in 3–4 wks · builds in 6–10</span>
  </div>

  <h2 data-reveal style="margin:0 0 54px;font-weight:900;font-size:clamp(40px,7.5vw,120px);line-height:.86;letter-spacing:-.04em;text-transform:uppercase;max-width:14ch;">How we'll work.</h2>

  <div class="g-process" style="display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:rgba(255,255,255,.14);border-top:1px solid rgba(255,255,255,.14);border-bottom:1px solid rgba(255,255,255,.14);">
    {steps.map((s) => (
      <div data-reveal style="background:#0b0b0c;padding:28px 22px;display:flex;flex-direction:column;gap:14px;min-height:210px;">
        <span style="font-family:'Space Mono',monospace;font-size:13px;letter-spacing:.06em;color:var(--accent,#ff4612);">({s.n}) {s.t}</span>
        <h2 class="cs-card-h2" style="margin:0;font-size:clamp(15px,1.6vw,17px);line-height:1.5;opacity:.84;">{s.d}</h2>
      </div>
    ))}
  </div>
</section>

<style>
  @media (max-width: 860px) {
    .g-process { grid-template-columns: 1fr !important; }
    .g-process > div { min-height: 0 !important; }
  }
</style>
