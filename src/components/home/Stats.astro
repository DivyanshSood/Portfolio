---
// Results / stats band. `home-section` is a responsive hook (mobile side-padding).
---

<section class="home-section" style="position:relative;z-index:2;background:var(--accent,#ff4612);color:#0b0b0c;padding:80px 30px;overflow:hidden;">
  <div style="display:flex;justify-content:space-between;font-family:'Space Mono',monospace;font-size:10px;letter-spacing:.16em;text-transform:uppercase;opacity:.65;margin-bottom:50px;">
    <span>(Results — 04)</span><span>By the numbers</span>
  </div>
  <div class="g-split" style="display:grid;grid-template-columns:1fr 1.4fr;gap:50px;align-items:start;">
    <div style="display:flex;flex-direction:column;gap:40px;">
      <div data-reveal><div style="font-weight:900;font-size:clamp(50px,7vw,96px);line-height:.9;letter-spacing:-.03em;">20+</div><div style="font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;opacity:.7;margin-top:8px;">Projects shipped<br />since 2022</div></div>
      <div data-reveal><div style="font-weight:900;font-size:clamp(50px,7vw,96px);line-height:.9;letter-spacing:-.03em;">3.2s</div><div style="font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;opacity:.7;margin-top:8px;">Faster average<br />load time</div></div>
      <div data-reveal><div style="font-weight:900;font-size:clamp(50px,7vw,96px);line-height:.9;letter-spacing:-.03em;">98%</div><div style="font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;opacity:.7;margin-top:8px;">Client<br />retention</div></div>
    </div>
    <h2 data-reveal style="margin:0;font-weight:900;font-size:clamp(44px,7.5vw,128px);line-height:.86;letter-spacing:-.04em;text-transform:uppercase;text-align:right;">Every result here started with a problem worth solving.</h2>
  </div>
</section>
