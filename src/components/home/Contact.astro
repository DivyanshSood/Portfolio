---
// Contact + footer — Mattis p24–25 language: giant "START A PROJECT.", a
// borderless underline form on the right, the personal note + contact channels
// on the left, then the footer. No bordered cards. The submit POSTs to
// /api/contact (mailto fallback) via src/scripts/contact-form.js, initialised
// in HomeScripts.astro. Copy/links unchanged (footer cursive signature
// dropped so the bold wordmark never doubles with the signature).
import { CALENDLY_URL, GOOGLE_MAPS_URL } from "../../lib/site.mjs";
---

<section id="contact" class="ds-contact" aria-label="Start a project">
  <div class="ds-contact-inner">
    <div class="ds-contact-bar mono" data-reveal>
      <span>(Contact — 04)</span>
      <span>2026 ©</span>
    </div>

    <div class="ds-contact-grid">
      {/* Left — personal note + channels */}
      <div class="ds-contact-left">
        <div class="ds-contact-note" data-reveal>
          <span class="ds-contact-avatar">DS</span>
          <p class="ds-contact-note-text">"I'll personally review your brief and get back to you within two hours."</p>
          <span class="ds-contact-note-role mono">Divyansh · Founder</span>
        </div>

        <a href={CALENDLY_URL} target="_blank" rel="noopener" class="ds-link ds-link-light ds-contact-book" data-reveal>
          Book an intro call <span aria-hidden="true">↗</span>
        </a>
        <p class="ds-contact-book-note mono" data-reveal>Prefer to talk first? Grab a 15-minute slot — your time zone, no commitment.</p>

        <div class="ds-contact-channels" data-reveal>
          <span class="ds-contact-label mono">Contact</span>
          <a href="tel:+919816091875" class="ds-contact-phone">+91 98160 91875</a>
          <a href="mailto:hello@divyanshsood.com" class="ds-contact-email mono">hello@divyanshsood.com</a>
          <div class="ds-contact-social mono">
            <a href="https://wa.me/919816091875" target="_blank" rel="noopener">WhatsApp ↗</a>
            <a href={GOOGLE_MAPS_URL} target="_blank" rel="noopener">Google Maps ↗</a>
            <a href="https://github.com/DivyanshSood" target="_blank" rel="noopener">GitHub ↗</a>
            <a href="https://www.linkedin.com/in/divyansh-sood-023556151/" target="_blank" rel="noopener">LinkedIn ↗</a>
          </div>
        </div>
      </div>

      {/* Right — giant heading + underline form */}
      <div class="ds-contact-right">
        <h2 class="ds-contact-title" data-giant-text>
          <span class="ds-giant-mask"><span class="ds-giant-line">Start a</span></span>
          <span class="ds-giant-mask"><span class="ds-giant-line">project.</span></span>
        </h2>
        <form id="ds-contact-form" class="ds-contact-form" data-reveal>
          <div class="ds-contact-row">
            <input id="cf-name" type="text" placeholder="Your name" name="name" autocomplete="name" aria-label="Your name" class="ds-contact-input" />
            <input id="cf-email" type="email" placeholder="Email address" name="email" autocomplete="email" aria-label="Email address" class="ds-contact-input" />
          </div>
          <textarea id="cf-msg" rows="4" placeholder="Tell me about your project" name="message" aria-label="Tell me about your project" class="ds-contact-input ds-contact-input-full"></textarea>
          <label class="ds-contact-check">
            <input id="cf-new" type="checkbox" />
            <span class="cf-box"></span> I need a brand-new website
          </label>
          {/* Honeypot — invisible to humans; bots that fill it are dropped. */}
          <input id="cf-hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none;" />
          <div class="ds-contact-submit-row">
            <button type="submit" class="ds-contact-submit">Send message <span aria-hidden="true">↗</span></button>
            <span class="ds-contact-terms mono">By submitting you agree to the Terms &amp; Privacy Policy.</span>
          </div>
        </form>
      </div>
    </div>

    {/* Footer */}
    <footer class="ds-foot">
      <div class="ds-foot-grid">
        <div class="ds-foot-brand">
          <div class="ds-foot-word">DIVYANSH SOOD<sup>®</sup></div>
        </div>
        <div class="ds-foot-col">
          <span class="ds-foot-h mono">Navigate</span>
          <a href="#top">Home</a>
          <a href="#about">About</a>
          <a href="#work">Works</a>
          <a href="#contact">Contact</a>
          <a href="/blog/">Blog</a>
        </div>
        <div class="ds-foot-col">
          <span class="ds-foot-h mono">Studio</span>
          <span class="ds-foot-muted">India · Worldwide<br />IST +5:30</span>
          <div class="ds-foot-links">
            <a href="https://github.com/DivyanshSood" target="_blank" rel="noopener">GitHub ↗</a>
            <a href="https://www.linkedin.com/in/divyansh-sood-023556151/" target="_blank" rel="noopener">LinkedIn ↗</a>
            <a href="/portfolio.pdf" target="_blank" rel="noopener">Portfolio PDF ↗</a>
          </div>
        </div>
      </div>
      <div class="ds-foot-bar mono">
        <span>© 2026 Divyansh Sood Studio</span>
        <span class="ds-foot-legal">
          <a href="/privacy/">Privacy</a>
          <a href="#ds-cookie-settings" data-cookie-settings>Cookies</a>
        </span>
        <a href="#top">Back to top ↑</a>
      </div>
    </footer>
  </div>
</section>

<style>
  .ds-contact {
    position: relative;
    z-index: 2;
    background: #0b0b0c;
    color: #fff;
    padding: clamp(64px, 8vw, 110px) 30px 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    overflow: hidden;
  }
  .ds-contact-inner { position: relative; z-index: 1; max-width: 1180px; margin: 0 auto; }

  .ds-contact-bar {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  /* Centred contact — heading + form on top, personal note + channels below,
     all centre-aligned into a single column. */
  .ds-contact-grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(40px, 6vw, 72px);
    padding-bottom: clamp(48px, 6vw, 72px);
  }
  .ds-contact-right { order: -1; width: 100%; }
  .ds-contact-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 620px;
  }

  /* Left — note + channels (borderless) */
  .ds-contact-note { margin-bottom: 26px; }
  .ds-contact-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--accent, #ff1f1f);
    color: #0b0b0c;
    font-weight: 800;
    font-size: 14px;
    margin-bottom: 16px;
  }
  .ds-contact-note-text {
    margin: 0 auto 10px;
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.45;
    font-weight: 600;
    max-width: 30ch;
  }
  .ds-contact-note-role {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }
  .ds-contact-book { margin-bottom: 12px; }
  .ds-contact-book-note {
    margin: 0 auto 34px;
    font-size: 11px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.5);
    max-width: 30ch;
  }
  .ds-contact-label {
    display: block;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 10px;
  }
  .ds-contact-phone {
    display: block;
    font-weight: 700;
    font-size: clamp(22px, 2.4vw, 30px);
    letter-spacing: -0.02em;
    color: #fff;
    text-decoration: none;
    margin-bottom: 12px;
  }
  .ds-contact-phone:hover { color: var(--accent, #ff1f1f); }
  .ds-contact-email {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }
  .ds-contact-email:hover { color: #fff; }
  .ds-contact-social {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 20px;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ds-contact-social a { color: rgba(255, 255, 255, 0.8); text-decoration: none; }
  .ds-contact-social a:hover { color: var(--accent, #ff1f1f); }

  /* Right — heading + form */
  .ds-contact-title {
    margin: 0 0 clamp(32px, 4vw, 48px);
    font-weight: 900;
    font-size: clamp(56px, 10vw, 156px);
    line-height: 0.82;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    text-align: center;
  }
  /* Keep the form fields a comfortable measure and centred under the heading. */
  .ds-contact-form { max-width: 640px; margin: 0 auto; width: 100%; text-align: left; }
  .ds-contact-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-bottom: 18px;
  }
  .ds-contact-input {
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    color: #fff;
    font-family: "Space Mono", monospace;
    font-size: 13px;
    padding: 16px 2px;
    outline: none;
    transition: border-color 0.3s ease;
    width: 100%;
  }
  .ds-contact-input::placeholder { color: rgba(255, 255, 255, 0.4); }
  .ds-contact-input:focus { border-bottom-color: var(--accent, #ff1f1f); }
  .ds-contact-input-full { width: 100%; margin-bottom: 26px; }
  textarea.ds-contact-input { resize: vertical; min-height: 92px; line-height: 1.55; }

  .ds-contact-check {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: "Space Mono", monospace;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 30px;
    cursor: pointer;
  }
  .ds-contact-check input { position: absolute; opacity: 0; width: 0; height: 0; }
  .cf-box {
    width: 16px;
    height: 16px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 2px;
    display: inline-block;
    flex: 0 0 auto;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .ds-contact-submit-row { display: flex; align-items: center; justify-content: center; gap: 24px; flex-wrap: wrap; }
  .ds-contact-submit {
    background: var(--accent, #ff1f1f);
    color: #0b0b0c;
    border: none;
    font-family: "Space Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    padding: 16px 28px;
    border-radius: 2px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .ds-contact-submit span { transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
  .ds-contact-submit:hover span { transform: translate(3px, -3px); }
  .ds-contact-terms { font-size: 11px; color: rgba(255, 255, 255, 0.5); max-width: 28ch; }

  /* Footer */
  .ds-foot { border-top: 1px solid rgba(255, 255, 255, 0.14); }
  .ds-foot-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 40px;
    padding: 48px 0;
  }
  .ds-foot-word { font-weight: 900; font-size: clamp(26px, 3vw, 38px); letter-spacing: -0.04em; }
  .ds-foot-word sup { font-size: 0.4em; top: -1em; }
  .ds-foot-col { display: flex; flex-direction: column; }
  .ds-foot-h {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 14px;
  }
  .ds-foot-col a {
    font-family: "Space Mono", monospace;
    font-size: 13px;
    color: #fff;
    text-decoration: none;
    opacity: 0.82;
    padding: 4px 0;
  }
  .ds-foot-col a:hover { opacity: 1; color: var(--accent, #ff1f1f); }
  .ds-foot-muted { font-family: "Space Mono", monospace; font-size: 13px; line-height: 1.7; color: rgba(255, 255, 255, 0.6); }
  .ds-foot-links { display: flex; flex-direction: column; margin-top: 14px; }
  .ds-foot-bar {
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    padding: 20px 0;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }
  .ds-foot-bar a { color: #fff; text-decoration: none; opacity: 0.8; }
  .ds-foot-bar a:hover { opacity: 1; color: var(--accent, #ff1f1f); }
  .ds-foot-legal { display: inline-flex; gap: 16px; flex-wrap: wrap; }

  @media (max-width: 860px) {
    .ds-contact-grid { grid-template-columns: 1fr; gap: 40px; }
    .ds-contact-right { order: -1; }
    .ds-foot-grid { grid-template-columns: 1fr; gap: 28px; }
  }
  @media (max-width: 520px) {
    .ds-contact-row { grid-template-columns: 1fr; }
  }
  /* Keep the footer bar clear of the fixed "Book a call" pill on phones. */
  @media (max-width: 560px) {
    .ds-foot-bar { padding-bottom: 84px; }
  }
</style>
