---
// Industries served — drawn straight from real shipped work, so every line is
// backed by a case study. `home-section` = mobile side-padding; `g-3` collapses
// to one column on phones.
const industries = [
  { t: "SaaS & AI products", d: "MVPs, web apps and AI features for founders.", eg: "WebSeek.ai · InHimalayas" },
  { t: "E-commerce & D2C", d: "Custom-coded storefronts — no Shopify themes.", eg: "ChinkiZ · Redline · CultXberserk" },
  { t: "Travel & tourism", d: "Booking sites that capture demand directly.", eg: "InHimalayas · Nandini · Dharamshala" },
  { t: "Creator brands", d: "Stores and sites built for an existing audience.", eg: "ChinkiZ · 600K+ subscribers" },
  { t: "Education", d: "Websites plus admissions apps and admin panels.", eg: "Modern K.B.S." },
  { t: "Energy & infrastructure", d: "Corporate sites with galleries and dashboards.", eg: "North Peak Power Systems" },
];
---

<section id="industries" class="home-section" style="position:relative;z-index:2;background:#e8e8e8;color:#0b0b0c;padding:90px 30px;">
  <div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-family:'Space Mono',monospace;font-size:10px;letter-spacing:.16em;text-transform:uppercase;opacity:.55;border-bottom:1px solid rgba(0,0,0,.14);padding-bottom:14px;margin-bottom:50px;">
    <span>(Industries — C)</span><span>Who I build for</span>
  </div>

  <div class="g-split" style="display:grid;grid-template-columns:1fr 1.15fr;gap:48px;align-items:end;margin-bottom:54px;">
    <h2 data-reveal style="margin:0;font-weight:900;font-size:clamp(40px,7vw,110px);line-height:.86;letter-spacing:-.04em;text-transform:uppercase;">Industries<br />I know.</h2>
    <p data-reveal style="margin:0;font-size:16px;line-height:1.6;font-weight:500;max-width:440px;opacity:.78;">Different sectors, one approach — start from how customers decide, then build the site that moves them. Here's where I've already done it.</p>
  </div>

  <div class="g-3" style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:1px;background:rgba(0,0,0,.14);border:1px solid rgba(0,0,0,.14);border-radius:8px;overflow:hidden;">
    {industries.map((it) => (
      <div data-reveal style="background:#e8e8e8;padding:30px 26px;display:flex;flex-direction:column;gap:10px;min-height:170px;">
        <h3 style="margin:0;font-weight:800;font-size:clamp(20px,2.4vw,27px);letter-spacing:-.02em;">{it.t}</h3>
        <p style="margin:0;font-size:14px;line-height:1.5;opacity:.7;flex:1;">{it.d}</p>
        <span style="font-family:'Space Mono',monospace;font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--accent,#ff4612);">{it.eg}</span>
      </div>
    ))}
  </div>
</section>
