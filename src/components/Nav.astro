---
import { CALENDLY_URL } from "../lib/site.mjs";
---

<nav id="ds-nav">
  <div class="nav-left">
    {/* Brand = the red cursive signature (swapped up from the hero, which now
        carries the heavy wordmark on the portrait instead). Same name, same
        ® — only the treatment moved. */}
    <a href="/" class="brand">Divyansh&nbsp;Sood<sup>®</sup><svg
        class="brand-swash"
        viewBox="0 0 300 32"
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"
      ><path
          d="M4 22 C 70 30, 130 8, 190 16 C 232 21, 270 16, 296 6"
          fill="none"
          vector-effect="non-scaling-stroke"
        /></svg></a>
  </div>
  <div class="nav-right">
    <div class="nav-links" id="nav-menu">
      <a href="/portfolio/">Portfolio</a>
      <a href="/blog/">Blog</a>
      <a href="/about/">About</a>
      <a href="/#contact">Contact</a>
    </div>
    <a href={CALENDLY_URL} target="_blank" rel="noopener" class="nav-cta">
      <span class="nav-cta-dot" aria-hidden="true"></span>
      Start a project
    </a>
    <button type="button" class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav-menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<style>
  /* The Mattis-style top nav: brand + tagline on the left, primary links and
     a single pill CTA on the right. Sits over the hero as a transparent strip
     so the portrait photo shows through. */
  #ds-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 18px 32px;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* Slides away while scrolling down, returns on the first upward scroll.
     Toggled by BaseScripts; never applied while the menu is open. */
  #ds-nav.nav-hidden { transform: translateY(-100%); }

  .nav-left {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 30px;
    flex: none;
  }

  /* Caveat runs a small x-height, so the signature needs a larger px size
     than the old 17px Archivo mark to hold the same visual weight. Red on
     the near-black page is ~5.1:1 — passes AA at this size. */
  #ds-nav .brand {
    position: relative;
    display: inline-block;
    font-family: "Caveat", cursive;
    font-weight: 700;
    font-size: 27px;
    letter-spacing: 0;
    color: var(--accent, #ff1f1f);
    text-decoration: none;
    line-height: 1;
    white-space: nowrap;
    flex: none;
  }
  #ds-nav .brand sup {
    font-size: 0.42em;
    top: -0.75em;
    font-weight: 700;
  }
  /* Hand-drawn underline swash beneath the signature — the same stroke the
     hero used to carry. Static (pre-drawn): the nav renders on every page,
     outside the homepage motion system, and a logo shouldn't re-animate on
     each navigation anyway. */
  .brand-swash {
    position: absolute;
    left: 6%;
    bottom: -0.1em;
    width: 94%;
    height: 0.26em;
    overflow: visible;
    pointer-events: none;
  }
  .brand-swash path {
    stroke: var(--accent, #ff1f1f);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 26px;
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .nav-links a {
    color: #fff;
    text-decoration: none;
    opacity: 0.85;
    padding: 6px 0;
  }
  .nav-links a:hover { opacity: 1; }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: var(--accent, #ff1f1f);
    color: #0b0b0c;
    text-decoration: none;
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 11px 18px 11px 16px;
    border-radius: 999px;
    font-weight: 700;
    white-space: nowrap;
    flex: none;
  }
  .nav-cta-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #0b0b0c;
    flex: none;
  }

  /* Hamburger — hidden on desktop, shown ≤860px. 44×44 touch target. */
  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    margin: -8px -8px -8px 4px;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
    flex: none;
  }
  .nav-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.2s ease;
  }
  #ds-nav.is-open .nav-toggle span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  #ds-nav.is-open .nav-toggle span:nth-child(2) { opacity: 0; }
  #ds-nav.is-open .nav-toggle span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Tablet & phones — collapse the links into a toggled dropdown panel so
     Works/Blog/About/Contact stay reachable (they used to just vanish). */
  @media (max-width: 860px) {
    #ds-nav { padding: 12px 18px; gap: 12px; }
    .nav-right { gap: 12px; }
    .nav-toggle { display: flex; }

    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: #0b0b0c;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      padding: 6px 18px 14px;
      font-size: 14px;
      letter-spacing: 0.1em;
      opacity: 0;
      transform: translateY(-8px);
      pointer-events: none;
      transition: opacity 0.24s ease, transform 0.24s ease;
    }
    #ds-nav.is-open .nav-links { opacity: 1; transform: none; pointer-events: auto; }
    .nav-links a {
      padding: 15px 2px;
      opacity: 0.92;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .nav-links a:last-child { border-bottom: 0; }
    .nav-cta { font-size: 10px; padding: 11px 15px; }
  }

  /* Phones — scale everything down. */
  @media (max-width: 560px) {
    #ds-nav { gap: 10px; padding: 11px 14px; }
    .nav-left { flex: 1 1 auto; gap: 9px; }
    #ds-nav .brand { font-size: 22px; }
  }
  @media (max-width: 420px) {
    .nav-cta { font-size: 9px; padding: 10px 12px; letter-spacing: 0.08em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-links, .nav-toggle span { transition: none; }
  }
</style>

<script>
  // Mobile nav: toggle the dropdown panel. Closes on link click, Escape, or an
  // outside tap so it never traps the user.
  (function () {
    const nav = document.getElementById("ds-nav");
    const toggle = nav?.querySelector(".nav-toggle") as HTMLButtonElement | null;
    if (!nav || !toggle) return;
    const set = (open: boolean) => {
      nav.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    };
    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      set(!nav.classList.contains("is-open"));
    });
    nav.querySelectorAll(".nav-links a").forEach((a) =>
      a.addEventListener("click", () => set(false))
    );
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") set(false);
    });
    document.addEventListener("click", (e) => {
      if (nav.classList.contains("is-open") && !nav.contains(e.target as Node)) set(false);
    });
  })();
</script>
