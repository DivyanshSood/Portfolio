---
/* ===========================================================================
   Cookie consent banner — GDPR/CCPA honest, no dark patterns.
   - Two-button choice: Accept analytics / Decline.
   - Doesn't ship with analytics pre-consented. GA + Yandex scripts are gated
     behind this banner via window.dsConsent === "accepted".
   - Stores choice in localStorage (ds-cookie-consent). If unset, banner
     shows after 1.2s so it doesn't fight the hero animation.
   - Footer link "Cookies" reopens it (`#ds-cookie-settings` in the URL).
   =========================================================================== */
---
<div id="ds-cookie-banner" class="ds-cookie-banner" role="dialog" aria-labelledby="ds-cookie-title" aria-describedby="ds-cookie-desc" hidden>
  <div class="ds-cookie-card" data-reveal>
    <div class="ds-cookie-head">
      <span class="ds-cookie-eyebrow mono">Cookies</span>
      <h2 id="ds-cookie-title" class="ds-cookie-title">A note about tracking on this site.</h2>
    </div>
    <p id="ds-cookie-desc" class="ds-cookie-desc">
      I use Google Analytics (anonymised IP) and Yandex Metrica to learn which pages get read and which get skipped. No personal data is sold or shared. Decline and the only request this site makes is the one to load it.
    </p>

    <details class="ds-cookie-details">
      <summary class="mono">What runs, when you accept</summary>
      <table class="ds-cookie-table" aria-label="Cookies and trackers in detail">
        <thead>
          <tr><th>Tool</th><th>Purpose</th><th>When</th></tr>
        </thead>
        <tbody>
          <tr>
            <td>Google Analytics 4</td>
            <td>Page views, anonymised location (country), no personal IDs</td>
            <td>Only after "Accept"</td>
          </tr>
          <tr>
            <td>Yandex Metrica</td>
            <td>Page views, anonymised, no session replay, no clickmap</td>
            <td>Only after "Accept"</td>
          </tr>
          <tr>
            <td>No third-party ads</td>
            <td>—</td>
            <td>—</td>
          </tr>
        </tbody>
      </table>
    </details>

    <div class="ds-cookie-actions">
      <button type="button" class="ds-cookie-btn ds-cookie-btn-accept" data-cookie-choice="accepted">Accept analytics</button>
      <button type="button" class="ds-cookie-btn ds-cookie-btn-decline" data-cookie-choice="declined">Decline</button>
      <a href="/privacy" class="ds-cookie-policy mono">Privacy policy ↗</a>
    </div>
  </div>
</div>

<script is:inline>
  // ---- Cookie consent runtime (inline, tiny, no dependencies) ----
  (function () {
    var KEY = "ds-cookie-consent";
    var banner = document.getElementById("ds-cookie-banner");
    if (!banner) return;
    var stored = null;
    try { stored = localStorage.getItem(KEY); } catch (e) { /* sandboxed or denied */ }

    function apply(choice) {
      try { localStorage.setItem(KEY, choice); } catch (e) {}
      window.dsConsent = choice;
      // Only after explicit accept do we boot the analytics scripts that the
      // Layout otherwise loads unconditionally. Strip them first, then add.
      if (choice === "accepted") {
        loadAnalytics();
      } else {
        // user declined — strip any GA/YM script tags already in the DOM
        stripAnalytics();
      }
      hideBanner();
    }

    function loadAnalytics() {
      if (window.__dsAnalyticsLoaded) return;
      window.__dsAnalyticsLoaded = true;
      var GA_ID = "G-51WG6025T0";
      var YM_ID = 110027161;
      // GA gtag.js
      var s = document.createElement("script");
      s.async = true;
      s.src = "https://www.googletagmanager.com/gtag/js?id=" + GA_ID;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag(){ window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag("js", new Date());
      gtag("config", GA_ID, { anonymize_ip: true });
      // Yandex Metrica
      (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window, document, "script", "https://mc.yandex.ru/metrika/tag.js?id=" + YM_ID, "ym");
      window.ym && window.ym(YM_ID, "init", { ssr: true, ecommerce: "dataLayer", accurateTrackBounce: true, trackLinks: true });
    }

    function stripAnalytics() {
      // Remove inline gtag/ym init scripts added by Layout, plus the tag.js
      // if it managed to attach before the click (it shouldn't have).
      document.querySelectorAll('script[src*="googletagmanager"],script[src*="mc.yandex.ru"]').forEach(function (n) { n.remove(); });
      try { delete window.gtag; delete window.dataLayer; delete window.ym; } catch (e) {}
    }

    function showBanner() {
      banner.hidden = false;
      // Allow the [hidden] removal to flush, then animate in
      requestAnimationFrame(function () {
        banner.classList.add("is-visible");
      });
    }
    function hideBanner() {
      banner.classList.remove("is-visible");
      setTimeout(function () { banner.hidden = true; }, 320);
    }

    // First-visit: show after a short delay so it doesn't fight the hero.
    if (!stored) {
      window.addEventListener("load", function () {
        setTimeout(showBanner, 1200);
      });
    } else {
      window.dsConsent = stored;
      if (stored === "accepted") loadAnalytics();
    }

    // Wire the buttons (delegated)
    banner.addEventListener("click", function (ev) {
      var t = ev.target;
      if (!(t instanceof Element)) return;
      var btn = t.closest("[data-cookie-choice]");
      if (btn) apply(btn.getAttribute("data-cookie-choice"));
    });

    // Hash-based reopen (#ds-cookie-settings) AND any [data-cookie-settings] link
    function maybeShowFromHash() {
      if (location.hash === "#ds-cookie-settings") showBanner();
    }
    window.addEventListener("hashchange", maybeShowFromHash);
    maybeShowFromHash();
    document.addEventListener("click", function (ev) {
      var t = ev.target;
      if (!(t instanceof Element)) return;
      var link = t.closest("[data-cookie-settings]");
      if (link) {
        ev.preventDefault();
        // Update hash without scrolling so the footer "Cookies" link feels
        // like a real link (back-button friendly, shareable URL).
        history.replaceState(null, "", location.pathname + "#ds-cookie-settings");
        showBanner();
      }
    });
  })();
</script>

<style>
  .ds-cookie-banner {
    position: fixed;
    inset: auto 18px 18px 18px;
    z-index: 80;
    display: flex;
    justify-content: center;
    pointer-events: none;
    transform: translateY(28px);
    opacity: 0;
    transition: transform .35s cubic-bezier(.2,.8,.2,1), opacity .35s ease;
  }
  .ds-cookie-banner.is-visible { transform: none; opacity: 1; pointer-events: auto; }

  .ds-cookie-card {
    width: min(680px, 100%);
    background: #0d0d0f;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 14px;
    padding: 22px 24px 20px;
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(14px);
  }
  .ds-cookie-head { margin-bottom: 10px; }
  .ds-cookie-eyebrow {
    display: inline-block;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent, #ff1f1f);
    margin-bottom: 8px;
  }
  .ds-cookie-title {
    margin: 0;
    font-weight: 800;
    font-size: clamp(18px, 2vw, 22px);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .ds-cookie-desc {
    margin: 10px 0 0;
    font-size: 14.5px;
    line-height: 1.55;
    opacity: 0.82;
    max-width: 56ch;
  }

  .ds-cookie-details {
    margin-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: 12px;
  }
  .ds-cookie-details summary {
    cursor: pointer;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.7;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .ds-cookie-details summary::-webkit-details-marker { display: none; }
  .ds-cookie-details summary::before {
    content: "→";
    display: inline-block;
    transition: transform 0.2s ease;
    color: var(--accent, #ff1f1f);
  }
  .ds-cookie-details[open] summary::before { transform: rotate(90deg); }

  .ds-cookie-table {
    width: 100%;
    margin-top: 12px;
    border-collapse: collapse;
    font-size: 13px;
    line-height: 1.45;
  }
  .ds-cookie-table th,
  .ds-cookie-table td {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    vertical-align: top;
  }
  .ds-cookie-table th {
    font-family: "Space Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.65;
    font-weight: 400;
  }
  .ds-cookie-table td:first-child { font-weight: 600; white-space: nowrap; }

  .ds-cookie-actions {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .ds-cookie-btn {
    appearance: none;
    border: 0;
    cursor: pointer;
    font-family: "Space Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 12px 18px;
    border-radius: 2px;
    font-weight: 700;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .ds-cookie-btn-accept {
    background: var(--accent, #ff1f1f);
    color: #0b0b0c;
  }
  .ds-cookie-btn-accept:hover { filter: brightness(1.05); }
  .ds-cookie-btn-decline {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }
  .ds-cookie-btn-decline:hover { border-color: rgba(255, 255, 255, 0.6); }

  .ds-cookie-policy {
    margin-left: auto;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.65;
    text-decoration: none;
    color: #fff;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    padding-bottom: 2px;
  }
  .ds-cookie-policy:hover { opacity: 1; border-bottom-color: #fff; }

  @media (max-width: 560px) {
    .ds-cookie-banner { inset: auto 12px 12px 12px; }
    .ds-cookie-card { padding: 18px 18px 16px; }
    .ds-cookie-policy { margin-left: 0; }
  }
</style>
