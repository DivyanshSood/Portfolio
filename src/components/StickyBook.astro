---
// Floating "Book a call" pill — appears site-wide once the visitor scrolls past
// the hero. Links to the central CALENDLY_URL so it stays in sync with every
// other CTA. Hidden until scroll so it never covers the hero.
import { CALENDLY_URL } from "../lib/site.mjs";
---

<a
  id="ds-sticky-book"
  href={CALENDLY_URL}
  target="_blank"
  rel="noopener"
  data-cursor
  aria-label="Book an intro call"
  style="position:fixed;right:18px;bottom:18px;z-index:60;display:inline-flex;align-items:center;gap:9px;background:var(--accent,#ff4612);color:#fff;text-decoration:none;font-family:'Space Mono',monospace;font-size:12px;letter-spacing:.08em;text-transform:uppercase;font-weight:700;padding:13px 19px;border-radius:999px;box-shadow:0 14px 36px -12px rgba(255,70,18,.7);opacity:0;transform:translateY(20px);pointer-events:none;transition:opacity .4s ease,transform .4s ease;"
>
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="16" y1="2" x2="16" y2="6"></line></svg>
  <span>Book a call</span>
</a>

<script is:inline>
  (function () {
    var el = document.getElementById("ds-sticky-book");
    if (!el) return;
    function onScroll() {
      var show = window.scrollY > 640;
      el.style.opacity = show ? "1" : "0";
      el.style.transform = show ? "translateY(0)" : "translateY(20px)";
      el.style.pointerEvents = show ? "auto" : "none";
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  })();
</script>
