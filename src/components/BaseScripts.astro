---
// Site-wide runtime (inlined, no framework), shared by every page via Layout.
// Motion is disabled site-wide: no Lenis, no scroll-reveal IO, no nav
// background scroll-state, no custom cursor follow. Only the static nav
// background state and the resize handler remain.
---

<script>
  const root = document.getElementById("ds-root");
  if (root) {
    /* ---------------- Nav static background ---------------- */
    // No scroll listener — the nav stays at its base appearance everywhere.
    const nav = document.getElementById("ds-nav");
    if (nav) {
      nav.style.background = "transparent";
      nav.style.backdropFilter = "none";
      nav.style.webkitBackdropFilter = "none";
      nav.style.borderBottomColor = "transparent";
    }

    /* ---------------- Force every [data-reveal] visible ---------------- */
    // Anything previously hidden waiting for IntersectionObserver is now
    // shown immediately (no fade-in stagger, no opacity:0 starting point).
    root.querySelectorAll<HTMLElement>("[data-reveal]").forEach((el) => {
      el.style.opacity = "1";
      el.style.transform = "none";
    });
  }
</script>
