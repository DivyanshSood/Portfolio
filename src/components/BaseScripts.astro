---
// Analytics conversion-event helper + delegated CTA tracking, shared by every
// page via the Base layout.
---

<script>
  // ---- Conversion events -------------------------------------------------
  // window.dsTrack(name, params) forwards a goal to GA4 + Yandex Metrica.
  // Both are loaded in the head by Base.astro; the typeof guards below keep
  // this a silent no-op if a content blocker stripped either one.
  const YM_ID = 110027161; // must match the loader in Base.astro
  (window as any).dsTrack = function (name: string, params?: Record<string, unknown>) {
    try {
      const w = window as any;
      if (typeof w.gtag === "function") w.gtag("event", name, params || {});
      if (typeof w.ym === "function") w.ym(YM_ID, "reachGoal", name, params || {});
    } catch (_e) {
      /* analytics must never break the page */
    }
  };

  // GA4's Leads reports (Business objectives → Generate leads) count only the
  // recommended `generate_lead` event, so the custom goals below never showed
  // up there — the report read zero leads for months. Every lead-intent action
  // now also sends `generate_lead`, with `lead_source` saying which one it was.
  // Mark generate_lead as a key event in GA4 Admin for it to count.
  (window as any).dsLead = function (source: string, params?: Record<string, unknown>) {
    (window as any).dsTrack("generate_lead", { lead_source: source, ...(params || {}) });
  };

  // Where on the page a CTA sits, so "WhatsApp from the footer" and "WhatsApp
  // from a case study's hero" can be told apart in reports.
  const whereIs = (a: Element) =>
    a.closest("footer") ? "footer"
    : a.closest("[data-endcta], #contact") ? "end_cta"
    : a.closest("header, [data-hero]") ? "hero"
    : "body";

  // Delegated CTA click tracking — one listener covers every page and every
  // Calendly / WhatsApp / phone / email / portfolio-PDF link on it.
  document.addEventListener("click", (ev) => {
    const t = ev.target as Element | null;
    const a = t && t.closest ? (t.closest("a[href]") as HTMLAnchorElement | null) : null;
    if (!a) return;
    const href = a.getAttribute("href") || "";
    let goal = "";
    if (href.includes("calendly.com")) goal = "calendly_click";
    else if (href.includes("wa.me")) goal = "whatsapp_click";
    else if (href.startsWith("tel:")) goal = "phone_click";
    else if (href.startsWith("mailto:")) goal = "email_click";
    else if (href.includes("portfolio.pdf")) goal = "pdf_download";
    if (!goal) return;
    const params = { href, link_location: whereIs(a), page_path: location.pathname };
    (window as any).dsTrack(goal, params);
    if (goal !== "pdf_download") (window as any).dsLead(goal.replace("_click", ""), params);
  });
</script>
