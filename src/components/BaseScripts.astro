---
// Site-wide runtime (inlined, no framework), shared by every page via Layout.
// Reveal/scroll motion is owned by the homepage's MotionController; here we only
// drive the shared nav's scroll-state background (transparent at the very top,
// a subtle dark bar once the page has scrolled past the hero).
---

<script>
  const nav = document.getElementById("ds-nav");
  if (nav) {
    const onScroll = () => {
      const scrolled = window.scrollY > 40;
      nav.style.background = scrolled ? "rgba(11,11,12,.72)" : "transparent";
      nav.style.backdropFilter = scrolled ? "blur(10px) saturate(140%)" : "none";
      (nav.style as any).webkitBackdropFilter = scrolled ? "blur(10px) saturate(140%)" : "none";
      nav.style.borderBottomColor = scrolled ? "rgba(255,255,255,.08)" : "transparent";
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
