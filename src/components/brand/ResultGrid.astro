---
// Case Study "(03) Telemetry — The result" grid: channel, big red value, label.
// `src` is an optional source line for a figure the reader can't check on a
// live site (a client's Search Console, an unpublished project count).
import { widestWordEm } from "../../lib/display-fit.mjs";

interface Props {
  stats: { v: string; l: string; src?: string }[];
}
const { stats } = Astro.props;
// Each value's widest word, in em (+4% for kerning, as in PageHero). The cell
// is a size container, so the value's font-size is capped at what lets that
// word fit the cell: "41.8K" and "2019" shrink in a five-across row instead of
// breaking as "41.8 / K" and "201 / 9". Values that already fit are unchanged.
const fit = (v: string) => (widestWordEm(v) * 1.04).toFixed(2);
---

<div class="rg">
  {stats.map((s, i) => (
    <div class="rg-c">
      <span class="rg-ch">CH.{String(i + 1).padStart(2, "0")}</span>
      <span class="rg-v" style={`--fit:${fit(s.v)}`}>{s.v}</span>
      <span class="rg-l">{s.l}</span>
      {s.src && <span class="rg-src">Source: {s.src}</span>}
    </div>
  ))}
</div>

<style>
  .rg{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:0;border-top:3px solid var(--ink)}
  .rg-c{padding:clamp(20px,2.4vw,32px) clamp(0px,1.4vw,24px) clamp(20px,2.4vw,32px) 0;border-bottom:1px solid var(--gda);display:flex;flex-direction:column;gap:14px;container-type:inline-size;min-width:0}
  .rg-ch{font-family:var(--mono);font-size:11px;letter-spacing:.1em;color:var(--g5c)}
  .rg-v{font-weight:900;font-style:italic;font-stretch:125%;line-height:.9;letter-spacing:-0.03em;font-size:min(clamp(56px,6.4vw,110px),calc(100cqi / var(--fit)));color:var(--red);overflow-wrap:break-word}
  .rg-l{font-size:16px;line-height:1.4}
  .rg-src{font-size:13px;line-height:1.4;color:var(--g5c)}
</style>
