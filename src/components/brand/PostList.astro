---
// Writing rows (Home "(07) Journal"): number · title · meta · arrow.
interface Props {
  items: { href: string; title: string; meta?: string }[];
  start?: number;
}
const { items, start = 1 } = Astro.props;
---

<div class="pl">
  {items.map((p, i) => (
    <a href={p.href} class="pl-row">
      <span class="pl-n">{String(i + start).padStart(2, "0")}</span>
      <span class="pl-t">{p.title}</span>
      {p.meta && <span class="pl-m">{p.meta}</span>}
      <span aria-hidden="true" class="pl-a">→</span>
    </a>
  ))}
</div>

<style>
  .pl{border-top:3px solid var(--ink)}
  .pl-row{display:flex;flex-wrap:wrap;align-items:baseline;gap:8px 24px;padding:clamp(18px,2vw,26px) 0;border-bottom:1px solid var(--gda);text-decoration:none;color:var(--ink)}
  .pl-row:hover{color:var(--red)}
  .pl-n{flex:0 0 40px;font-family:var(--mono);font-size:12px;color:var(--g5c)}
  .pl-t{flex:1 1 300px;font-weight:750;font-stretch:106%;font-size:clamp(19px,1.9vw,27px);line-height:1.2;letter-spacing:-0.01em}
  .pl-m{font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--g5c)}
  .pl-a{font-size:20px}
</style>
