---
// Cross-links between the location pages, from src/lib/locations.mjs. A page
// passes `near` (its closest towns, in order); pages without one get the
// featured set. The Himachal hub is always linked unless it's this page.
import { LOCATIONS, FEATURED_LOCATIONS, locationBySlug, locationHref, HUB } from "../../lib/locations.mjs";

interface Props {
  near?: string[];
}
const here = Astro.url.pathname;
const list = (Astro.props.near?.map((s) => locationBySlug(s)).filter(Boolean) ?? FEATURED_LOCATIONS) as typeof LOCATIONS;
const links = [
  ...list.map((l) => ({ href: locationHref(l.slug), label: `Web developer in ${l.city}` })),
  HUB,
].filter((a) => a.href !== here);
---

<nav aria-label="Other areas I serve" class="nearby">
  <div class="lbl">Also serving</div>
  <div class="links-row">
    {links.map((a) => <a href={a.href}>{a.label} →</a>)}
  </div>
</nav>

<style>
  .nearby{display:flex;flex-direction:column;gap:6px}
</style>
