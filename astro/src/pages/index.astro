  .lg-orb-2 { width: 420px; height: 420px; background: radial-gradient(circle, #7fb0ff, transparent 70%); top: 20%; right: -100px; animation: lg-float2 26s ease-in-out infinite; }
  .lg-orb-3 { width: 520px; height: 520px; background: radial-gradient(circle, #ff9e7d, transparent 70%); bottom: -160px; left: 30%; animation: lg-float3 30s ease-in-out infinite; }
  .lg-orb-4 { width: 340px; height: 340px; background: radial-gradient(circle, #9be7c4, transparent 70%); top: 55%; left: 5%; animation: lg-float1 28s ease-in-out infinite reverse; }
  @keyframes lg-float1 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(60px, 50px) scale(1.1); } }
