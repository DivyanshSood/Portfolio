---
import Base from "../layouts/Base.astro";
import HomepageSchemas from "../components/HomepageSchemas.astro";

// ── Liquid-glass dashboard homepage ───────────────────────────────
// Faithful port of the Claude Design "Portfolio.html" bundle.
// All class names are prefixed `lg-` so this page is fully isolated
// from the global CSS that the blog / work / case-study pages share.

const WA = "https://wa.me/919816091875?text=Hi%20Divyansh,%20I%20want%20a%20website%20for%20my%20business.";
const AVATAR = "https://ik.imagekit.io/dn2zdxiu3/Portfolioprojectimages/divyansh.webp";

const navItems = [
  { id: "hero", label: "Home", icon: "⌂" },
  { id: "work", label: "Work", icon: "◆", badge: "8" },
  { id: "pricing", label: "Pricing", icon: "◎" },
  { id: "stack", label: "Stack", icon: "⚡" },
  { id: "reviews", label: "Reviews", icon: "★" },
  { id: "about", label: "About", icon: "○" },
  { id: "included", label: "What's Included", icon: "✓" },
  { id: "faq", label: "FAQ", icon: "?" },
  { id: "contact", label: "Contact", icon: "✉" },
];

const marqueeItems = [
  "CBSE School Portal", "D2C E-commerce", "600K Creator Storefront",
  "Himalayan Booking Platform", "Tour Operator CMS", "Solar Contractor Dashboard",
  "Taxi Operator Rebuild", "Brand + Razorpay Storefront", "AI Website Generator", "Live in 14 days",
];

const heroStats = [
  { icon: "⚡", count: 14, suffix: "", unit: "days", label: "Brief → Live URL", amber: true },
  { icon: "★", value: "5.0", unit: "★", label: "Client rating", amber: false },
  { icon: "◆", count: 7, suffix: "", unit: "days", label: "Fastest delivery", amber: true },
  { icon: "👥", count: 600, suffix: "K+", unit: "", label: "Audience served", amber: false },
];

const projectTags = ["All", "Travel", "E-Commerce", "Institutional", "AI", "Infra"];

const projects = [
  {
    title: "WebSeek.ai", tag: "AI PRODUCT", year: "2026", wide: true, initials: "W",
    desc: "AI website generator. Prompt → working site.",
    img: "https://ik.imagekit.io/dn2zdxiu3/Portfolioprojectimages/AiWebsitegenerator/AiWebsitegenerator-1.webp",
    url: "/projects/webseek",
    gradient: "linear-gradient(135deg, #E8A54B 0%, #d4923a 50%, #1a1a1a 100%)",
    stats: [{ val: "3", label: "AI models" }, { val: "5", label: "Free credits" }, { val: "Any", label: "Language" }],
  },
  {
    title: "InHimalayas", tag: "TRAVEL · BOOKING", year: "2025", wide: false, initials: "IH",
    desc: "Booking platform for Himalayan stays. AI-search tuned.",
    img: "https://ik.imagekit.io/dn2zdxiu3/Portfolioprojectimages/inhimalayas/inhimalayas-1.webp",
    url: "/projects/inhimalayas",
    gradient: "linear-gradient(135deg, #2d6a4f 0%, #40916c 50%, #95d5b2 100%)",
    stats: [{ val: "30+", label: "Stays listed" }, { val: "↑", label: "AI traffic" }, { val: "2 wks", label: "Brief → live" }],
  },
  {
    title: "Dharamshala Tours", tag: "TRAVEL · CMS", year: "2025", wide: false, initials: "DT",
    desc: "WhatsApp-first booking. ~1,000 bookings/month.",
    img: "https://ik.imagekit.io/dn2zdxiu3/Portfolioprojectimages/DharamshalaTours/DharamshalaTours-1.webp",
    url: "/projects/dharamshala-tours",
    gradient: "linear-gradient(135deg, #E8A54B 0%, #f0c27f 100%)",
    stats: [{ val: "~1K", label: "Bookings/mo" }, { val: "WhatsApp", label: "First flow" }, { val: "Custom", label: "CMS" }],
  },
  {
    title: "Redline Moto", tag: "BRAND · E-COMMERCE", year: "2025", wide: false, initials: "RM",
    desc: "Brand identity + Razorpay store for moto apparel.",
    img: "https://ik.imagekit.io/dn2zdxiu3/Portfolioprojectimages/redlinestudios/redlinestudios-1.webp",
    url: "/projects/redline",
    gradient: "linear-gradient(135deg, #c0392b 0%, #1a1a1a 100%)",
    stats: [{ val: "Brand", label: "+ Storefront" }, { val: "Razorpay", label: "Live checkout" }, { val: "1 sprint", label: "End-to-end" }],
  },
  {
    title: "ChinkiZ Knitting Knife", tag: "D2C · CREATOR", year: "2024", wide: true, initials: "CK",
    desc: "D2C store for a 600K-sub YouTuber. Custom video gallery.",
    img: "https://ik.imagekit.io/dn2zdxiu3/Portfolioprojectimages/ChinkizKnittingKnife/ChinkizKnittingKnife-1.webp",
    url: "/projects/chinkiz",
    gradient: "linear-gradient(135deg, #E8A54B 0%, #1a1a1a 60%, #2c2c2c 100%)",
    stats: [{ val: "600K+", label: "YouTube subs" }, { val: "Razorpay", label: "Cart + COD" }, { val: "0", label: "Themes used" }],
  },
  {
    title: "Modern K.B.S.", tag: "INSTITUTIONAL", year: "2024", wide: false, initials: "MK",
    desc: "School site + admissions panel. 7 days vs. 6 months.",
    img: "https://ik.imagekit.io/dn2zdxiu3/Portfolioprojectimages/modernkbs/modernkbs-1.webp",
    url: "/projects/modernkbs",
    gradient: "linear-gradient(135deg, #2c3e50 0%, #3498db 100%)",
    stats: [{ val: "7d", label: "vs. 6 months" }, { val: "Admin", label: "For staff" }, { val: "I–XII", label: "Admissions" }],
  },
  {
    title: "Nandini Travels", tag: "TRAVEL · LOCAL", year: "2025", wide: false, initials: "NT",
    desc: "Kangra's most-reviewed taxi operator. Rebuilt site.",
    img: "https://ik.imagekit.io/dn2zdxiu3/Portfolioprojectimages/nandinitravels/nandinitravels-1.webp",
    url: "/projects/nandini",
    gradient: "linear-gradient(135deg, #1a1a1a 0%, #444 50%, #E8A54B 100%)",
    stats: [{ val: "Next.js", label: "Rebuild" }, { val: "10×", label: '"More premium"' }, { val: "Direct", label: "Bookings live" }],
  },
  {
    title: "North Peak Power Systems", tag: "INFRA · DASHBOARD", year: "2025", wide: false, initials: "NP",
    desc: "Electrical & solar contractor. 15 pages + admin.",
    img: "https://ik.imagekit.io/dn2zdxiu3/Portfolioprojectimages/NorthPeakPowerSystems/NorthPeakPowerSystems-1.webp",
    url: "/projects/northpeak",
    gradient: "linear-gradient(135deg, #27ae60 0%, #1a1a1a 100%)",
    stats: [{ val: "15", label: "Pages" }, { val: "Admin", label: "Self-publish" }, { val: "Angular", label: "Framework" }],
  },
];

const packages = [
  { name: "Landing", price: "₹7K–10K", time: "5 days", desc: "Single high-converting page", features: ["Hero + offer + social proof", "WhatsApp-first form", "Lighthouse 90+"], icon: "◎", popular: false },
  { name: "Starter", price: "₹13K–16K", time: "14 days", desc: "5-page business site", features: ["Form → WhatsApp + email", "Lighthouse 90+ on mobile", "Free hosting · year 1"], icon: "◆", popular: true },
  { name: "Business", price: "₹28K–32K", time: "2–3 weeks", desc: "10–15 pages with CMS", features: ["Simple admin panel", "Hindi / regional ready", "WhatsApp commerce flow"], icon: "⬡", popular: false },
  { name: "Premium", price: "₹48K–55K", time: "3–5 weeks", desc: "School · E-com · Brand", features: ["Custom admin / dashboard", "Razorpay · UPI · COD", "Logo & identity included"], icon: "★", popular: false },
];

const stackLayers = [
  { label: "Frontend", items: ["Astro", "Next.js", "React", "Tailwind", "Framer Motion", "Lenis"], dark: false },
  { label: "Backend", items: ["Node", "Vercel Fns", "CF Workers", "Supabase", "Sanity", "Resend", "Clerk"], dark: true },
  { label: "Payments", items: ["Razorpay", "Stripe", "WATI", "UPI", "COD"], dark: false },
  { label: "Hosting", items: ["Vercel", "Cloudflare Pages", "R2", "Netlify", "WAF"], dark: true },
  { label: "SEO · AI", items: ["Schema.org", "llms.txt", "Sitemap", "OpenGraph", "Lighthouse CI"], dark: false },
  { label: "AI Tools", items: ["Claude", "GPT", "Gemini", "pgvector", "Cursor"], dark: true },
];

const reviews = [
  { name: "Chinki", company: "ChinkiZ Knitting Knife", note: "600K+ YouTube", text: "Did not think it could be achieved without going to e-commerce builders. Divyansh was amazing — even produced a video gallery matching our tutorials." },
  { name: "Admin", company: "Modern K.B.S.", note: "7-day delivery", text: "Every other agency said 6 months. Delivered in 7 days. Excited to work with him again." },
  { name: "Founder", company: "InHimalayas", note: "AI traffic lift", text: "Glad it worked out so fast and so well. Would recommend him to anyone." },
  { name: "Founder", company: "Redline Moto", note: "Full stack · 1 sprint", text: "Bhai bhai bhai! Itne time mein pura backend, frontend, design — koi aam agency nahi de paati!" },
  { name: "Founder", company: "Nandini Travels", note: "10× more premium", text: "Looks 10 times more premium than our competitors. Started getting direct bookings." },
  { name: "Founder", company: "North Peak Power Systems", note: "Lifetime referral", text: "Exactly yahi chahiye tha. Mein apne circle mein lifetime zaroor refer karunga." },
];

const included = [
  { title: "Design", icon: "✦", dark: false, items: ["Custom layouts (no themes)", "Logo design (Premium)", "Brand palette & typography", "Mobile-first wireframes", "Day-5 preview & refund"] },
  { title: "Build", icon: "⚡", dark: true, items: ["Custom-coded (Astro / Next.js)", "Lighthouse 90+ score", "SEO basics + Schema", "llms.txt for AI search", "WhatsApp + email forms"] },
  { title: "Content", icon: "◎", dark: false, items: ["Copywriting guidance", "Image production (add-on)", "Hero video editing (add-on)", "Hindi / regional language", "Royalty-free stock setup"] },
  { title: "Launch", icon: "◆", dark: true, items: ["Domain & hosting setup", "Razorpay / UPI integration", "Google Business profile", "30 days free fixes", "5-min video walkthrough"] },
];

const faqs = [
  { q: "What do I get for ₹13,000?", a: "Custom-coded 5-page website. Mobile-perfect. Lighthouse 90+. Contact form → email + WhatsApp. Free hosting year 1. SEO basics. GST invoice. 14 days." },
  { q: "How does payment work?", a: "50% advance to start, 50% on delivery. UPI, NEFT, or Razorpay. GST invoice on first payment. Don't like the Day 5 preview? Full refund, no friction." },
  { q: "Domain and hosting — who pays?", a: "You buy your domain (₹600–1,200/yr). Hosting free on Vercel year 1. After that, ~₹2,000/yr or enrol in AMC at ₹2,500/mo." },
  { q: "Hindi or regional language?", a: "Hindi-English bilingual ₹3,000 add-on. Punjabi / Tamil / others ₹5,000 each." },
  { q: "Migrate from Wix / WordPress?", a: "Yes. Migration included — no extra fee. URLs and SEO preserved." },
  { q: "How do I know you're real?", a: "8 live client sites above. Real founder testimonials. GST registration. 10-min video call before you pay." },
];

const waSvg = `<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.111.547 4.099 1.504 5.832L0 24l6.335-1.652A11.943 11.943 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.82c-1.87 0-3.652-.507-5.202-1.424l-.372-.222-3.867 1.01 1.032-3.77-.244-.388A9.778 9.778 0 012.18 12 9.82 9.82 0 0112 2.18 9.82 9.82 0 0121.82 12 9.82 9.82 0 0112 21.82z"/>`;
---
<Base>
  <Fragment slot="head">
    <HomepageSchemas />
  </Fragment>

  <div class="lg-ambient" aria-hidden="true">
    <div class="lg-orb lg-orb-1"></div>
    <div class="lg-orb lg-orb-2"></div>
    <div class="lg-orb lg-orb-3"></div>
    <div class="lg-orb lg-orb-4"></div>
  </div>

  <div class="lg-root">
    <!-- Mobile toggle -->
    <button class="lg-glass-strong lg-mobile-toggle" id="lg-mobile-toggle" aria-label="Open menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1d1d1f" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
    <div class="lg-overlay" id="lg-overlay" hidden></div>

    <div class="lg-app-shell">
      <!-- Sidebar -->
      <aside class="lg-glass-strong lg-sidebar" id="lg-sidebar">
        <div class="lg-profile">
          <img src={AVATAR} alt="Divyansh Sood" class="lg-avatar" />
          <div>
            <div class="lg-name">Divyansh Sood</div>
            <div class="lg-subtitle">Web Developer</div>
          </div>
        </div>
        {navItems.map((item) => (
          <button class="lg-nav-item" data-target={item.id} type="button">
            <span class="lg-nav-ico">{item.icon}</span>
            <span class="lg-nav-label">{item.label}</span>
            {item.badge && <span class="lg-nav-badge">{item.badge}</span>}
          </button>
        ))}
        <a href={WA} target="_blank" rel="noopener" class="lg-sidebar-cta">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" set:html={waSvg}></svg>
          WhatsApp
        </a>
      </aside>

      <div class="lg-sidebar-spacer"></div>

      <main class="lg-main">
        <!-- ── Hero ───────────────────────────────────────── -->
        <div class="lg-fade" id="hero">
          <div class="lg-hero-grid">
            <div class="lg-glass lg-card-hover lg-hero-main">
              <div style="position:relative;z-index:1;">
                <div class="lg-eyebrow">
                  <span class="lg-eyebrow-dot"></span>
                  <span class="lg-eyebrow-text">Solo Studio · Himalayas</span>
                </div>
                <h1 class="lg-hero-h1">Websites that<br/>earn, <span style="color:#E8A54B;">for you.</span></h1>
                <p class="lg-hero-sub">Custom-coded, mobile-first. Live in <strong style="color:#1d1d1f;font-weight:600;">14 days</strong>.</p>
                <div style="display:flex;gap:10px;flex-wrap:wrap;">
                  <a href={WA} target="_blank" rel="noopener" class="lg-btn-primary lg-hero-cta">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" set:html={waSvg}></svg>
                    WhatsApp now
                  </a>
                  <a href="#work" class="lg-btn-secondary lg-glass lg-hero-cta2">See 8 live sites ↓</a>
                </div>
              </div>
              <div class="lg-hero-glow"></div>
            </div>

            <div class="lg-hero-stats">
              {heroStats.map((s) => (
                <div class="lg-glass lg-card-hover lg-stat">
                  <div class={"lg-stat-ico" + (s.amber ? " lg-amber" : "")}>{s.icon}</div>
                  <div>
                    <div class="lg-stat-val">
                      {s.count !== undefined
                        ? <span class="lg-counter" data-count-end={s.count} data-suffix={s.suffix}>0</span>
                        : <span>{s.value}</span>}<span class="lg-stat-unit">{s.unit}</span>
                    </div>
                    <div class="lg-stat-label">{s.label}</div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- ── Marquee ────────────────────────────────────── -->
        <div class="lg-glass-dark lg-marquee">
          <div class="lg-marquee-track">
            {[...marqueeItems, ...marqueeItems].map((item) => (
              <span class="lg-marquee-item">{item} <span style="color:#E8A54B;margin:0 4px;">●</span></span>
            ))}
          </div>
        </div>

        <!-- ── Work ───────────────────────────────────────── -->
        <div class="lg-fade" id="work">
          <div class="lg-sec-head">
            <h2>Selected Work</h2>
            <p>8 live · more in build</p>
          </div>
          <div class="lg-filters" id="lg-filters">
            {projectTags.map((t, i) => (
              <button class={"lg-filter" + (i === 0 ? " is-active" : "")} data-filter={t}>{t}</button>
            ))}
          </div>
          <div class="lg-work-grid" id="lg-work-grid">
            {projects.map((p, i) => (
              <a href={p.url} class={"lg-glass lg-card-hover lg-rise lg-work-card" + (p.wide ? " lg-wide" : "")}
                 data-tag={p.tag.toLowerCase()} style={`animation-delay:${Math.min(i * 0.06, 0.4)}s;`}>
                <div class="lg-work-thumb" style={`background:${p.gradient};` + (p.wide ? "height:200px;" : "height:180px;")}>
                  <span class="lg-work-initials">{p.initials}</span>
                  <img src={p.img} alt={p.title} loading="lazy" decoding="async" class="lg-work-img" onerror="this.style.display='none'" />
                  <div class="lg-work-badges">
                    <span class="lg-badge-year">{p.year}</span>
                    <span class="lg-badge-tag">{p.tag}</span>
                  </div>
                  <div class="lg-work-overlay">
                    {p.stats.map((s) => (
                      <div style="text-align:center;">
                        <div class="lg-ov-val">{s.val}</div>
                        <div class="lg-ov-label">{s.label}</div>
                      </div>
                    ))}
                  </div>
                </div>
                <div class="lg-work-info">
                  <div class="lg-work-title">{p.title}</div>
                  <div class="lg-work-desc">{p.desc}</div>
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- ── Pricing ────────────────────────────────────── -->
        <div class="lg-fade" id="pricing">
          <div class="lg-sec-head">
            <h2>Pick a package</h2>
            <p>GST invoice · 50% advance · Day-5 refund</p>
          </div>
          <div class="lg-pricing-grid">
            {packages.map((pkg, i) => (
              <div class={(pkg.popular ? "lg-glass-dark" : "lg-glass") + " lg-card-hover lg-rise lg-price-card" + (pkg.popular ? " lg-popular" : "")}
                   style={`animation-delay:${Math.min(i * 0.06, 0.3)}s;`}>
                {pkg.popular && <div class="lg-price-flag">Most picked</div>}
                <div class={"lg-price-ico" + (pkg.popular ? " lg-pop" : "")}>{pkg.icon}</div>
                <div class="lg-price-name">{pkg.name}</div>
                <div class="lg-price-desc">{pkg.desc}</div>
                <div class="lg-price-amt">{pkg.price}</div>
                <div class="lg-price-time">{pkg.time} · live URL</div>
                <div class="lg-price-feats">
                  {pkg.features.map((f) => (
                    <div class="lg-price-feat"><span class="lg-tick">✓</span>{f}</div>
                  ))}
                </div>
                <a href={`https://wa.me/919816091875?text=Hi%20Divyansh,%20I%20want%20the%20${pkg.name}%20package.`} target="_blank" rel="noopener" class="lg-price-btn">Discuss on WhatsApp ↗</a>
              </div>
            ))}
          </div>
          <div class="lg-addon-grid">
            <div class="lg-glass-dark lg-card-hover lg-addon" style="color:#fff;">
              <div class="lg-addon-eyebrow" style="color:#E8A54B;">+ AMC</div>
              <div style="font-size:21px;font-weight:700;margin-bottom:4px;">₹2,500<span style="font-size:12px;font-weight:400;opacity:0.6;">/month</span></div>
              <div style="font-size:11px;opacity:0.6;line-height:1.5;">Uptime · daily backups · 2h changes/mo</div>
            </div>
            <div class="lg-glass lg-card-hover lg-addon">
              <div class="lg-addon-eyebrow" style="color:#86868b;">+ Add-ons</div>
              <div style="display:flex;gap:6px;flex-wrap:wrap;">
                {["Logo ₹4K", "Hindi ₹3K", "Extra page ₹2K", "Photo ₹6K+", "Video ₹8K+"].map((a) => (
                  <span class="lg-addon-chip">{a}</span>
                ))}
              </div>
            </div>
            <div class="lg-card-hover lg-addon lg-addon-custom">
              <div class="lg-addon-eyebrow" style="opacity:0.85;">Custom Build</div>
              <div style="font-size:15px;font-weight:700;margin-bottom:8px;">Multi-vendor · SaaS · Rescue</div>
              <a href="https://wa.me/919816091875?text=Hi%20Divyansh,%20I%20have%20a%20custom%20project." target="_blank" rel="noopener" class="lg-addon-btn">Chat on WhatsApp ↗</a>
            </div>
          </div>
        </div>

        <!-- ── Stack ──────────────────────────────────────── -->
        <div class="lg-fade" id="stack">
          <div class="lg-sec-head">
            <h2>Under the hood</h2>
            <p>Open, owned by you, no lock-in</p>
          </div>
          <div class="lg-stack-grid">
            {stackLayers.map((layer, i) => (
              <div class={(layer.dark ? "lg-glass-dark" : "lg-glass") + " lg-card-hover lg-rise lg-stack-card"} style={`animation-delay:${Math.min(i * 0.05, 0.3)}s;`}>
                <div class={"lg-stack-tag" + (layer.dark ? " lg-dark" : "")}>{String(i + 1).padStart(2, "0")} / {layer.label}</div>
                <div style="display:flex;gap:6px;flex-wrap:wrap;">
                  {layer.items.map((item) => (
                    <span class={"lg-chip-hover lg-stack-chip" + (layer.dark ? " lg-dark" : "")}>{item}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- ── Reviews ────────────────────────────────────── -->
        <div class="lg-fade" id="reviews">
          <div class="lg-sec-head">
            <h2>Client notes</h2>
            <p>In their words</p>
          </div>
          <div class="lg-reviews-grid" id="lg-reviews">
            {reviews.map((r, i) => (
              <div class={"lg-glass lg-card-hover lg-review" + (i === 0 ? " is-active" : "")} data-idx={i}>
                <div class="lg-review-text">“{r.text}”</div>
                <div style="display:flex;align-items:center;gap:10px;">
                  <div class="lg-review-av">{r.name[0]}</div>
                  <div>
                    <div class="lg-review-name">{r.name} · {r.company}</div>
                    <div class="lg-review-note">{r.note}</div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- ── About ──────────────────────────────────────── -->
