<script is:inline>
(function () {
  // ── Animated counters ─────────────────────────────────────────
  document.querySelectorAll('.lg-counter').forEach(function (el) {
    var end = parseInt(el.getAttribute('data-count-end'), 10) || 0;
    var suffix = el.getAttribute('data-suffix') || '';
    var duration = 1800;
    var started = false;
    function run() {
      if (started) return; started = true;
      var startTime = Date.now();
      (function tick() {
        var p = Math.min((Date.now() - startTime) / duration, 1);
        var eased = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.floor(eased * end).toLocaleString() + suffix;
        if (p < 1) requestAnimationFrame(tick);
        else el.textContent = end.toLocaleString() + suffix;
      })();
    }
    var io = new IntersectionObserver(function (entries) {
      if (entries[0].isIntersecting) { run(); io.disconnect(); }
    }, { threshold: 0.3 });
    io.observe(el);
    setTimeout(run, 600);
  });

  // ── Project filter ────────────────────────────────────────────
  var filters = document.getElementById('lg-filters');
  var grid = document.getElementById('lg-work-grid');
  if (filters && grid) {
    filters.addEventListener('click', function (e) {
      var btn = e.target.closest('.lg-filter');
      if (!btn) return;
      filters.querySelectorAll('.lg-filter').forEach(function (b) { b.classList.toggle('is-active', b === btn); });
      var f = btn.getAttribute('data-filter').toLowerCase();
      grid.querySelectorAll('.lg-work-card').forEach(function (card) {
        var show = f === 'all' || card.getAttribute('data-tag').indexOf(f) !== -1;
        card.style.display = show ? 'flex' : 'none';
      });
    });
  }

  // ── FAQ accordion ─────────────────────────────────────────────
  document.querySelectorAll('#lg-faq .lg-faq-item').forEach(function (item) {
    item.querySelector('.lg-faq-q').addEventListener('click', function () {
      var open = item.classList.contains('is-open');
      document.querySelectorAll('#lg-faq .lg-faq-item').forEach(function (i) { i.classList.remove('is-open'); });
      if (!open) item.classList.add('is-open');
    });
  });

  // ── Reviews auto-rotate ───────────────────────────────────────
  var reviewWrap = document.getElementById('lg-reviews');
  if (reviewWrap) {
    var cards = Array.prototype.slice.call(reviewWrap.querySelectorAll('.lg-review'));
    var active = 0;
    function setActive(i) {
      cards[active].classList.remove('is-active');
      active = i;
      cards[active].classList.add('is-active');
    }
    cards.forEach(function (c, i) { c.addEventListener('click', function () { setActive(i); }); });
    var timer = null;
    function startRotate() { if (!timer) timer = setInterval(function () { setActive((active + 1) % cards.length); }, 5000); }
    function stopRotate() { if (timer) { clearInterval(timer); timer = null; } }
    startRotate();
    reviewWrap.addEventListener('mouseenter', stopRotate);
    reviewWrap.addEventListener('mouseleave', startRotate);
  }

  // ── Contact form → WhatsApp ───────────────────────────────────
  var form = document.getElementById('lg-contact-form');
  if (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var f = form.elements;
      var text = 'Hi Divyansh, I want a website.\n'
        + 'Name: ' + f.name.value + '\n'
        + 'Phone: ' + f.phone.value + '\n'
        + 'Business: ' + f.business.value + '\n'
        + 'Budget: ' + f.budget.value + '\n'
        + 'Details: ' + f.message.value;
      window.open('https://wa.me/919816091875?text=' + encodeURIComponent(text), '_blank');
    });
  }

  // ── Sidebar: mobile drawer + smooth scroll + active section ───
  var sidebar = document.getElementById('lg-sidebar');
  var toggle = document.getElementById('lg-mobile-toggle');
  var overlay = document.getElementById('lg-overlay');
  function closeDrawer() { sidebar.classList.remove('is-open'); overlay.hidden = true; }
  if (toggle) toggle.addEventListener('click', function () {
    var open = sidebar.classList.toggle('is-open'); overlay.hidden = !open;
  });
  if (overlay) overlay.addEventListener('click', closeDrawer);

  document.querySelectorAll('.lg-nav-item').forEach(function (item) {
    item.addEventListener('click', function () {
      var el = document.getElementById(item.getAttribute('data-target'));
      if (!el) return;
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      if (window.matchMedia('(max-width: 899px)').matches) closeDrawer();
    });
  });

  var navIds = ['hero','work','pricing','stack','reviews','about','included','faq','contact'];
  function setNav(id) {
    document.querySelectorAll('.lg-nav-item').forEach(function (n) {
      n.classList.toggle('is-active', n.getAttribute('data-target') === id);
    });
  }
  var navIo = new IntersectionObserver(function (entries) {
    entries.forEach(function (en) { if (en.isIntersecting) setNav(en.target.id); });
  }, { threshold: 0.2, rootMargin: '-80px 0px -60% 0px' });
  navIds.forEach(function (id) { var el = document.getElementById(id); if (el) navIo.observe(el); });
})();
</script>
