---
import Base from "../layouts/Base.astro";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
import { work } from "../data/work-data";
---
<Base
  title="All work — Divyansh Sood"
  description={`${work.length} shipped projects. Travel, e-commerce, education, AI tooling — case studies for each.`}
  canonical="https://www.divyanshsood.com/work/"
>
  <div class="app-shell">
    <Sidebar />
    <div class="sidebar-spacer"></div>
    <main class="main-content">
      <section id="work-all">
        <div class="sec-head">
          <h2>All work.</h2>
          <p>{work.length} projects · click any to read the case study</p>
        </div>

        <div class="work-grid" id="work-grid">
          {work.map((p) => (
            <a class="work-card" href={p.href} aria-label={`${p.title} — ${p.blurb}`}>
              <div class="work-thumb">
                <img loading="lazy" decoding="async" alt={p.images[0].alt} src={p.images[0].src} />
              </div>
              <div class="work-body">
                <div class="work-meta">{p.meta}</div>
                <div class="work-headline">
                  <span class="work-name">{p.title}</span>
                  <span class="work-pill">{p.pill}</span>
                </div>
                <p class="work-blurb">{p.blurb}</p>
                <ul class="work-kpis">
                  {p.kpis.map((k) => (
                    <li>
                      <b>{k.v}</b>
                      <span>{k.l}</span>
                    </li>
                  ))}
                </ul>
                <div class="work-go">Read case study <span aria-hidden="true">↗</span></div>
              </div>
            </a>
          ))}
        </div>

        <p class="work-back-home"><a href="/">← Back to home</a></p>
      </section>

      <Footer />
    </main>
  </div>
</Base>
