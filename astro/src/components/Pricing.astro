---
const packages = [
  {
    name: "Landing",
    desc: "Single high-converting page",
    price: "₹7K–10K",
    time: "5 days · live URL",
    features: ["Hero + offer + social proof", "WhatsApp-first form", "Lighthouse 90+"],
    waText: "Hi%20Divyansh,%20I%20want%20the%20Landing%20package%20(%E2%82%B97-10K).%20My%20business%20is...",
    icon: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="1.5"/><line x1="9" y1="9" x2="15" y2="9"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>',
    featured: false,
  },
  {
    name: "Starter",
    desc: "5-page business site",
    price: "₹13K–16K",
    time: "14 days · live URL",
    features: ["Form → WhatsApp + email", "Lighthouse 90+ on mobile", "Free hosting · year 1"],
    waText: "Hi%20Divyansh,%20I%20want%20the%20Starter%20package%20(%E2%82%B913-16K).%20My%20business%20is...",
    icon: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="10" x2="20" y2="10"/><line x1="4" y1="14" x2="20" y2="14"/><line x1="4" y1="18" x2="14" y2="18"/></svg>',
    featured: true,
  },
  {
    name: "Business",
    desc: "10–15 pages with CMS",
    price: "₹28K–32K",
    time: "2–3 weeks · live URL",
    features: ["Simple admin panel", "Hindi / regional ready", "WhatsApp commerce flow"],
    waText: "Hi%20Divyansh,%20I%20want%20the%20Business%20package%20(%E2%82%B928-32K).%20My%20business%20is...",
    icon: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="8" height="8" rx="1"/><rect x="13" y="3" width="8" height="8" rx="1"/><rect x="3" y="13" width="8" height="8" rx="1"/><rect x="13" y="13" width="8" height="8" rx="1"/></svg>',
    featured: false,
  },
  {
    name: "Premium",
    desc: "School · E-com · Brand",
    price: "₹48K–55K",
    time: "3–5 weeks · live URL",
    features: ["Custom admin / dashboard", "Razorpay · UPI · COD", "Logo & identity included"],
    waText: "Hi%20Divyansh,%20I%20want%20the%20Premium%20package%20(%E2%82%B948-55K).%20My%20business%20is...",
    icon: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l9 5-9 5-9-5z"/><path d="M3 12l9 5 9-5"/><path d="M3 17l9 5 9-5"/></svg>',
    featured: false,
  },
];

const addons = ["Logo ₹4K", "Hindi ₹3K", "Other lang ₹5K", "Extra page ₹2K", "Photo ₹6K+", "Video ₹8K+"];
---
<section id="engagements">
  <div class="sec-head">
    <h2>Three sizes. One weirder option.</h2>
    <p>GST invoice · 50% advance · Day-5 refund</p>
  </div>

  <div class="pricing-grid">
    {packages.map((p) => (
      <article class={`pcard-new${p.featured ? " is-featured" : ""}`}>
        {p.featured && <div class="pcard-flag">Most picked</div>}
        <div class="pcard-ico" set:html={p.icon}></div>
        <div class="pcard-tier">{p.name}</div>
        <div class="pcard-desc-new">{p.desc}</div>
        <div class="pcard-amt">{p.price}</div>
        <div class="pcard-time-new">{p.time}</div>
        <ul class="pcard-list-new">
          {p.features.map((f) => <li>{f}</li>)}
        </ul>
        <a class="pcard-cta-new" href={`https://wa.me/919816091875?text=${p.waText}`} target="_blank" rel="noopener">Discuss on WhatsApp →</a>
      </article>
    ))}
  </div>

  <div class="pricing-extras">
    <div class="pextra dark">
      <div class="pextra-eyebrow">+ AMC</div>
      <div class="pextra-amt">₹2,500<small>/month</small></div>
      <div class="pextra-desc">Uptime · daily backups · 2h changes/mo · domain + SSL handled</div>
    </div>
    <div class="pextra light">
      <div class="pextra-eyebrow" style="color: var(--ink-4);">+ Add-ons</div>
      <div class="pextra-chips">
        {addons.map((a) => <span class="pextra-chip">{a}</span>)}
      </div>
    </div>
    <div class="pcard-new is-custom" style="padding: 22px;">
      <div class="pcard-flag" style="position: static; display: inline-block; align-self: flex-start; margin-bottom: 6px;">Custom Build</div>
      <div class="pcard-tier" style="font-size: 15px; margin-top: 8px;">Multi-vendor · SaaS · Rescue</div>
      <p class="pcard-desc-new" style="font-size: 12px; margin-bottom: 14px;">Anything weirder than the standard tiers — quote in 10 min, 5-day refund.</p>
      <a class="pcard-cta-new" href="https://wa.me/919816091875?text=Hi%20Divyansh,%20I%20have%20a%20custom%20project." target="_blank" rel="noopener">Chat on WhatsApp →</a>
    </div>
  </div>
</section>
