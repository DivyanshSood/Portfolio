---
import { work } from "../data/work-data";
const featured = work.slice(0, 3);
---
<section id="work" class="work-strip-section">
  <header class="strip-head">
    <div>
      <h2>Selected work.</h2>
      <p>Three to start with · scroll for context</p>
    </div>
    <a href="/work/" class="strip-more">See all {work.length}<span aria-hidden="true"> →</span></a>
  </header>

  <div class="work-strip" data-strip>
    {featured.map((p) => (
      <a class="strip-item" href={p.href} aria-label={`${p.title} — ${p.blurb}`}>
        <div class="strip-thumb">
          <img loading="lazy" decoding="async" alt={p.images[0].alt} src={p.images[0].src} />
        </div>
        <div class="strip-meta">
          <span class="strip-year">{p.meta}</span>
          <span class="strip-pill">{p.pill}</span>
        </div>
        <h3 class="strip-title">{p.title}</h3>
        <p class="strip-blurb">{p.blurb}</p>
      </a>
    ))}
  </div>
</section>
