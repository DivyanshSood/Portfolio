---
const quotes = [
  { body: `Didn't think it could be achieved without going to an e-commerce builder. Highly recommend.`, name: "Chinki", company: "ChinkiZ Knitting Knife", sig: "600K+ YouTube" },
  { body: `Every other agency said 6 months. Delivered in 7 days. Excited to work with him again.`, name: "Admin", company: "Modern K.B.S.", sig: "7-day delivery" },
  { body: `Glad it worked out so fast and so well. Would recommend him to anyone.`, name: "Founder", company: "InHimalayas", sig: "AI traffic lift" },
  { body: `Bhai bhai bhai! Itne time mein pura backend, frontend, design — koi aam agency nahi de paati!`, name: "Founder", company: "Redline Moto", sig: "Full stack · 1 sprint" },
  { body: `Looks 10 times more premium than our competitors. Started getting direct bookings.`, name: "Founder", company: "Nandini Travels", sig: "10× more premium" },
  { body: `Exactly yahi chahiye tha. Mein apne circle mein lifetime zaroor refer karunga.`, name: "Founder", company: "North Peak Power Systems", sig: "Govt → private pivot" },
];
---
<section id="notes" class="notes-bare">
  <div class="sec-head">
    <h2>Client notes.</h2>
    <p>In their words.</p>
  </div>

  <ul class="notes-list">
    {quotes.map((q) => (
      <li class="note">
        <blockquote class="note-body">"{q.body}"</blockquote>
        <footer class="note-foot">
          <span class="note-who">{q.name} · {q.company}</span>
          <span class="note-sig">{q.sig}</span>
        </footer>
      </li>
    ))}
  </ul>
</section>
