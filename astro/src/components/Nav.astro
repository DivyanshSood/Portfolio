---
// Top bar nav (used on /blog and /projects/* — homepage uses Sidebar instead).
---
<nav class="nav-bar" aria-label="Primary">
  <a class="nav-brand" href="/">
    <span class="dot"></span>
    <span>DIVYANSH SOOD</span>
  </a>

  <div class="nav-menu" id="nav-menu">
    <a class="nav-link" href="/#work">Work</a>
    <a class="nav-link" href="/#engagements">Pricing</a>
    <a class="nav-link" href="/#stack">Stack</a>
    <a class="nav-link" href="/#notes">Reviews</a>
    <a class="nav-link" href="/#about">About</a>
    <a class="nav-link" href="/blog/">Blog</a>
  </div>

  <a class="nav-wa" href="https://wa.me/919816091875?text=Hi%20Divyansh,%20I%20want%20a%20website%20for%20my%20business." target="_blank" rel="noopener" data-track="nav-whatsapp">
    <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.111.547 4.099 1.504 5.832L0 24l6.335-1.652A11.943 11.943 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
    <span>WhatsApp</span>
  </a>

  <button class="nav-toggle" id="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav-menu">
    <span></span><span></span><span></span>
  </button>
</nav>

<style>
  .nav-bar {
    position: fixed;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 6px 6px 14px;
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(20px) saturate(1.4);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 999px;
    box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.12), 0 0 0 1px rgba(0, 0, 0, 0.03);
    max-width: calc(100vw - 24px);
  }
  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--f-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--ink-3);
    white-space: nowrap;
  }
  .nav-brand .dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px rgba(232, 165, 75, 0.4);
  }
  .nav-menu { display: flex; align-items: center; gap: 2px; margin-left: 8px; }
  .nav-link {
    padding: 7px 12px;
    font-size: 12px;
    font-weight: 500;
    color: var(--ink-4);
    border-radius: 999px;
    transition: color 0.25s var(--ease-out), background 0.25s var(--ease-out);
    white-space: nowrap;
  }
  .nav-link:hover { color: var(--ink); background: rgba(0,0,0,0.05); }

  .nav-wa {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 14px 7px 11px;
    font-size: 12px;
    font-weight: 600;
    color: #fff;
    background: var(--ink);
    border-radius: 999px;
    transition: background 0.25s var(--ease-out), transform 0.25s var(--ease-out);
    white-space: nowrap;
  }
  .nav-wa:hover { background: var(--accent); transform: translateY(-1px); }

  .nav-toggle {
    display: none;
    width: 36px; height: 36px;
    background: rgba(0,0,0,0.04);
    border-radius: 999px;
    align-items: center; justify-content: center;
    flex-direction: column; gap: 4px;
  }
  .nav-toggle span {
    width: 16px; height: 2px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.25s var(--ease-out);
  }
  .nav-toggle.is-open span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .nav-toggle.is-open span:nth-child(2) { opacity: 0; }
  .nav-toggle.is-open span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  @media (max-width: 760px) {
    .nav-bar { gap: 4px; padding: 5px 5px 5px 12px; }
    .nav-menu {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      flex-direction: column;
      align-items: stretch;
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 16px 40px rgba(0,0,0,0.12);
      padding: 8px;
      min-width: 180px;
      display: none;
      margin-left: 0;
    }
    .nav-menu.is-open { display: flex; }
    .nav-link { padding: 10px 12px; font-size: 13px; }
    .nav-toggle { display: inline-flex; }
    .nav-wa span { display: none; }
    .nav-wa { padding: 7px 10px; }
  }
</style>

<script is:inline>
(function () {
  var t = document.getElementById('nav-toggle');
  var m = document.getElementById('nav-menu');
  if (!t || !m) return;
  function close() {
    m.classList.remove('is-open');
    t.classList.remove('is-open');
    t.setAttribute('aria-expanded', 'false');
  }
  function open() {
    m.classList.add('is-open');
    t.classList.add('is-open');
    t.setAttribute('aria-expanded', 'true');
  }
  t.addEventListener('click', function (e) {
    e.stopPropagation();
    if (m.classList.contains('is-open')) close(); else open();
  });
  m.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', close); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
  document.addEventListener('click', function (e) {
    if (!m.classList.contains('is-open')) return;
    if (m.contains(e.target) || t.contains(e.target)) return;
    close();
  });
})();
</script>
