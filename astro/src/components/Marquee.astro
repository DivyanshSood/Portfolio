---
const items = [
  "CBSE School Portal",
  "D2C E-commerce",
  "600K Creator Storefront",
  "Travel Booking Platform",
  "Tour Operator CMS",
  "Solar Contractor Dashboard",
  "Taxi Operator Rebuild",
  "Brand + Razorpay Storefront",
  "AI Website Generator",
  "Live in 14 days",
];
const sequence = [...items, ...items];
---
<div class="mar-card reveal" aria-hidden="true">
  <div class="mar-track">
    {sequence.map((item) => (
      <span class="mar-item">
        {item}
        <span class="sep">●</span>
      </span>
    ))}
  </div>
</div>
