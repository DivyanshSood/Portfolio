---
const groups = [
  {
    title: "Design",
    dark: false,
    icon: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 0 0 18"/></svg>',
    items: ["Custom layouts (no themes)", "Logo design (Premium tier)", "Brand palette & typography", "Mobile-first wireframes", "Day-5 preview & refund"],
  },
  {
    title: "Build",
    dark: true,
    icon: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z"/></svg>',
    items: ["Custom-coded (Astro / Next.js)", "Lighthouse 90+ score", "SEO basics + Schema markup", "llms.txt for AI search", "WhatsApp + email forms"],
  },
  {
    title: "Content",
    dark: false,
    icon: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><polyline points="3 7 12 13 21 7"/></svg>',
    items: ["Copywriting guidance", "Image production (add-on)", "Hero video editing (add-on)", "Hindi / regional language", "Royalty-free stock setup"],
  },
  {
    title: "Launch",
    dark: true,
    icon: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19c0-4 4-9 9-9 0 5-5 9-9 9z"/><path d="M14 4c4 1 5 4 6 6-2 1-5 0-6-6z"/></svg>',
    items: ["Domain & hosting setup", "Razorpay / UPI integration", "Google Business profile help", "30 days free fixes post-launch", "5-min video walkthrough"],
  },
];
---
<section id="included">
  <div class="sec-head">
    <h2>A to Z. No surprises.</h2>
    <p>What's included · every project</p>
  </div>
  <div class="incl-grid-new">
    {groups.map((g) => (
      <div class={`incl-card ${g.dark ? "dark" : "light"}`}>
        <div class="incl-card-ico" set:html={g.icon}></div>
        <div class="incl-card-title">{g.title}</div>
        <ul class="incl-list-new">
          {g.items.map((it) => <li>{it}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>
