---
// Left rail navigation for the homepage dashboard.
type NavItem = { id: string; label: string; icon: string; badge?: string; href?: string };
const navItems: NavItem[] = [
  { id: "hero",      label: "Home",            icon: "home" },
  { id: "work",      label: "Work",            icon: "grid", badge: "8", href: "/work/" },
  { id: "notes",     label: "Kind words",      icon: "star" },
  { id: "about",     label: "About",           icon: "user" },
  { id: "contact",   label: "Contact",         icon: "mail" },
  { id: "blog",      label: "Writing",         icon: "doc", href: "/blog/" },
];

const icons: Record<string, string> = {
  home:  '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1V9.5z"/></svg>',
  grid:  '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>',
  tag:   '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41 13.42 20.58a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><circle cx="7" cy="7" r="1.5"/></svg>',
  bolt:  '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z"/></svg>',
  star:  '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3 7 7 .5-5.5 5 1.7 7.5L12 17.7 5.8 22l1.7-7.5L2 9.5 9 9z"/></svg>',
  user:  '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-7 8-7s8 3 8 7"/></svg>',
  check: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5 5L20 6"/></svg>',
  help:  '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.5 9a2.5 2.5 0 1 1 4 2c-.6.5-1.5 1-1.5 2"/><circle cx="12" cy="17" r="0.5" fill="currentColor"/></svg>',
  mail:  '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>',
  doc:   '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>',
};
---
<header class="mobile-header" aria-label="Mobile">
  <a href="/" class="mh-brand">
    <img src="https://ik.imagekit.io/dn2zdxiu3/Portfolioprojectimages/divyansh.webp" alt="Divyansh Sood" class="mh-avatar" loading="lazy" />
    <span class="mh-name">Divyansh Sood</span>
  </a>
  <button class="sidebar-toggle" id="sidebar-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="sidebar">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
  </button>
</header>

<div class="sidebar-overlay" id="sidebar-overlay" hidden></div>

<aside class="sidebar" id="sidebar" aria-label="Primary">
  <div class="sidebar-profile">
    <img src="https://ik.imagekit.io/dn2zdxiu3/Portfolioprojectimages/divyansh.webp" alt="Divyansh Sood" class="sidebar-avatar" loading="lazy" />
    <div>
      <div class="sidebar-name">Divyansh Sood</div>
      <div class="sidebar-role">Web Developer</div>
    </div>
  </div>

  <div class="sidebar-nav">
    {navItems.map((item) => (
      item.href ? (
        <a class="sidebar-link" href={item.href} data-target={item.id}>
          <span class="ico" set:html={icons[item.icon]}></span>
          <span>{item.label}</span>
          {item.badge && <span class="badge">{item.badge}</span>}
        </a>
      ) : (
        <button class="sidebar-link" data-target={item.id} type="button">
          <span class="ico" set:html={icons[item.icon]}></span>
          <span>{item.label}</span>
          {item.badge && <span class="badge">{item.badge}</span>}
        </button>
      )
    ))}
  </div>

  <div class="sidebar-status" aria-label="Availability">
    <span class="sidebar-status-dot"></span>
    <span>Available for new work</span>
  </div>
</aside>

<script is:inline>
(function () {
  var sidebar = document.getElementById('sidebar');
  var toggle  = document.getElementById('sidebar-toggle');
  var overlay = document.getElementById('sidebar-overlay');
  if (!sidebar || !toggle) return;

  // ---- Mobile open/close
  function open()  { sidebar.classList.add('is-open'); overlay.hidden = false; toggle.setAttribute('aria-expanded', 'true'); }
  function close() { sidebar.classList.remove('is-open'); overlay.hidden = true;  toggle.setAttribute('aria-expanded', 'false'); }
  toggle.addEventListener('click', function () {
    if (sidebar.classList.contains('is-open')) close(); else open();
  });
  overlay.addEventListener('click', close);

  // ---- Smooth scroll for in-page links (skip true cross-page anchors like /blog/)
  sidebar.querySelectorAll('.sidebar-link').forEach(function (link) {
    link.addEventListener('click', function (e) {
      var id = link.getAttribute('data-target');
      if (link.tagName === 'A' && link.getAttribute('href') && link.getAttribute('href').charAt(0) !== '#') {
        // External / cross-page link — let it navigate
        return;
      }
      var el = document.getElementById(id);
      if (!el) return;
      e.preventDefault();
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      if (window.matchMedia('(max-width: 899px)').matches) close();
    });
  });

  // ---- Active state on scroll
  var sections = ['hero','work','notes','about','contact']
    .map(function (id) { return document.getElementById(id); })
    .filter(Boolean);

  function setActive(id) {
    sidebar.querySelectorAll('.sidebar-link').forEach(function (l) {
      l.classList.toggle('is-active', l.getAttribute('data-target') === id);
    });
  }

  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) setActive(entry.target.id);
    });
  }, { threshold: 0.2, rootMargin: '-80px 0px -60% 0px' });
  sections.forEach(function (s) { io.observe(s); });
})();
</script>
