---
// Build-your-own quote — vanilla JS slider + chip toggles + add-on toggles.
// On submit, the WhatsApp button href is rebuilt with the encoded payload.
// No backend, no Formspree — all state lives in the URL of the wa.me link.
---
<section id="quote" class="quote-section" aria-labelledby="quote-title">
  <header class="sec-head">
    <div class="sec-eyebrow"><span class="num">03</span><span>Pricing</span></div>
    <h2 id="quote-title">Build <em>your own</em> quote.</h2>
    <p>Drag the slider · pick a delivery speed · toggle add-ons. The number is live.</p>
  </header>

  <div class="quote-grid">
    <div class="quote-panel" data-quote-panel>
      <div class="qrow">
        <div class="qrow-head">
          <span class="qrow-label">Pages</span>
          <span class="qrow-meta"><b data-page-count>6</b> · <span data-page-cost>₹21,000</span></span>
        </div>
        <input
          class="quote-slider"
          type="range"
          min="3" max="20" value="6" step="1"
          data-pages
          aria-label="Number of pages"
        />
        <div class="qticks" aria-hidden="true">
          <span>3 · brochure</span><span>5 · landing</span><span>10 · full</span><span>20</span>
        </div>
      </div>

      <div class="qrow">
        <div class="qrow-head">
          <span class="qrow-label">Delivery speed</span>
          <span class="qrow-meta"><b data-speed-days>14</b> days · <span data-speed-mul>×1.0</span></span>
        </div>
        <div class="chip-row" role="radiogroup" aria-label="Delivery speed">
          <button class="qchip" type="button" data-speed="0">considered<span class="qchip-price">21 days</span></button>
          <button class="qchip on" type="button" data-speed="1">normal<span class="qchip-price">14 days</span></button>
          <button class="qchip" type="button" data-speed="2">rushed<span class="qchip-price">7 days</span></button>
        </div>
      </div>

      <div class="qrow">
        <div class="qrow-head">
          <span class="qrow-label">Add-ons</span>
          <span class="qrow-meta"><b data-addon-count>4</b> selected · tap to toggle</span>
        </div>
        <div class="chip-row chip-row-wrap">
          <button class="qchip on" type="button" data-addon="cms" data-cost="8000">CMS / admin<span class="qchip-price">₹8,000</span></button>
          <button class="qchip" type="button" data-addon="i18n" data-cost="4000">Hindi + English<span class="qchip-price">₹4,000</span></button>
          <button class="qchip" type="button" data-addon="payments" data-cost="6000">Razorpay / Stripe<span class="qchip-price">₹6,000</span></button>
          <button class="qchip on" type="button" data-addon="wa" data-cost="5000">WhatsApp bridge<span class="qchip-price">₹5,000</span></button>
          <button class="qchip" type="button" data-addon="blog" data-cost="4000">Blog / news<span class="qchip-price">₹4,000</span></button>
          <button class="qchip on" type="button" data-addon="seo" data-cost="3500">Local SEO + schema<span class="qchip-price">₹3,500</span></button>
          <button class="qchip on" type="button" data-addon="motion" data-cost="4500">Tasteful motion<span class="qchip-price">₹4,500</span></button>
          <button class="qchip" type="button" data-addon="amc" data-cost="6000">12-month AMC<span class="qchip-price">₹6,000</span></button>
        </div>
      </div>

      <div class="qrow qrow-last">
        <div class="qrow-head">
          <span class="qrow-label">Always included</span>
          <span class="qrow-meta">no surcharge</span>
        </div>
        <ul class="qincluded">
          <li>GST invoice · HSN 998314</li>
          <li>50% advance · day-5 refund window</li>
          <li>GitHub repo + hosting handover</li>
          <li>20-minute Loom walkthrough</li>
          <li>Two rounds of polish before launch</li>
        </ul>
      </div>
    </div>

    <aside class="quote-total" aria-label="Live estimate">
      <div class="qt-label">Estimate</div>
      <div class="qt-num">
        <span class="qt-cur">₹</span><span data-total>42,000</span>
      </div>
      <div class="qt-delivery">
        ≈ <b data-half>₹21,000</b> advance · live by day <b data-speed-days-2>14</b>
      </div>

      <ul class="qt-summary">
        <li><b data-page-count-2>6</b> pages · <span data-speed-label>normal</span> build</li>
        <li><b data-addon-count-2>4</b> add-ons selected</li>
        <li>GST invoice · day-5 refund</li>
        <li>You keep the code</li>
      </ul>

      <a
        class="qt-cta"
        href="https://wa.me/919816091875"
        target="_blank"
        rel="noopener"
        data-wa-link
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
          <path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l.376.599-1.013 3.697 3.616-.949zm5.396-2.207c-.213-.354-.213-.354-.428-.354-.213 0-.353.071-.499.302-.428.713-.713.998-1.07.998-.142 0-.357-.071-.642-.214-1.07-.499-2.069-1.282-2.853-2.281-.642-.785-1.07-1.498-1.07-1.711 0-.143.071-.215.142-.357.215-.214.428-.499.642-.713.071-.142.142-.213.213-.428.071-.213 0-.357-.071-.499-.071-.142-.642-1.498-.856-2.067-.213-.499-.428-.428-.642-.428H4.71c-.213 0-.642.071-.927.428-.357.357-1.213 1.213-1.213 2.924 0 1.71 1.213 3.353 1.426 3.638.214.286 2.424 3.781 6.062 5.235 3.638 1.426 3.638.927 4.281.856.642-.071 2.067-.785 2.353-1.642.286-.785.286-1.498.213-1.642-.071-.142-.286-.213-.642-.357-.357-.142-2.067-1.07-2.353-1.213-.357-.142-.499-.213-.642.143z"/>
        </svg>
        Send via WhatsApp →
      </a>

      <p class="qt-fine">
        Estimate, not a final invoice. Real number depends on content readiness and how many cousins want a say.
      </p>
    </aside>
  </div>
</section>

<script is:inline>
(function () {
  var BASE = 18000;
  var PER_PAGE = 3000;
  var SPEEDS = [
    { lbl: "considered", d: 21, m: 0.9 },
    { lbl: "normal",     d: 14, m: 1.0 },
    { lbl: "rushed",     d:  7, m: 1.35 }
  ];
  var WA = "https://wa.me/919816091875?text=";

  var state = { pages: 6, speed: 1 };
  var panel = document.querySelector('[data-quote-panel]');
  if (!panel) return;
  var pageInput = panel.querySelector('[data-pages]');
  var fmt = function (n) { return n.toLocaleString('en-IN'); };

  var setText = function (sel, val) {
    document.querySelectorAll(sel).forEach(function (el) { el.textContent = val; });
  };

  var compute = function () {
    var addons = panel.querySelectorAll('[data-addon].on');
    var addonSum = 0;
    addons.forEach(function (b) { addonSum += parseInt(b.getAttribute('data-cost'), 10); });
    var pageCost = BASE + PER_PAGE * (state.pages - 5);
    var subtotal = pageCost + addonSum;
    var total = Math.round(subtotal * SPEEDS[state.speed].m);
    var half = Math.round(total / 2);

    setText('[data-page-count]', state.pages);
    setText('[data-page-count-2]', state.pages);
    setText('[data-page-cost]', '₹' + fmt(pageCost));
    setText('[data-speed-days]', SPEEDS[state.speed].d);
    setText('[data-speed-days-2]', SPEEDS[state.speed].d);
    setText('[data-speed-mul]', '×' + SPEEDS[state.speed].m);
    setText('[data-speed-label]', SPEEDS[state.speed].lbl);
    setText('[data-addon-count]', addons.length);
    setText('[data-addon-count-2]', addons.length);
    setText('[data-total]', fmt(total));
    setText('[data-half]', '₹' + fmt(half));

    var lines = [];
    lines.push("Hi Divyansh — built a quote on your site:");
    lines.push("• " + state.pages + " pages, " + SPEEDS[state.speed].lbl + " (" + SPEEDS[state.speed].d + " days)");
    var addonLabels = [];
    addons.forEach(function (b) { addonLabels.push(b.firstChild.textContent.trim()); });
    lines.push("• Add-ons: " + (addonLabels.join(", ") || "none"));
    lines.push("• Total: ₹" + fmt(total) + " (₹" + fmt(half) + " advance)");
    lines.push("When can we start?");

    var cta = document.querySelector('[data-wa-link]');
    if (cta) cta.href = WA + encodeURIComponent(lines.join("\n"));
  };

  pageInput.addEventListener('input', function (e) {
    state.pages = parseInt(e.target.value, 10);
    compute();
  });

  panel.querySelectorAll('[data-speed]').forEach(function (b) {
    b.addEventListener('click', function () {
      state.speed = parseInt(b.getAttribute('data-speed'), 10);
      panel.querySelectorAll('[data-speed]').forEach(function (x) { x.classList.remove('on'); });
      b.classList.add('on');
      compute();
    });
  });

  panel.querySelectorAll('[data-addon]').forEach(function (b) {
    b.addEventListener('click', function () {
      b.classList.toggle('on');
      compute();
    });
  });

  compute();
})();
</script>
