---
// Boring tech, loud results.
// Bento layout: one dark hero cell explaining the philosophy + a chip tray,
// supporting cells for hosting / payments / CMS / comms / i18n, and a
// live-performance footer cell. Mobile collapses to a single column.

const TECH = [
  "Astro", "Next.js", "React", "TypeScript", "Tailwind",
  "Sanity", "Supabase", "Razorpay", "Stripe", "Cloudflare",
  "Vercel", "Resend",
];
---
<section id="stack" class="stack-bento" aria-labelledby="stack-title">
  <header class="sec-head">
    <div class="sec-eyebrow"><span class="num">04</span><span>The Toolkit</span></div>
    <h2 id="stack-title">Boring tech, <em>loud results.</em></h2>
    <p>Astro, Next.js, Postgres. Not whatever shipped on Twitter last week.</p>
  </header>

  <div class="bento">
    <article class="cell big">
      <div class="cell-eye">Philosophy</div>
      <h3>Use the <em>boring</em>, battle-tested ones.</h3>
      <p>If your site has to outlive three rounds of "let's redesign", boring beats clever — every single time. Open standards, owned by you, zero lock-in.</p>
      <div class="chip-tray" aria-label="Stack chips">
        {TECH.map((t) => <span class="tech-chip">{t}</span>)}
      </div>
    </article>

    <article class="cell s1 tone-paprika">
      <div class="cell-eye">Hosting</div>
      <h3>Vercel · Cloudflare</h3>
      <p>Edge-deployed everywhere. Bangalore in 0.9s. Brooklyn in 0.6s. Berlin in 0.7s.</p>
    </article>

    <article class="cell s2 tone-cream">
      <div class="cell-eye">Payments</div>
      <h3>₹ · $ · €</h3>
      <p>Razorpay for India. Stripe for everyone else. UPI, cards, wallets — no PayPal arguments.</p>
    </article>

    <article class="cell s3">
      <div class="cell-eye">CMS</div>
      <h3>Sanity · Notion</h3>
      <p class="tight">Your team edits, not me.</p>
    </article>

    <article class="cell s3">
      <div class="cell-eye">Comms</div>
      <h3>WhatsApp · Resend</h3>
      <p class="tight">Forms route to your phone.</p>
    </article>

    <article class="cell s2 tone-forest">
      <div class="cell-eye">SEO · AI</div>
      <h3>Schema, sitemap, llms.txt.</h3>
      <p>Structured data that Google + ChatGPT + Perplexity actually read. Your site shows up where buyers look.</p>
    </article>

    <article class="cell s1 perf-cell">
      <div class="cell-eye">Live performance · this page</div>
      <div class="perf-line">
        <span class="v" data-metric="lcp">1.1s</span><span class="lbl">LCP</span>
        <span class="sep">·</span>
        <span class="v" data-metric="cls">0.02</span><span class="lbl">CLS</span>
        <span class="sep">·</span>
        <span class="v" data-metric="inp">120ms</span><span class="lbl">INP</span>
      </div>
      <p>Median Core Web Vitals across every site in production.</p>
    </article>
  </div>
</section>
